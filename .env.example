# ---------------------------------------------------------------------------
# DLPay Web — variables de entorno (plantilla)
#
# Copiar a `.env` y completar. `.env` NUNCA se versiona (ver ADR-0003).
#
# REGLA: toda variable con prefijo PUBLIC_ queda EXPUESTA en el navegador.
# Lo que se prefija es público y debe tratarse como público.
# Ningún secreto lleva prefijo PUBLIC_. Ningún secreto entra al cliente.
#
# Hoy el sitio no consume ninguna API ni almacena datos: todas las variables
# de abajo son CONFIGURACIÓN PÚBLICA, no credenciales.
# ---------------------------------------------------------------------------

# --- Contacto --------------------------------------------------------------
# Número de WhatsApp de la mesa, en formato internacional sin signos.
# Es el destino del CTA principal del cotizador (ver cotizador-spec.md §5).
PUBLIC_WHATSAPP_NUMBER=56977615921

# --- Cotizador -------------------------------------------------------------
# Precio de MUESTRA en CLP por 1 USDT, consumido por ConfigPriceSource.
# NO es un precio real ni una fuente de mercado: es un valor configurable
# mientras la fuente oficial siga PENDIENTE (CLAUDE.md §13, D7).
PUBLIC_QUOTE_SAMPLE_RATE=919.70

# Etiqueta legible de la fuente del precio, mostrada junto al dato.
# PENDIENTE DE DECISIÓN — fuente oficial de market price (CLAUDE.md §13, D7).
PUBLIC_QUOTE_SOURCE_LABEL=referencia de mercado

# Límites operativos mostrados en los estados del cotizador.
# PENDIENTE DE DECISIÓN — montos reales (CLAUDE.md §13, D6).
PUBLIC_QUOTE_MIN_CLP=50000

# Monto máximo. Sin definir, el estado "sobre el máximo" no se activa.
# PENDIENTE DE DECISIÓN — es una regla de negocio (CLAUDE.md §13, D21).
# PUBLIC_QUOTE_MAX_CLP=

# --- Plataforma de Guita ---------------------------------------------------
# Punto ÚNICO de acoplamiento con la plataforma actual. "Iniciar sesión" y
# "Crear cuenta" enlazan aquí hasta que exista infraestructura propia — que es
# una etapa independiente, fuera del alcance de este proyecto.
PUBLIC_PLATFORM_LOGIN_URL=https://dlpay.cl/auth/login
PUBLIC_PLATFORM_REGISTER_URL=https://dlpay.cl/auth/register

# --- Sitio -----------------------------------------------------------------
# URL canónica del despliegue. De ella salen canonical, Open Graph, el JSON-LD,
# el sitemap y el robots.txt.
#
# SE DEJA VACÍA A PROPÓSITO. Un build la EXIGE y además la valida: rechaza los
# hosts locales (localhost, 127.0.0.1, *.local), lo que no sea https, y las
# rutas que no sean la raíz del dominio. Antes esta plantilla traía
# `http://localhost:4321`, y quien copiaba el archivo obtenía un build verde
# que publicaba localhost en todas esas URL sin que nada avisara.
#
# En `npm run dev` no hace falta: el servidor de desarrollo usa
# http://localhost:4321 por su cuenta.
#
# Para verificar un build en local, pásala en la misma línea:
#     PUBLIC_SITE_URL=https://dlpay.cl npm run build
PUBLIC_SITE_URL=

# --- Indexación por buscadores --------------------------------------------
# Abre la indexación. CERRADA POR OMISIÓN: sólo el literal `true` la habilita.
# Ausente, vacía, `1` o `yes` dejan el despliegue con `noindex, nofollow` en
# todas las páginas y `Disallow: /` en el robots.txt.
#
# El modo seguro es el que se obtiene sin hacer nada, porque el riesgo no es
# simétrico: un Staging indexado publica bajo la marca DLPay `/terminos/` y
# `/privacidad/`, que hoy son páginas de estado pendientes de Compliance
# (CLAUDE.md §13, D9/D19/D20), y duplica el contenido de dlpay.cl.
#
# Se pone en `true` ÚNICAMENTE en el despliegue del sitio público.
# Cada build declara en su salida qué política aplicó.
PUBLIC_ALLOW_INDEXING=false
