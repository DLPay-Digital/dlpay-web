---
/**
 * Layout base. Deliberadamente mínimo: sólo el documento, los tokens y el SEO
 * que toda página necesita. Cabecera, pie y navegación se construyen en Fase 4,
 * cuando una página real los pida (Principio 5).
 */
import '../styles/fonts.css';
import '../styles/tokens.css';
import { indexing, site } from '../lib/config/site.ts';

interface Props {
  title: string;
  description: string;
  /** Ruta canónica relativa, con barra inicial. */
  path?: string;
  /**
   * Precarga también la tipografía de cifras. Sólo en las páginas con cotizador:
   * ahí Spline Sans Mono pinta el precio, que es el elemento protagonista del
   * primer viewport. En el resto sería peso desperdiciado.
   */
  hasQuoter?: boolean;
  /**
   * Cierra la indexación de ESTA página, esté abierta o no la del sitio. Hoy lo
   * usa sólo la 404: es la única página que se sirve bajo cualquier URL, así que
   * no tiene una dirección propia que un buscador deba guardar.
   *
   * Arrastra la omisión del `<link rel="canonical">` a propósito. Un canónico
   * afirma «esta es la versión preferida de este contenido» y `noindex` afirma
   * «no guardes este contenido»: juntos son señales contradictorias, y además
   * aquí el contenido no vive en ninguna URL. El `og:url` sí se conserva, porque
   * una tarjeta Open Graph sin URL queda inválida.
   */
  noindex?: boolean;
  /**
   * Esta página **no ejecuta un solo byte** y así se queda: no recibe el
   * marcador de visita de la intro de marca (ADR-0010).
   *
   * Lo usan las cuatro legales —vía `Legal.astro`— y la 404. Son las cinco
   * páginas que `docs/arquitectura-produccion.md` §1.1 declara en **0 bytes
   * ejecutables**, y esa propiedad es lo que ADR-0010 llamó «opción C»:
   * Sebastián eligió no ponerlas a ejecutar por una animación de entrada,
   * porque es exactamente lo que **D28** se negó a pagar para darle botón de
   * cerrar a la franja de notificación.
   *
   * Lo que cuesta dejarlas fuera está escrito en ADR-0010 y no se esconde:
   * quien entre por una de estas cinco y después **escriba** la dirección de
   * la Home verá la intro, porque sin marcador y sin referente no hay forma de
   * distinguir ese caso de una llegada nueva. El clic sí queda cubierto.
   *
   * No hace falta acordarse: `tests/zero-js.test.ts` falla si una de las cinco
   * empieza a ejecutar algo.
   */
  zeroJs?: boolean;
}

const {
  title,
  description,
  path = Astro.url.pathname,
  hasQuoter = false,
  noindex = false,
  zeroJs = false,
} = Astro.props;
const canonical = new URL(path, site.url).href;
const fullTitle = title === site.name ? title : `${title} · ${site.name}`;
const ogImage = new URL('/og-image.png', site.url).href;

/**
 * Datos estructurados. Sólo campos verificables: nombre, razón social, sitio y
 * logo. Nada de fundación, cobertura, valoraciones ni cifras — el mismo criterio
 * que rige el resto del contenido.
 */
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  logo: new URL('/logo.png', site.url).href,
};
---
<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      ── Marcador de visita ─────────────────────────────────────────────────

      Va **lo primero**, antes que cualquier otro script del documento, y su
      único trabajo es responder a una pregunta: ¿es ésta la primera página que
      esta pestaña ve de nuestro sitio? Lo hace **leyendo antes de escribir**.

      Quien lo consume es la intro de marca de la Home (ADR-0010). Está acá y no
      en la Home porque la pregunta se responde en la página de ENTRADA, sea cual
      sea; si sólo la Home dejara rastro, entrar por `/precio` y llegar después a
      la Home dispararía la intro a mitad de visita.

      **Ojo con el orden**: si este bloque quedara después del componente de la
      intro, `window.__dlpayInicio` valdría `undefined` allí y **la intro no se
      vería nunca**. El fallo cae del lado seguro, pero es silencioso: si algún
      día deja de verse, es esto.

      `catch` → `false`, y no `true`: sin almacenamiento no se puede saber si es
      una entrada, y ante la duda no se tapa la página.
    */}
    {!zeroJs && (
      <script is:inline>
        (function () {
          try {
            var visto = sessionStorage.getItem('dlpay-visita');
            sessionStorage.setItem('dlpay-visita', '1');
            window.__dlpayInicio = !visto;
          } catch (e) {
            window.__dlpayInicio = false;
          }
        })();
      </script>
    )}

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}

    {/*
      Escudo de indexación. Este layout es el único `<head>` del sitio —las
      páginas legales pasan por `Legal.astro`, que envuelve a este—, así que
      basta ponerlo aquí para cubrir todas las rutas.

      Va cerrado salvo que se abra explícitamente (PUBLIC_ALLOW_INDEXING=true).
      Un Staging indexable publicaría bajo la marca DLPay `/terminos/` y
      `/privacidad/`, que son páginas de estado pendientes de Compliance
      (CLAUDE.md §13, D9/D19/D20), y duplicaría el contenido de dlpay.cl.
    */}
    {(noindex || !indexing.allowed) && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0B1320" />

    <!-- Sólo la variante del primer viewport se precarga (Design System §3) -->
    <link
      rel="preload"
      href="/fonts/familjen-grotesk-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {hasQuoter && (
      <link
        rel="preload"
        href="/fonts/spline-sans-mono-latin.woff2"
        as="font"
        type="font/woff2"
        crossorigin
      />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="DLPay. Cambia pesos por dólares y muévelos donde necesites." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organization).replace(/</g, '\\u003c')}
    />

    {/*
      Lo que una página necesite en la cabecera y no sea de todas. Hoy lo usa
      una sola: la Home, para montar la intro de marca (ADR-0010), que tiene que
      correr síncrona y antes de `<body>`.

      Va al final del `<head>` a propósito, para que el marcador de arriba
      siempre corra primero.
    */}
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
