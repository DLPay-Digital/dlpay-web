---
/**
 * Layout de las páginas legales. Comparten estructura para que se lean como un
 * mismo cuerpo de documentos y no como cuatro páginas sueltas.
 *
 * ── Medida de lectura: la del blog, no la del resto del sitio ──────────────
 *
 * Decisión de Sebastián del 2026-09-23. **Un documento y un artículo no son una
 * página de marketing**, y la medida de lectura es lo que lo dice sin decirlo:
 * una columna ancha se lee como un texto para leer entero, no como una sección
 * que se barre. Es el tono que un contrato necesita.
 *
 * Por eso esta columna es **la misma que la del artículo del blog** —760px de
 * texto, con el mismo relleno en móvil y sin relleno desde 900— y no una
 * parecida: son las dos únicas familias de texto largo del sitio y tienen que
 * mirarse iguales.
 *
 * **Se aparta del tope de 65 caracteres del Design System §3 a propósito**, y
 * la excepción está escrita ahí con su medición. Medido sobre el build, en las
 * cuatro páginas: el carácter de esta prosa mide 6,37–6,53px, así que 760px dan
 * **116–119 caracteres por línea**, la misma familia de medida que los 112 del
 * blog. Ajustarla a 112 exactos habría exigido 715px y habría dejado las
 * legales MÁS ESTRECHAS que el artículo, que es justo lo contrario de tratarlas
 * igual: el número de caracteres depende del texto, el ancho de la columna no.
 *
 * Antes tenía `max-width: 47ch`, que daba 38 caracteres reales: una cinta de
 * 298px con casi 500px de blanco a cada lado.
 */
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../lib/config/site.ts';

interface Props {
  title: string;
  description: string;
  path: string;
  lead: string;
}
const { title, description, path, lead } = Astro.props;
---
<Base title={title} description={description} path={path}>
  <Header />
  <main id="main">
    {/*
      `sequence` (M6) desde el 2026-09-23: el encabezado entra palabra por
      palabra igual que en el resto del sitio. **No cuesta JavaScript** —M6 es
      una animación CSS de carga, no depende del observador— así que estas
      cuatro páginas siguen en cero bytes. El cuerpo del documento no se mueve:
      lo que entra es la portada de la página, no el texto legal.
    */}
    <PageHero title={title} lead={lead} sequence />
    <div class="doc">
      <article class="prose">
        <slot />
        <footer class="meta">
          <p>{site.legalName}, que opera bajo la marca {site.name}.</p>
        </footer>
      </article>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .doc { background: var(--papel); padding: var(--s-9) 0; }
  /* 760px, la columna del artículo del blog. Ver la nota de arriba. */
  .prose {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 var(--pad-section-m);
  }

  .prose :global(h2) {
    font-size: var(--t-h3-m);
    font-weight: 600;
    line-height: var(--lh-h3);
    margin: var(--s-7) 0 var(--s-3);
  }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(h3) {
    font-size: var(--t-body);
    font-weight: 600;
    margin: var(--s-5) 0 var(--s-2);
  }
  .prose :global(p) { color: var(--ink-mute); margin-bottom: var(--s-4); }
  .prose :global(strong) { color: var(--ink); font-weight: 600; }
  .prose :global(ul) {
    list-style: none;
    margin: 0 0 var(--s-4);
    padding: 0;
    display: grid;
    gap: var(--s-3);
  }
  .prose :global(li) {
    color: var(--ink-mute);
    padding-left: var(--s-4);
    border-left: 1px solid var(--line);
  }
  .prose :global(dl) { margin: 0 0 var(--s-4); }
  .prose :global(dt) {
    font-size: var(--t-body-sm);
    font-weight: 600;
    color: var(--ink-mute);
  }
  .prose :global(dd) {
    margin: 0 0 var(--s-3);
    color: var(--ink);
  }

  .meta {
    margin-top: var(--s-8);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
    font-size: var(--t-dato-sm);
    color: var(--ink-mute);
  }
  .meta p { margin: 0 0 var(--s-1); }

  @media (min-width: 900px) {
    /* Sin relleno lateral desde 900, igual que `.post` del artículo: así los
       760px son de texto y las dos familias coinciden de verdad. */
    .prose { padding-inline: 0; }
    .prose :global(h2) { font-size: var(--t-h3); }
  }
</style>
