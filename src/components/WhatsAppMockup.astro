---
/**
 * Un teléfono dibujado en CSS con una conversación dentro. Cero imágenes.
 *
 * No imita a WhatsApp: usa los verdes de DLPay, el isotipo de DLPay y nuestra
 * tipografía. Es una abstracción de un chat, no una réplica de una app ajena.
 *
 * ── Dos variantes, dos consumidores reales ──────────────────────────────────
 *
 * · `proof` (por omisión) — el bloque de la Home que acompaña al cotizador:
 *   teléfono + pie explicativo, y OCULTO bajo 900px, porque en móvil la persona
 *   ya está en el teléfono desde el que va a escribir y dibujarle un teléfono
 *   dentro del teléfono no le aporta nada.
 * · `bare` — sólo el dispositivo, visible en todos los anchos. Lo usa
 *   `Process.astro`, donde el teléfono ES el contenido de cada paso y ocultarlo
 *   en móvil dejaría la sección sin la mitad de su narrativa.
 *
 * ── REGLA DURA que sobrevive al refactor ────────────────────────────────────
 *
 * Sin la prop `thread`, el texto de la burbuja NO se escribe a mano: sale de
 * `whatsappMessage()`, la misma función que arma el enlace del botón, con la
 * misma cotización inicial que carga el cotizador. Así es imposible que el
 * mockup de la Home prometa un mensaje distinto del que se envía.
 *
 * Con `thread`, el hilo es NARRATIVO y lo escribe quien llama. Eso lo saca de
 * la garantía anterior a propósito: son ejemplos de una conversación, no el
 * mensaje que se va a enviar. Quien pase un hilo se hace responsable de que lo
 * que diga ahí sea aprobable — y si menciona cifras, de derivarlas de
 * `lib/pricing` en vez de teclearlas.
 *
 * El dispositivo va aria-hidden y el contexto lo dan las palabras de alrededor:
 * un lector de pantalla no necesita el cromo de un teléfono dibujado.
 */
import Logo from './Logo.astro';
import { ConfigPriceSource } from '../lib/pricing/config-price-source.ts';
import { buildQuote, whatsappMessage } from '../lib/pricing/quote.ts';

interface ChatMessage {
  /** `user` sale por la derecha; `dlpay` entra por la izquierda. */
  sender: 'user' | 'dlpay';
  text: string;
}

interface Props {
  /** Hilo narrativo. Sin él, se muestra el mensaje real del cotizador. */
  thread?: readonly ChatMessage[];
  variant?: 'proof' | 'bare';
}

const { thread, variant = 'proof' } = Astro.props;

/** El hilo por omisión se deriva; nunca se teclea. Ver la regla dura arriba. */
async function defaultThread(): Promise<readonly ChatMessage[]> {
  const price = await new ConfigPriceSource().getPrice();
  const minPay = Number(import.meta.env.PUBLIC_QUOTE_MIN_CLP ?? '50000') || 50000;
  const maxRaw = Number(import.meta.env.PUBLIC_QUOTE_MAX_CLP ?? '');
  const maxPay = Number.isFinite(maxRaw) && maxRaw > 0 ? maxRaw : undefined;

  /** Mismos valores que Quoter.astro: el mockup y el botón dicen lo mismo. */
  const samplePay = 2_000_000;
  const quote = buildQuote({
    intent: 'send_abroad',
    giveAmount: samplePay,
    price,
    minPay,
    ...(maxPay !== undefined ? { maxPay } : {}),
  });

  return [{ sender: 'user', text: whatsappMessage(quote, samplePay) }];
}

const messages = thread ?? (await defaultThread());
---
{/*
  El `data-enter` sólo lo lleva la variante `proof`, que es un bloque autónomo.
  En `bare` el movimiento lo decide quien coloca el teléfono: anidar dos
  `[data-enter]` haría que el contenedor se revele y, dentro, el teléfono se
  revele otra vez — dos fundidos para una sola cosa.
*/}
<figure class:list={['mockup', variant]} data-enter={variant === 'proof' ? '' : undefined}>
  <div class="device" aria-hidden="true">
    <div class="screen">
      <span class="island"></span>
      <div class="bar">
        <span class="avatar"><Logo class="avatar-mark" /></span>
        <span class="who">DLPay</span>
      </div>
      <div class="chat">
        {messages.map((m) => (
          <p class:list={['bubble', m.sender === 'user' ? 'out' : 'in']}>{m.text}</p>
        ))}
      </div>
    </div>
  </div>

  {variant === 'proof' && (
    <figcaption class="claim">
      <b>El chat se abre con tu operación ya escrita.</b>
      No empiezas de cero ni tienes que repetir el monto: llega tal cual lo dejaste
      en el cotizador, y un ejecutivo confirma el precio final.
    </figcaption>
  )}
</figure>

<style>
  /* Sólo desde 900px. En móvil la persona YA está en el teléfono desde el que
     va a escribir: dibujarle un teléfono dentro del teléfono no le aporta nada
     y le cuesta scroll. */
  .proof { display: none; }

  @media (min-width: 900px) {
    .proof {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: var(--s-8);
      max-width: var(--container);
      margin: 0 auto;
      padding: var(--s-8) var(--pad-section);
    }
  }

  /* La variante desnuda no trae layout propio: lo pone quien la coloca. */
  .bare { margin: 0; }

  /*
    Dos ajustes que sólo aplican a `bare`, donde hay CUATRO teléfonos seguidos.
    No se tocan en `proof`, que es un teléfono único y ya está aprobado así.

    1· El chat se apoya ABAJO. Es como se ve de verdad una conversación corta en
       cualquier app de mensajería: el historial crece hacia arriba y lo último
       queda al borde inferior. Anclado arriba, los ~350px de pantalla vacía por
       debajo se leen como un error de maquetación en vez de como aire.
    2· 196px en vez de 236px de ancho. Con la proporción 9/19.5 eso baja cada
       teléfono de 511px a 425px: 344px menos de scroll a lo largo de la
       sección, sin perder legibilidad de las burbujas.
  */
  .bare .chat { justify-content: flex-end; }
  .bare .device { width: 196px; }

  /* ── El dispositivo ──────────────────────────────────────────────────────
     Puro CSS. Bisel en tinta, sin marcas ni botones de ningún fabricante. */
  .device {
    width: 236px;
    /* 9/19.5 — la proporción de un teléfono actual. */
    aspect-ratio: 9 / 19.5;
    display: flex;
    /* Bisel fino y uniforme. La isla vive dentro de la pantalla, que es donde
       vive de verdad. */
    padding: 8px;
    background: var(--tinta);
    border-radius: 40px;
    position: relative;
    /* Cuatro capas. Las dos primeras son la elevación real —una sombra de
       contacto corta y otra ambiental larga—, que es lo que hace que un objeto
       parezca apoyado y no pegado. Las dos insets son el canto del bisel: una
       luz arriba, donde el cristal la coge, y un filo tenue alrededor. */
    box-shadow:
      0 2px 4px rgba(11, 19, 32, .16),
      0 20px 44px -18px rgba(11, 19, 32, .38),
      inset 0 1px 0 rgba(237, 242, 239, .18),
      inset 0 0 0 1px rgba(237, 242, 239, .06);
  }
  /* Botones físicos. Sobresalen 3px del marco y son del mismo tono, así que
     sólo se leen como silueta contra el papel.
     Izquierda: el par de volumen resuelto con UN pseudo-elemento — el
     box-shadow sin desenfoque dibuja la copia de abajo. Derecha: encendido. */
  .device::before,
  .device::after {
    content: '';
    position: absolute;
    width: 4px;
    background: var(--tinta);
  }
  .device::before {
    left: -3px;
    top: 116px;
    height: 32px;
    border-radius: 2px 0 0 2px;
    box-shadow: 0 44px 0 var(--tinta);
  }
  .device::after {
    right: -3px;
    top: 150px;
    height: 52px;
    border-radius: 0 2px 2px 0;
  }

  /* Isla dinámica: píldora en tinta sobre la cabecera, como una app real. */
  .island {
    position: absolute;
    top: 8px;
    left: 50%;
    transform: translateX(-50%);
    width: 30%;
    height: 22px;
    border-radius: 20px;
    background: var(--tinta);
    z-index: 1;
  }
  .screen {
    flex: 1;
    position: relative;
    border-radius: 32px;
    overflow: hidden;
    background: var(--papel-2);
    display: flex;
    flex-direction: column;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    /* 38px arriba: la isla ocupa hasta los 30px y el nombre no debe pisarla. */
    padding: 38px var(--s-4) var(--s-3);
    background: var(--verde-deep);
  }
  .avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--papel);
    color: var(--verde-deep);
    display: grid;
    place-items: center;
    flex: none;
  }
  .avatar-mark { width: 14px; height: auto; display: block; }
  /* --on-tinta sobre --verde-deep = 4.72:1 (AA para texto normal). */
  .who { color: var(--on-tinta); font-weight: 600; font-size: var(--t-body-sm); }

  /* Una conversación, no un mensaje: hueco entre burbujas y alineación por
     emisor. El hueco es de UI móvil, más apretado que el ritmo del sitio. */
  .chat {
    padding: var(--s-4);
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .bubble {
    position: relative;
    max-width: 92%;
    /* Ritmo de UI móvil, no de párrafo web. 14px queda fuera de la escala
       tipográfica a propósito — esto simula el cromo de otra aplicación, no es
       texto del sitio. */
    padding: var(--s-2) var(--s-3);
    font-size: 14px;
    line-height: 1.4;
    color: var(--ink);
    box-shadow: 0 1px 2px rgba(11, 19, 32, .10);
  }
  /* La colita, en la esquina superior del lado por el que sale el mensaje. */
  .bubble::after {
    content: '';
    position: absolute;
    top: 0;
    width: 7px;
    height: 11px;
    background: var(--burbuja);
  }

  /* Saliente: --verde diluido, nunca el verde de WhatsApp.
     --ink encima da 12.41:1 — AAA de sobra (pide 7:1). */
  .out {
    --burbuja: rgba(22, 199, 132, .22);
    margin: 0 0 0 auto;
    background: var(--burbuja);
    border-radius: var(--r-3) 0 var(--r-3) var(--r-3);
  }
  .out::after { right: -6px; clip-path: polygon(0 0, 100% 0, 0 100%); }

  /* Entrante: papel sobre la pantalla en papel-2. Los dos tonos claros sólo se
     separan 1.11:1, así que lo que define la burbuja es la sombra, igual que en
     una app real — no un borde, que ensuciaría el cromo. --ink sobre --papel da
     16.00:1. */
  .in {
    --burbuja: var(--papel);
    margin: 0 auto 0 0;
    background: var(--burbuja);
    border-radius: 0 var(--r-3) var(--r-3) var(--r-3);
  }
  .in::after { left: -6px; clip-path: polygon(100% 0, 0 0, 100% 100%); }

  .claim { color: var(--ink-mute); max-width: 46ch; font-size: var(--t-body); }
  .claim b { color: var(--ink); font-weight: 600; display: block; margin-bottom: var(--s-2); }
</style>
