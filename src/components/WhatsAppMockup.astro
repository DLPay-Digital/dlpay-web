---
/**
 * Cómo llega el mensaje al ejecutivo. Acompaña al cotizador: responde la duda
 * que aparece justo antes de pulsar el CTA — "¿me va a abrir un chat en blanco
 * y tengo que explicarlo todo yo?".
 *
 * REGLA DURA: el texto de la burbuja NO se escribe a mano. Sale de
 * `whatsappMessage()`, la misma función que arma el enlace del botón, con la
 * misma cotización inicial que carga el cotizador. Así es imposible que el
 * mockup prometa un mensaje distinto del que se envía, y si alguien edita la
 * plantilla, esto cambia con ella. Un texto de ejemplo escrito aparte habría
 * divergido en el primer cambio — ya nos pasó con la aritmética del cotizador.
 *
 * No imita a WhatsApp: usa los verdes de DLPay, el isotipo de DLPay y nuestra
 * tipografía. Es una abstracción de un chat, no una réplica de una app ajena.
 *
 * El dispositivo va aria-hidden y el pie lo explica con palabras: un lector de
 * pantalla no necesita el cromo de un teléfono dibujado.
 */
import Logo from './Logo.astro';
import { ConfigPriceSource } from '../lib/pricing/config-price-source.ts';
import { buildQuote, whatsappMessage } from '../lib/pricing/quote.ts';

const price = await new ConfigPriceSource().getPrice();
const minPay = Number(import.meta.env.PUBLIC_QUOTE_MIN_CLP ?? '50000') || 50000;
const maxRaw = Number(import.meta.env.PUBLIC_QUOTE_MAX_CLP ?? '');
const maxPay = Number.isFinite(maxRaw) && maxRaw > 0 ? maxRaw : undefined;

/** Mismos valores que Quoter.astro: el mockup y el botón dicen lo mismo al cargar. */
const samplePay = 2_000_000;
const sampleQuote = buildQuote({
  intent: 'send_abroad',
  giveAmount: samplePay,
  price,
  minPay,
  ...(maxPay !== undefined ? { maxPay } : {}),
});
const message = whatsappMessage(sampleQuote, samplePay);
---
<figure class="proof" data-enter>
  <div class="device" aria-hidden="true">
    <div class="screen">
      <span class="island"></span>
      <div class="bar">
        <span class="avatar"><Logo class="avatar-mark" /></span>
        <span class="who">DLPay</span>
      </div>
      <div class="chat">
        <p class="bubble">{message}</p>
      </div>
    </div>
  </div>

  <figcaption class="claim">
    <b>El chat se abre con tu operación ya escrita.</b>
    No empiezas de cero ni tienes que repetir el monto: llega tal cual lo dejaste
    en el cotizador, y un ejecutivo confirma el precio final.
  </figcaption>
</figure>

<style>
  /* Sólo desde 900px. En móvil la persona YA está en el teléfono desde el que
     va a escribir: dibujarle un teléfono dentro del teléfono no le aporta nada
     y le cuesta scroll. */
  .proof { display: none; }

  @media (min-width: 900px) {
    .proof {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: var(--s-8);
      max-width: var(--container);
      margin: 0 auto;
      padding: var(--s-8) var(--pad-section);
    }
  }

  /* ── El dispositivo ──────────────────────────────────────────────────────
     Puro CSS. Bisel en tinta, sin marcas ni botones de ningún fabricante. */
  .device {
    width: 236px;
    /* 9/19.5 — la proporción de un teléfono actual. A 236px de ancho da 511px
       de alto, así que la pantalla queda mucho más larga que el chat: ese aire
       de abajo es correcto, una conversación de un mensaje se ve así. */
    aspect-ratio: 9 / 19.5;
    display: flex;
    /* Bisel fino y uniforme. El de 24px arriba ya no hace falta: la isla vive
       dentro de la pantalla, que es donde vive de verdad. */
    padding: 8px;
    background: var(--tinta);
    border-radius: 40px;
    position: relative;
    /* Cuatro capas. Las dos primeras son la elevación real —una sombra de
       contacto corta y otra ambiental larga—, que es lo que hace que un objeto
       parezca apoyado y no pegado. Las dos insets son el canto del bisel: una
       luz arriba, donde el cristal la coge, y un filo tenue alrededor. */
    box-shadow:
      0 2px 4px rgba(11, 19, 32, .16),
      0 20px 44px -18px rgba(11, 19, 32, .38),
      inset 0 1px 0 rgba(237, 242, 239, .18),
      inset 0 0 0 1px rgba(237, 242, 239, .06);
  }
  /* Botones físicos. Sobresalen 3px del marco y son del mismo tono, así que
     sólo se leen como silueta contra el papel.
     Izquierda: el par de volumen resuelto con UN pseudo-elemento — el
     box-shadow sin desenfoque dibuja la copia de abajo. Derecha: encendido. */
  .device::before,
  .device::after {
    content: '';
    position: absolute;
    width: 4px;
    background: var(--tinta);
  }
  .device::before {
    left: -3px;
    top: 116px;
    height: 32px;
    border-radius: 2px 0 0 2px;
    box-shadow: 0 44px 0 var(--tinta);
  }
  .device::after {
    right: -3px;
    top: 150px;
    height: 52px;
    border-radius: 0 2px 2px 0;
  }

  /* Isla dinámica: píldora en tinta sobre la cabecera, como una app real. */
  .island {
    position: absolute;
    top: 8px;
    left: 50%;
    transform: translateX(-50%);
    width: 30%;
    height: 22px;
    border-radius: 20px;
    background: var(--tinta);
    z-index: 1;
  }
  .screen {
    flex: 1;
    position: relative;
    border-radius: 32px;
    overflow: hidden;
    background: var(--papel-2);
    display: flex;
    flex-direction: column;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    /* 38px arriba: la isla ocupa hasta los 30px y el nombre no debe pisarla. */
    padding: 38px var(--s-4) var(--s-3);
    background: var(--verde-deep);
  }
  .avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--papel);
    color: var(--verde-deep);
    display: grid;
    place-items: center;
    flex: none;
  }
  .avatar-mark { width: 14px; height: auto; display: block; }
  /* --on-tinta sobre --verde-deep = 4.72:1 (AA para texto normal). */
  .who { color: var(--on-tinta); font-weight: 600; font-size: var(--t-body-sm); }

  .chat { padding: var(--s-4); flex: 1; }

  /* Burbuja de salida. --verde diluido, nunca el verde de WhatsApp.
     --ink encima da 12.41:1 — AAA de sobra (pide 7:1).
     Se alinea a la derecha, como un mensaje enviado de verdad. */
  .bubble {
    --burbuja: rgba(22, 199, 132, .22);
    position: relative;
    max-width: 92%;
    margin: 0 0 0 auto;
    background: var(--burbuja);
    border-radius: var(--r-3) 0 var(--r-3) var(--r-3);
    /* Ritmo de UI móvil, no de párrafo web: más compacto y más apretado.
       14px queda fuera de la escala tipográfica a propósito — esto simula el
       cromo de otra aplicación, no es texto del sitio. */
    padding: var(--s-2) var(--s-3);
    font-size: 14px;
    line-height: 1.4;
    color: var(--ink);
    box-shadow: 0 1px 2px rgba(11, 19, 32, .10);
  }
  /* La colita del mensaje saliente. El radio superior derecho es 0 para que
     encaje al ras; el triángulo sale por fuera y cabe en el padding del chat. */
  .bubble::after {
    content: '';
    position: absolute;
    top: 0;
    right: -6px;
    width: 7px;
    height: 11px;
    background: var(--burbuja);
    clip-path: polygon(0 0, 100% 0, 0 100%);
  }

  .claim { color: var(--ink-mute); max-width: 46ch; font-size: var(--t-body); }
  .claim b { color: var(--ink); font-weight: 600; display: block; margin-bottom: var(--s-2); }
</style>
