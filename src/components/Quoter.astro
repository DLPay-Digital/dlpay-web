---
/**
 * COTIZADOR — el elemento central de la web.
 * Especificación: docs/design-system/cotizador-spec.md
 *
 * Flujo: qué quieres hacer -> cuánto -> cuánto recibes -> precio referencial ->
 * WhatsApp con todo prellenado -> un ejecutivo confirma el precio final.
 *
 * Lo que NO hace: ejecutar una operación, bloquear un precio, prometer un
 * precio final. El tipo `Quote` lo impide (`isReferential: true` es literal).
 *
 * Es la ÚNICA isla interactiva del sitio (ADR-0002 §2). El precio se resuelve
 * en build desde ConfigPriceSource y viaja al cliente en data-attributes.
 */
import { ConfigPriceSource } from '../lib/pricing/config-price-source.ts';
import { formatCLP, formatRate, formatUSD } from '../lib/pricing/format.ts';
import { buildQuote, whatsappUrl } from '../lib/pricing/quote.ts';
import { contact, platform, quoteLimits } from '../lib/config/site.ts';

interface Props {
  /** Sobre tinta flota con sombra; sobre papel va plano (spec §2). */
  variant?: 'floating' | 'flat';
}
const { variant = 'floating' } = Astro.props;

const price = await new ConfigPriceSource().getPrice();

/* Límites y monto inicial: UN solo origen para toda la web (D24). Los
   pendientes D6 y D21 están anotados donde vive el valor, en environment.ts. */
const { minPayClp: minPay, maxPayClp: maxPay, samplePayClp: initialPay } = quoteLimits;
const initialGet = initialPay / price.rate;

/**
 * El enlace se arma también en el servidor, con la MISMA función que usa el
 * cliente. Sin JavaScript el CTA sigue llevando a WhatsApp con el monto de
 * ejemplo escrito; con JavaScript se actualiza a medida que el usuario tipea.
 */
const initialQuote = buildQuote({
  intent: 'to_usd',
  giveAmount: initialPay,
  price,
  minPay,
  ...(maxPay !== undefined ? { maxPay } : {}),
});
const wa = whatsappUrl(contact.whatsappNumber, initialQuote, initialPay);

const intents = [
  { value: 'to_usd', label: 'Convertir a dólares' },
  { value: 'to_clp', label: 'Convertir a pesos' },
];
---

<section
  class:list={['quoter', variant]}
  id="cotizador"
  data-rate={price.rate}
  data-min={minPay}
  data-max={maxPay ?? ''}
  data-wa={contact.whatsappNumber}
  data-source={price.source}
  aria-labelledby="quoter-title"
>
  <h2 class="sr-only" id="quoter-title">Cotizador de dólar digital</h2>

  <fieldset class="intent">
    <legend class="intent-legend">¿Qué quieres hacer?</legend>
    <div class="intent-options">
      {intents.map((option, i) => (
        <label class="intent-option">
          <input type="radio" name="intent" value={option.value} checked={i === 0} />
          <span>{option.label}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <div class="field">
    <label class="label" for="give-input">Conviertes</label>
    <div class="input-box">
      <input
        id="give-input"
        class="amount num"
        type="text"
        inputmode="numeric"
        autocomplete="off"
        value={formatCLP(initialPay)}
        aria-describedby="quoter-note"
      />
      <span class="currency" data-cur-give>CLP</span>
    </div>
  </div>

  <div class="field">
    <label class="label" for="get-input" data-label-get>Recibo aprox.</label>
    <div class="input-box">
      <input
        id="get-input"
        class="amount num"
        type="text"
        inputmode="decimal"
        autocomplete="off"
        value={formatUSD(initialGet)}
      />
      <span class="currency" data-cur-get>USD</span>
    </div>
  </div>

  <p class="alert" data-alert hidden aria-live="polite"></p>

  <div class="price-row">
    <span class="price-label">
      Precio referencial
      <em>hace un momento</em>
    </span>
    <span class="price-value num" data-rate-display>
      {formatRate(price.rate)}<small>CLP por dólar</small>
    </span>
  </div>

  <p class="note" id="quoter-note">
    <strong>Sin comisiones ocultas:</strong> el precio ya incluye el spread.
    <span class="source">
      El precio del dólar que ves es un valor referencial de mercado, no un precio cerrado:
      lo confirma tu ejecutivo antes de operar.
    </span>
  </p>
  <p class="rail">
    Recibes <strong>dólar digital</strong> en tu billetera, equivalente 1:1 al dólar. Es lo
    que permite moverlo en minutos y a cualquier hora. No depositamos en cuentas bancarias
    en el extranjero.
  </p>

  <a class="cta" href={wa} target="_blank" rel="noopener" data-cta>
    Cotizar este monto por WhatsApp
  </a>
  <a class="secondary" href={platform.registerUrl}>
    o crea tu cuenta para operar en línea
  </a>
</section>

<!--
  Barra fija móvil (Fase 1, patrón 13 · cotizador-spec §7). Estaba especificada
  y no se había construido: en móvil, al bajar a leer, el CTA desaparecía.

  Lleva la cifra viva porque así el movimiento es información: el número te
  acompaña. Arranca `hidden`, así que no existe para un lector de pantalla
  mientras la tarjeta está a la vista y no duplica el CTA.
-->
<div class="dock" data-dock hidden>
  <div class="dock-in">
    <span class="dock-fig">
      <span class="dock-label" data-dock-label>Recibes</span>
      <span class="dock-amount num" data-dock-amount>{formatUSD(initialGet)}</span>
    </span>
    <a class="dock-cta" href={wa} target="_blank" rel="noopener" data-dock-cta>
      Continuar
    </a>
  </div>
</div>

<style>

  .quoter {
    background: var(--papel);
    color: var(--ink);
    padding: var(--s-5);
    border-radius: var(--r-card);
  }
  .quoter.floating { box-shadow: var(--elev-card); }
  .quoter.flat {
    border-radius: var(--r-3);
    border: 1px solid var(--line);
  }

  /* El primer paso de la conversación: qué quieres hacer. Dos opciones desde el
     2026-09-14, cuando se retiró «Enviar al extranjero» por hacer la misma
     aritmética que «Convertir a dólares». Ver cotizador-spec.md. */
  .intent { border: 0; padding: 0; margin: 0 0 var(--s-5); }
  .intent-legend {
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    color: var(--ink-mute);
    padding: 0;
    margin-bottom: var(--s-2);
  }
  .intent-options {
    display: grid;
    gap: var(--s-1);
  }
  /* La etiqueta es el elemento de la rejilla y se estira sola; el recuadro
     visible va dentro, así que hay que decirle que llene su celda. Sin esto,
     una opción que envuelve a dos líneas queda más alta que las demás. */
  .intent-option { display: flex; position: relative; }
  .intent-option input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    min-height: 0;
  }
  .intent-option span {
    transition: background-color var(--m-fast) var(--m-ease),
                border-color var(--m-fast) var(--m-ease),
                color var(--m-fast) var(--m-ease);
    flex: 1;
    display: flex;
    align-items: center;
    padding: var(--s-3);
    border: 1px solid var(--line);
    border-radius: var(--r-2);
    font-size: var(--t-body-sm);
    font-weight: 600;
    color: var(--ink-mute);
    cursor: pointer;
    min-height: 44px;
    line-height: 1.4;
  }
  .intent-option input:checked + span {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--papel);
  }
  .intent-option input:focus-visible + span {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .field { margin-bottom: var(--s-3); }
  .label {
    display: block;
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    color: var(--ink-mute);
    margin-bottom: var(--s-2);
  }
  .input-box {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    border: 1px solid var(--line);
    border-radius: var(--r-2);
    padding: 0 var(--s-3);
    background: #fff;
  }
  /* El borde de foco es un indicador de interfaz: necesita 3:1 contra el blanco
     del campo. verde-deep da 4.9:1; el verde de marca sólo 1.9:1. */
  .input-box {
    transition: border-color var(--m-fast) var(--m-ease),
                box-shadow var(--m-fast) var(--m-ease);
  }
  .input-box:focus-within {
    border-color: var(--verde-deep);
    /* `--verde-deep` al 18%, a mano por la misma razón que en `IconBadge`:
       `color-mix()` está por debajo del `cssTarget` del proyecto. */
    box-shadow: 0 0 0 3px rgba(10, 114, 80, 0.18);
  }
  .input-box.invalid { border-color: var(--baja); }

  .amount {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    padding: var(--s-3) 0;
    font-size: var(--t-dato-m);
    font-weight: 500;
    line-height: 1.1;
    color: var(--ink);
    width: 100%;
  }
  .amount:focus { outline: none; }
  .currency {
    flex: none;
    font-size: var(--t-body-sm);
    font-weight: 600;
    color: var(--ink-mute);
  }

  .alert {
    font-size: var(--t-body-sm);
    line-height: 1.45;
    color: var(--ink);
    background: var(--error-bg);
    border: 1px solid var(--error-line);
    border-radius: var(--r-2);
    padding: var(--s-3);
    margin: var(--s-3) 0 0;
  }

  .price-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-4);
    border-top: 1px solid var(--line);
    margin-top: var(--s-5);
    padding-top: var(--s-4);
  }
  /* Bajo ~430px la etiqueta y la cifra no caben en una fila: la etiqueta se
     partía en cuatro líneas y "919,70 CLP por dólar" (nowrap) llegaba pegada
     al borde de la tarjeta. Apiladas, cada una tiene el ancho completo. */
  @media (max-width: 430px) {
    .price-row {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s-2);
    }
  }
  .price-label {
    font-size: var(--t-label);
    font-weight: 600;
    color: var(--ink-mute);
    line-height: 1.35;
  }
  .price-label em {
    display: block;
    font-style: normal;
    font-weight: 400;
    opacity: 0.8;
  }
  .price-value {
    font-size: var(--t-dato-m);
    font-weight: 500;
    line-height: var(--lh-dato);
    white-space: nowrap;
  }
  /* M2 · el precio acusa que cambió. 160ms, sólo sobre el valor nuevo.
     No es un conteo desde cero: eso mostraría precios falsos. */
  .price-value.is-set { animation: settle 160ms var(--m-ease) both; }
  @keyframes settle {
    from { opacity: 0; transform: translateY(2px); }
    to   { opacity: 1; transform: none; }
  }
  /* M2 también en los campos. NO al teclear: mientras escribes, la cifra tiene
     que seguirte sin latencia — animar cada pulsación añadiría el retardo
     percibido que este cotizador existe para no tener. Se aplica al cambiar de
     intención, donde las dos cifras saltan sin que hayas tecleado nada. */
  .amount.is-set { animation: settle 160ms var(--m-ease) both; }

  @media (prefers-reduced-motion: reduce) {
    .price-value.is-set,
    .amount.is-set { animation: none; }
  }

  .price-value small {
    font-family: var(--f-text);
    font-size: var(--t-dato-sm);
    font-weight: 600;
    color: var(--ink-mute);
    margin-left: var(--s-1);
    letter-spacing: 0;
  }

  .note {
    font-size: var(--t-body-sm);
    line-height: 1.45;
    color: var(--ink-mute);
    margin: var(--s-4) 0 var(--s-5);
  }
  .note strong { color: var(--ink); font-weight: 600; }
  /* Antes mostraba una etiqueta de dato y por eso iba en la tipografía de
     cifras. Ahora es una frase: va en la tipografía de texto. */
  .source { display: block; margin-top: var(--s-2); font-size: var(--t-dato-sm); }

  /* El riel se explica, pero en el peso que le corresponde: no es el titular */
  .rail strong { color: var(--ink); font-weight: 600; }
  .rail {
    font-size: var(--t-dato-sm);
    line-height: 1.45;
    color: var(--ink-mute);
    padding-top: var(--s-3);
    border-top: 1px solid var(--line);
    margin: 0 0 var(--s-5);
  }

  .cta {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: var(--verde);
    color: var(--on-verde);
    font-size: var(--t-body);
    font-weight: 700;
    padding: var(--s-4);
    border-radius: var(--r-2);
    text-decoration: none;
  }
  .cta { transition: background-color var(--m-fast) var(--m-ease); }
  .cta:hover { background: var(--verde-hi); }

  .secondary {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: var(--s-2);
    min-height: 44px;
    font-size: var(--t-body-sm);
    font-weight: 500;
    color: var(--verde-deep);
    text-decoration: none;
  }
  .secondary:hover { text-decoration: underline; }

  /* La barra se ancla al borde inferior. Su eje de entrada es ese borde, no la
     diagonal de la marca: no es contenido que entra en la página, es un
     elemento acoplado que asoma desde donde vive. Misma duración y curva. */
  .dock {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 30;
    background: var(--tinta);
    border-top: 1px solid rgba(237, 242, 239, 0.14);
    padding: var(--s-3) var(--pad-section-m);
    padding-bottom: max(var(--s-3), env(safe-area-inset-bottom));
    transform: translateY(100%);
    transition: transform var(--m-base) var(--m-ease);
  }
  .dock.is-up { transform: none; }

  .dock-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    max-width: var(--container);
    margin: 0 auto;
  }
  .dock-fig { display: flex; flex-direction: column; min-width: 0; }
  .dock-label {
    font-size: var(--t-dato-sm);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    color: var(--on-tinta-mute);
  }
  .dock-amount {
    font-size: var(--t-h3-m);
    font-weight: 500;
    color: var(--on-tinta);
    line-height: 1.2;
    white-space: nowrap;
  }
  /* M2 también acá: la cifra acusa que cambió mientras te acompaña. */
  .dock-amount.is-set { animation: settle 160ms var(--m-ease) both; }

  .dock-cta {
    flex: none;
    display: flex;
    align-items: center;
    background: var(--verde);
    color: var(--on-verde);
    font-size: var(--t-body-sm);
    font-weight: 700;
    padding: 0 var(--s-5);
    min-height: 44px;
    border-radius: var(--r-2);
    text-decoration: none;
    transition: background-color var(--m-fast) var(--m-ease);
  }
  .dock-cta:hover { background: var(--verde-hi); }

  @media (prefers-reduced-motion: reduce) {
    .dock { transition: none; }
    .dock-amount.is-set { animation: none; }
  }

  @media (min-width: 900px) {
    /* En escritorio el cotizador nunca se pierde de vista: la barra no aplica. */
    .dock { display: none; }
    .price-value { font-size: var(--t-dato); }
    /* DOS columnas, no tres: al retirar «Enviar al extranjero» esta regla se
       quedó en 3 y la tercera columna vacía empujaba las dos opciones contra el
       borde izquierdo. Con `1fr 1fr` reparten el ancho de la tarjeta y quedan
       centradas respecto de ella. */
    .intent-options { grid-template-columns: repeat(2, 1fr); }
    .intent-option span {
      justify-content: center;
      text-align: center;
      padding: var(--s-3) var(--s-2);
    }
  }
</style>

<script>
  import { formatCLP, formatUSD, parseAmount } from '../lib/pricing/format.ts';
  import {
    buildQuote,
    clpAmount,
    convert,
    currenciesFor,
    formatAmount,
    whatsappUrl,
  } from '../lib/pricing/quote.ts';
  import type { Currency, Intent } from '../lib/pricing/types.ts';

  const root = document.querySelector<HTMLElement>('#cotizador');
  if (root) {
    const rate = Number(root.dataset.rate);
    const minPay = Number(root.dataset.min);
    const maxRaw = Number(root.dataset.max);
    const maxPay = Number.isFinite(maxRaw) && maxRaw > 0 ? maxRaw : undefined;
    const source = root.dataset.source ?? '';
    const waNumber = root.dataset.wa!;

    const giveInput = root.querySelector<HTMLInputElement>('#give-input')!;
    const getInput = root.querySelector<HTMLInputElement>('#get-input')!;
    const giveCur = root.querySelector<HTMLElement>('[data-cur-give]')!;
    const getCur = root.querySelector<HTMLElement>('[data-cur-get]')!;
    const alertEl = root.querySelector<HTMLElement>('[data-alert]')!;
    const cta = root.querySelector<HTMLAnchorElement>('[data-cta]')!;
    const boxes = root.querySelectorAll<HTMLElement>('.input-box');
    const priceEl = root.querySelector<HTMLElement>('.price-value');
    const dock = document.querySelector<HTMLElement>('[data-dock]');
    const dockLabel = dock?.querySelector<HTMLElement>('[data-dock-label]');
    const dockAmount = dock?.querySelector<HTMLElement>('[data-dock-amount]');
    const dockCta = dock?.querySelector<HTMLAnchorElement>('[data-dock-cta]');
    const intentInputs = root.querySelectorAll<HTMLInputElement>('input[name="intent"]');

    const fmt = (value: number, currency: Currency): string =>
      currency === 'CLP' ? formatCLP(value) : formatUSD(value);

    const price = { rate, pair: 'USD/CLP' as const, source, asOf: new Date() };

    let intent: Intent = 'to_usd';
    let giveAmount = parseAmount(giveInput.value);
    let lastShown = '';

    // La pantalla y el mensaje calculan con la MISMA función. Antes el
    // componente tenía su propia aritmética, sin la guarda de tasa del módulo:
    // con una tasa corrupta la pantalla habría mostrado Infinity y el mensaje 0.
    const received = (): number => convert(intent, giveAmount, rate);

    const render = (): void => {
      const { give, get } = currenciesFor(intent);
      const quote = buildQuote({
        intent,
        giveAmount,
        price,
        minPay,
        ...(maxPay !== undefined ? { maxPay } : {}),
      });

      giveCur.textContent = give;
      getCur.textContent = get;
      giveInput.inputMode = give === 'CLP' ? 'numeric' : 'decimal';
      getInput.inputMode = get === 'CLP' ? 'numeric' : 'decimal';

      const fuera = quote.state === 'below_min' || quote.state === 'above_max';
      boxes.forEach((b) => b.classList.toggle('invalid', fuera));
      // Se muestra la región ANTES de escribirle. Un lector de pantalla no
      // vigila regiones ocultas: escribiendo primero, el aviso no se anunciaba.
      const aviso =
        quote.state === 'below_min'
          ? `Monto mínimo: ${formatCLP(minPay)} CLP. Puedes escribirnos igual y te orientamos.`
          : quote.state === 'above_max' && maxPay !== undefined
            ? `Para montos sobre CLP ${formatCLP(maxPay)} te atiende un ejecutivo. Escríbenos.`
            : '';

      if (aviso) {
        alertEl.hidden = false;
        alertEl.textContent = aviso;
      } else {
        alertEl.textContent = '';
        alertEl.hidden = true;
      }

      // M2 · el dato acusa el cambio. Sólo cuando el valor recibido cambia de
      // verdad: si se reanimara en cada tecleo sería ruido, no información.
      const shown = formatAmount(received(), get);
      if (priceEl && shown !== lastShown) {
        lastShown = shown;
        priceEl.classList.remove('is-set');
        void priceEl.offsetWidth;
        priceEl.classList.add('is-set');
      }

      // El fallback de cualquier problema es WhatsApp, nunca un error seco
      const href = whatsappUrl(waNumber, quote, giveAmount);
      cta.href = href;
      cta.textContent = fuera ? 'Escríbenos por WhatsApp' : 'Continuar por WhatsApp';

      // La barra refleja exactamente la tarjeta: mismo enlace, misma cifra,
      // mismo estado. Una sola verdad, dos lugares donde se ve.
      if (dock && dockLabel && dockAmount && dockCta) {
        dockCta.href = href;
        dockCta.textContent = fuera ? 'Escríbenos' : 'Continuar';
        dockLabel.textContent = fuera ? 'Fuera de rango' : 'Recibes';
        const dockShown = fuera ? '—' : shown;
        if (dockAmount.textContent !== dockShown) {
          dockAmount.textContent = dockShown;
          dockAmount.classList.remove('is-set');
          void dockAmount.offsetWidth;
          dockAmount.classList.add('is-set');
        }
      }
    };

    // El campo que se edita NO se reformatea bajo el cursor (spec §3): se
    // actualiza el otro, y el propio se formatea recién al salir.
    /**
     * M2 sobre un campo: reinicia la animación leyendo offsetWidth.
     *
     * Nunca la aplica al campo enfocado. Animar lo que alguien está escribiendo
     * es pelear con su cursor, y además el navegador ya reposiciona el caret.
     */
    const settle = (el: HTMLElement): void => {
      if (document.activeElement === el) return;
      el.classList.remove('is-set');
      void el.offsetWidth;
      el.classList.add('is-set');
    };

    giveInput.addEventListener('input', () => {
      giveAmount = parseAmount(giveInput.value);
      getInput.value = fmt(received(), currenciesFor(intent).get);
      render();
    });
    giveInput.addEventListener('blur', () => {
      giveInput.value = fmt(giveAmount, currenciesFor(intent).give);
    });

    getInput.addEventListener('input', () => {
      const { give } = currenciesFor(intent);
      const target = parseAmount(getInput.value);
      // La inversa de `convert`, con la misma guarda de tasa.
      giveAmount = rate > 0 ? (give === 'CLP' ? target * rate : target / rate) : 0;
      giveInput.value = fmt(giveAmount, give);
      render();
    });
    getInput.addEventListener('blur', () => {
      getInput.value = fmt(received(), currenciesFor(intent).get);
    });

    // Al cambiar de intención se conserva el monto en PESOS, que es como el
    // cliente piensa la operación.
    intentInputs.forEach((input) =>
      input.addEventListener('change', () => {
        const clpBefore = clpAmount(intent, giveAmount, rate);
        intent = input.value as Intent;
        const { give, get } = currenciesFor(intent);
        giveAmount = give === 'CLP' ? clpBefore : rate > 0 ? clpBefore / rate : 0;
        giveInput.value = fmt(giveAmount, give);
        getInput.value = fmt(received(), get);
        settle(giveInput);
        settle(getInput);
        render();
      })
    );

    render();

    /**
     * La barra asoma sólo cuando la tarjeta quedó ARRIBA del viewport. Si la
     * tarjeta está más abajo —porque el usuario subió— no aparece: el
     * instrumento viene en camino y duplicarlo sería ruido.
     */
    if (dock && 'IntersectionObserver' in window) {
      const dockObserver = new IntersectionObserver(
        ([entry]) => {
          if (!entry) return;
          const passed = !entry.isIntersecting && entry.boundingClientRect.bottom < 0;
          dock.hidden = !passed;
          // Se separa de `hidden` para que la transición tenga un fotograma.
          requestAnimationFrame(() => dock.classList.toggle('is-up', passed));
          // Evita que la barra tape la última línea de la página.
          document.documentElement.classList.toggle('has-dock', passed);
        },
        { threshold: 0 }
      );
      dockObserver.observe(root);
    }
  }
</script>
