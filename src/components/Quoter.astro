---
/**
 * COTIZADOR — el elemento central de la web.
 * Especificación: docs/design-system/cotizador-spec.md
 *
 * Flujo: qué quieres hacer -> a dónde -> cuánto -> cuánto llega -> precio
 * referencial -> WhatsApp con todo prellenado -> un ejecutivo confirma el
 * precio final y coordina el destino.
 *
 * Lo que NO hace: ejecutar una operación, bloquear un precio, prometer un
 * precio final. El tipo `Quote` lo impide (`isReferential: true` es literal).
 *
 * Es la ÚNICA isla interactiva del producto (ADR-0002 §2). El precio se
 * resuelve en build desde ConfigPriceSource y viaja al cliente en
 * data-attributes.
 *
 * ── Rediseñado el 2026-10-22 (Cowork, entrega `cotizador-`) ────────────────
 *
 * Desde ADR-0014 el servicio no termina en una divisa: **el dinero llega a
 * destino en la moneda de ese destino.** La tarjeta seguía preguntando como una
 * casa de cambio —dos botones negros de «convertir», un desplegable de monedas
 * y el precio aparte, al pie— y ahora pregunta como un envío. Decisiones de
 * Sebastián del 2026-10-22, una por una:
 *
 * 1. **El destino se elige por país**, «¿A dónde envías?», y la moneda sale
 *    sola. Trece destinos para doce divisas: el dólar sirve a dos.
 * 2. **La vuelta a pesos se queda, más discreta**: un interruptor chico arriba,
 *    no dos botones del mismo peso que el resto de la tarjeta.
 * 3. **El precio se escribe para que se lea**: 1 USD = 919,70 CLP en las
 *    fuertes y 1 CLP = 4,35 COP en las débiles (`precioLegible`).
 *
 * Y una de forma, que no es una decisión sino la gramática del sitio: **entre
 * lo que envías y lo que llega va el recorrido**, el tramo verde que en todas
 * las figuras significa «lo nuestro» (DS §6.2). Desde ADR-0014 es de punta a
 * punta, así que acá también. El precio y la nota del spread viven en ese
 * tramo, que es donde ocurren: entre un monto y el otro.
 */
import { ConfigPriceSource } from '../lib/pricing/config-price-source.ts';
import {
  DEFAULT_CURRENCY,
  DEFAULT_DESTINO,
  availableCurrencies,
  currencyInfo,
  destinos,
} from '../lib/pricing/currencies.ts';
import { formatCLP, formatForeign } from '../lib/pricing/format.ts';
import { buildQuote, precioLegible, whatsappUrl } from '../lib/pricing/quote.ts';
import { contact, platform, quoteLimits } from '../lib/config/site.ts';
import Icon from './Icon.astro';
import Bandera from './Bandera.astro';
import { CODIGOS_BANDERA, banderaDeDestino, banderaDeDivisa } from '../lib/banderas.ts';

interface Props {
  /** Sobre tinta flota con sombra; sobre papel va plano (spec §2). */
  variant?: 'floating' | 'flat';
}
const { variant = 'floating' } = Astro.props;

/**
 * Las doce divisas del catálogo (ADR-0013, ampliado el 2026-10-22).
 *
 * Todas tienen tasa: la que Sebastián confirme en el entorno, o la de muestra
 * mientras no la haya. Lo que impide que una muestra llegue al sitio público no
 * es este archivo sino el build, que se detiene con la indexación abierta
 * mientras quede alguna sin confirmar (`assertRatesConfirmed`).
 */
const divisas = availableCurrencies();
const lugares = destinos();

const price = await new ConfigPriceSource(DEFAULT_CURRENCY).getPrice();

/** Lo único que el catálogo no sabe y el build sí: la tasa de cada divisa. */
const tasas = await Promise.all(
  divisas.map(async (d) => {
    const p = await new ConfigPriceSource(d.code).getPrice();
    return { c: d.code, r: p.rate, n: d.name };
  })
);

/* Límites y monto inicial: UN solo origen para toda la web (D24). Los
   pendientes D6 y D21 están anotados donde vive el valor, en environment.ts. */
const { minPayClp: minPay, maxPayClp: maxPay, samplePayClp: initialPay } = quoteLimits;
const initialGet = initialPay / price.rate;

/**
 * El enlace se arma también en el servidor, con la MISMA función que usa el
 * cliente. Sin JavaScript el CTA sigue llevando a WhatsApp con el monto de
 * ejemplo y el destino escritos; con JavaScript se actualiza a medida que el
 * usuario tipea.
 */
const initialQuote = buildQuote({
  intent: 'to_foreign',
  giveAmount: initialPay,
  price,
  minPay,
  ...(maxPay !== undefined ? { maxPay } : {}),
});
const wa = whatsappUrl(contact.whatsappNumber, initialQuote, initialPay, DEFAULT_DESTINO);

const mayuscula = (s: string): string => s.charAt(0).toUpperCase() + s.slice(1);
---

<section
  class:list={['quoter', variant]}
  id="cotizador"
  data-rate={price.rate}
  data-min={minPay}
  data-max={maxPay ?? ''}
  data-wa={contact.whatsappNumber}
  data-source={price.source}
  data-divisas={JSON.stringify(tasas)}
  aria-labelledby="quoter-title"
>
  <h2 class="sr-only" id="quoter-title">Cotizador de envíos y divisas</h2>

  {/*
    ── El interruptor: el envío manda, la vuelta a pesos se queda chica ──────

    Hasta el 2026-10-22 eran dos botones a lo ancho de la tarjeta, rellenos de
    tinta el elegido: lo primero que se veía era una elección entre dos cosas
    del mismo peso. Desde ADR-0014 no lo son —el envío es el servicio, la vuelta
    es la otra mitad de una casa de cambio— y Sebastián pidió que la vuelta
    siguiera pero más discreta.

    **Sigue siendo un grupo de dos radios**, que es lo que es: una elección
    entre dos, no pestañas que cambian de panel. El área que se pulsa es la
    `label` entera, de 44 px de alto (DS §10); lo que se ve más chico es la
    ficha de dentro.

    «Enviar» se lee completo como «Enviar al extranjero»: el resto va en
    `sr-only` porque a 320 px las dos opciones enteras no caben en una fila, y
    a la vista la pregunta de abajo, «¿A dónde envías?», ya lo completa.
  */}
  <fieldset class="modo">
    <legend class="sr-only">¿Qué quieres hacer?</legend>
    <label class="modo-op">
      <input type="radio" name="intent" value="to_foreign" checked />
      <span>Enviar<span class="sr-only"> al extranjero</span></span>
    </label>
    <label class="modo-op">
      <input type="radio" name="intent" value="to_clp" />
      <span>Pasar a pesos</span>
    </label>
  </fieldset>

  {/*
    ── A dónde: el país, con su bandera, y la moneda sale sola ──────────────

    Era «¿A qué moneda?» con doce opciones, y desde la entrega `cotizador-`
    fue «¿A dónde envías?» con un `<select>` nativo de trece países. **Desde la
    entrega `wise-` (2026-10-22) es un selector propio, con bandera y buscador**,
    como el de Wise: una lista del sistema no puede dibujar una bandera, y la
    bandera es lo que hace que el destino se encuentre de un vistazo.

    **Cómo se usa sin ratón**, y por eso es más largo que un `<select>`:
    - el botón dice lo elegido y abre el panel (`aria-haspopup="listbox"`);
    - en el panel el foco va al buscador, que es un `combobox` y gobierna la
      lista con `aria-activedescendant`: las flechas mueven, Intro elige,
      Escape cierra y devuelve el foco al botón;
    - escribir filtra por país, por código y por nombre de la moneda, con o
      sin tildes;
    - el foco que sale del selector lo cierra.

    En «Pasar a pesos» la pregunta es otra —qué divisa tienes, no a dónde va—,
    así que se cambia de selector y no de texto. Sin JavaScript se ve el
    primero, con Estados Unidos elegido, y el botón no abre nada: sin la isla
    tampoco hay cálculo, igual que antes con el nativo.
  */}
  <div class="field" data-campo-destino>
    <span class="label" id="destino-rot">¿A dónde envías?</span>
    <div class="selector" data-selector="destino">
      <button
        type="button"
        class="selector-boton"
        id="destino-boton"
        aria-haspopup="listbox"
        aria-expanded="false"
        aria-controls="destino-panel"
        aria-labelledby="destino-rot destino-boton"
        data-boton
      >
        <span class="selector-actual" data-actual>
          <Bandera code={banderaDeDestino(DEFAULT_DESTINO) ?? 'us'} size={24} />
          <span class="selector-nombre">{DEFAULT_DESTINO}</span>
          <span class="selector-codigo num">{DEFAULT_CURRENCY}</span>
        </span>
        <Icon name="chevron" size={20} class="selector-ico" />
      </button>
      <div class="selector-panel" id="destino-panel" data-panel hidden>
        <input
          class="selector-buscar"
          type="text"
          role="combobox"
          aria-label="Busca un país o una moneda"
          aria-autocomplete="list"
          aria-expanded="true"
          aria-controls="destino-lista"
          autocomplete="off"
          spellcheck="false"
          placeholder="Busca un país o una moneda"
          data-buscar
        />
        <ul class="selector-lista" role="listbox" id="destino-lista" aria-label="Destinos" data-lista>
          {lugares.map((l, i) => (
            <li
              role="option"
              id={`dst-${i}`}
              class="selector-op"
              aria-selected={l.destino === DEFAULT_DESTINO ? 'true' : 'false'}
              data-valor={l.destino}
              data-c={l.code}
              data-texto={`${l.destino} ${l.code} ${currencyInfo(l.code).name} ${currencyInfo(l.code).plural}`}
            >
              <Bandera code={banderaDeDestino(l.destino) ?? 'us'} size={24} />
              <span class="op-nombre">{l.destino}</span>
              <span class="op-codigo num">{l.code}</span>
            </li>
          ))}
        </ul>
        <p class="selector-vacio" data-vacio hidden>Ningún destino coincide.</p>
        <p class="sr-only" role="status" data-estado data-uno="destino" data-varios="destinos" data-ninguno="Ningún destino coincide."></p>
      </div>
    </div>
  </div>

  <div class="field" data-campo-divisa hidden>
    <span class="label" id="divisa-rot">¿Qué divisa tienes?</span>
    <div class="selector" data-selector="divisa">
      <button
        type="button"
        class="selector-boton"
        id="divisa-boton"
        aria-haspopup="listbox"
        aria-expanded="false"
        aria-controls="divisa-panel"
        aria-labelledby="divisa-rot divisa-boton"
        data-boton
      >
        <span class="selector-actual" data-actual>
          <Bandera code={banderaDeDivisa(DEFAULT_CURRENCY) ?? 'us'} size={24} />
          <span class="selector-nombre">{mayuscula(currencyInfo(DEFAULT_CURRENCY).name)}</span>
          <span class="selector-codigo num">{DEFAULT_CURRENCY}</span>
        </span>
        <Icon name="chevron" size={20} class="selector-ico" />
      </button>
      <div class="selector-panel" id="divisa-panel" data-panel hidden>
        <input
          class="selector-buscar"
          type="text"
          role="combobox"
          aria-label="Busca una moneda"
          aria-autocomplete="list"
          aria-expanded="true"
          aria-controls="divisa-lista"
          autocomplete="off"
          spellcheck="false"
          placeholder="Busca una moneda"
          data-buscar
        />
        <ul class="selector-lista" role="listbox" id="divisa-lista" aria-label="Divisas" data-lista>
          {divisas.map((d, i) => (
            <li
              role="option"
              id={`dvs-${i}`}
              class="selector-op"
              aria-selected={d.code === DEFAULT_CURRENCY ? 'true' : 'false'}
              data-valor={d.code}
              data-c={d.code}
              data-texto={`${d.name} ${d.plural} ${d.code} ${d.destinations.join(' ')}`}
            >
              <Bandera code={banderaDeDivisa(d.code) ?? 'us'} size={24} />
              <span class="op-nombre">{mayuscula(d.name)}</span>
              <span class="op-codigo num">{d.code}</span>
            </li>
          ))}
        </ul>
        <p class="selector-vacio" data-vacio hidden>Ninguna moneda coincide.</p>
        <p class="sr-only" role="status" data-estado data-uno="moneda" data-varios="monedas" data-ninguno="Ninguna moneda coincide."></p>
      </div>
    </div>
  </div>

  {/* Las banderas de las fichas de moneda, para que la isla las copie: el
      dibujo se escribe una vez, en el servidor, y no viaja en el JavaScript. */}
  <template id="cot-banderas">
    {CODIGOS_BANDERA.map((c) => <Bandera code={c} size={16} />)}
  </template>

  {/*
    ── Los dos montos y, entre ellos, el recorrido ───────────────────────────

    Cada monto es una caja con su etiqueta y su moneda arriba, en una fila, y la
    cifra debajo a todo el ancho: así la cifra gana el espacio de la ficha, que
    a 320 px es lo que decide si «2.000.000» cabe. La moneda se lee también con
    lector de pantalla, porque el campo la tiene en `aria-describedby`; antes
    el campo decía «Conviertes, 2.000.000» y no en qué.

    Entre las dos corre el tramo verde: lo nuestro, de punta a punta desde
    ADR-0014 (DS §6.2). Sobre él, el punto —la unidad de valor, la misma que el
    precio cotiza: «1 USD»— marca dónde está el precio, y el precio y la nota
    del spread van al lado, que es donde pasan: entre lo que pones y lo que
    llega. **No estrena ninguna marca**: son las dos del §6.2 con el
    significado que ya tienen.

    **Lo que esto cambia del spec §2:** el precio referencial deja de ser la
    segunda cifra grande de la tarjeta, al pie, con su propia fila. La cifra que
    responde la pregunta es la que llega; el precio es la explicación de esa
    cifra y se lee junto a ella. Sigue diciendo «Precio referencial» con esas
    dos palabras (spec §48).

    REQUIERE VALIDACIÓN DE COMPLIANCE — «Envías» y «Llega aprox.» afirman lo
    mismo que la nota del riel, más abajo: que el dinero llega a destino. No
    afirman plazo ni canal (ADR-0014 §3).
  */}
  <div class="montos">
    <div class="monto">
      <div class="monto-cabeza">
        <label class="monto-label" for="give-input" data-label-give>Envías</label>
        <span class="moneda num" id="cur-give"><Bandera code="cl" size={16} /><span data-cur-give>CLP</span></span>
      </div>
      <input
        id="give-input"
        class="amount num"
        type="text"
        inputmode="numeric"
        autocomplete="off"
        value={formatCLP(initialPay)}
        aria-describedby="cur-give quoter-note"
      />
    </div>

    <div class="tramo">
      <p class="tramo-precio">
        <span class="tramo-rot">Precio referencial</span>
        {/*
          **La forma del precio cambió el 2026-10-22.** Era «919,70 CLP por
          dólar», con la unidad escrita a mano y luego derivada del catálogo; en
          las monedas débiles daba «0,23 CLP por peso colombiano». Ahora sale de
          `precioLegible`, la misma función que escribe el mensaje de WhatsApp.
        */}
        <span class="tramo-valor num" data-rate-display>{precioLegible(price.rate, DEFAULT_CURRENCY)}</span>
      </p>
      <p class="tramo-nota" id="quoter-note">
        <strong>Sin comisiones ocultas:</strong> el precio ya incluye el spread.
      </p>
    </div>

    <div class="monto monto-llega">
      <div class="monto-cabeza">
        <label class="monto-label" for="get-input" data-label-get>Llega aprox.</label>
        <span class="moneda num" id="cur-get"><Bandera code={banderaDeDestino(DEFAULT_DESTINO) ?? 'us'} size={16} /><span data-cur-get>USD</span></span>
      </div>
      <input
        id="get-input"
        class="amount num"
        type="text"
        inputmode="decimal"
        autocomplete="off"
        value={formatForeign(initialGet, currencyInfo(DEFAULT_CURRENCY).decimals)}
        aria-describedby="cur-get"
      />
    </div>
  </div>

  <p class="alert" data-alert hidden aria-live="polite"></p>

  {/*
    La nota del riel, **sin cambios** desde ADR-0014: el spec §42 pide una nota
    permanente dentro del cotizador, y lo que mitiga hoy es el plazo. El largo
    historial de esta nota —de «Recibes dólar digital en tu billetera…» a esta
    línea— está en `cotizador-spec.md`, en la enmienda del 2026-09-28.

    REQUIERE VALIDACIÓN DE COMPLIANCE — que el dinero llega a destino en la
    moneda de ese destino.
  */}
  <p class="rail">
    Llega <strong>en la moneda del destino</strong>. El plazo te lo confirma tu ejecutivo.
  </p>

  <a class="cta" href={wa} target="_blank" rel="noopener" data-cta>
    Cotizar este monto por WhatsApp
  </a>
  <a class="secondary" href={platform.registerUrl}>
    o crea tu cuenta para operar en línea
  </a>
</section>

<!--
  Barra fija móvil (Fase 1, patrón 13 · cotizador-spec §7). Lleva la cifra viva
  porque así el movimiento es información: el número te acompaña. Desde el
  2026-10-22 dice también a dónde llega: «Llega a Colombia». Arranca `hidden`,
  así que no existe para un lector de pantalla mientras la tarjeta está a la
  vista y no duplica el CTA.
-->
<div class="dock" data-dock hidden>
  <div class="dock-in">
    <span class="dock-fig">
      <span class="dock-label"><Bandera code={banderaDeDestino(DEFAULT_DESTINO) ?? 'us'} size={16} /><span data-dock-label>Llega a {DEFAULT_DESTINO}</span></span>
      <span class="dock-amount num" data-dock-amount>{formatForeign(initialGet, currencyInfo(DEFAULT_CURRENCY).decimals)}</span>
    </span>
    <a class="dock-cta" href={wa} target="_blank" rel="noopener" data-dock-cta>
      Continuar
    </a>
  </div>
</div>

<style>
  .quoter {
    /* El foco de dentro de la tarjeta es el verde oscuro, no el de la tinta.
       La tarjeta es papel sobre la banda oscura del héroe, y `.on-tinta-surface`
       pone `--focus` en `--verde`: sobre papel da 2:1, bajo el 3:1 que pide un
       indicador. Pasaba en los dos botones de intención y en el de WhatsApp. */
    --focus: var(--verde-deep);
    background: var(--papel);
    color: var(--ink);
    padding: var(--s-5);
    border-radius: var(--r-card);
  }
  .quoter.floating { box-shadow: var(--elev-card); }
  .quoter.flat {
    border-radius: var(--r-3);
    border: 1px solid var(--line);
  }

  /* ── El interruptor ──────────────────────────────────────────────────── */
  .modo {
    display: inline-flex;
    border: 0;
    margin: 0 0 var(--s-4);
    padding: 0;
    background: var(--papel-2);
    border-radius: var(--r-2);
  }
  .modo-op { position: relative; display: flex; min-height: 44px; cursor: pointer; }
  .modo-op input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    min-height: 0;
  }
  /* La ficha visible va a 4 px del borde del área que se pulsa: se ve chica y
     el blanco de 44 px es la etiqueta entera. */
  .modo-op > span {
    display: flex;
    align-items: center;
    margin: 4px;
    padding: 0 var(--s-3);
    border: 1px solid transparent;
    border-radius: var(--r-1);
    font-size: var(--t-label);
    font-weight: 600;
    color: var(--ink-mute);
    transition: background-color var(--m-fast) var(--m-ease),
                border-color var(--m-fast) var(--m-ease),
                color var(--m-fast) var(--m-ease);
  }
  /* La elegida se dice con un borde de 4,98:1 contra el papel-2 que la rodea
     (WCAG 1.4.11): el blanco sobre papel-2 sólo da 1,2:1, y el cambio de gris a
     tinta en el texto, 2,9:1. Con `--line` el estado no llegaba al 3:1. */
  .modo-op input:checked + span {
    background: #fff;
    border-color: var(--ink-mute);
    color: var(--ink);
  }
  .modo-op:hover input:not(:checked) + span { color: var(--ink); }
  .modo-op input:focus-visible + span {
    outline: 2px solid var(--focus);
    outline-offset: 1px;
  }

  /* ── Los desplegables ───────────────────────────────────────────────── */
  .field { margin-bottom: var(--s-4); }
  .field[hidden] { display: none; }
  .label {
    display: block;
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    color: var(--ink-mute);
    margin-bottom: var(--s-2);
  }
  /* ── El selector con bandera (entrega `wise-`) ─────────────────────── */
  .selector { position: relative; }
  .selector-boton {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    width: 100%;
    min-height: 52px;
    padding: 0 var(--s-3);
    border: 1px solid var(--line);
    border-radius: var(--r-2);
    background: #fff;
    font: inherit;
    color: var(--ink);
    text-align: left;
    cursor: pointer;
    transition: border-color var(--m-fast) var(--m-ease),
                box-shadow var(--m-fast) var(--m-ease);
  }
  .selector-boton:hover { border-color: var(--ink-mute); }
  .selector-boton:focus { outline: none; }
  .selector-boton:focus-visible,
  .selector-boton[aria-expanded='true'] {
    border-color: var(--verde-deep);
    box-shadow: 0 0 0 3px rgba(10, 114, 80, 0.18);
  }
  .selector-actual { display: flex; align-items: center; gap: var(--s-3); min-width: 0; }
  .selector-nombre {
    font-size: var(--t-body);
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .selector-codigo { font-size: var(--t-label); font-weight: 500; color: var(--ink-mute); }
  /* La flecha del set apunta a la derecha; girada, dice «se despliega», y de
     cabeza, «se recoge». */
  .selector-boton :global(.selector-ico) {
    flex: none;
    color: var(--ink-mute);
    transform: rotate(90deg);
    transition: transform var(--m-fast) var(--m-ease);
  }
  .selector-boton[aria-expanded='true'] :global(.selector-ico) { transform: rotate(-90deg); }

  /* El panel cuelga del botón y tapa lo que hay debajo dentro de la tarjeta.
     Lleva la sombra de los menús, `--elev-pop`, que el DS reserva para esto. */
  .selector-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 6px);
    z-index: 20;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--r-2);
    box-shadow: var(--elev-pop);
    padding: var(--s-2);
  }
  .selector-panel[hidden] { display: none; }
  .selector-buscar {
    display: block;
    width: 100%;
    min-height: 44px;
    padding: 0 var(--s-3);
    border: 1px solid var(--line);
    border-radius: var(--r-1);
    background: var(--papel);
    font: inherit;
    font-size: var(--t-body);
    color: var(--ink);
  }
  .selector-buscar::placeholder { color: var(--ink-mute); opacity: 1; }
  /* El mismo foco que el botón y las cajas de los montos: borde y anillo. Con
     sólo el borde, el buscador era el único campo de la tarjeta sin anillo. */
  .selector-buscar:focus {
    outline: none;
    border-color: var(--verde-deep);
    box-shadow: 0 0 0 3px rgba(10, 114, 80, 0.18);
  }
  .selector-lista {
    list-style: none;
    margin: var(--s-2) 0 0;
    padding: 0;
    max-height: 288px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .selector-op {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-height: 44px;
    padding: 0 var(--s-3);
    border-radius: var(--r-1);
    cursor: pointer;
  }
  .selector-op[hidden] { display: none; }
  .op-nombre { flex: 1; min-width: 0; font-size: var(--t-body-sm); font-weight: 600; color: var(--ink); }
  .op-codigo { font-size: var(--t-label); color: var(--ink-mute); }
  /* La activa —la que eligen Intro o un clic— va en papel-2 y con un borde a
     la izquierda; la elegida, con el verde oscuro en el código y un punto. */
  .selector-op:hover,
  .selector-op.activa { background: var(--papel-2); }
  .selector-op.activa { box-shadow: inset 3px 0 0 var(--ink-mute); }
  .selector-op[aria-selected='true'] .op-codigo { color: var(--verde-deep); font-weight: 600; }
  .selector-op[aria-selected='true']::after {
    content: '';
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 4px solid var(--verde-deep);
  }
  .selector-vacio { padding: var(--s-3); font-size: var(--t-body-sm); color: var(--ink-mute); }

  /* ── Los montos y el tramo ──────────────────────────────────────────── */
  .monto {
    border: 1px solid var(--line);
    border-radius: var(--r-2);
    background: #fff;
    padding: var(--s-2) var(--s-3) var(--s-2);
    cursor: text;
    transition: border-color var(--m-fast) var(--m-ease),
                box-shadow var(--m-fast) var(--m-ease);
  }
  /* El borde de foco es un indicador de interfaz: necesita 3:1 contra el blanco
     del campo. verde-deep da 4.9:1; el verde de marca sólo 1.9:1. El anillo es
     `--verde-deep` al 18%, a mano porque `color-mix()` está por debajo del
     `cssTarget` del proyecto. */
  .monto:focus-within {
    border-color: var(--verde-deep);
    box-shadow: 0 0 0 3px rgba(10, 114, 80, 0.18);
  }
  /* Fuera de rango se marca la caja de los PESOS, que es donde vive el mínimo:
     la que envías en un envío, la que recibes de vuelta a pesos. Antes se
     ponían rojas las dos, y la que llega no tenía nada mal. */
  .monto.invalid { border-color: var(--baja); }

  .monto-cabeza {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
  }
  .monto-label {
    display: block;
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    color: var(--ink-mute);
    line-height: 1.3;
  }
  .amount {
    display: block;
    min-width: 0;
    width: 100%;
    border: 0;
    background: transparent;
    padding: 2px 0 var(--s-1);
    font-size: var(--t-dato-m);
    font-weight: 500;
    line-height: 1.15;
    color: var(--ink);
  }
  .amount:focus { outline: none; }
  .monto-llega .amount { font-weight: 600; }
  /* Una cifra que no cabe baja un escalón en vez de cortarse, y si tampoco
     cabe, otro: «1.086.956.520,65» pesos argentinos a 320 px, o cualquier monto
     con el espaciado de WCAG 1.4.12. La clase la pone la isla midiendo la
     cifra, no contando dígitos (ver `ajustar`). */
  .amount.largo { font-size: var(--t-h3); }
  .amount.muy-largo { font-size: var(--t-body); }
  /* La moneda, en una ficha: el código en la letra de las cifras, sobre el
     papel de la tarjeta. Es dato, no adorno, y no se pulsa. */
  .moneda {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px var(--s-2) 3px 4px;
    border-radius: var(--r-1);
    background: var(--papel-2);
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: .02em;
    color: var(--ink);
  }

  /* El tramo: 3 px de verde de una caja a la otra, a la altura de las cifras.
     El punto (`.tramo-valor::before`) es un borde y no un fondo, para que en
     colores forzados siga ahí. */
  /* El tramo cae en el eje de las cifras: 12 px de relleno de la caja más su
     borde, así que baja desde debajo del primer dígito de lo que envías hasta
     la etiqueta de lo que llega. */
  .tramo {
    position: relative;
    padding: var(--s-3) 0 var(--s-3) 40px;
  }
  .tramo::before {
    content: '';
    position: absolute;
    left: 13px;
    top: 0;
    bottom: 0;
    border-left: 3px solid var(--verde-deep);
  }
  .tramo-precio {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .tramo-rot {
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    color: var(--ink-mute);
    line-height: 1.3;
  }
  .tramo-valor {
    position: relative;
    font-size: var(--t-h3-m);
    font-weight: 600;
    line-height: 1.25;
    color: var(--ink);
  }
  /* El punto va colgado de la cifra del precio y no de la caja del tramo: así
     cae a la altura de esa línea sea cual sea el tamaño de letra. Su centro
     es el del tramo: 40 − 13 − 1,5 + 6,5 = 32 px a la izquierda del texto. */
  .tramo-valor::before {
    content: '';
    position: absolute;
    left: -32px;
    top: 50%;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    border: 6.5px solid var(--verde-deep);
    box-shadow: 0 0 0 3px var(--papel);
    transform: translateY(-50%);
  }
  .tramo-nota {
    margin-top: var(--s-2);
    font-size: var(--t-label);
    line-height: 1.45;
    color: var(--ink-mute);
  }
  .tramo-nota strong { color: var(--ink); font-weight: 600; }

  /* M2 · el dato acusa que cambió. 160ms, sólo sobre el valor nuevo. No es un
     conteo desde cero: eso mostraría precios falsos. NO al teclear: mientras
     escribes, la cifra tiene que seguirte sin latencia. */
  .tramo-valor.is-set,
  .amount.is-set { animation: settle 160ms var(--m-ease) both; }
  @keyframes settle {
    from { opacity: 0; transform: translateY(2px); }
    to   { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tramo-valor.is-set,
    .amount.is-set { animation: none; }
  }

  .alert {
    font-size: var(--t-body-sm);
    line-height: 1.45;
    color: var(--ink);
    background: var(--error-bg);
    border: 1px solid var(--error-line);
    border-radius: var(--r-2);
    padding: var(--s-3);
    margin: var(--s-3) 0 0;
  }

  /* El riel se explica, pero en el peso que le corresponde: no es el titular */
  .rail {
    font-size: var(--t-label);
    line-height: 1.45;
    color: var(--ink-mute);
    margin: var(--s-4) 0;
  }
  .rail strong { color: var(--ink); font-weight: 600; }

  .cta {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: var(--verde);
    color: var(--on-verde);
    font-size: var(--t-body);
    font-weight: 700;
    padding: var(--s-4);
    border-radius: var(--r-2);
    text-decoration: none;
    transition: background-color var(--m-fast) var(--m-ease);
  }
  .cta:hover { background: var(--verde-hi); }

  .secondary {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: var(--s-2);
    min-height: 44px;
    font-size: var(--t-body-sm);
    font-weight: 500;
    color: var(--verde-deep);
    text-decoration: none;
  }
  .secondary:hover { text-decoration: underline; }

  /* La barra se ancla al borde inferior. Su eje de entrada es ese borde, no la
     diagonal de la marca: no es contenido que entra en la página, es un
     elemento acoplado que asoma desde donde vive. Misma duración y curva. */
  .dock {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 30;
    background: var(--tinta);
