    padding: var(--s-3) var(--pad-section-m);
    padding-bottom: max(var(--s-3), env(safe-area-inset-bottom));
    transform: translateY(100%);
    transition: transform var(--m-base) var(--m-ease);
  }
  .dock.is-up { transform: none; }
  .dock-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    max-width: var(--container);
    margin: 0 auto;
  }
  .dock-fig { display: flex; flex-direction: column; min-width: 0; }
  .dock-label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: var(--t-dato-sm);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    color: var(--on-tinta-mute);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .dock-amount {
    font-size: var(--t-h3-m);
    font-weight: 500;
    color: var(--on-tinta);
    line-height: 1.2;
    white-space: nowrap;
  }
  /* M2 también acá: la cifra acusa que cambió mientras te acompaña. */
  .dock-amount.is-set { animation: settle 160ms var(--m-ease) both; }
  .dock-cta {
    flex: none;
    display: flex;
    align-items: center;
    background: var(--verde);
    color: var(--on-verde);
    font-size: var(--t-body-sm);
    font-weight: 700;
    padding: 0 var(--s-5);
    min-height: 44px;
    border-radius: var(--r-2);
    text-decoration: none;
    transition: background-color var(--m-fast) var(--m-ease);
  }
  .dock-cta:hover { background: var(--verde-hi); }
  @media (prefers-reduced-motion: reduce) {
    .dock { transition: none; }
    .dock-amount.is-set { animation: none; }
  }

  /* Bajo 360 px la tarjeta gana 16 px de ancho útil: con 24 de relleno, la
     cifra de partida no cabía en su caja con el espaciado de WCAG 1.4.12. */
  @media (max-width: 359px) {
    .quoter { padding: var(--s-4); }
  }

  @media (min-width: 900px) {
    /* En escritorio el cotizador nunca se pierde de vista: la barra no aplica. */
    .dock { display: none; }
    .amount { font-size: var(--t-dato); }
    .amount.largo { font-size: var(--t-dato-m); }
    .amount.muy-largo { font-size: var(--t-h3); }
    .tramo-valor { font-size: var(--t-h3); }
  }

  /* En colores forzados el sistema pinta los bordes y quita los fondos: el
     tramo y el punto ya son bordes, así que siguen. La ficha de la moneda y el
     interruptor elegido pierden su fondo y necesitan un borde que los diga. */
  @media (forced-colors: active) {
    .selector-panel { border: 1px solid CanvasText; }
    .selector-op.activa { outline: 2px solid Highlight; outline-offset: -2px; }
    .selector-op[aria-selected='true']::after { border-color: Highlight; }
    .moneda { border: 1px solid CanvasText; }
    .modo { border: 1px solid CanvasText; }
    /* El borde transparente de la opción sin elegir se pintaría: se le da el
       color del fondo para que sólo la elegida tenga caja. */
    .modo-op > span { border-color: Canvas; }
    .modo-op input:checked + span { border-color: Highlight; color: Highlight; }
    /* El botón de WhatsApp es un relleno, y el relleno se va: sin borde quedaba
       como un enlace suelto. Pasaba también antes del rediseño. */
    .cta { border: 1px solid LinkText; }
    /* El de la barra, igual: sin el borde quedaba el texto «Ir al chat» solo
       (2026-10-24). */
    .dock-cta { border: 1px solid LinkText; }
    .tramo::before, .tramo-valor::before { border-color: Highlight; }
    .tramo-valor::before { box-shadow: none; }
  }
</style>

<script>
  import { formatCLP, formatForeign, parseAmount } from '../lib/pricing/format.ts';
  import {
    buildQuote,
    clpAmount,
    convert,
    currenciesFor,
    formatAmount,
    precioLegible,
    whatsappUrl,
  } from '../lib/pricing/quote.ts';
  import type { Currency, Intent } from '../lib/pricing/types.ts';
  import { currencyInfo, type IslandCurrency } from '../lib/pricing/currencies.ts';

  const root = document.querySelector<HTMLElement>('#cotizador');
  if (root) {
    const divisas: IslandCurrency[] = JSON.parse(root.dataset.divisas ?? '[]');
    const campoDestino = root.querySelector<HTMLElement>('[data-campo-destino]');
    const campoDivisa = root.querySelector<HTMLElement>('[data-campo-divisa]');
    const banderas = document.querySelector<HTMLTemplateElement>('#cot-banderas');

    /** Una bandera de 16 px, copiada de la plantilla que dibujó el servidor. */
    const bandera = (codigo: string | undefined): Node | null =>
      (codigo && banderas?.content.querySelector(`[data-bandera="${codigo}"]`)?.cloneNode(true)) || null;
    const ponerBandera = (caja: Element | null | undefined, codigo: string | undefined): void => {
      const nueva = bandera(codigo);
      const vieja = caja?.querySelector('[data-bandera]');
      if (nueva && vieja) vieja.replaceWith(nueva);
    };

    /** Sin tildes ni mayúsculas: «peru» encuentra Perú y «japon», Japón. */
    const normal = (t: string): string =>
      t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();

    /**
     * El selector con bandera (entrega `wise-`). Un botón que abre un panel con
     * un buscador y una lista. El buscador es el `combobox` y lleva la lista
     * con `aria-activedescendant`, así que el foco no sale nunca de él.
     */
    const crearSelector = (cont: HTMLElement | null, alElegir: (op: HTMLElement) => void) => {
      const boton = cont?.querySelector<HTMLButtonElement>('[data-boton]');
      const panel = cont?.querySelector<HTMLElement>('[data-panel]');
      const buscar = cont?.querySelector<HTMLInputElement>('[data-buscar]');
      const lista = cont?.querySelector<HTMLElement>('[data-lista]');
      const vacio = cont?.querySelector<HTMLElement>('[data-vacio]');
      const estado = cont?.querySelector<HTMLElement>('[data-estado]');
      let espera = 0;
      const actual = cont?.querySelector<HTMLElement>('[data-actual]');
      const ops = [...(lista?.querySelectorAll<HTMLElement>('[role="option"]') ?? [])];
      let activa = -1;
      const visibles = () => ops.filter((o) => !o.hidden);
      const elegida = () => ops.find((o) => o.getAttribute('aria-selected') === 'true') ?? ops[0];

      const activar = (op: HTMLElement | undefined): void => {
        ops.forEach((o) => o.classList.remove('activa'));
        if (!op || !buscar) { buscar?.removeAttribute('aria-activedescendant'); activa = -1; return; }
        op.classList.add('activa');
        buscar.setAttribute('aria-activedescendant', op.id);
        activa = visibles().indexOf(op);
        op.scrollIntoView({ block: 'nearest' });
      };
      const filtrar = (): void => {
        const q = normal(buscar?.value ?? '');
        ops.forEach((o) => { o.hidden = q !== '' && !normal(o.dataset.texto ?? '').includes(q); });
        if (vacio) vacio.hidden = visibles().length > 0;
        // La activa es la que EMPIEZA por lo escrito, si la hay: «pe» encuentra
        // cuatro (Perú y tres pesos), e Intro debe elegir Perú.
        const v = visibles();
        activar(v.find((o) => normal(o.dataset.valor ?? '').startsWith(q) || normal(o.querySelector('.op-nombre')?.textContent ?? '').startsWith(q)) ?? v[0]);
        /* Cuántas quedan, para quien no ve la lista (WCAG 4.1.3). Al dejar de
           escribir y no en cada tecla, como la calculadora del spread; y nada
           al abrir, que es cuando el lector ya lee la opción activa. Sin esto,
           «Ningún destino coincide.» sólo se veía. */
        window.clearTimeout(espera);
        if (!estado) return;
        if (q === '') { estado.textContent = ''; return; }
        espera = window.setTimeout(() => {
          const d = estado.dataset;
          estado.textContent = v.length === 0 ? d.ninguno ?? '' : `${v.length} ${v.length === 1 ? d.uno : d.varios}`;
        }, 500);
      };
      const abrir = (): void => {
        if (!panel || !boton || !buscar) return;
        panel.hidden = false;
        boton.setAttribute('aria-expanded', 'true');
        buscar.value = '';
        filtrar();
        activar(elegida());
        buscar.focus();
      };
      const cerrar = (devolverFoco: boolean): void => {
        if (!panel || panel.hidden) return;
        panel.hidden = true;
        boton?.setAttribute('aria-expanded', 'false');
        if (devolverFoco) boton?.focus();
      };
      /** Marca una opción como elegida y copia su bandera, su nombre y su código al botón. */
      const marcar = (op: HTMLElement): void => {
        ops.forEach((o) => o.setAttribute('aria-selected', o === op ? 'true' : 'false'));
        const flag = op.querySelector('[data-bandera]')?.cloneNode(true);
        const nombre = op.querySelector('.op-nombre')?.textContent ?? '';
        const codigo = op.querySelector('.op-codigo')?.textContent ?? '';
        const vieja = actual?.querySelector('[data-bandera]');
        if (flag && vieja) vieja.replaceWith(flag);
        const n = actual?.querySelector('.selector-nombre');
        const c = actual?.querySelector('.selector-codigo');
        if (n) n.textContent = nombre;
        if (c) c.textContent = codigo;
      };
      const elegir = (op: HTMLElement | undefined): void => {
        if (!op) return;
        marcar(op);
        cerrar(true);
        alElegir(op);
      };

      boton?.addEventListener('click', () => (panel?.hidden ? abrir() : cerrar(true)));
      buscar?.addEventListener('input', filtrar);
      buscar?.addEventListener('keydown', (e) => {
        const v = visibles();
        if (e.key === 'ArrowDown') { e.preventDefault(); activar(v[Math.min(activa + 1, v.length - 1)]); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); activar(v[Math.max(activa - 1, 0)]); }
        else if (e.key === 'Home') { e.preventDefault(); activar(v[0]); }
        else if (e.key === 'End') { e.preventDefault(); activar(v[v.length - 1]); }
        else if (e.key === 'Enter') { e.preventDefault(); elegir(v[activa]); }
        else if (e.key === 'Escape') { e.preventDefault(); cerrar(true); }
        else if (e.key === 'Tab') cerrar(false);
      });
      // Con el ratón: `mousedown` evita que el buscador pierda el foco antes del clic.
      lista?.addEventListener('mousedown', (e) => e.preventDefault());
      lista?.addEventListener('click', (e) => {
        const op = (e.target as HTMLElement).closest<HTMLElement>('[role="option"]');
        if (op) elegir(op);
      });
      lista?.addEventListener('mousemove', (e) => {
        const op = (e.target as HTMLElement).closest<HTMLElement>('[role="option"]');
        if (op && !op.classList.contains('activa')) activar(op);
      });
      // El foco o un clic que salen del selector lo cierran.
      cont?.addEventListener('focusout', (e) => {
        if (!cont.contains(e.relatedTarget as Node | null)) cerrar(false);
      });
      document.addEventListener('pointerdown', (e) => {
        if (cont && !cont.contains(e.target as Node)) cerrar(false);
      });

      return {
        valor: (): string | undefined => elegida()?.dataset.valor,
        codigo: (): string | undefined => elegida()?.dataset.c,
        bandera: (): string | undefined =>
          elegida()?.querySelector<HTMLElement>('[data-bandera]')?.dataset.bandera,
        /** Elige sin avisar: para sincronizar un selector con el otro. */
        poner: (pred: (op: HTMLElement) => boolean): boolean => {
          const op = ops.find(pred);
          if (op) marcar(op);
          return !!op;
        },
      };
    };

    /** La divisa del destino elegido: viaja en la opción, `data-c`. */
    const divisaDe = (codigo: string | undefined): IslandCurrency =>
      divisas.find((d) => d.c === codigo) ??
      divisas[0] ?? { c: 'USD', r: Number(root.dataset.rate), n: 'dólar' };

    // Se crean más abajo, cuando ya existen las funciones a las que avisan.
    let selDestino: ReturnType<typeof crearSelector>;
    let selDivisa: ReturnType<typeof crearSelector>;
    const codigoDestino = (): string | undefined =>
      root.querySelector<HTMLElement>('[data-selector="destino"] [role="option"][aria-selected="true"]')?.dataset.c;

    let divisa: IslandCurrency = divisaDe(codigoDestino());
    let rate = divisa.r;
    const minPay = Number(root.dataset.min);
    const maxRaw = Number(root.dataset.max);
    const maxPay = Number.isFinite(maxRaw) && maxRaw > 0 ? maxRaw : undefined;
    const source = root.dataset.source ?? '';
    const waNumber = root.dataset.wa!;

    const giveInput = root.querySelector<HTMLInputElement>('#give-input')!;
    const getInput = root.querySelector<HTMLInputElement>('#get-input')!;
    const giveLabel = root.querySelector<HTMLElement>('[data-label-give]')!;
    const getLabel = root.querySelector<HTMLElement>('[data-label-get]')!;
    const giveCur = root.querySelector<HTMLElement>('[data-cur-give]')!;
    const getCur = root.querySelector<HTMLElement>('[data-cur-get]')!;
    const giveBox = giveInput.closest<HTMLElement>('.monto')!;
    const getBox = getInput.closest<HTMLElement>('.monto')!;
    const alertEl = root.querySelector<HTMLElement>('[data-alert]')!;
    const cta = root.querySelector<HTMLAnchorElement>('[data-cta]')!;
    const rateEl = root.querySelector<HTMLElement>('[data-rate-display]');
    const dock = document.querySelector<HTMLElement>('[data-dock]');
    const dockLabel = dock?.querySelector<HTMLElement>('[data-dock-label]');
    const dockAmount = dock?.querySelector<HTMLElement>('[data-dock-amount]');
    const dockCta = dock?.querySelector<HTMLAnchorElement>('[data-dock-cta]');
    const intentInputs = root.querySelectorAll<HTMLInputElement>('input[name="intent"]');

    /* Los decimales los trae la divisa elegida: «1.250,00 yenes» escribiría una
       fracción que esa moneda no usa, y en dinero eso se lee como precisión
       falsa. El peso chileno nunca lleva decimales. */
    const fmt = (value: number, currency: Currency): string =>
      currency === 'CLP' ? formatCLP(value) : formatForeign(value, currencyInfo(divisa.c).decimals);

    const precio = () =>
      ({ rate, currency: divisa.c, pair: `${divisa.c}/CLP` as const, source, asOf: new Date() });

    let intent: Intent = 'to_foreign';
    let giveAmount = parseAmount(giveInput.value);
    let lastRate = '';

    // La pantalla y el mensaje calculan con la MISMA función. Antes el
    // componente tenía su propia aritmética, sin la guarda de tasa del módulo:
    // con una tasa corrupta la pantalla habría mostrado Infinity y el mensaje 0.
    const received = (): number => convert(intent, giveAmount, rate);

    /** M2 sobre un elemento: reinicia la animación leyendo offsetWidth. Nunca
        sobre el campo enfocado: animar lo que alguien escribe es pelear con su
        cursor. */
    const settle = (el: HTMLElement): void => {
      if (document.activeElement === el) return;
      el.classList.remove('is-set');
      void el.offsetWidth;
      el.classList.add('is-set');
    };

    /** Una cifra que no cabe en su caja baja un escalón (`.largo`). Se mide,
        no se cuentan dígitos: lo que cabe depende del ancho, de la letra y del
        espaciado que el visitante haya puesto. */
    const ajustar = (): void => {
      for (const el of [giveInput, getInput]) {
        el.classList.remove('largo', 'muy-largo');
        if (el.scrollWidth > el.clientWidth + 1) el.classList.add('largo');
        if (el.scrollWidth > el.clientWidth + 1) el.classList.replace('largo', 'muy-largo');
      }
    };
    window.addEventListener('resize', ajustar, { passive: true });

    const render = (): void => {
      const { give, get } = currenciesFor(intent, divisa.c);
      const envio = intent === 'to_foreign';
      const destino = envio ? selDestino.valor() : undefined;
      const quote = buildQuote({
        intent,
        giveAmount,
        price: precio(),
        minPay,
        ...(maxPay !== undefined ? { maxPay } : {}),
      });

      giveCur.textContent = give;
      getCur.textContent = get;
      // Las banderas de las fichas: Chile para los pesos; para la otra, la del
      // destino en un envío y la de la divisa de vuelta a pesos.
      const otra = envio ? selDestino.bandera() : selDivisa.bandera();
      ponerBandera(giveCur.parentElement, envio ? 'cl' : otra);
      ponerBandera(getCur.parentElement, envio ? otra : 'cl');
      giveLabel.textContent = envio ? 'Envías' : 'Conviertes';
      getLabel.textContent = envio ? 'Llega aprox.' : 'Recibes aprox.';
      giveInput.inputMode = give === 'CLP' ? 'numeric' : 'decimal';
      getInput.inputMode = get === 'CLP' ? 'numeric' : 'decimal';

      // El precio y su forma son del par, no del cotizador. M2 sólo cuando
      // cambia de verdad: si se reanimara en cada tecleo sería ruido.
      const legible = precioLegible(rate, divisa.c);
      if (rateEl && legible !== lastRate) {
        lastRate = legible;
        rateEl.textContent = legible;
        settle(rateEl);
      }

      const fuera = quote.state === 'below_min' || quote.state === 'above_max';
      giveBox.classList.toggle('invalid', fuera && give === 'CLP');
      getBox.classList.toggle('invalid', fuera && get === 'CLP');
      // Se muestra la región ANTES de escribirle. Un lector de pantalla no
      // vigila regiones ocultas: escribiendo primero, el aviso no se anunciaba.
      const aviso =
        quote.state === 'below_min'
          ? `Monto mínimo: ${formatCLP(minPay)} CLP. Puedes escribirnos igual y te orientamos.`
          : quote.state === 'above_max' && maxPay !== undefined
            ? `Para montos sobre CLP ${formatCLP(maxPay)} te atiende un ejecutivo. Escríbenos.`
            : '';
      if (aviso) {
        alertEl.hidden = false;
        alertEl.textContent = aviso;
      } else {
        alertEl.textContent = '';
        alertEl.hidden = true;
      }

      ajustar();

      // El fallback de cualquier problema es WhatsApp, nunca un error seco
      const href = whatsappUrl(waNumber, quote, giveAmount, destino);
      cta.href = href;
      cta.textContent = fuera ? 'Escríbenos por WhatsApp' : 'Continuar por WhatsApp';

      // La barra refleja exactamente la tarjeta: mismo enlace, misma cifra,
      // mismo estado. Una sola verdad, dos lugares donde se ve.
      if (dock && dockLabel && dockAmount && dockCta) {
        dockCta.href = href;
        dockCta.textContent = fuera ? 'Escríbenos' : 'Continuar';
        dockLabel.textContent = fuera ? 'Fuera de rango' : envio ? `Llega a ${destino ?? ''}` : 'Recibes';
        ponerBandera(dock, fuera ? undefined : envio ? selDestino.bandera() : 'cl');
        const dockShown = fuera ? '—' : formatAmount(received(), get);
        if (dockAmount.textContent !== dockShown) {
          dockAmount.textContent = dockShown;
          dockAmount.classList.remove('is-set');
          void dockAmount.offsetWidth;
          dockAmount.classList.add('is-set');
        }
      }
    };

    /** Cambia de divisa conservando el monto en PESOS: el cliente piensa la
        operación en lo que pone, no en lo que recibe. */
    const usarDivisa = (codigo: string | undefined): void => {
      const clpBefore = clpAmount(intent, giveAmount, rate);
      divisa = divisaDe(codigo);
      rate = divisa.r;
      const { give, get } = currenciesFor(intent, divisa.c);
      giveAmount = give === 'CLP' ? clpBefore : rate > 0 ? clpBefore / rate : 0;
      giveInput.value = fmt(giveAmount, give);
      getInput.value = fmt(received(), get);
      settle(giveInput);
      settle(getInput);
    };

    // El campo que se edita NO se reformatea bajo el cursor (spec §3): se
    // actualiza el otro, y el propio se formatea recién al salir.
    giveInput.addEventListener('input', () => {
      giveAmount = parseAmount(giveInput.value);
      getInput.value = fmt(received(), currenciesFor(intent, divisa.c).get);
      render();
    });
    giveInput.addEventListener('blur', () => {
      giveInput.value = fmt(giveAmount, currenciesFor(intent, divisa.c).give);
      ajustar();
    });
    getInput.addEventListener('input', () => {
      const { give } = currenciesFor(intent, divisa.c);
      const target = parseAmount(getInput.value);
      // La inversa de `convert`, con la misma guarda de tasa.
      giveAmount = rate > 0 ? (give === 'CLP' ? target * rate : target / rate) : 0;
      giveInput.value = fmt(giveAmount, give);
      render();
    });
    getInput.addEventListener('blur', () => {
      getInput.value = fmt(received(), currenciesFor(intent, divisa.c).get);
      ajustar();
    });

    selDestino = crearSelector(root.querySelector('[data-selector="destino"]'), (op) => {
      usarDivisa(op.dataset.c);
      render();
    });
    selDivisa = crearSelector(root.querySelector('[data-selector="divisa"]'), (op) => {
      usarDivisa(op.dataset.c);
      render();
    });

    /* Al cambiar de modo se cambia de desplegable y se conserva lo elegido: de
       un envío a Colombia se pasa a «tienes pesos colombianos», y de vuelta, si
       entretanto elegiste euros, el destino pasa a Europa. El monto en pesos
       se conserva, como siempre. */
    intentInputs.forEach((input) =>
      input.addEventListener('change', () => {
        const clpBefore = clpAmount(intent, giveAmount, rate);
        intent = input.value as Intent;
        const envio = intent === 'to_foreign';
        if (campoDestino) campoDestino.hidden = !envio;
        if (campoDivisa) campoDivisa.hidden = envio;
        if (envio && selDestino.codigo() !== divisa.c) selDestino.poner((o) => o.dataset.c === divisa.c);
        if (!envio) selDivisa.poner((o) => o.dataset.c === divisa.c);
        const { give, get } = currenciesFor(intent, divisa.c);
        giveAmount = give === 'CLP' ? clpBefore : rate > 0 ? clpBefore / rate : 0;
        giveInput.value = fmt(giveAmount, give);
        getInput.value = fmt(received(), get);
        settle(giveInput);
        settle(getInput);
        render();
      })
    );

    /**
     * Un destino que llega de fuera: `?destino=Colombia` en la dirección, o un
     * enlace de esta misma página con `data-cotizar-destino` (las tarjetas de
     * la sección de destinos). El primero se aplica al cargar; el segundo, sin
     * recargar: elige el destino, vuelve al modo de envío, lleva la vista al
     * cotizador y deja el foco en el selector.
     */
    const irADestino = (nombre: string | null | undefined): boolean => {
      if (!nombre) return false;
      const pedido = (o: HTMLElement): boolean => normal(o.dataset.valor ?? '') === normal(nombre);
      const opciones = root.querySelectorAll<HTMLElement>('[data-selector="destino"] [role="option"]');
      if (![...opciones].some(pedido)) return false;
      // Primero el modo y después el destino. Al volver al envío, el cambio de
      // modo elige el destino de la divisa que estaba —de dólares sale Ecuador—
      // y, al revés, pisaba el destino pedido.
      const envio = root.querySelector<HTMLInputElement>('input[name="intent"][value="to_foreign"]');
      if (envio && !envio.checked) { envio.checked = true; envio.dispatchEvent(new Event('change')); }
      selDestino.poner(pedido);
      usarDivisa(selDestino.codigo());
      return true;
    };
    irADestino(new URLSearchParams(location.search).get('destino'));
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-cotizar-destino]');
      if (!a || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      if (!irADestino(a.dataset.cotizarDestino)) return;
      e.preventDefault();
      render();
      const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      root.scrollIntoView({ behavior: quieto ? 'auto' : 'smooth', block: 'start' });
      root.querySelector<HTMLButtonElement>('[data-selector="destino"] [data-boton]')?.focus({ preventScroll: true });
    });

    render();

    /**
     * La barra asoma sólo cuando la tarjeta quedó ARRIBA del viewport. Si la
     * tarjeta está más abajo —porque el usuario subió— no aparece: el
     * instrumento viene en camino y duplicarlo sería ruido.
     */
    if (dock && 'IntersectionObserver' in window) {
      const dockObserver = new IntersectionObserver(
        ([entry]) => {
          if (!entry) return;
          const passed = !entry.isIntersecting && entry.boundingClientRect.bottom < 0;
          dock.hidden = !passed;
          // Se separa de `hidden` para que la transición tenga un fotograma.
          requestAnimationFrame(() => dock.classList.toggle('is-up', passed));
          // Evita que la barra tape la última línea de la página.
          document.documentElement.classList.toggle('has-dock', passed);
        },
        { threshold: 0 }
      );
      dockObserver.observe(root);
    }
  }
</script>
