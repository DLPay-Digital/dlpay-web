---
/**
 * COTIZADOR — el elemento central de la web.
 * Especificación: docs/design-system/cotizador-spec.md
 *
 * Flujo: cuánto -> a dónde (o qué divisa tienes) -> cuánto llega -> lo que
 * cobramos y el precio referencial -> WhatsApp con todo prellenado -> un
 * ejecutivo confirma el precio final y coordina el destino.
 *
 * Lo que NO hace: ejecutar una operación, bloquear un precio, prometer un
 * precio final. El tipo `Quote` lo impide (`isReferential: true` es literal).
 *
 * Es la ÚNICA isla interactiva del producto (ADR-0002 §2). El precio se
 * resuelve en build desde ConfigPriceSource y viaja al cliente en
 * data-attributes.
 *
 * ── Rediseñado el 2026-10-22 (Cowork, entrega `cotizador-`) ────────────────
 *
 * Desde ADR-0014 el servicio no termina en una divisa: **el dinero llega a
 * destino en la moneda de ese destino.** La tarjeta seguía preguntando como una
 * casa de cambio —dos botones negros de «convertir», un desplegable de monedas
 * y el precio aparte, al pie— y ahora pregunta como un envío. Decisiones de
 * Sebastián del 2026-10-22, una por una:
 *
 * 1. **El destino se elige por país**, «¿A dónde envías?», y la moneda sale
 *    sola. Trece destinos para doce divisas: el dólar sirve a dos.
 * 2. **La vuelta a pesos se queda, más discreta**: un interruptor chico arriba,
 *    no dos botones del mismo peso que el resto de la tarjeta.
 * 3. **El precio se escribe para que se lea**: 1 USD = 919,70 CLP en las
 *    fuertes y 1 CLP = 4,35 COP en las débiles (`precioLegible`).
 *
 * Y una de forma, que no es una decisión sino la gramática del sitio: **entre
 * lo que envías y lo que llega va el recorrido**, el tramo verde que en todas
 * las figuras significa «lo nuestro» (DS §6.2). Desde ADR-0014 es de punta a
 * punta, así que acá también. El precio y la nota del spread viven en ese
 * tramo, que es donde ocurren: entre un monto y el otro.
 *
 * ── El tarifario, desde el 2026-10-27 (Cowork, entrega `tarifario-`) ───────
 *
 * Sebastián cambió el modelo de precio: **la tasa es la de mercado, sin
 * recargo, y lo que DLPay cobra son dos líneas a la vista** —un costo de envío
 * fijo y una comisión de cambio por tramo— (`lib/pricing/tarifario.ts`). La
 * nota «el precio ya incluye el spread» salió, por pedido suyo, y queda «Sin
 * comisiones ocultas».
 *
 * Las dos líneas van **en el tramo**, que es donde pasan: lo que envías baja
 * por el tramo, pierde el costo de envío y la comisión, y lo que queda se
 * convierte en el punto, que sigue marcando el precio. De vuelta a pesos, el
 * orden se da vuelta porque la cuenta también: primero se convierte y después
 * se descuenta. Global66 enseña el desglose debajo de los dos montos; acá va
 * entre ellos porque es lo que le pasa al dinero entre uno y otro.
 *
 * Cada destino trae su tarifa ya resuelta en pesos (`data-tarifas`): la isla
 * no importa el tarifario ni ve de qué monto en dólares sale el costo de envío.
 *
 * ── Compacto, desde el 2026-10-28 (Cowork, entrega `compacto-`) ────────────
 *
 * Sebastián: «que el diseño de nuestro cotizador se vea elegante y sin tanta
 * palabrería», con la eficiencia del de Global66 y no su dibujo. Tres cambios,
 * los tres suyos:
 *
 * 1. **Sin el interruptor «Enviar / Pasar a pesos» ni «¿A dónde envías?».** La
 *    dirección se decide desde las divisas: la ficha de cada monto es el
 *    selector, y un botón junto al precio da vuelta la operación. La decisión
 *    2 de arriba, del 2026-10-22, queda reemplazada.
 * 2. **Lo que cobramos, en el detalle.** Primero fue una línea, «Cobramos CLP
 *    19.495 · Ver detalle», con el desglose plegado en el tramo. El mismo día,
 *    con eso a la vista, Sebastián sacó la línea —«eso ya se sabe en el
 *    detalle»— y pidió el detalle «tal cual al de Global66»: «Ver detalle» abre
 *    una pestaña con el detalle completo, y en ella «Costos operacionales:
 *    CLP 0», «para que sea llamativo».
 * 3. **«Sin comisiones ocultas.» se queda a la vista**, al pie del tramo, junto
 *    a «Ver detalle».
 *
 * La tarjeta baja de 733 a 545 px a 390, y la cifra que llega entra en la
 * primera pantalla de un iPhone de 390×844.
 */
import { ConfigPriceSource } from '../lib/pricing/config-price-source.ts';
import {
  DEFAULT_CURRENCY,
  DEFAULT_DESTINO,
  availableCurrencies,
  currencyInfo,
  destinos,
} from '../lib/pricing/currencies.ts';
import { formatCLP, formatForeign, formatComision } from '../lib/pricing/format.ts';
import { buildQuote, precioLegible, whatsappUrl } from '../lib/pricing/quote.ts';
import { tarifasParaIsla } from '../lib/pricing/tarifario.ts';
import { contact, platform, quoteLimits } from '../lib/config/site.ts';
import Icon from './Icon.astro';
import Bandera from './Bandera.astro';
import { CODIGOS_BANDERA, banderaDeDestino, banderaDeDivisa } from '../lib/banderas.ts';

interface Props {
  /** Sobre tinta flota con sombra; sobre papel va plano (spec §2). */
  variant?: 'floating' | 'flat';
}
const { variant = 'floating' } = Astro.props;

/**
 * Las divisas del catálogo (ADR-0013, ampliado el 2026-10-22; nueve desde el
 * 2026-10-27, con el tarifario).
 *
 * Todas tienen tasa: la que Sebastián confirme en el entorno, o la de muestra
 * mientras no la haya. Lo que impide que una muestra llegue al sitio público no
 * es este archivo sino el build, que se detiene con la indexación abierta
 * mientras quede alguna sin confirmar (`assertRatesConfirmed`).
 */
const divisas = availableCurrencies();
const lugares = destinos();

const price = await new ConfigPriceSource(DEFAULT_CURRENCY).getPrice();

/** Lo único que el catálogo no sabe y el build sí: la tasa de cada divisa. */
const tasas = await Promise.all(
  divisas.map(async (d) => {
    const p = await new ConfigPriceSource(d.code).getPrice();
    return { c: d.code, r: p.rate, n: d.name };
  })
);

/* Límites y monto inicial: UN solo origen para toda la web (D24). Los
   pendientes D6 y D21 están anotados donde vive el valor, en environment.ts. */
const { minPayClp: minPay, maxPayClp: maxPay, samplePayClp: initialPay } = quoteLimits;

/**
 * La tarifa de cada destino y la de la vuelta a pesos, ya en pesos: el costo de
 * envío (`e`), los tres porcentajes en puntos básicos (`p`) y si llega en la
 * moneda de ese país (`m`; China llega en dólares). Es lo único del tarifario
 * que viaja al navegador.
 */
const { porDestino: tarifas, aPesos: tarifaPesos } = await tarifasParaIsla(lugares.map((l) => l.destino));
const deInicio = tarifas[DEFAULT_DESTINO];
const tarifaInicial = { envio: deInicio?.e ?? 0, comision: deInicio?.p ?? tarifaPesos.p };

/**
 * El enlace se arma también en el servidor, con la MISMA función que usa el
 * cliente. Sin JavaScript el CTA sigue llevando a WhatsApp con el monto de
 * ejemplo y el destino escritos; con JavaScript se actualiza a medida que el
 * usuario tipea.
 */
const initialQuote = buildQuote({
  intent: 'to_foreign',
  giveAmount: initialPay,
  price,
  tarifa: tarifaInicial,
  minPay,
  ...(maxPay !== undefined ? { maxPay } : {}),
});
const initialGet = initialQuote.getAmount;
const cargosIniciales = initialQuote.cargos;
const wa = whatsappUrl(contact.whatsappNumber, initialQuote, initialPay, DEFAULT_DESTINO);

const mayuscula = (s: string): string => s.charAt(0).toUpperCase() + s.slice(1);
---

<section
  class:list={['quoter', variant]}
  id="cotizador"
  data-rate={price.rate}
  data-min={minPay}
  data-max={maxPay ?? ''}
  data-wa={contact.whatsappNumber}
  data-source={price.source}
  data-divisas={JSON.stringify(tasas)}
  data-tarifas={JSON.stringify(tarifas)}
  data-tarifa-pesos={JSON.stringify(tarifaPesos)}
  aria-labelledby="quoter-title"
>
  <h2 class="sr-only" id="quoter-title">Cotizador de envíos y divisas</h2>

  {/*
    ── La dirección la deciden las divisas (2026-10-28) ──────────────────────

    Hasta el 2026-10-27 había arriba un interruptor «Enviar / Pasar a pesos» y
    debajo «¿A dónde envías?», un selector a lo ancho. Sebastián los retiró:
    «dejando a libre disposición lo que quiera hacer el cliente cambiando desde
    las divisas». **Ahora cada monto lleva su ficha de moneda, y la ficha es el
    selector**, como en Global66:

    - la de arriba dice qué pones: pesos, o la divisa que tienes;
    - la de abajo dice a dónde llega: un destino, o Chile en pesos;
    - elegir una divisa en una pone la otra en pesos, porque un lado es siempre
      el peso chileno;
    - el botón de las flechas, junto al precio, da vuelta la operación.

    **La de abajo elige un país y enseña un código.** El dólar llega a tres
    destinos y cuesta distinto en cada uno, así que la lista es de países; la
    ficha enseña la bandera, que los distingue, y el código, que es la unidad de
    la cifra. El país lo dice además la nota del riel, más abajo, con palabras.
  */}

  {/* Las banderas de las fichas de moneda, para que la isla las copie: el
      dibujo se escribe una vez, en el servidor, y no viaja en el JavaScript. */}
  <template id="cot-banderas">
    {CODIGOS_BANDERA.map((c) => <Bandera code={c} size={16} />)}
  </template>

  {/*
    ── Los dos montos y, entre ellos, el recorrido ───────────────────────────

    Cada monto es una caja con su etiqueta y su ficha arriba, en una fila, y la
    cifra debajo a todo el ancho: a 320 px es lo que decide si «2.000.000»
    cabe. Entre las dos corre el tramo verde —lo nuestro, de punta a punta
    desde ADR-0014 (DS §6.2)—, y sobre él el punto marca el precio. **No
    estrena ninguna marca**: el botón de las flechas es un control, no una
    marca, y por eso va al lado del precio y no sobre el tramo.

    REQUIERE VALIDACIÓN DE COMPLIANCE — «Envías» y «Llega aprox.» afirman lo
    mismo que la nota del riel, más abajo: que el dinero llega a destino. No
    afirman plazo ni canal (ADR-0014 §3).
  */}
  <div class="montos">
    <div class="monto">
      <div class="monto-cabeza">
        <label class="monto-label" for="give-input" data-label-give>Envías</label>
        <div class="selector" data-selector="give">
          <button
            type="button"
            class="moneda"
            id="give-boton"
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-controls="give-panel"
            aria-label="Moneda que envías: peso chileno, CLP"
            data-boton
          >
            <span class="moneda-actual" data-actual>
              <Bandera code="cl" size={16} />
              <span class="selector-codigo num" id="cur-give" data-cur-give>CLP</span>
            </span>
            <Icon name="chevron" size={14} class="selector-ico" />
          </button>
          <div class="selector-panel" id="give-panel" data-panel hidden>
            <input
              class="selector-buscar"
              type="text"
              role="combobox"
              aria-label="Busca una moneda"
              aria-autocomplete="list"
              aria-expanded="true"
              aria-controls="give-lista"
              autocomplete="off"
              spellcheck="false"
              placeholder="Busca una moneda"
              data-buscar
            />
            <ul class="selector-lista" role="listbox" id="give-lista" aria-label="Lo que pones" data-lista>
              <li
                role="option"
                id="giv-clp"
                class="selector-op"
                aria-selected="true"
                data-valor="CLP"
                data-c="CLP"
                data-nombre="peso chileno"
                data-texto="Peso chileno CLP pesos chilenos Chile"
              >
                <Bandera code="cl" size={24} />
                <span class="op-nombre">Peso chileno</span>
                <span class="op-codigo num">CLP</span>
              </li>
              {divisas.map((d, i) => (
                <li
                  role="option"
                  id={`giv-${i}`}
                  class:list={['selector-op', i === 0 && 'op-otra']}
                  aria-selected="false"
                  data-valor={d.code}
                  data-c={d.code}
                  data-nombre={d.name}
                  data-texto={`${d.name} ${d.plural} ${d.code} ${d.destinations.join(' ')}`}
                >
                  <Bandera code={banderaDeDivisa(d.code) ?? 'us'} size={24} />
                  <span class="op-nombre">{mayuscula(d.name)}</span>
                  <span class="op-codigo num">{d.code}</span>
                </li>
              ))}
            </ul>
            <p class="selector-vacio" data-vacio hidden>Ninguna moneda coincide.</p>
            <p class="sr-only" role="status" data-estado data-uno="moneda" data-varios="monedas" data-ninguno="Ninguna moneda coincide."></p>
          </div>
        </div>
      </div>
      <input
        id="give-input"
        class="amount num"
        type="text"
        inputmode="numeric"
        autocomplete="off"
        value={formatCLP(initialPay)}
        aria-describedby="cur-give quoter-note"
      />
    </div>

    <div class="tramo" data-tramo>
      {/*
        ── El tramo: el precio, y el detalle a un toque (2026-10-28, b) ───────

        Desde la entrega `compacto-` el tramo decía el total, «Cobramos CLP
        19.495», con el desglose plegado debajo. Sebastián lo sacó: el total ya
        está en el detalle. Ahora el tramo dice el precio y «Sin comisiones
        ocultas.», y a su lado «Ver detalle», que abre el detalle completo en una
        pestaña, como el de Global66 (abajo, `cot-detalle`).

        REQUIERE VALIDACIÓN DE COMPLIANCE — «sin recargo»; y que el cobro se lea
        al abrir el detalle y no en la tarjeta.
      */}
      <div class="tramo-fila" data-precio>
        <p class="tramo-precio">
          {/* «Precio referencial», con esas dos palabras (spec §48), y «sin
              recargo»: lo que cobramos va aparte, en el detalle. */}
          <span class="tramo-rot">Precio referencial, sin recargo</span>
          <span class="tramo-valor num" data-rate-display>{precioLegible(price.rate, DEFAULT_CURRENCY)}</span>
        </p>
        <button
          type="button"
          class="vuelta"
          aria-label={`Cambiar a pasar ${currencyInfo(DEFAULT_CURRENCY).plural} a pesos`}
          title={`Cambiar a pasar ${currencyInfo(DEFAULT_CURRENCY).plural} a pesos`}
          data-vuelta
        >
          <Icon name="intercambiar" size={20} />
        </button>
      </div>
      <div class="tramo-pie">
        <p class="tramo-nota" id="quoter-note">
          <strong>Sin comisiones ocultas.</strong>
        </p>
        <button
          type="button"
          class="ver-detalle"
          aria-haspopup="dialog"
          aria-controls="cot-detalle"
          data-abrir-detalle
        >
          Ver detalle<Icon name="chevron" size={14} class="ver-ico" />
        </button>
      </div>
    </div>

    <div class="monto monto-llega">
      <div class="monto-cabeza">
        <label class="monto-label" for="get-input" data-label-get>Llega aprox.</label>
        <div class="selector" data-selector="get">
          <button
            type="button"
            class="moneda"
            id="get-boton"
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-controls="get-panel"
            aria-label={`Destino: ${DEFAULT_DESTINO}, ${DEFAULT_CURRENCY}`}
            data-boton
          >
            <span class="moneda-actual" data-actual>
              <Bandera code={banderaDeDestino(DEFAULT_DESTINO) ?? 'us'} size={16} />
              <span class="selector-codigo num" id="cur-get" data-cur-get>{DEFAULT_CURRENCY}</span>
            </span>
            <Icon name="chevron" size={14} class="selector-ico" />
          </button>
          <div class="selector-panel" id="get-panel" data-panel hidden>
            <input
              class="selector-buscar"
              type="text"
              role="combobox"
              aria-label="Busca un país o una moneda"
              aria-autocomplete="list"
              aria-expanded="true"
              aria-controls="get-lista"
              autocomplete="off"
              spellcheck="false"
              placeholder="Busca un país o una moneda"
              data-buscar
            />
            <ul class="selector-lista" role="listbox" id="get-lista" aria-label="A dónde llega" data-lista>
              {lugares.map((l, i) => (
                <li
                  role="option"
                  id={`dst-${i}`}
                  class="selector-op"
                  aria-selected={l.destino === DEFAULT_DESTINO ? 'true' : 'false'}
                  data-valor={l.destino}
                  data-c={l.code}
                  data-nombre={l.destino}
                  data-texto={`${l.destino} ${l.code} ${currencyInfo(l.code).name} ${currencyInfo(l.code).plural}`}
                >
                  <Bandera code={banderaDeDestino(l.destino) ?? 'us'} size={24} />
                  <span class="op-nombre">{l.destino}</span>
                  <span class="op-codigo num">{l.code}</span>
                </li>
              ))}
              <li
                role="option"
                id="dst-clp"
                class="selector-op op-otra"
                aria-selected="false"
                data-valor="Chile"
                data-c="CLP"
                data-nombre="Chile, en pesos"
                data-texto="Chile pesos CLP peso chileno pasar a pesos"
              >
                <Bandera code="cl" size={24} />
                <span class="op-nombre">Chile, en pesos</span>
                <span class="op-codigo num">CLP</span>
              </li>
            </ul>
            <p class="selector-vacio" data-vacio hidden>Ningún destino coincide.</p>
            <p class="sr-only" role="status" data-estado data-uno="destino" data-varios="destinos" data-ninguno="Ningún destino coincide."></p>
          </div>
        </div>
      </div>
      <input
        id="get-input"
        class="amount num"
        type="text"
        inputmode="decimal"
        autocomplete="off"
        value={formatForeign(initialGet, currencyInfo(DEFAULT_CURRENCY).decimals)}
        aria-describedby="cur-get"
      />
    </div>
  </div>

  <p class="alert" data-alert hidden aria-live="polite"></p>
  {/* Lo que no se ve al darse vuelta la operación: sin el interruptor no hay
      un radio que diga en qué sentido estás, así que se dice al cambiar. */}
  <p class="sr-only" aria-live="polite" data-sentido></p>

  {/*
    La nota del riel (spec §42), que mitiga el plazo y dice en qué llega.
    **Desde el 2026-10-28 nombra el destino**: la ficha de abajo enseña sólo la
    bandera y el código, y el código del dólar sirve a tres países.

    REQUIERE VALIDACIÓN DE COMPLIANCE — que el dinero llega a destino en esa
    moneda.
  */}
  <p class="rail" data-rail>
    Llega <strong>a {DEFAULT_DESTINO}, en {currencyInfo(DEFAULT_CURRENCY).plural}</strong>. El plazo te lo confirma tu ejecutivo.
  </p>

  <a class="cta" href={wa} target="_blank" rel="noopener" data-cta>
    Cotizar este monto por WhatsApp
  </a>
  <a class="secondary" href={platform.registerUrl}>
    o crea tu cuenta para operar en línea
  </a>

  {/*
    ── El detalle completo, en una pestaña (2026-10-28, b) ────────────────────

    Pedido de Sebastián: «el esquema tal cual al de Global66 […] al clickear en
    ver detalle se abra una pequeña pestaña con el detalle completo». Las filas
    son las suyas, en el mismo orden: lo que envías; lo que cobramos, parte por
    parte; el monto a convertir; el precio; y lo que llega. *El mismo día salió
    la fila del total, «Lo que cobramos», y las cifras pasaron a una sola medida:
    a tres tamaños distintos se veía desordenado (Sebastián).* **«Costos
    operacionales: CLP 0»** también es pedido suyo, «para que sea llamativo», y
    va en verde: es lo que no cobramos.

    Es un `<dialog>` modal: atrapa el foco, Escape lo cierra (en Global66 no) y
    el foco vuelve a «Ver detalle» (en Global66 se va al principio de la
    página). Un clic en el fondo también lo cierra, como allá.

    REQUIERE VALIDACIÓN DE COMPLIANCE — el costo de envío, la comisión, «Costos
    operacionales: CLP 0» y las cifras.
  */}
  <dialog class="detalle" id="cot-detalle" aria-labelledby="detalle-titulo" data-detalle>
    <div class="detalle-in">
      <div class="detalle-cabeza">
        <h3 class="detalle-titulo" id="detalle-titulo">Detalle completo</h3>
        <button type="button" class="detalle-cerrar" data-cerrar-detalle>
          Cerrar<span class="detalle-cruz"><Icon name="cerrar" size={16} /></span>
        </button>
      </div>
      <dl class="detalle-lista" data-detalle-lista>
        <div class="fila" data-fila="pone"><dt data-f-give-rot>Envías</dt><dd class="num" data-f-give>CLP {formatCLP(initialPay)}</dd></div>
        {/* Los tres cobros van seguidos y sin raya entre ellos: es lo único que
            los agrupa. «Lo que cobramos», el total, salió el 2026-10-28 a pedido
            de Sebastián: el detalle enseña las partes y nada más. */}
        <div class="fila parte" data-fila="cobro"><dt>Costo de envío</dt><dd class="num" data-c-envio>CLP {formatCLP(cargosIniciales.envio)}</dd></div>
        <div class="fila parte" data-fila="cobro"><dt>Comisión de cambio <span class="pct num" data-c-pct>{formatComision(cargosIniciales.comisionPb)}</span></dt><dd class="num" data-c-comision>CLP {formatCLP(cargosIniciales.comision)}</dd></div>
        <div class="fila parte ultima cero" data-fila="cobro"><dt>Costos operacionales</dt><dd class="num">CLP 0</dd></div>
        <div class="fila" data-fila="subtotal"><dt data-c-sub-rot>Monto a convertir</dt><dd class="num" data-c-sub>CLP {formatCLP(cargosIniciales.aConvertir)}</dd></div>
        <div class="fila" data-fila="precio"><dt>Precio referencial</dt><dd class="num" data-f-tasa>{precioLegible(price.rate, DEFAULT_CURRENCY)}</dd></div>
        <div class="fila llega" data-fila="llega"><dt data-f-get-rot>Llega aprox. a {DEFAULT_DESTINO}</dt><dd class="num" data-f-get>{DEFAULT_CURRENCY} {formatForeign(initialGet, currencyInfo(DEFAULT_CURRENCY).decimals)}</dd></div>
      </dl>
    </div>
  </dialog>
</section>

<!--
  Barra fija móvil (Fase 1, patrón 13 · cotizador-spec §7). Lleva la cifra viva
  porque así el movimiento es información: el número te acompaña. Desde el
  2026-10-22 dice también a dónde llega: «Llega a Colombia». Arranca `hidden`,
  así que no existe para un lector de pantalla mientras la tarjeta está a la
  vista y no duplica el CTA.
-->
<div class="dock" data-dock hidden>
  <div class="dock-in">
    <span class="dock-fig">
      <span class="dock-label"><Bandera code={banderaDeDestino(DEFAULT_DESTINO) ?? 'us'} size={16} /><span data-dock-label>Llega a {DEFAULT_DESTINO}</span></span>
      <span class="dock-amount num" data-dock-amount>{formatForeign(initialGet, currencyInfo(DEFAULT_CURRENCY).decimals)}</span>
    </span>
    <a class="dock-cta" href={wa} target="_blank" rel="noopener" data-dock-cta>
      Continuar
    </a>
  </div>
</div>

<style>
  .quoter {
    /* El foco de dentro de la tarjeta es el verde oscuro, no el de la tinta.
       La tarjeta es papel sobre la banda oscura del héroe, y `.on-tinta-surface`
       pone `--focus` en `--verde`: sobre papel da 2:1, bajo el 3:1 que pide un
       indicador. Pasaba en los dos botones de intención y en el de WhatsApp. */
    --focus: var(--verde-deep);
    background: var(--papel);
    color: var(--ink);
    padding: var(--s-5);
    border-radius: var(--r-card);
  }
  .quoter.floating { box-shadow: var(--elev-card); }
  .quoter.flat {
    border-radius: var(--r-3);
    border: 1px solid var(--line);
  }

  /* ── El selector con bandera (entrega `wise-`) ─────────────────────── */
  /* ── La ficha de moneda, que es el selector (2026-10-28) ───────────────
     Era una ficha quieta junto a la etiqueta del monto, y el destino se elegía
     en un botón a lo ancho, arriba. Ahora la ficha es el botón: bandera, código
     y la flecha que dice que se abre. Se ve de 32 px y se pulsa en 44 (DS §10):
     el `::after` agranda el área sin agrandar el dibujo. */
  .selector { position: static; }
  .moneda {
    position: relative;
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    padding: 0 6px 0 5px;
    border: 1px solid transparent;
    border-radius: var(--r-1);
    background: var(--papel-2);
    font: inherit;
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: .02em;
    color: var(--ink);
    cursor: pointer;
    transition: border-color var(--m-fast) var(--m-ease),
                box-shadow var(--m-fast) var(--m-ease);
  }
  .moneda::after { content: ''; position: absolute; inset: -6px -4px; }
  .moneda:hover { border-color: var(--ink-mute); }
  .moneda:focus { outline: none; }
  .moneda:focus-visible,
  .moneda[aria-expanded='true'] {
    border-color: var(--verde-deep);
    box-shadow: 0 0 0 3px rgba(10, 114, 80, 0.18);
  }
  .moneda-actual { display: inline-flex; align-items: center; gap: 6px; }
  .moneda .selector-codigo { font-size: inherit; font-weight: 600; color: var(--ink); }
  /* La flecha del set apunta a la derecha; girada, dice «se despliega», y de
     cabeza, «se recoge». */
  .moneda :global(.selector-ico) {
    flex: none;
    color: var(--ink-mute);
    transform: rotate(90deg);
    transition: transform var(--m-fast) var(--m-ease);
  }
  .moneda[aria-expanded='true'] :global(.selector-ico) { transform: rotate(-90deg); }

  /* El panel cuelga del botón y tapa lo que hay debajo dentro de la tarjeta.
     Lleva la sombra de los menús, `--elev-pop`, que el DS reserva para esto. */
  .selector-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 6px);
    z-index: 20;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--r-2);
    box-shadow: var(--elev-pop);
    padding: var(--s-2);
  }
  .selector-panel[hidden] { display: none; }
  /* Abre hacia donde cabe (lo decide la isla, `caber`): el héroe esconde lo
     que se sale, y la ficha de abajo, abierta hacia abajo, se cortaba. */
  .selector-panel.arriba { top: auto; bottom: calc(100% + 6px); }
  .selector-buscar {
    display: block;
    width: 100%;
    min-height: 44px;
    padding: 0 var(--s-3);
    border: 1px solid var(--line);
    border-radius: var(--r-1);
    background: var(--papel);
    font: inherit;
    font-size: var(--t-body);
    color: var(--ink);
  }
  .selector-buscar::placeholder { color: var(--ink-mute); opacity: 1; }
  /* El mismo foco que el botón y las cajas de los montos: borde y anillo. Con
     sólo el borde, el buscador era el único campo de la tarjeta sin anillo. */
  .selector-buscar:focus {
    outline: none;
    border-color: var(--verde-deep);
    box-shadow: 0 0 0 3px rgba(10, 114, 80, 0.18);
  }
  .selector-lista {
    list-style: none;
    margin: var(--s-2) 0 0;
    padding: 0;
    max-height: 288px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .selector-op {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-height: 44px;
    padding: 0 var(--s-3);
    border-radius: var(--r-1);
    cursor: pointer;
  }
  .selector-op[hidden] { display: none; }
  .op-nombre { flex: 1; min-width: 0; font-size: var(--t-body-sm); font-weight: 600; color: var(--ink); }
  .op-codigo { font-size: var(--t-label); color: var(--ink-mute); }
  /* La activa —la que eligen Intro o un clic— va en papel-2 y con un borde a
     la izquierda; la elegida, con el verde oscuro en el código y un punto. */
  .selector-op:hover,
  .selector-op.activa { background: var(--papel-2); }
  .selector-op.activa { box-shadow: inset 3px 0 0 var(--ink-mute); }
  .selector-op[aria-selected='true'] .op-codigo { color: var(--verde-deep); font-weight: 600; }
  .selector-op[aria-selected='true']::after {
    content: '';
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 4px solid var(--verde-deep);
  }
  .selector-vacio { padding: var(--s-3); font-size: var(--t-body-sm); color: var(--ink-mute); }
  /* Lo que cambia de lado —la primera divisa arriba, Chile abajo— va tras un
     filete: es la otra operación. */
  .selector-op.op-otra { position: relative; margin-top: 9px; }
  .selector-op.op-otra::before {
    content: '';
    position: absolute;
    left: var(--s-3);
    right: var(--s-3);
    top: -5px;
    border-top: 1px solid var(--line);
  }

  /* ── Los montos y el tramo ──────────────────────────────────────────── */
  .monto {
    position: relative;
    border: 1px solid var(--line);
    border-radius: var(--r-2);
    background: #fff;
    padding: var(--s-2) var(--s-3) var(--s-2);
    cursor: text;
    transition: border-color var(--m-fast) var(--m-ease),
                box-shadow var(--m-fast) var(--m-ease);
  }
  /* El borde de foco es un indicador de interfaz: necesita 3:1 contra el blanco
     del campo. verde-deep da 4.9:1; el verde de marca sólo 1.9:1. El anillo es
     `--verde-deep` al 18%, a mano porque `color-mix()` está por debajo del
     `cssTarget` del proyecto. */
  /* Con la ficha dentro de la caja, `:focus-within` encendía el anillo de la
     caja cuando el foco estaba en la ficha o en su buscador: dos anillos. La
     clase la pone la isla cuando el foco está en la cifra (`:has()` está por
     encima del `cssTarget` del proyecto). */
  .monto.is-foco {
    border-color: var(--verde-deep);
    box-shadow: 0 0 0 3px rgba(10, 114, 80, 0.18);
  }
  /* Fuera de rango se marca la caja de los PESOS, que es donde vive el mínimo:
     la que envías en un envío, la que recibes de vuelta a pesos. Antes se
     ponían rojas las dos, y la que llega no tenía nada mal. */
  .monto.invalid { border-color: var(--baja); }

  .monto-cabeza {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
  }
  .monto-label {
    display: block;
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    color: var(--ink-mute);
    line-height: 1.3;
  }
  .amount {
    display: block;
    min-width: 0;
    width: 100%;
    border: 0;
    background: transparent;
    padding: 2px 0 var(--s-1);
    font-size: var(--t-dato-m);
    font-weight: 500;
    line-height: 1.15;
    color: var(--ink);
  }
  .amount:focus { outline: none; }
  .monto-llega .amount { font-weight: 600; }
  /* Una cifra que no cabe baja un escalón en vez de cortarse, y si tampoco
     cabe, otro: «1.086.956.520,65» pesos argentinos a 320 px, o cualquier monto
     con el espaciado de WCAG 1.4.12. La clase la pone la isla midiendo la
     cifra, no contando dígitos (ver `ajustar`). */
  .amount.largo { font-size: var(--t-h3); }
  .amount.muy-largo { font-size: var(--t-body); }
  /* El tramo: 3 px de verde de una caja a la otra, a la altura de las cifras.
     El punto (`.tramo-valor::before`) es un borde y no un fondo, para que en
     colores forzados siga ahí. */
  /* El tramo cae en el eje de las cifras: 12 px de relleno de la caja más su
     borde, así que baja desde debajo del primer dígito de lo que envías hasta
     la etiqueta de lo que llega. */
  .tramo {
    position: relative;
    padding: var(--s-3) 0 var(--s-3) 40px;
  }
  .tramo::before {
    content: '';
    position: absolute;
    left: 13px;
    top: 0;
    bottom: 0;
    border-left: 3px solid var(--verde-deep);
  }
  /* El precio y, a su derecha, el botón que da vuelta la operación: está donde
     ocurre la conversión. Redondo y de 44 px, en el blanco de las cajas. */
  .tramo-fila { display: flex; align-items: center; gap: var(--s-3); }
  .tramo-precio {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .vuelta {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: #fff;
    color: var(--ink);
    cursor: pointer;
    transition: border-color var(--m-fast) var(--m-ease);
  }
  .vuelta:hover { border-color: var(--ink-mute); }
  .vuelta:focus { outline: none; }
  .vuelta:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .tramo-rot {
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    color: var(--ink-mute);
    line-height: 1.3;
  }
  .tramo-valor {
    position: relative;
    font-size: var(--t-h3-m);
    font-weight: 600;
    line-height: 1.25;
    color: var(--ink);
  }
  /* Con el botón de vuelta al lado, «1 USD = 919,70 CLP» no cabía en una línea
     a 320–360 px ni en la columna del héroe a 900–940: se partía en «1 USD =»
     y «919,70 CLP». Como las cifras de los montos, baja un escalón, y otro, y
     si ni así cabe —el espaciado de WCAG 1.4.12— se parte (`ajustar`). No es
     `nowrap`: un texto que no se parte empuja el ancho mínimo de la tarjeta, y
     a 320 la tarjeta se salía 9 px del héroe, que la cortaba. */
  .tramo-valor.largo { font-size: var(--t-body); }
  .tramo-valor.muy-largo { font-size: var(--t-body-sm); }
  /* El punto va colgado de la cifra del precio y no de la caja del tramo: así
     cae a la altura de esa línea sea cual sea el tamaño de letra. Su centro
     es el del tramo: 40 − 13 − 1,5 + 6,5 = 32 px a la izquierda del texto. */
  .tramo-valor::before {
    content: '';
    position: absolute;
    left: -32px;
    top: 50%;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    border: 6.5px solid var(--verde-deep);
    box-shadow: 0 0 0 3px var(--papel);
    transform: translateY(-50%);
  }
  /* ── «Sin comisiones ocultas.» y, a su lado, «Ver detalle» (2026-10-28, b)
     La afirmación y la manera de comprobarla, en una línea. El botón mide 44 px
     de alto (DS §10) y no agranda el tramo: el renglón ya los tenía. Si no
     caben juntos —320 px con el espaciado de 1.4.12—, el botón baja. */
  .tramo-pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    column-gap: var(--s-3);
    margin: var(--s-1) 0 calc(-1 * var(--s-2));
  }
  .tramo-nota {
    font-size: var(--t-label);
    line-height: 1.45;
    color: var(--ink-mute);
  }
  .tramo-nota strong { color: var(--ink); font-weight: 600; }
  .ver-detalle {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    min-height: 44px;
    margin-left: auto;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: var(--t-label);
    font-weight: 600;
    color: var(--verde-deep);
    cursor: pointer;
  }
  .ver-detalle:hover { text-decoration: underline; }
  .ver-detalle:focus { outline: none; }
  .ver-detalle:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; border-radius: var(--r-1); }
  .ver-detalle :global(.ver-ico) { transform: rotate(90deg); }

  /* ── El detalle completo, en una pestaña (2026-10-28, b) ─────────────────
     El esquema del de Global66, en la tarjeta del sitio: papel, radio de
     tarjeta y la sombra de lo que se abre encima (`--elev-pop`). Centrado
     también en el teléfono, como allá, con 16 px a cada lado. Las filas se
     separan con `--line`, que no significa nada: el punteado, que en el DS es
     un límite (§6.2), no se usa. Los tres cobros van seguidos, sin raya entre
     ellos. **Todas las cifras van a la misma medida y el mismo peso**, alineadas
     a la derecha: la mono hace que las cifras caigan en columna. Sólo lo que
     llega va más fuerte, en peso y no en tamaño. */
  .detalle {
    width: min(440px, calc(100vw - 32px));
    max-width: none;
    max-height: calc(100vh - 32px);
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: var(--r-card);
    background: var(--papel);
    color: var(--ink);
    box-shadow: var(--elev-pop);
    overflow: auto;
  }
  .detalle:not([open]) { display: none; }
  /* La página de atrás se queda quieta mientras el detalle está abierto. */
  :global(html.sin-desplazar) { overflow: hidden; }
  .detalle::backdrop { background: rgba(11, 19, 32, 0.6); }
  /* Sin `showModal` (Safari 14, que está en el `cssTarget`): fija y sin fondo. */
  .detalle.sin-modal { position: fixed; z-index: 40; inset: 0; }
  .detalle-in { padding: var(--s-5); }
  .detalle-cabeza {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    margin-bottom: var(--s-3);
  }
  .detalle-titulo { margin: 0; font-size: var(--t-h3); font-weight: 700; line-height: 1.25; }
  .detalle-cerrar {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    color: var(--ink-mute);
    cursor: pointer;
  }
  .detalle-cruz {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--ink-mute);
    border-radius: 50%;
    color: var(--ink);
  }
  .detalle-cerrar:hover { color: var(--ink); }
  .detalle-cerrar:hover .detalle-cruz { border-color: var(--ink); }
  .detalle-cerrar:focus { outline: none; }
  .detalle-cerrar:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; border-radius: var(--r-1); }
  .detalle-lista { margin: 0; }
  .detalle-lista .fila {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    column-gap: var(--s-3);
    padding: var(--s-2) 0;
    font-size: var(--t-body-sm);
    line-height: 1.45;
    font-weight: 600;
  }
  .detalle-lista .fila { border-bottom: 1px solid var(--line); }
  /* Los tres cobros se leen como un bloque: la raya va al final. */
  .detalle-lista .parte:not(.ultima) { border-bottom: 0; padding-bottom: 0; }
  .detalle-lista dd {
    margin: 0 0 0 auto;
    white-space: nowrap;
    text-align: right;
    font-size: var(--t-body-sm);
    font-weight: 600;
  }
  .detalle-lista .pct { font-size: inherit; font-weight: 600; white-space: nowrap; }
  .detalle-lista .cero dd { color: var(--verde-deep); }
  .detalle-lista .llega { border-bottom: 0; }
  .detalle-lista .llega dd { font-weight: 700; }

  /* M2 · el dato acusa que cambió. 160ms, sólo sobre el valor nuevo. No es un
     conteo desde cero: eso mostraría precios falsos. NO al teclear: mientras
     escribes, la cifra tiene que seguirte sin latencia. */
  .tramo-valor.is-set,
  .amount.is-set { animation: settle 160ms var(--m-ease) both; }
  @keyframes settle {
    from { opacity: 0; transform: translateY(2px); }
    to   { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tramo-valor.is-set,
    .amount.is-set { animation: none; }
  }

  .alert {
    font-size: var(--t-body-sm);
    line-height: 1.45;
    color: var(--ink);
    background: var(--error-bg);
    border: 1px solid var(--error-line);
    border-radius: var(--r-2);
    padding: var(--s-3);
    margin: var(--s-3) 0 0;
  }

  /* El riel se explica, pero en el peso que le corresponde: no es el titular */
  .rail {
    font-size: var(--t-label);
    line-height: 1.45;
    color: var(--ink-mute);
    margin: var(--s-4) 0;
  }
  .rail strong { color: var(--ink); font-weight: 600; }

  .cta {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: var(--verde);
    color: var(--on-verde);
    font-size: var(--t-body);
    font-weight: 700;
    padding: var(--s-4);
    border-radius: var(--r-2);
    text-decoration: none;
    transition: background-color var(--m-fast) var(--m-ease);
  }
  .cta:hover { background: var(--verde-hi); }

  .secondary {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: var(--s-2);
    min-height: 44px;
    font-size: var(--t-body-sm);
    font-weight: 500;
    color: var(--verde-deep);
    text-decoration: none;
  }
  .secondary:hover { text-decoration: underline; }

  /* La barra se ancla al borde inferior. Su eje de entrada es ese borde, no la
     diagonal de la marca: no es contenido que entra en la página, es un
     elemento acoplado que asoma desde donde vive. Misma duración y curva. */
  .dock {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 30;
    background: var(--tinta);
    border-top: 1px solid rgba(237, 242, 239, 0.14);
    padding: var(--s-3) var(--pad-section-m);
    padding-bottom: max(var(--s-3), env(safe-area-inset-bottom));
    transform: translateY(100%);
    transition: transform var(--m-base) var(--m-ease);
  }
  .dock.is-up { transform: none; }
  .dock-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    max-width: var(--container);
    margin: 0 auto;
  }
  .dock-fig { display: flex; flex-direction: column; min-width: 0; }
  .dock-label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: var(--t-dato-sm);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    color: var(--on-tinta-mute);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .dock-amount {
    font-size: var(--t-h3-m);
    font-weight: 500;
    color: var(--on-tinta);
    line-height: 1.2;
    white-space: nowrap;
  }
  /* M2 también acá: la cifra acusa que cambió mientras te acompaña. */
  .dock-amount.is-set { animation: settle 160ms var(--m-ease) both; }
  .dock-cta {
    flex: none;
    display: flex;
    align-items: center;
    background: var(--verde);
    color: var(--on-verde);
    font-size: var(--t-body-sm);
    font-weight: 700;
    padding: 0 var(--s-5);
    min-height: 44px;
    border-radius: var(--r-2);
    text-decoration: none;
    transition: background-color var(--m-fast) var(--m-ease);
  }
  .dock-cta:hover { background: var(--verde-hi); }
  @media (prefers-reduced-motion: reduce) {
    .dock { transition: none; }
    .dock-amount.is-set { animation: none; }
  }

  /* Bajo 360 px la tarjeta gana 16 px de ancho útil: con 24 de relleno, la
     cifra de partida no cabía en su caja con el espaciado de WCAG 1.4.12. */
  @media (max-width: 359px) {
    .quoter { padding: var(--s-4); }
  }

  @media (min-width: 900px) {
    /* En escritorio el cotizador nunca se pierde de vista: la barra no aplica. */
    .dock { display: none; }
    .amount { font-size: var(--t-dato); }
    .amount.largo { font-size: var(--t-dato-m); }
    .amount.muy-largo { font-size: var(--t-h3); }
    .tramo-valor { font-size: var(--t-h3); }
  }

  /* En colores forzados el sistema pinta los bordes y quita los fondos: el
     tramo y el punto ya son bordes, así que siguen. La ficha de la moneda y el
     interruptor elegido pierden su fondo y necesitan un borde que los diga. */
  @media (forced-colors: active) {
    .selector-panel { border: 1px solid CanvasText; }
    .selector-op.activa { outline: 2px solid Highlight; outline-offset: -2px; }
    .selector-op[aria-selected='true']::after { border-color: Highlight; }
    .moneda { border: 1px solid CanvasText; }
    .detalle { border: 1px solid CanvasText; }
    /* El botón de WhatsApp es un relleno, y el relleno se va: sin borde quedaba
       como un enlace suelto. Pasaba también antes del rediseño. */
    .cta { border: 1px solid LinkText; }
    /* El de la barra, igual: sin el borde quedaba el texto «Ir al chat» solo
       (2026-10-24). */
    .dock-cta { border: 1px solid LinkText; }
    .tramo::before, .tramo-valor::before { border-color: Highlight; }
    .tramo-valor::before { box-shadow: none; }
  }
</style>

<script>
  import { formatCLP, formatForeign, formatComision, parseAmount } from '../lib/pricing/format.ts';
  import {
    buildQuote,
    cargosDe,
    clpAmount,
    currenciesFor,
    formatAmount,
    invertir,
    precioLegible,
    whatsappUrl,
  } from '../lib/pricing/quote.ts';
  import type { Currency, Intent } from '../lib/pricing/types.ts';
  import type { TarifaCliente, TarifaIsla } from '../lib/pricing/tarifario.ts';
  import { currencyInfo, type IslandCurrency } from '../lib/pricing/currencies.ts';

  const root = document.querySelector<HTMLElement>('#cotizador');
  if (root) {
    const divisas: IslandCurrency[] = JSON.parse(root.dataset.divisas ?? '[]');
    const tarifas: Record<string, TarifaIsla> = JSON.parse(root.dataset.tarifas ?? '{}');
    const tarifaPesos: TarifaIsla = JSON.parse(root.dataset.tarifaPesos ?? '{"e":0,"p":[0,0,0],"m":true}');
    const banderas = document.querySelector<HTMLTemplateElement>('#cot-banderas');

    /** Una bandera de 16 px, copiada de la plantilla que dibujó el servidor. */
    const bandera = (codigo: string | undefined): Node | null =>
      (codigo && banderas?.content.querySelector(`[data-bandera="${codigo}"]`)?.cloneNode(true)) || null;
    const ponerBandera = (caja: Element | null | undefined, codigo: string | undefined): void => {
      const nueva = bandera(codigo);
      const vieja = caja?.querySelector('[data-bandera]');
      if (nueva && vieja) vieja.replaceWith(nueva);
    };

    /** Sin tildes ni mayúsculas: «peru» encuentra Perú y «japon», Japón. */
    const normal = (t: string): string =>
      t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();

    /**
     * El selector con bandera (entrega `wise-`). Un botón que abre un panel con
     * un buscador y una lista. El buscador es el `combobox` y lleva la lista
     * con `aria-activedescendant`, así que el foco no sale nunca de él.
     */
    const crearSelector = (cont: HTMLElement | null, alElegir: (op: HTMLElement) => void) => {
      const boton = cont?.querySelector<HTMLButtonElement>('[data-boton]');
      const panel = cont?.querySelector<HTMLElement>('[data-panel]');
      const buscar = cont?.querySelector<HTMLInputElement>('[data-buscar]');
      const lista = cont?.querySelector<HTMLElement>('[data-lista]');
      const vacio = cont?.querySelector<HTMLElement>('[data-vacio]');
      const estado = cont?.querySelector<HTMLElement>('[data-estado]');
      let espera = 0;
      const actual = cont?.querySelector<HTMLElement>('[data-actual]');
      const ops = [...(lista?.querySelectorAll<HTMLElement>('[role="option"]') ?? [])];
      let activa = -1;
      const visibles = () => ops.filter((o) => !o.hidden);
      const elegida = () => ops.find((o) => o.getAttribute('aria-selected') === 'true') ?? ops[0];

      const activar = (op: HTMLElement | undefined): void => {
        ops.forEach((o) => o.classList.remove('activa'));
        if (!op || !buscar) { buscar?.removeAttribute('aria-activedescendant'); activa = -1; return; }
        op.classList.add('activa');
        buscar.setAttribute('aria-activedescendant', op.id);
        activa = visibles().indexOf(op);
        op.scrollIntoView({ block: 'nearest' });
      };
      const filtrar = (): void => {
        const q = normal(buscar?.value ?? '');
        ops.forEach((o) => { o.hidden = q !== '' && !normal(o.dataset.texto ?? '').includes(q); });
        if (vacio) vacio.hidden = visibles().length > 0;
        // La activa es la que EMPIEZA por lo escrito, si la hay: «pe» encuentra
        // cuatro (Perú y tres pesos), e Intro debe elegir Perú.
        const v = visibles();
        activar(v.find((o) => normal(o.dataset.valor ?? '').startsWith(q) || normal(o.querySelector('.op-nombre')?.textContent ?? '').startsWith(q)) ?? v[0]);
        /* Cuántas quedan, para quien no ve la lista (WCAG 4.1.3). Al dejar de
           escribir y no en cada tecla, como la calculadora del spread; y nada
           al abrir, que es cuando el lector ya lee la opción activa. Sin esto,
           «Ningún destino coincide.» sólo se veía. */
        window.clearTimeout(espera);
        if (!estado) return;
        if (q === '') { estado.textContent = ''; return; }
        espera = window.setTimeout(() => {
          const d = estado.dataset;
          estado.textContent = v.length === 0 ? d.ninguno ?? '' : `${v.length} ${v.length === 1 ? d.uno : d.varios}`;
        }, 500);
      };
      /**
       * El panel abre hacia abajo, y hacia arriba si abajo no cabe y arriba hay
       * más sitio. «Caber» es dentro del primer contenedor que esconde lo que
       * se sale —el héroe—, no de la pantalla: la pantalla se puede desplazar,
       * el héroe no deja ver lo que corta. Si tampoco cabe así, la lista se
       * acorta, con un piso de tres opciones.
       */
      const caber = (): void => {
        if (!panel || !lista) return;
        panel.classList.remove('arriba');
        lista.style.maxHeight = '';
        let corte: HTMLElement | null = cont?.parentElement ?? null;
        while (corte && getComputedStyle(corte).overflow === 'visible') corte = corte.parentElement;
        const borde = corte ? corte.getBoundingClientRect() : { top: 0, bottom: window.innerHeight };
        const caja = (panel.offsetParent ?? cont)?.getBoundingClientRect();
        if (!caja) return;
        const alto = panel.offsetHeight;
        const abajo = borde.bottom - caja.bottom - 6;
        const arriba = caja.top - borde.top - 6;
        const sube = abajo < alto && arriba > abajo;
        panel.classList.toggle('arriba', sube);
        const sitio = sube ? arriba : abajo;
        if (alto > sitio) lista.style.maxHeight = `${Math.max(132, lista.offsetHeight - (alto - sitio))}px`;
      };
      const abrir = (): void => {
        if (!panel || !boton || !buscar) return;
        panel.hidden = false;
        caber();
        boton.setAttribute('aria-expanded', 'true');
        buscar.value = '';
        filtrar();
        activar(elegida());
        buscar.focus();
      };
      const cerrar = (devolverFoco: boolean): void => {
        if (!panel || panel.hidden) return;
        panel.hidden = true;
        boton?.setAttribute('aria-expanded', 'false');
        if (devolverFoco) boton?.focus();
      };
      /** Marca una opción como elegida y copia su bandera, su nombre y su código al botón. */
      const marcar = (op: HTMLElement): void => {
        ops.forEach((o) => o.setAttribute('aria-selected', o === op ? 'true' : 'false'));
        // La de la ficha es la de 16 px de la plantilla, no la de 24 de la lista.
        const flag = bandera(op.querySelector<HTMLElement>('[data-bandera]')?.dataset.bandera);
        const nombre = op.querySelector('.op-nombre')?.textContent ?? '';
        const codigo = op.querySelector('.op-codigo')?.textContent ?? '';
        const vieja = actual?.querySelector('[data-bandera]');
        if (flag && vieja) vieja.replaceWith(flag);
        const n = actual?.querySelector('.selector-nombre');
        const c = actual?.querySelector('.selector-codigo');
        if (n) n.textContent = nombre;
        if (c) c.textContent = codigo;
      };
      const elegir = (op: HTMLElement | undefined): void => {
        if (!op) return;
        marcar(op);
        cerrar(true);
        alElegir(op);
      };

      boton?.addEventListener('click', () => (panel?.hidden ? abrir() : cerrar(true)));
      buscar?.addEventListener('input', filtrar);
      buscar?.addEventListener('keydown', (e) => {
        const v = visibles();
        if (e.key === 'ArrowDown') { e.preventDefault(); activar(v[Math.min(activa + 1, v.length - 1)]); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); activar(v[Math.max(activa - 1, 0)]); }
        else if (e.key === 'Home') { e.preventDefault(); activar(v[0]); }
        else if (e.key === 'End') { e.preventDefault(); activar(v[v.length - 1]); }
        else if (e.key === 'Enter') { e.preventDefault(); elegir(v[activa]); }
        else if (e.key === 'Escape') { e.preventDefault(); cerrar(true); }
        else if (e.key === 'Tab') cerrar(false);
      });
      // Con el ratón: `mousedown` evita que el buscador pierda el foco antes del clic.
      lista?.addEventListener('mousedown', (e) => e.preventDefault());
      lista?.addEventListener('click', (e) => {
        const op = (e.target as HTMLElement).closest<HTMLElement>('[role="option"]');
        if (op) elegir(op);
      });
      lista?.addEventListener('mousemove', (e) => {
        const op = (e.target as HTMLElement).closest<HTMLElement>('[role="option"]');
        if (op && !op.classList.contains('activa')) activar(op);
      });
      // El foco o un clic que salen del selector lo cierran.
      cont?.addEventListener('focusout', (e) => {
        if (!cont.contains(e.relatedTarget as Node | null)) cerrar(false);
      });
      document.addEventListener('pointerdown', (e) => {
        if (cont && !cont.contains(e.target as Node)) cerrar(false);
      });

      return {
        valor: (): string | undefined => elegida()?.dataset.valor,
        codigo: (): string | undefined => elegida()?.dataset.c,
        bandera: (): string | undefined =>
          elegida()?.querySelector<HTMLElement>('[data-bandera]')?.dataset.bandera,
        /** Elige sin avisar: para sincronizar un selector con el otro. */
        poner: (pred: (op: HTMLElement) => boolean): boolean => {
          const op = ops.find(pred);
          if (op) marcar(op);
          return !!op;
        },
      };
    };

    /** La divisa del destino elegido: viaja en la opción, `data-c`. */
    const divisaDe = (codigo: string | undefined): IslandCurrency =>
      divisas.find((d) => d.c === codigo) ??
      divisas[0] ?? { c: 'USD', r: Number(root.dataset.rate), n: 'dólar' };

    // Se crean más abajo, cuando ya existen las funciones a las que avisan.
    let selGive: ReturnType<typeof crearSelector>;
    let selGet: ReturnType<typeof crearSelector>;
    const opsGet = [...root.querySelectorAll<HTMLElement>('[data-selector="get"] [role="option"]')];
    /** El destino elegido abajo. Se recuerda mientras se pasa a pesos, para volver a él. */
    let destino: string = opsGet.find((o) => o.getAttribute('aria-selected') === 'true')?.dataset.valor ?? '';
    const codigoDe = (d: string): string | undefined => opsGet.find((o) => o.dataset.valor === d)?.dataset.c;
    /**
     * El destino al que se vuelve con una divisa: el último elegido si llega en
     * ella; si no, uno que la reciba en su moneda. Con el dólar en tres
     * destinos, el primero por orden alfabético sería China, que no llega en
     * la suya: de dólares se vuelve a Estados Unidos.
     */
    const destinoPara = (codigo: string): string => {
      if (codigoDe(destino) === codigo) return destino;
      const de = opsGet.filter((o) => o.dataset.c === codigo);
      return (de.find((o) => tarifas[o.dataset.valor ?? '']?.m === true) ?? de[0])?.dataset.valor ?? destino;
    };

    let divisa: IslandCurrency = divisaDe(codigoDe(destino));
    let rate = divisa.r;
    const minPay = Number(root.dataset.min);
    const maxRaw = Number(root.dataset.max);
    const maxPay = Number.isFinite(maxRaw) && maxRaw > 0 ? maxRaw : undefined;
    const source = root.dataset.source ?? '';
    const waNumber = root.dataset.wa!;

    const giveInput = root.querySelector<HTMLInputElement>('#give-input')!;
    const getInput = root.querySelector<HTMLInputElement>('#get-input')!;
    const giveLabel = root.querySelector<HTMLElement>('[data-label-give]')!;
    const getLabel = root.querySelector<HTMLElement>('[data-label-get]')!;
    const giveCur = root.querySelector<HTMLElement>('[data-cur-give]')!;
    const getCur = root.querySelector<HTMLElement>('[data-cur-get]')!;
    const giveBox = giveInput.closest<HTMLElement>('.monto')!;
    const getBox = getInput.closest<HTMLElement>('.monto')!;
    const alertEl = root.querySelector<HTMLElement>('[data-alert]')!;
    const cta = root.querySelector<HTMLAnchorElement>('[data-cta]')!;
    const rateEl = root.querySelector<HTMLElement>('[data-rate-display]');
    const dock = document.querySelector<HTMLElement>('[data-dock]');
    const dockLabel = dock?.querySelector<HTMLElement>('[data-dock-label]');
    const dockAmount = dock?.querySelector<HTMLElement>('[data-dock-amount]');
    const dockCta = dock?.querySelector<HTMLAnchorElement>('[data-dock-cta]');
    const botonVuelta = root.querySelector<HTMLButtonElement>('[data-vuelta]');
    const sentidoEl = root.querySelector<HTMLElement>('[data-sentido]');
    const giveBoton = root.querySelector<HTMLElement>('#give-boton');
    const getBoton = root.querySelector<HTMLElement>('#get-boton');
    // El detalle completo y sus filas, que se reordenan de vuelta a pesos.
    const detalle = root.querySelector<HTMLDialogElement>('[data-detalle]');
    const abrirDetalle = root.querySelector<HTMLButtonElement>('[data-abrir-detalle]');
    const fila = (n: string): HTMLElement | null => root.querySelector<HTMLElement>(`[data-fila="${n}"]`);
    const [filaPone, filaSub, filaPrecio] = ['pone', 'subtotal', 'precio'].map(fila);
    const filasCobro = [...root.querySelectorAll<HTMLElement>('[data-fila="cobro"]')];
    const fGiveRot = root.querySelector<HTMLElement>('[data-f-give-rot]');
    const fGive = root.querySelector<HTMLElement>('[data-f-give]');
    const fGetRot = root.querySelector<HTMLElement>('[data-f-get-rot]');
    const fGet = root.querySelector<HTMLElement>('[data-f-get]');
    const fTasa = root.querySelector<HTMLElement>('[data-f-tasa]');
    const cEnvio = root.querySelector<HTMLElement>('[data-c-envio]');
    const cPct = root.querySelector<HTMLElement>('[data-c-pct]');
    const cComision = root.querySelector<HTMLElement>('[data-c-comision]');
    const cSubRot = root.querySelector<HTMLElement>('[data-c-sub-rot]');
    const cSub = root.querySelector<HTMLElement>('[data-c-sub]');
    const railEl = root.querySelector<HTMLElement>('[data-rail]');

    /* Los decimales los trae la divisa elegida: «1.250,00 yenes» escribiría una
       fracción que esa moneda no usa, y en dinero eso se lee como precisión
       falsa. El peso chileno nunca lleva decimales. */
    const fmt = (value: number, currency: Currency): string =>
      currency === 'CLP' ? formatCLP(value) : formatForeign(value, currencyInfo(divisa.c).decimals);

    const precio = () =>
      ({ rate, currency: divisa.c, pair: `${divisa.c}/CLP` as const, source, asOf: new Date() });

    let intent: Intent = 'to_foreign';
    let giveAmount = parseAmount(giveInput.value);
    let lastRate = '';

    /** La tarifa que aplica: la del destino elegido, o la de la vuelta a pesos. */
    const tarifaIsla = (): TarifaIsla =>
      intent === 'to_clp' ? tarifaPesos : tarifas[destino] ?? tarifaPesos;
    const tarifa = (): TarifaCliente => {
      const t = tarifaIsla();
      return { envio: t.e, comision: t.p };
    };

    // La pantalla y el mensaje calculan con la MISMA función. Antes el
    // componente tenía su propia aritmética, sin la guarda de tasa del módulo:
    // con una tasa corrupta la pantalla habría mostrado Infinity y el mensaje 0.
    // Desde el 2026-10-27 esa función descuenta además la tarifa.
    const received = (): number => cargosDe(intent, giveAmount, rate, tarifa()).llega;

    /** Una cifra en pesos de una línea: «CLP 18.995», y «− CLP 18.995» si se
        descuenta. Con su código y no con «$»: en el cotizador hay una divisa
        concreta, y ahí los pesos son «CLP» (DS §5). */
    const pesos = (v: number): string => `CLP ${formatCLP(v)}`;
    /** Una cifra con su código delante, «USD 2.153,43», como los pesos. */
    const cifra = (v: number, c: Currency): string => `${c} ${fmt(v, c)}`;

    /**
     * El detalle completo. Las cifras van sin signo, como en un recibo: los
     * rótulos ya dicen que son cobros. De vuelta a pesos las filas
     * siguen a la cuenta, que también se da vuelta: lo que conviertes, el
     * precio, los pesos que salen, lo que cobramos y lo que recibes. Se mueven
     * los nodos, no se reordenan con CSS, para que el lector de pantalla lea en
     * el mismo orden que se ve (WCAG 1.3.2); con el diálogo cerrado, nada que
     * tenga el foco se mueve.
     */
    const pintarCargos = (envio: boolean): void => {
      const { cargos } = cargosDe(intent, giveAmount, rate, tarifa());
      if (cEnvio) cEnvio.textContent = pesos(cargos.envio);
      if (cPct) cPct.textContent = formatComision(cargos.comisionPb);
      if (cComision) cComision.textContent = pesos(cargos.comision);
      if (cSubRot) cSubRot.textContent = envio ? 'Monto a convertir' : 'En pesos';
      if (cSub) cSub.textContent = pesos(cargos.aConvertir);
      if (filaPone && filaSub && filaPrecio) {
        if (envio) filaPone.after(...filasCobro, filaSub, filaPrecio);
        else filaPone.after(filaPrecio, filaSub, ...filasCobro);
      }
    };

    /**
     * La nota del riel. La de siempre, salvo en dos casos: un destino que no
     * llega en su moneda (China, en dólares) y la vuelta a pesos.
     * REQUIERE VALIDACIÓN DE COMPLIANCE — igual que la del servidor.
     */
    const pintarRiel = (envio: boolean): void => {
      if (!railEl) return;
      const fuerte = document.createElement('strong');
      let antes = 'Llega ';
      let despues = '. El plazo te lo confirma tu ejecutivo.';
      if (!envio) {
        antes = 'Recibes ';
        fuerte.textContent = 'en pesos';
      } else {
        // Desde el 2026-10-28 nombra el destino: la ficha enseña sólo el código.
        fuerte.textContent = `a ${destino}, en ${currencyInfo(divisa.c).plural}`;
        if (!tarifaIsla().m) despues = ', no en la moneda local. El plazo te lo confirma tu ejecutivo.';
      }
      railEl.replaceChildren(antes, fuerte, despues);
    };

    /** M2 sobre un elemento: reinicia la animación leyendo offsetWidth. Nunca
        sobre el campo enfocado: animar lo que alguien escribe es pelear con su
        cursor. */
    const settle = (el: HTMLElement): void => {
      if (document.activeElement === el) return;
      el.classList.remove('is-set');
      void el.offsetWidth;
      el.classList.add('is-set');
    };

    /** Una cifra que no cabe en su caja baja un escalón (`.largo`). Se mide,
        no se cuentan dígitos: lo que cabe depende del ancho, de la letra y del
        espaciado que el visitante haya puesto. */
    const ajustar = (): void => {
      for (const el of [giveInput, getInput]) {
        el.classList.remove('largo', 'muy-largo');
        if (el.scrollWidth > el.clientWidth + 1) el.classList.add('largo');
        if (el.scrollWidth > el.clientWidth + 1) el.classList.replace('largo', 'muy-largo');
      }
      // El precio, igual, pero midiendo si se partió en dos líneas.
      if (rateEl) {
        const partido = (): boolean =>
          rateEl.getBoundingClientRect().height > parseFloat(getComputedStyle(rateEl).lineHeight) * 1.5;
        rateEl.classList.remove('largo', 'muy-largo');
        if (partido()) rateEl.classList.add('largo');
        if (partido()) rateEl.classList.replace('largo', 'muy-largo');
      }
    };
    window.addEventListener('resize', ajustar, { passive: true });

    const render = (): void => {
      const { give, get } = currenciesFor(intent, divisa.c);
      const envio = intent === 'to_foreign';
      const destinoMsg = envio ? destino : undefined;
      const quote = buildQuote({
        intent,
        giveAmount,
        price: precio(),
        tarifa: tarifa(),
        minPay,
        ...(maxPay !== undefined ? { maxPay } : {}),
      });
      pintarCargos(envio);
      pintarRiel(envio);

      // Las fichas copian bandera y código de la opción elegida (`marcar`); acá
      // se les da el nombre que leen los lectores de pantalla, que el código
      // solo no dice: «USD» sirve a tres destinos.
      giveCur.textContent = give;
      getCur.textContent = get;
      const nombre = currencyInfo(divisa.c).name;
      giveBoton?.setAttribute('aria-label', envio ? 'Moneda que envías: peso chileno, CLP' : `Moneda que conviertes: ${nombre}, ${divisa.c}`);
      getBoton?.setAttribute('aria-label', envio ? `Destino: ${destino}, ${divisa.c}` : 'Recibes en: peso chileno, CLP');
      const vuelta = envio
        ? `Cambiar a pasar ${currencyInfo(divisa.c).plural} a pesos`
        : `Cambiar a enviar pesos a ${destinoPara(divisa.c)}`;
      botonVuelta?.setAttribute('aria-label', vuelta);
      botonVuelta?.setAttribute('title', vuelta);
      giveLabel.textContent = envio ? 'Envías' : 'Conviertes';
      getLabel.textContent = envio ? 'Llega aprox.' : 'Recibes aprox.';
      giveInput.inputMode = give === 'CLP' ? 'numeric' : 'decimal';
      getInput.inputMode = get === 'CLP' ? 'numeric' : 'decimal';

      // El precio y su forma son del par, no del cotizador. M2 sólo cuando
      // cambia de verdad: si se reanimara en cada tecleo sería ruido.
      const legible = precioLegible(rate, divisa.c);
      if (rateEl && legible !== lastRate) {
        lastRate = legible;
        rateEl.textContent = legible;
        settle(rateEl);
      }
      // El detalle completo, al día aunque esté cerrado: se abre ya escrito.
      if (fGiveRot) fGiveRot.textContent = envio ? 'Envías' : 'Conviertes';
      if (fGive) fGive.textContent = cifra(giveAmount, give);
      if (fGetRot) fGetRot.textContent = envio ? `Llega aprox. a ${destino}` : 'Recibes aprox.';
      if (fGet) fGet.textContent = cifra(received(), get);
      if (fTasa) fTasa.textContent = legible;

      const fuera = quote.state === 'below_min' || quote.state === 'above_max';
      giveBox.classList.toggle('invalid', fuera && give === 'CLP');
      getBox.classList.toggle('invalid', fuera && get === 'CLP');
      // Se muestra la región ANTES de escribirle. Un lector de pantalla no
      // vigila regiones ocultas: escribiendo primero, el aviso no se anunciaba.
      // «CLP 20.000» y no «20.000 CLP» desde el 2026-10-27: el código va
      // delante, como en el aviso del máximo de aquí abajo, en el desglose y en
      // el mensaje de WhatsApp. Este era el único que lo ponía detrás.
      const aviso =
        quote.state === 'below_min'
          ? `Monto mínimo: CLP ${formatCLP(minPay)}. Puedes escribirnos igual y te orientamos.`
          : quote.state === 'above_max' && maxPay !== undefined
            ? `Para montos sobre CLP ${formatCLP(maxPay)} te atiende un ejecutivo. Escríbenos.`
            : '';
      if (aviso) {
        alertEl.hidden = false;
        alertEl.textContent = aviso;
      } else {
        alertEl.textContent = '';
        alertEl.hidden = true;
      }

      ajustar();

      // El fallback de cualquier problema es WhatsApp, nunca un error seco
      const href = whatsappUrl(waNumber, quote, giveAmount, destinoMsg);
      cta.href = href;
      cta.textContent = fuera ? 'Escríbenos por WhatsApp' : 'Continuar por WhatsApp';

      // La barra refleja exactamente la tarjeta: mismo enlace, misma cifra,
      // mismo estado. Una sola verdad, dos lugares donde se ve.
      if (dock && dockLabel && dockAmount && dockCta) {
        dockCta.href = href;
        dockCta.textContent = fuera ? 'Escríbenos' : 'Continuar';
        dockLabel.textContent = fuera ? 'Fuera de rango' : envio ? `Llega a ${destino}` : 'Recibes';
        ponerBandera(dock, fuera ? undefined : envio ? selGet.bandera() : 'cl');
        const dockShown = fuera ? '—' : formatAmount(received(), get);
        if (dockAmount.textContent !== dockShown) {
          dockAmount.textContent = dockShown;
          dockAmount.classList.remove('is-set');
          void dockAmount.offsetWidth;
          dockAmount.classList.add('is-set');
        }
      }
    };

    /** Cambia de divisa conservando el monto en PESOS: el cliente piensa la
        operación en lo que pone, no en lo que recibe. */
    const usarDivisa = (codigo: string | undefined): void => {
      const clpBefore = clpAmount(intent, giveAmount, rate);
      divisa = divisaDe(codigo);
      rate = divisa.r;
      const { give, get } = currenciesFor(intent, divisa.c);
      giveAmount = give === 'CLP' ? clpBefore : rate > 0 ? clpBefore / rate : 0;
      giveInput.value = fmt(giveAmount, give);
      getInput.value = fmt(received(), get);
      settle(giveInput);
      settle(getInput);
    };

    // El campo que se edita NO se reformatea bajo el cursor (spec §3): se
    // actualiza el otro, y el propio se formatea recién al salir.
    giveInput.addEventListener('input', () => {
      giveAmount = parseAmount(giveInput.value);
      getInput.value = fmt(received(), currenciesFor(intent, divisa.c).get);
      render();
    });
    giveInput.addEventListener('blur', () => {
      giveInput.value = fmt(giveAmount, currenciesFor(intent, divisa.c).give);
      ajustar();
    });
    getInput.addEventListener('input', () => {
      const { give } = currenciesFor(intent, divisa.c);
      const target = parseAmount(getInput.value);
      // La inversa de `cargosDe`, con la misma guarda de tasa: cuánto hay que
      // poner para que llegue lo escrito, ya con la tarifa descontada.
      giveAmount = invertir(intent, target, rate, tarifa());
      giveInput.value = fmt(giveAmount, give);
      render();
    });
    getInput.addEventListener('blur', () => {
      getInput.value = fmt(received(), currenciesFor(intent, divisa.c).get);
      ajustar();
    });
    // El anillo de la caja, sólo con el foco en la cifra (ver el CSS de `.is-foco`).
    for (const el of [giveInput, getInput]) {
      el.addEventListener('focus', () => el.closest('.monto')?.classList.add('is-foco'));
      el.addEventListener('blur', () => el.closest('.monto')?.classList.remove('is-foco'));
    }

    /**
     * Cambia de sentido conservando el monto en PESOS, como hacía el
     * interruptor que había hasta el 2026-10-28. Con `codigo`, además cambia de
     * divisa. Deja las dos fichas de acuerdo: un lado es siempre el peso.
     */
    const cambiarA = (nuevo: Intent, codigo?: string): void => {
      const clpBefore = clpAmount(intent, giveAmount, rate);
      intent = nuevo;
      if (codigo) { divisa = divisaDe(codigo); rate = divisa.r; }
      if (intent === 'to_foreign') {
        destino = destinoPara(divisa.c);
        selGet.poner((o) => o.dataset.valor === destino);
        selGive.poner((o) => o.dataset.c === 'CLP');
      } else {
        selGive.poner((o) => o.dataset.c === divisa.c);
        selGet.poner((o) => o.dataset.c === 'CLP');
      }
      const { give, get } = currenciesFor(intent, divisa.c);
      giveAmount = give === 'CLP' ? clpBefore : rate > 0 ? clpBefore / rate : 0;
      giveInput.value = fmt(giveAmount, give);
      getInput.value = fmt(received(), get);
      settle(giveInput);
      settle(getInput);
      if (sentidoEl) {
        sentidoEl.textContent = intent === 'to_foreign'
          ? `Ahora envías pesos a ${destino}.`
          : `Ahora conviertes ${currencyInfo(divisa.c).plural} a pesos.`;
      }
    };

    /* La ficha de arriba: pesos, o la divisa que tienes. Elegir una divisa pasa
       a pesos; elegir pesos vuelve a enviar. */
    selGive = crearSelector(root.querySelector('[data-selector="give"]'), (op) => {
      const c = op.dataset.c ?? 'CLP';
      if (c === 'CLP') { if (intent === 'to_clp') cambiarA('to_foreign'); }
      else if (intent === 'to_foreign') cambiarA('to_clp', c);
      else usarDivisa(c);
      render();
    });
    /* La de abajo: un destino, o Chile en pesos. Elegir un destino vuelve a
       enviar; elegir Chile pasa a pesos la divisa del destino que estaba. */
    selGet = crearSelector(root.querySelector('[data-selector="get"]'), (op) => {
      const c = op.dataset.c ?? 'CLP';
      if (c === 'CLP') { if (intent === 'to_foreign') cambiarA('to_clp', divisa.c); }
      else {
        destino = op.dataset.valor ?? destino;
        if (intent === 'to_clp') cambiarA('to_foreign', c);
        else usarDivisa(c);
      }
      render();
    });
    botonVuelta?.addEventListener('click', () => {
      cambiarA(intent === 'to_foreign' ? 'to_clp' : 'to_foreign');
      render();
    });

    /* El detalle completo. `showModal` atrapa el foco, Escape lo cierra y el
       foco vuelve a «Ver detalle». Un clic en el fondo cierra, como en
       Global66: el fondo es el propio `dialog`, porque el contenido va en
       `.detalle-in`. Mientras está abierto, la página de atrás no se desplaza.
       Sin `showModal` (Safari 14), se abre fijo y sin fondo. */
    if (detalle && abrirDetalle) {
      const cerrarDetalle = (): void => {
        if (typeof detalle.close === 'function') detalle.close();
        else { detalle.removeAttribute('open'); detalle.classList.remove('sin-modal'); abrirDetalle.focus(); }
        document.documentElement.classList.remove('sin-desplazar');
      };
      abrirDetalle.addEventListener('click', () => {
        document.documentElement.classList.add('sin-desplazar');
        if (typeof detalle.showModal === 'function') detalle.showModal();
        else {
          // Sin el diálogo nativo, el foco y Escape se ponen a mano.
          detalle.classList.add('sin-modal');
          detalle.setAttribute('open', '');
          detalle.querySelector<HTMLElement>('[data-cerrar-detalle]')?.focus();
        }
      });
      detalle.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && typeof detalle.showModal !== 'function') cerrarDetalle();
      });
      detalle.querySelector('[data-cerrar-detalle]')?.addEventListener('click', cerrarDetalle);
      detalle.addEventListener('click', (e) => { if (e.target === detalle) cerrarDetalle(); });
      // Escape cierra el diálogo nativo sin pasar por `cerrarDetalle`.
      detalle.addEventListener('close', () => document.documentElement.classList.remove('sin-desplazar'));
    }

    /**
     * Un destino que llega de fuera: `?destino=Colombia` en la dirección, o un
     * enlace de esta misma página con `data-cotizar-destino` (las tarjetas de
     * la sección de destinos). El primero se aplica al cargar; el segundo, sin
     * recargar: elige el destino, vuelve al modo de envío, lleva la vista al
     * cotizador y deja el foco en el selector.
     */
    const irADestino = (nombre: string | null | undefined): boolean => {
      if (!nombre) return false;
      const op = opsGet.find((o) => o.dataset.c !== 'CLP' && normal(o.dataset.valor ?? '') === normal(nombre));
      if (!op) return false;
      destino = op.dataset.valor ?? destino;
      if (intent === 'to_clp') cambiarA('to_foreign', op.dataset.c);
      else { selGet.poner((o) => o === op); usarDivisa(op.dataset.c); }
      return true;
    };
    irADestino(new URLSearchParams(location.search).get('destino'));
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-cotizar-destino]');
      if (!a || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      if (!irADestino(a.dataset.cotizarDestino)) return;
      e.preventDefault();
      render();
      const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      root.scrollIntoView({ behavior: quieto ? 'auto' : 'smooth', block: 'start' });
      getBoton?.focus({ preventScroll: true });
    });

    render();

    /**
     * La barra asoma sólo cuando la tarjeta quedó ARRIBA del viewport. Si la
     * tarjeta está más abajo —porque el usuario subió— no aparece: el
     * instrumento viene en camino y duplicarlo sería ruido.
     */
    if (dock && 'IntersectionObserver' in window) {
      const dockObserver = new IntersectionObserver(
        ([entry]) => {
          if (!entry) return;
          const passed = !entry.isIntersecting && entry.boundingClientRect.bottom < 0;
          dock.hidden = !passed;
          // Se separa de `hidden` para que la transición tenga un fotograma.
          requestAnimationFrame(() => dock.classList.toggle('is-up', passed));
          // Evita que la barra tape la última línea de la página.
          document.documentElement.classList.toggle('has-dock', passed);
        },
        { threshold: 0 }
      );
      dockObserver.observe(root);
    }
  }
</script>
