---
/**
 * COTIZADOR — el elemento central de la web.
 * Especificación: docs/design-system/cotizador-spec.md
 *
 * Flujo: qué quieres hacer -> a dónde -> cuánto -> cuánto llega -> precio
 * referencial -> WhatsApp con todo prellenado -> un ejecutivo confirma el
 * precio final y coordina el destino.
 *
 * Lo que NO hace: ejecutar una operación, bloquear un precio, prometer un
 * precio final. El tipo `Quote` lo impide (`isReferential: true` es literal).
 *
 * Es la ÚNICA isla interactiva del producto (ADR-0002 §2). El precio se
 * resuelve en build desde ConfigPriceSource y viaja al cliente en
 * data-attributes.
 *
 * ── Rediseñado el 2026-10-22 (Cowork, entrega `cotizador-`) ────────────────
 *
 * Desde ADR-0014 el servicio no termina en una divisa: **el dinero llega a
 * destino en la moneda de ese destino.** La tarjeta seguía preguntando como una
 * casa de cambio —dos botones negros de «convertir», un desplegable de monedas
 * y el precio aparte, al pie— y ahora pregunta como un envío. Decisiones de
 * Sebastián del 2026-10-22, una por una:
 *
 * 1. **El destino se elige por país**, «¿A dónde envías?», y la moneda sale
 *    sola. Trece destinos para doce divisas: el dólar sirve a dos.
 * 2. **La vuelta a pesos se queda, más discreta**: un interruptor chico arriba,
 *    no dos botones del mismo peso que el resto de la tarjeta.
 * 3. **El precio se escribe para que se lea**: 1 USD = 919,70 CLP en las
 *    fuertes y 1 CLP = 4,35 COP en las débiles (`precioLegible`).
 *
 * Y una de forma, que no es una decisión sino la gramática del sitio: **entre
 * lo que envías y lo que llega va el recorrido**, el tramo verde que en todas
 * las figuras significa «lo nuestro» (DS §6.2). Desde ADR-0014 es de punta a
 * punta, así que acá también. El precio y la nota del spread viven en ese
 * tramo, que es donde ocurren: entre un monto y el otro.
 */
import { ConfigPriceSource } from '../lib/pricing/config-price-source.ts';
import {
  DEFAULT_CURRENCY,
  DEFAULT_DESTINO,
  availableCurrencies,
  currencyInfo,
  destinos,
} from '../lib/pricing/currencies.ts';
import { formatCLP, formatForeign } from '../lib/pricing/format.ts';
import { buildQuote, precioLegible, whatsappUrl } from '../lib/pricing/quote.ts';
import { contact, platform, quoteLimits } from '../lib/config/site.ts';
import Icon from './Icon.astro';

interface Props {
  /** Sobre tinta flota con sombra; sobre papel va plano (spec §2). */
  variant?: 'floating' | 'flat';
}
const { variant = 'floating' } = Astro.props;

/**
 * Las doce divisas del catálogo (ADR-0013, ampliado el 2026-10-22).
 *
 * Todas tienen tasa: la que Sebastián confirme en el entorno, o la de muestra
 * mientras no la haya. Lo que impide que una muestra llegue al sitio público no
 * es este archivo sino el build, que se detiene con la indexación abierta
 * mientras quede alguna sin confirmar (`assertRatesConfirmed`).
 */
const divisas = availableCurrencies();
const lugares = destinos();

const price = await new ConfigPriceSource(DEFAULT_CURRENCY).getPrice();

/** Lo único que el catálogo no sabe y el build sí: la tasa de cada divisa. */
const tasas = await Promise.all(
  divisas.map(async (d) => {
    const p = await new ConfigPriceSource(d.code).getPrice();
    return { c: d.code, r: p.rate, n: d.name };
  })
);

/* Límites y monto inicial: UN solo origen para toda la web (D24). Los
   pendientes D6 y D21 están anotados donde vive el valor, en environment.ts. */
const { minPayClp: minPay, maxPayClp: maxPay, samplePayClp: initialPay } = quoteLimits;
const initialGet = initialPay / price.rate;

/**
 * El enlace se arma también en el servidor, con la MISMA función que usa el
 * cliente. Sin JavaScript el CTA sigue llevando a WhatsApp con el monto de
 * ejemplo y el destino escritos; con JavaScript se actualiza a medida que el
 * usuario tipea.
 */
const initialQuote = buildQuote({
  intent: 'to_foreign',
  giveAmount: initialPay,
  price,
  minPay,
  ...(maxPay !== undefined ? { maxPay } : {}),
});
const wa = whatsappUrl(contact.whatsappNumber, initialQuote, initialPay, DEFAULT_DESTINO);

const mayuscula = (s: string): string => s.charAt(0).toUpperCase() + s.slice(1);
---

<section
  class:list={['quoter', variant]}
  id="cotizador"
  data-rate={price.rate}
  data-min={minPay}
  data-max={maxPay ?? ''}
  data-wa={contact.whatsappNumber}
  data-source={price.source}
  data-divisas={JSON.stringify(tasas)}
  aria-labelledby="quoter-title"
>
  <h2 class="sr-only" id="quoter-title">Cotizador de envíos y divisas</h2>

  {/*
    ── El interruptor: el envío manda, la vuelta a pesos se queda chica ──────

    Hasta el 2026-10-22 eran dos botones a lo ancho de la tarjeta, rellenos de
    tinta el elegido: lo primero que se veía era una elección entre dos cosas
    del mismo peso. Desde ADR-0014 no lo son —el envío es el servicio, la vuelta
    es la otra mitad de una casa de cambio— y Sebastián pidió que la vuelta
    siguiera pero más discreta.

    **Sigue siendo un grupo de dos radios**, que es lo que es: una elección
    entre dos, no pestañas que cambian de panel. El área que se pulsa es la
    `label` entera, de 44 px de alto (DS §10); lo que se ve más chico es la
    ficha de dentro.

    «Enviar» se lee completo como «Enviar al extranjero»: el resto va en
    `sr-only` porque a 320 px las dos opciones enteras no caben en una fila, y
    a la vista la pregunta de abajo, «¿A dónde envías?», ya lo completa.
  */}
  <fieldset class="modo">
    <legend class="sr-only">¿Qué quieres hacer?</legend>
    <label class="modo-op">
      <input type="radio" name="intent" value="to_foreign" checked />
      <span>Enviar<span class="sr-only"> al extranjero</span></span>
    </label>
    <label class="modo-op">
      <input type="radio" name="intent" value="to_clp" />
      <span>Pasar a pesos</span>
    </label>
  </fieldset>

  {/*
    ── A dónde: el país, y la moneda sale sola ───────────────────────────────

    Era «¿A qué moneda?» con doce opciones del tipo «Dólar · USD (Estados
    Unidos, Ecuador)». Un envío se piensa por destino, así que ahora son los
    trece países y cada uno trae su divisa. La opción dice las dos cosas,
    «Colombia · COP», para que nadie tenga que adivinar en qué llega.

    El desplegable es el NATIVO (`<select>`), con su lista del sistema: en un
    teléfono abre el selector del teléfono, y con teclado y lector funciona sin
    una línea de ARIA propia. Lo único que se le cambia es la caja cerrada:
    `appearance: none` y la flecha del set de iconos, girada, porque la del
    sistema no hablaba la misma letra que el resto de la tarjeta.

    En «Pasar a pesos» la pregunta es otra —qué divisa tienes, no a dónde va—,
    así que se cambia de desplegable y no de texto: el de destinos se oculta y
    aparece el de divisas, con su propia etiqueta. Sin JavaScript se ve sólo el
    primero, que es el que corresponde a la opción marcada.
  */}
  <div class="field" data-campo-destino>
    <label class="label" for="destino-select">¿A dónde envías?</label>
    <div class="select-box">
      <select id="destino-select" class="select" data-destino>
        {lugares.map((l) => (
          <option value={l.destino} data-c={l.code} selected={l.destino === DEFAULT_DESTINO}>
            {l.destino} · {l.code}
          </option>
        ))}
      </select>
      <Icon name="chevron" size={20} class="select-ico" />
    </div>
  </div>

  <div class="field" data-campo-divisa hidden>
    <label class="label" for="divisa-select">¿Qué divisa tienes?</label>
    <div class="select-box">
      <select id="divisa-select" class="select" data-divisa>
        {divisas.map((d) => (
          <option value={d.code} selected={d.code === DEFAULT_CURRENCY}>
            {mayuscula(d.name)} · {d.code}
          </option>
        ))}
      </select>
      <Icon name="chevron" size={20} class="select-ico" />
    </div>
  </div>

  {/*
    ── Los dos montos y, entre ellos, el recorrido ───────────────────────────

    Cada monto es una caja con su etiqueta y su moneda arriba, en una fila, y la
    cifra debajo a todo el ancho: así la cifra gana el espacio de la ficha, que
    a 320 px es lo que decide si «2.000.000» cabe. La moneda se lee también con
    lector de pantalla, porque el campo la tiene en `aria-describedby`; antes
    el campo decía «Conviertes, 2.000.000» y no en qué.

    Entre las dos corre el tramo verde: lo nuestro, de punta a punta desde
    ADR-0014 (DS §6.2). Sobre él, el punto —la unidad de valor, la misma que el
    precio cotiza: «1 USD»— marca dónde está el precio, y el precio y la nota
    del spread van al lado, que es donde pasan: entre lo que pones y lo que
    llega. **No estrena ninguna marca**: son las dos del §6.2 con el
    significado que ya tienen.

    **Lo que esto cambia del spec §2:** el precio referencial deja de ser la
    segunda cifra grande de la tarjeta, al pie, con su propia fila. La cifra que
    responde la pregunta es la que llega; el precio es la explicación de esa
    cifra y se lee junto a ella. Sigue diciendo «Precio referencial» con esas
    dos palabras (spec §48).

    REQUIERE VALIDACIÓN DE COMPLIANCE — «Envías» y «Llega aprox.» afirman lo
    mismo que la nota del riel, más abajo: que el dinero llega a destino. No
    afirman plazo ni canal (ADR-0014 §3).
  */}
  <div class="montos">
    <div class="monto">
      <div class="monto-cabeza">
        <label class="monto-label" for="give-input" data-label-give>Envías</label>
        <span class="moneda num" id="cur-give" data-cur-give>CLP</span>
      </div>
      <input
        id="give-input"
        class="amount num"
        type="text"
        inputmode="numeric"
        autocomplete="off"
        value={formatCLP(initialPay)}
        aria-describedby="cur-give quoter-note"
      />
    </div>

    <div class="tramo">
      <p class="tramo-precio">
        <span class="tramo-rot">Precio referencial</span>
        {/*
          **La forma del precio cambió el 2026-10-22.** Era «919,70 CLP por
          dólar», con la unidad escrita a mano y luego derivada del catálogo; en
          las monedas débiles daba «0,23 CLP por peso colombiano». Ahora sale de
          `precioLegible`, la misma función que escribe el mensaje de WhatsApp.
        */}
        <span class="tramo-valor num" data-rate-display>{precioLegible(price.rate, DEFAULT_CURRENCY)}</span>
      </p>
      <p class="tramo-nota" id="quoter-note">
        <strong>Sin comisiones ocultas:</strong> el precio ya incluye el spread.
      </p>
    </div>

    <div class="monto monto-llega">
      <div class="monto-cabeza">
        <label class="monto-label" for="get-input" data-label-get>Llega aprox.</label>
        <span class="moneda num" id="cur-get" data-cur-get>USD</span>
      </div>
      <input
        id="get-input"
        class="amount num"
        type="text"
        inputmode="decimal"
        autocomplete="off"
        value={formatForeign(initialGet, currencyInfo(DEFAULT_CURRENCY).decimals)}
        aria-describedby="cur-get"
      />
    </div>
  </div>

  <p class="alert" data-alert hidden aria-live="polite"></p>

  {/*
    La nota del riel, **sin cambios** desde ADR-0014: el spec §42 pide una nota
    permanente dentro del cotizador, y lo que mitiga hoy es el plazo. El largo
    historial de esta nota —de «Recibes dólar digital en tu billetera…» a esta
    línea— está en `cotizador-spec.md`, en la enmienda del 2026-09-28.

    REQUIERE VALIDACIÓN DE COMPLIANCE — que el dinero llega a destino en la
    moneda de ese destino.
  */}
  <p class="rail">
    Llega <strong>en la moneda del destino</strong>. El plazo te lo confirma tu ejecutivo.
  </p>

  <a class="cta" href={wa} target="_blank" rel="noopener" data-cta>
    Cotizar este monto por WhatsApp
  </a>
  <a class="secondary" href={platform.registerUrl}>
    o crea tu cuenta para operar en línea
  </a>
</section>

<!--
  Barra fija móvil (Fase 1, patrón 13 · cotizador-spec §7). Lleva la cifra viva
  porque así el movimiento es información: el número te acompaña. Desde el
  2026-10-22 dice también a dónde llega: «Llega a Colombia». Arranca `hidden`,
  así que no existe para un lector de pantalla mientras la tarjeta está a la
  vista y no duplica el CTA.
-->
<div class="dock" data-dock hidden>
  <div class="dock-in">
    <span class="dock-fig">
      <span class="dock-label" data-dock-label>Llega a {DEFAULT_DESTINO}</span>
      <span class="dock-amount num" data-dock-amount>{formatForeign(initialGet, currencyInfo(DEFAULT_CURRENCY).decimals)}</span>
    </span>
    <a class="dock-cta" href={wa} target="_blank" rel="noopener" data-dock-cta>
      Continuar
    </a>
  </div>
</div>

<style>
  .quoter {
    /* El foco de dentro de la tarjeta es el verde oscuro, no el de la tinta.
       La tarjeta es papel sobre la banda oscura del héroe, y `.on-tinta-surface`
       pone `--focus` en `--verde`: sobre papel da 2:1, bajo el 3:1 que pide un
       indicador. Pasaba en los dos botones de intención y en el de WhatsApp. */
    --focus: var(--verde-deep);
    background: var(--papel);
    color: var(--ink);
    padding: var(--s-5);
    border-radius: var(--r-card);
  }
  .quoter.floating { box-shadow: var(--elev-card); }
  .quoter.flat {
    border-radius: var(--r-3);
    border: 1px solid var(--line);
  }

  /* ── El interruptor ──────────────────────────────────────────────────── */
  .modo {
    display: inline-flex;
    border: 0;
    margin: 0 0 var(--s-4);
    padding: 0;
    background: var(--papel-2);
    border-radius: var(--r-2);
  }
  .modo-op { position: relative; display: flex; min-height: 44px; cursor: pointer; }
  .modo-op input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    min-height: 0;
  }
  /* La ficha visible va a 4 px del borde del área que se pulsa: se ve chica y
     el blanco de 44 px es la etiqueta entera. */
  .modo-op > span {
    display: flex;
    align-items: center;
    margin: 4px;
    padding: 0 var(--s-3);
    border: 1px solid transparent;
    border-radius: var(--r-1);
    font-size: var(--t-label);
    font-weight: 600;
    color: var(--ink-mute);
    transition: background-color var(--m-fast) var(--m-ease),
                border-color var(--m-fast) var(--m-ease),
                color var(--m-fast) var(--m-ease);
  }
  /* La elegida se dice con un borde de 4,98:1 contra el papel-2 que la rodea
     (WCAG 1.4.11): el blanco sobre papel-2 sólo da 1,2:1, y el cambio de gris a
     tinta en el texto, 2,9:1. Con `--line` el estado no llegaba al 3:1. */
  .modo-op input:checked + span {
    background: #fff;
    border-color: var(--ink-mute);
    color: var(--ink);
  }
  .modo-op:hover input:not(:checked) + span { color: var(--ink); }
  .modo-op input:focus-visible + span {
    outline: 2px solid var(--focus);
    outline-offset: 1px;
  }

  /* ── Los desplegables ───────────────────────────────────────────────── */
  .field { margin-bottom: var(--s-4); }
  .field[hidden] { display: none; }
  .label {
    display: block;
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    color: var(--ink-mute);
    margin-bottom: var(--s-2);
  }
  .select-box {
    position: relative;
    border: 1px solid var(--line);
    border-radius: var(--r-2);
    background: #fff;
    transition: border-color var(--m-fast) var(--m-ease),
                box-shadow var(--m-fast) var(--m-ease);
  }
  .select {
    appearance: none;
    display: block;
    width: 100%;
    min-height: 48px;
    border: 0;
    background: transparent;
    padding: 0 calc(var(--s-3) + 28px) 0 var(--s-3);
    font: inherit;
    font-size: var(--t-body);
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
    text-overflow: ellipsis;
  }
  .select:focus { outline: none; }
  /* La flecha del set apunta a la derecha; girada, dice «se despliega». */
  .select-box :global(.select-ico) {
    position: absolute;
    right: var(--s-3);
    top: 50%;
    transform: translateY(-50%) rotate(90deg);
    color: var(--ink-mute);
    pointer-events: none;
  }

  /* ── Los montos y el tramo ──────────────────────────────────────────── */
  .monto {
    border: 1px solid var(--line);
    border-radius: var(--r-2);
    background: #fff;
    padding: var(--s-2) var(--s-3) var(--s-2);
    cursor: text;
    transition: border-color var(--m-fast) var(--m-ease),
                box-shadow var(--m-fast) var(--m-ease);
  }
  /* El borde de foco es un indicador de interfaz: necesita 3:1 contra el blanco
     del campo. verde-deep da 4.9:1; el verde de marca sólo 1.9:1. El anillo es
     `--verde-deep` al 18%, a mano porque `color-mix()` está por debajo del
     `cssTarget` del proyecto. */
  .monto:focus-within,
  .select-box:focus-within {
    border-color: var(--verde-deep);
    box-shadow: 0 0 0 3px rgba(10, 114, 80, 0.18);
  }
  /* Fuera de rango se marca la caja de los PESOS, que es donde vive el mínimo:
     la que envías en un envío, la que recibes de vuelta a pesos. Antes se
     ponían rojas las dos, y la que llega no tenía nada mal. */
  .monto.invalid { border-color: var(--baja); }

  .monto-cabeza {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
  }
  .monto-label {
    display: block;
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    color: var(--ink-mute);
    line-height: 1.3;
  }
  .amount {
    display: block;
    min-width: 0;
    width: 100%;
    border: 0;
    background: transparent;
    padding: 2px 0 var(--s-1);
    font-size: var(--t-dato-m);
    font-weight: 500;
    line-height: 1.15;
    color: var(--ink);
  }
  .amount:focus { outline: none; }
  .monto-llega .amount { font-weight: 600; }
  /* Una cifra que no cabe baja un escalón en vez de cortarse, y si tampoco
     cabe, otro: «1.086.956.520,65» pesos argentinos a 320 px, o cualquier monto
     con el espaciado de WCAG 1.4.12. La clase la pone la isla midiendo la
     cifra, no contando dígitos (ver `ajustar`). */
  .amount.largo { font-size: var(--t-h3); }
  .amount.muy-largo { font-size: var(--t-body); }
  /* La moneda, en una ficha: el código en la letra de las cifras, sobre el
     papel de la tarjeta. Es dato, no adorno, y no se pulsa. */
  .moneda {
    flex: none;
    padding: 3px var(--s-2);
    border-radius: var(--r-1);
    background: var(--papel-2);
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: .02em;
    color: var(--ink);
  }

  /* El tramo: 3 px de verde de una caja a la otra, a la altura de las cifras.
     El punto (`.tramo-valor::before`) es un borde y no un fondo, para que en
     colores forzados siga ahí. */
  /* El tramo cae en el eje de las cifras: 12 px de relleno de la caja más su
     borde, así que baja desde debajo del primer dígito de lo que envías hasta
     la etiqueta de lo que llega. */
  .tramo {
    position: relative;
    padding: var(--s-3) 0 var(--s-3) 40px;
  }
  .tramo::before {
    content: '';
    position: absolute;
    left: 13px;
    top: 0;
    bottom: 0;
    border-left: 3px solid var(--verde-deep);
  }
  .tramo-precio {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .tramo-rot {
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    color: var(--ink-mute);
    line-height: 1.3;
  }
  .tramo-valor {
    position: relative;
    font-size: var(--t-h3-m);
    font-weight: 600;
    line-height: 1.25;
    color: var(--ink);
  }
  /* El punto va colgado de la cifra del precio y no de la caja del tramo: así
     cae a la altura de esa línea sea cual sea el tamaño de letra. Su centro
     es el del tramo: 40 − 13 − 1,5 + 6,5 = 32 px a la izquierda del texto. */
  .tramo-valor::before {
    content: '';
    position: absolute;
    left: -32px;
    top: 50%;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    border: 6.5px solid var(--verde-deep);
    box-shadow: 0 0 0 3px var(--papel);
    transform: translateY(-50%);
  }
  .tramo-nota {
    margin-top: var(--s-2);
    font-size: var(--t-label);
    line-height: 1.45;
    color: var(--ink-mute);
  }
  .tramo-nota strong { color: var(--ink); font-weight: 600; }

  /* M2 · el dato acusa que cambió. 160ms, sólo sobre el valor nuevo. No es un
     conteo desde cero: eso mostraría precios falsos. NO al teclear: mientras
     escribes, la cifra tiene que seguirte sin latencia. */
  .tramo-valor.is-set,
  .amount.is-set { animation: settle 160ms var(--m-ease) both; }
  @keyframes settle {
    from { opacity: 0; transform: translateY(2px); }
    to   { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tramo-valor.is-set,
    .amount.is-set { animation: none; }
  }

  .alert {
    font-size: var(--t-body-sm);
    line-height: 1.45;
    color: var(--ink);
    background: var(--error-bg);
    border: 1px solid var(--error-line);
    border-radius: var(--r-2);
    padding: var(--s-3);
    margin: var(--s-3) 0 0;
  }

  /* El riel se explica, pero en el peso que le corresponde: no es el titular */
  .rail {
    font-size: var(--t-label);
    line-height: 1.45;
    color: var(--ink-mute);
    margin: var(--s-4) 0;
  }
  .rail strong { color: var(--ink); font-weight: 600; }

  .cta {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: var(--verde);
    color: var(--on-verde);
    font-size: var(--t-body);
    font-weight: 700;
    padding: var(--s-4);
    border-radius: var(--r-2);
    text-decoration: none;
    transition: background-color var(--m-fast) var(--m-ease);
  }
  .cta:hover { background: var(--verde-hi); }

  .secondary {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: var(--s-2);
    min-height: 44px;
    font-size: var(--t-body-sm);
    font-weight: 500;
    color: var(--verde-deep);
    text-decoration: none;
  }
  .secondary:hover { text-decoration: underline; }

  /* La barra se ancla al borde inferior. Su eje de entrada es ese borde, no la
     diagonal de la marca: no es contenido que entra en la página, es un
     elemento acoplado que asoma desde donde vive. Misma duración y curva. */
  .dock {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 30;
    background: var(--tinta);
    border-top: 1px solid rgba(237, 242, 239, 0.14);
    padding: var(--s-3) var(--pad-section-m);
    padding-bottom: max(var(--s-3), env(safe-area-inset-bottom));
    transform: translateY(100%);
    transition: transform var(--m-base) var(--m-ease);
  }
  .dock.is-up { transform: none; }
  .dock-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    max-width: var(--container);
    margin: 0 auto;
  }
  .dock-fig { display: flex; flex-direction: column; min-width: 0; }
  .dock-label {
    font-size: var(--t-dato-sm);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    color: var(--on-tinta-mute);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .dock-amount {
    font-size: var(--t-h3-m);
    font-weight: 500;
    color: var(--on-tinta);
    line-height: 1.2;
    white-space: nowrap;
  }
  /* M2 también acá: la cifra acusa que cambió mientras te acompaña. */
  .dock-amount.is-set { animation: settle 160ms var(--m-ease) both; }
  .dock-cta {
    flex: none;
    display: flex;
    align-items: center;
    background: var(--verde);
    color: var(--on-verde);
    font-size: var(--t-body-sm);
    font-weight: 700;
    padding: 0 var(--s-5);
    min-height: 44px;
    border-radius: var(--r-2);
    text-decoration: none;
    transition: background-color var(--m-fast) var(--m-ease);
  }
  .dock-cta:hover { background: var(--verde-hi); }
  @media (prefers-reduced-motion: reduce) {
    .dock { transition: none; }
    .dock-amount.is-set { animation: none; }
  }

  /* Bajo 360 px la tarjeta gana 16 px de ancho útil: con 24 de relleno, la
     cifra de partida no cabía en su caja con el espaciado de WCAG 1.4.12. */
  @media (max-width: 359px) {
    .quoter { padding: var(--s-4); }
  }

  @media (min-width: 900px) {
    /* En escritorio el cotizador nunca se pierde de vista: la barra no aplica. */
    .dock { display: none; }
    .amount { font-size: var(--t-dato); }
    .amount.largo { font-size: var(--t-dato-m); }
    .amount.muy-largo { font-size: var(--t-h3); }
    .tramo-valor { font-size: var(--t-h3); }
  }

  /* En colores forzados el sistema pinta los bordes y quita los fondos: el
     tramo y el punto ya son bordes, así que siguen. La ficha de la moneda y el
     interruptor elegido pierden su fondo y necesitan un borde que los diga. */
  @media (forced-colors: active) {
    .moneda { border: 1px solid CanvasText; }
    .modo { border: 1px solid CanvasText; }
    /* El borde transparente de la opción sin elegir se pintaría: se le da el
       color del fondo para que sólo la elegida tenga caja. */
    .modo-op > span { border-color: Canvas; }
    .modo-op input:checked + span { border-color: Highlight; color: Highlight; }
    /* El botón de WhatsApp es un relleno, y el relleno se va: sin borde quedaba
       como un enlace suelto. Pasaba también antes del rediseño. */
    .cta { border: 1px solid LinkText; }
    .tramo::before, .tramo-valor::before { border-color: Highlight; }
    .tramo-valor::before { box-shadow: none; }
  }
</style>

<script>
  import { formatCLP, formatForeign, parseAmount } from '../lib/pricing/format.ts';
  import {
    buildQuote,
    clpAmount,
    convert,
    currenciesFor,
    formatAmount,
    precioLegible,
    whatsappUrl,
  } from '../lib/pricing/quote.ts';
  import type { Currency, Intent } from '../lib/pricing/types.ts';
  import { currencyInfo, type IslandCurrency } from '../lib/pricing/currencies.ts';

  const root = document.querySelector<HTMLElement>('#cotizador');
  if (root) {
    const divisas: IslandCurrency[] = JSON.parse(root.dataset.divisas ?? '[]');
    const destinoSel = root.querySelector<HTMLSelectElement>('[data-destino]');
    const divisaSel = root.querySelector<HTMLSelectElement>('[data-divisa]');
    const campoDestino = root.querySelector<HTMLElement>('[data-campo-destino]');
    const campoDivisa = root.querySelector<HTMLElement>('[data-campo-divisa]');

    /** La divisa del destino elegido: viaja en la opción, `data-c`. */
    const divisaDe = (codigo: string | undefined): IslandCurrency =>
      divisas.find((d) => d.c === codigo) ??
      divisas[0] ?? { c: 'USD', r: Number(root.dataset.rate), n: 'dólar' };
    const codigoDestino = (): string | undefined =>
      destinoSel?.selectedOptions[0]?.dataset.c;

    let divisa: IslandCurrency = divisaDe(codigoDestino());
    let rate = divisa.r;
    const minPay = Number(root.dataset.min);
    const maxRaw = Number(root.dataset.max);
    const maxPay = Number.isFinite(maxRaw) && maxRaw > 0 ? maxRaw : undefined;
    const source = root.dataset.source ?? '';
    const waNumber = root.dataset.wa!;

    const giveInput = root.querySelector<HTMLInputElement>('#give-input')!;
    const getInput = root.querySelector<HTMLInputElement>('#get-input')!;
    const giveLabel = root.querySelector<HTMLElement>('[data-label-give]')!;
    const getLabel = root.querySelector<HTMLElement>('[data-label-get]')!;
    const giveCur = root.querySelector<HTMLElement>('[data-cur-give]')!;
    const getCur = root.querySelector<HTMLElement>('[data-cur-get]')!;
    const giveBox = giveInput.closest<HTMLElement>('.monto')!;
    const getBox = getInput.closest<HTMLElement>('.monto')!;
    const alertEl = root.querySelector<HTMLElement>('[data-alert]')!;
    const cta = root.querySelector<HTMLAnchorElement>('[data-cta]')!;
    const rateEl = root.querySelector<HTMLElement>('[data-rate-display]');
    const dock = document.querySelector<HTMLElement>('[data-dock]');
    const dockLabel = dock?.querySelector<HTMLElement>('[data-dock-label]');
    const dockAmount = dock?.querySelector<HTMLElement>('[data-dock-amount]');
    const dockCta = dock?.querySelector<HTMLAnchorElement>('[data-dock-cta]');
    const intentInputs = root.querySelectorAll<HTMLInputElement>('input[name="intent"]');

    /* Los decimales los trae la divisa elegida: «1.250,00 yenes» escribiría una
       fracción que esa moneda no usa, y en dinero eso se lee como precisión
       falsa. El peso chileno nunca lleva decimales. */
    const fmt = (value: number, currency: Currency): string =>
      currency === 'CLP' ? formatCLP(value) : formatForeign(value, currencyInfo(divisa.c).decimals);

    const precio = () =>
      ({ rate, currency: divisa.c, pair: `${divisa.c}/CLP` as const, source, asOf: new Date() });

    let intent: Intent = 'to_foreign';
    let giveAmount = parseAmount(giveInput.value);
    let lastRate = '';

    // La pantalla y el mensaje calculan con la MISMA función. Antes el
    // componente tenía su propia aritmética, sin la guarda de tasa del módulo:
    // con una tasa corrupta la pantalla habría mostrado Infinity y el mensaje 0.
    const received = (): number => convert(intent, giveAmount, rate);

    /** M2 sobre un elemento: reinicia la animación leyendo offsetWidth. Nunca
        sobre el campo enfocado: animar lo que alguien escribe es pelear con su
        cursor. */
    const settle = (el: HTMLElement): void => {
      if (document.activeElement === el) return;
      el.classList.remove('is-set');
      void el.offsetWidth;
      el.classList.add('is-set');
    };

    /** Una cifra que no cabe en su caja baja un escalón (`.largo`). Se mide,
        no se cuentan dígitos: lo que cabe depende del ancho, de la letra y del
        espaciado que el visitante haya puesto. */
    const ajustar = (): void => {
      for (const el of [giveInput, getInput]) {
        el.classList.remove('largo', 'muy-largo');
        if (el.scrollWidth > el.clientWidth + 1) el.classList.add('largo');
        if (el.scrollWidth > el.clientWidth + 1) el.classList.replace('largo', 'muy-largo');
      }
    };
    window.addEventListener('resize', ajustar, { passive: true });

    const render = (): void => {
      const { give, get } = currenciesFor(intent, divisa.c);
      const envio = intent === 'to_foreign';
      const destino = envio ? destinoSel?.value : undefined;
      const quote = buildQuote({
        intent,
        giveAmount,
        price: precio(),
        minPay,
        ...(maxPay !== undefined ? { maxPay } : {}),
      });

      giveCur.textContent = give;
      getCur.textContent = get;
      giveLabel.textContent = envio ? 'Envías' : 'Conviertes';
      getLabel.textContent = envio ? 'Llega aprox.' : 'Recibes aprox.';
      giveInput.inputMode = give === 'CLP' ? 'numeric' : 'decimal';
      getInput.inputMode = get === 'CLP' ? 'numeric' : 'decimal';

      // El precio y su forma son del par, no del cotizador. M2 sólo cuando
      // cambia de verdad: si se reanimara en cada tecleo sería ruido.
      const legible = precioLegible(rate, divisa.c);
      if (rateEl && legible !== lastRate) {
        lastRate = legible;
        rateEl.textContent = legible;
        settle(rateEl);
      }

      const fuera = quote.state === 'below_min' || quote.state === 'above_max';
      giveBox.classList.toggle('invalid', fuera && give === 'CLP');
      getBox.classList.toggle('invalid', fuera && get === 'CLP');
      // Se muestra la región ANTES de escribirle. Un lector de pantalla no
      // vigila regiones ocultas: escribiendo primero, el aviso no se anunciaba.
      const aviso =
        quote.state === 'below_min'
          ? `Monto mínimo: ${formatCLP(minPay)} CLP. Puedes escribirnos igual y te orientamos.`
          : quote.state === 'above_max' && maxPay !== undefined
            ? `Para montos sobre CLP ${formatCLP(maxPay)} te atiende un ejecutivo. Escríbenos.`
            : '';
      if (aviso) {
        alertEl.hidden = false;
        alertEl.textContent = aviso;
      } else {
        alertEl.textContent = '';
        alertEl.hidden = true;
      }

      ajustar();

      // El fallback de cualquier problema es WhatsApp, nunca un error seco
      const href = whatsappUrl(waNumber, quote, giveAmount, destino);
      cta.href = href;
      cta.textContent = fuera ? 'Escríbenos por WhatsApp' : 'Continuar por WhatsApp';

      // La barra refleja exactamente la tarjeta: mismo enlace, misma cifra,
      // mismo estado. Una sola verdad, dos lugares donde se ve.
      if (dock && dockLabel && dockAmount && dockCta) {
        dockCta.href = href;
        dockCta.textContent = fuera ? 'Escríbenos' : 'Continuar';
        dockLabel.textContent = fuera ? 'Fuera de rango' : envio ? `Llega a ${destino ?? ''}` : 'Recibes';
        const dockShown = fuera ? '—' : formatAmount(received(), get);
        if (dockAmount.textContent !== dockShown) {
          dockAmount.textContent = dockShown;
          dockAmount.classList.remove('is-set');
          void dockAmount.offsetWidth;
          dockAmount.classList.add('is-set');
        }
      }
    };

    /** Cambia de divisa conservando el monto en PESOS: el cliente piensa la
        operación en lo que pone, no en lo que recibe. */
    const usarDivisa = (codigo: string | undefined): void => {
      const clpBefore = clpAmount(intent, giveAmount, rate);
      divisa = divisaDe(codigo);
      rate = divisa.r;
      const { give, get } = currenciesFor(intent, divisa.c);
      giveAmount = give === 'CLP' ? clpBefore : rate > 0 ? clpBefore / rate : 0;
      giveInput.value = fmt(giveAmount, give);
      getInput.value = fmt(received(), get);
      settle(giveInput);
      settle(getInput);
    };

    // El campo que se edita NO se reformatea bajo el cursor (spec §3): se
    // actualiza el otro, y el propio se formatea recién al salir.
    giveInput.addEventListener('input', () => {
      giveAmount = parseAmount(giveInput.value);
      getInput.value = fmt(received(), currenciesFor(intent, divisa.c).get);
      render();
    });
    giveInput.addEventListener('blur', () => {
      giveInput.value = fmt(giveAmount, currenciesFor(intent, divisa.c).give);
      ajustar();
    });
    getInput.addEventListener('input', () => {
      const { give } = currenciesFor(intent, divisa.c);
      const target = parseAmount(getInput.value);
      // La inversa de `convert`, con la misma guarda de tasa.
      giveAmount = rate > 0 ? (give === 'CLP' ? target * rate : target / rate) : 0;
      giveInput.value = fmt(giveAmount, give);
      render();
    });
    getInput.addEventListener('blur', () => {
      getInput.value = fmt(received(), currenciesFor(intent, divisa.c).get);
      ajustar();
    });

    destinoSel?.addEventListener('change', () => {
      usarDivisa(codigoDestino());
      render();
    });
    divisaSel?.addEventListener('change', () => {
      usarDivisa(divisaSel.value);
      render();
    });

    /* Al cambiar de modo se cambia de desplegable y se conserva lo elegido: de
       un envío a Colombia se pasa a «tienes pesos colombianos», y de vuelta, si
       entretanto elegiste euros, el destino pasa a Europa. El monto en pesos
       se conserva, como siempre. */
    intentInputs.forEach((input) =>
      input.addEventListener('change', () => {
        const clpBefore = clpAmount(intent, giveAmount, rate);
        intent = input.value as Intent;
        const envio = intent === 'to_foreign';
        if (campoDestino) campoDestino.hidden = !envio;
        if (campoDivisa) campoDivisa.hidden = envio;
        if (envio && destinoSel && codigoDestino() !== divisa.c) {
          const opcion = [...destinoSel.options].find((o) => o.dataset.c === divisa.c);
          if (opcion) destinoSel.value = opcion.value;
        }
        if (!envio && divisaSel) divisaSel.value = divisa.c;
        const { give, get } = currenciesFor(intent, divisa.c);
        giveAmount = give === 'CLP' ? clpBefore : rate > 0 ? clpBefore / rate : 0;
        giveInput.value = fmt(giveAmount, give);
        getInput.value = fmt(received(), get);
        settle(giveInput);
        settle(getInput);
        render();
      })
    );

    render();

    /**
     * La barra asoma sólo cuando la tarjeta quedó ARRIBA del viewport. Si la
     * tarjeta está más abajo —porque el usuario subió— no aparece: el
     * instrumento viene en camino y duplicarlo sería ruido.
     */
    if (dock && 'IntersectionObserver' in window) {
      const dockObserver = new IntersectionObserver(
        ([entry]) => {
          if (!entry) return;
          const passed = !entry.isIntersecting && entry.boundingClientRect.bottom < 0;
          dock.hidden = !passed;
          // Se separa de `hidden` para que la transición tenga un fotograma.
          requestAnimationFrame(() => dock.classList.toggle('is-up', passed));
          // Evita que la barra tape la última línea de la página.
          document.documentElement.classList.toggle('has-dock', passed);
        },
        { threshold: 0 }
      );
      dockObserver.observe(root);
    }
  }
</script>
