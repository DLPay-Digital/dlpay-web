---
/**
 * "Cómo funciona" — web + WhatsApp + verificación como UN solo recorrido
 * (Fase 1 §5.5, principio UX 3). Numerado porque es una secuencia real.
 *
 * Zig-zag en escritorio, apilado en móvil. El DOM va SIEMPRE figura → texto,
 * que es el orden correcto en móvil; en escritorio se invierten sólo las filas
 * impares con `order`. Una regla, sin duplicar marcado.
 *
 * `order` no altera el orden del DOM ni el de lectura, y las figuras van
 * aria-hidden sin nada enfocable dentro: no hay desajuste entre orden visual y
 * orden de tabulación.
 *
 * El número dejó de ser un marcador de 32px y pasó a etiqueta ("Paso 1"): la
 * secuencia sigue siendo información, pero el protagonismo visual es de la
 * figura. Dos anclas por paso competían.
 *
 * Las cuñas entre pasos se retiraron: vivían en una columna-marcador que ya no
 * existe, y ahora cada figura muestra movimiento por su cuenta.
 */
import { steps } from '../content/home.ts';
import StepFigure from './StepFigure.astro';
---
<section class="steps" id="como-funciona" aria-labelledby="steps-title">
  <div class="inner">
    <header class="head">
      <h2 id="steps-title" data-enter>De la cotización al dinero movido</h2>
      <p>Cuatro pasos. La web te deja listo; una persona cierra la operación.</p>
    </header>

    <ol class="list">
      {steps.map((step) => (
        <li class="step" data-enter>
          <StepFigure kind={step.figure} />
          <div class="body">
            <p class="paso num">Paso {step.n}</p>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
            {step.time && <span class="time num">{step.time}</span>}
          </div>
        </li>
      ))}
    </ol>

    <p class="foot">
      Antes de tu primera operación te pedimos registro y verificación de identidad.
      Es obligatorio para todos, personas y empresas.
      <a href="/como-funciona/">Ver el proceso completo</a>
    </p>
  </div>
</section>

<style>
  .steps { background: var(--papel); padding: var(--s-9) 0; }
  .inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--pad-section-m);
  }
  .head { max-width: 46ch; margin-bottom: var(--s-7); }
  h2 {
    font-size: var(--t-h2-m);
    font-weight: 700;
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
    margin-bottom: var(--s-3);
  }
  .head p { color: var(--ink-mute); }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-8);
  }
  /* Móvil: una columna, figura arriba y texto abajo en los cuatro pasos.
     Como el DOM ya va en ese orden, aquí no hace falta ninguna regla. */
  .step { display: grid; gap: var(--s-4); justify-items: start; }

  .paso {
    font-size: var(--t-label);
    letter-spacing: var(--ls-label);
    font-weight: 600;
    color: var(--verde-deep);
    margin-bottom: var(--s-2);
  }

  .body { padding-bottom: var(--s-2); }
  h3 {
    font-size: var(--t-h3-m);
    font-weight: 600;
    line-height: var(--lh-h3);
    margin-bottom: var(--s-2);
  }
  /* :not(.paso) — sin esto, `.body p` (0,3,1) pisa a `.paso` (0,2,0) y además
     va después en la hoja: la etiqueta del paso salía gris en vez de verde. */
  .body p:not(.paso) { color: var(--ink-mute); max-width: 52ch; }
  .time {
    display: inline-block;
    margin-top: var(--s-3);
    font-size: var(--t-dato-sm);
    font-weight: 500;
    color: var(--ink-mute);
  }

  .foot {
    margin-top: var(--s-7);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
    font-size: var(--t-body-sm);
    color: var(--ink-mute);
    max-width: 60ch;
  }
  .foot a { color: var(--verde-deep); font-weight: 600; text-decoration: none; }
  .foot a:hover { text-decoration: underline; }

  @media (min-width: 900px) {
    .inner { padding-inline: var(--pad-section); }
    h2 { font-size: var(--t-h2); }
    h3 { font-size: var(--t-h3); }
    .list { gap: var(--s-9); }
    .step {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: var(--s-8);
    }
    .fig { justify-self: center; }
    /* Única regla del zig-zag: las impares invierten, las pares se quedan en el
       orden del DOM. Da texto│figura · figura│texto · texto│figura · figura│texto. */
    .step:nth-child(odd) .fig { order: 2; }
  }
</style>
