---
/**
 * FAQ — sólo objeciones reales previas a la primera operación (phase-2.5 §2).
 * Acordeón con <details>: sin JavaScript, accesible por teclado de fábrica.
 *
 * Las preguntas llegan por prop y no se importan acá. Sirve a dos páginas con
 * públicos distintos —las cinco de la Home son enteras de persona; las cuatro de
 * `/empresas` son de empresa— y duplicar el componente habría duplicado algo más
 * caro que un acordeón: el criterio de qué es una objeción real.
 *
 * `items` y `title` son OBLIGATORIAS a propósito, sin valor por omisión. Un
 * `<Faq />` que cayera de vuelta al contenido de la Home publicaría las
 * preguntas equivocadas en silencio, que es exactamente la clase de fallo que ya
 * nos ha costado antes.
 */
import type { FaqItem } from '../content/home.ts';

interface Props {
  items: readonly FaqItem[];
  title: string;
  /**
   * `papel-2` para el segundo bloque cuando hay dos seguidos en una página.
   * Dos bloques con el mismo fondo dejan 192px de aire entre el último
   * desplegable de uno y el título del otro, y se leen como un solo bloque mal
   * espaciado. Alternar es el ritmo que el sitio ya usa entre secciones.
   */
  surface?: 'papel' | 'papel-2';
}
const { items, title, surface = 'papel' } = Astro.props;

/*
  El `id` del título se DERIVA del título y no está escrito a mano.

  Lo estuvo hasta el 2026-09-23 —`id="faq-title"` fijo—, y no molestaba porque
  ninguna página usaba el componente dos veces. `/preguntas` lo usa dos veces, y
  dos elementos con el mismo `id` son HTML inválido: el `aria-labelledby` del
  segundo apuntaría al título del primero, así que un lector de pantalla
  anunciaría las preguntas de empresa con el nombre del bloque de personas.

  Se deriva en vez de pedirse por prop para que no haya forma de olvidarlo: un
  `id` obligatorio se puede escribir mal o repetir, y el fallo sería otra vez
  silencioso. Dos bloques con el MISMO título en una página volverían a chocar,
  pero eso ya sería un error de contenido visible a simple vista.

  `normalize('NFD')` + el rango de diacríticos quita las tildes: sin eso,
  «Antes de tu primera operación» dejaría una `ó` en el `id`. Es válido en HTML5
  pero no en un selector CSS sin escapar, y este `id` se usa como ancla.
*/
const slug = title
  .normalize('NFD')
  .replace(/[\u0300-\u036f]/g, '')
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-|-$/g, '');
const titleId = `faq-${slug}`;
---
<section class:list={['faq', surface]} aria-labelledby={titleId}>
  <div class="inner">
    <h2 id={titleId} data-enter>{title}</h2>
    <div class="items">
      {items.map((item) => (
        <details class="item">
          <summary>
            <span>{item.q}</span>
            <svg class="mark" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
              <path d="M2 7h10M7 2v10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { background: var(--papel); padding: var(--s-9) 0; }
  .faq.papel-2 { background: var(--papel-2); }
  .inner { max-width: 760px; margin: 0 auto; padding: 0 var(--pad-section-m); }
  h2 {
    font-size: var(--t-h2-m);
    font-weight: 700;
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
    margin-bottom: var(--s-6);
  }

  .items { border-top: 1px solid var(--line); }
  .item { border-bottom: 1px solid var(--line); }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding: var(--s-4) 0;
    cursor: pointer;
    list-style: none;
    font-size: var(--t-h3-m);
    font-weight: 600;
    line-height: var(--lh-h3);
    min-height: 44px;
  }
  summary::-webkit-details-marker { display: none; }
  .mark {
    width: 14px;
    height: 14px;
    flex: none;
    color: var(--verde-deep);
    transition: transform var(--m-fast) var(--m-ease);
  }
  .item[open] .mark { transform: rotate(45deg); }
  .item p {
    color: var(--ink-mute);
    padding-bottom: var(--s-4);
    max-width: 47ch;
  }

  @media (min-width: 900px) {
    h2 { font-size: var(--t-h2); }
    summary { font-size: var(--t-h3); }
  }
</style>
