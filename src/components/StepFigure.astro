---
/**
 * Abstracciones de los cuatro pasos. Mismo vocabulario que UseCaseFigure y que
 * el diagrama de flujo: punto verde = contraparte · tramo con cuña = dinero
 * moviéndose · barra = un monto.
 *
 * Cada figura añade el detalle que distingue a SU paso — eso es lo que las hace
 * información y no ilustración (ADR-0001 §3):
 *
 *   cotiza   · dos montos de largo distinto sobre su pista: escribes uno, ves el otro
 *   chat     · la operación ya escrita dentro de la burbuja, y una respuesta
 *   custodia · el tramo SE DETIENE contra una barra: "antes de mover nada"
 *   entrega  · el tramo termina EN la billetera y no sigue
 *
 * Dirección de arte (2026-09-07): elevación sutil en los contenedores, rellenos
 * por capas y trazos más presentes. Dos decisiones que no seguí al pie de la
 * letra, ambas por accesibilidad:
 *
 *  · El chip activo va en --verde-deep, no en --verde: el verde de marca sobre
 *    papel da 2.02:1 y un gráfico con significado necesita 3:1 (DS §2.4).
 *  · La sombra sale de --elev-pop, no de un valor nuevo, para no abrir una
 *    segunda escala de elevación fuera del Design System.
 *
 * Ningún monto es una cifra: son barras. Una cifra inventada en la Home es
 * justo lo que no se puede publicar.
 *
 * aria-hidden: el h3 y el párrafo de al lado ya lo dicen con palabras.
 */
interface Props {
  kind: 'cotiza' | 'chat' | 'custodia' | 'entrega';
  /**
   * Astro inyecta aquí la clase de ámbito del componente padre. Sin recibirla y
   * volcarla en la raíz, las reglas del padre que apuntan a `.fig` —entre ellas
   * el `order` del zig-zag— nunca aplican.
   */
  class?: string;
}
const { kind, class: className } = Astro.props;
---
<svg class:list={['fig', className]} width="240"
  height="160"
  viewBox="0 0 240 160" fill="none" aria-hidden="true">
  {kind === 'cotiza' && (
    <>
      <rect class="surface lift" x="20" y="14" width="200" height="124" rx="10" />

      {/* La intención es el primer paso del cotizador: una activa, dos en reposo. */}
      <rect class="chip-on" x="34" y="28" width="52" height="20" rx="6" />
      <rect class="chip-on-mark" x="44" y="36" width="32" height="4" rx="2" />
      <rect class="chip-off" x="94" y="28" width="52" height="20" rx="6" />
      <rect class="chip-off-mark" x="104" y="36" width="32" height="4" rx="2" />
      <rect class="chip-off" x="154" y="28" width="52" height="20" rx="6" />
      <rect class="chip-off-mark" x="164" y="36" width="32" height="4" rx="2" />

      {/* Pista completa + monto encima: se ve cuánto es de todo lo que cabe. */}
      <text class="tag" x="34" y="82">CLP</text>
      <rect class="track" x="76" y="74" width="128" height="10" rx="5" />
      <rect class="amount" x="76" y="74" width="104" height="10" rx="5" />
      <path class="rule" d="M34 100h172" />
      <text class="tag" x="34" y="126">USD</text>
      <rect class="track" x="76" y="118" width="128" height="10" rx="5" />
      <rect class="amount" x="76" y="118" width="68" height="10" rx="5" />
    </>
  )}

  {kind === 'chat' && (
    <>
      {/* Tu mensaje, con la operación ya escrita. Burbuja y cola son un solo
          trazo: superpuestas dejaban una costura visible. */}
      <path
        class="surface lift"
        d="M54 14h150a10 10 0 0110 10v42a10 10 0 01-10 10h-4l8 10-22-10H54a10 10 0 01-10-10V24a10 10 0 0110-10z"
      />
      <text class="tag" x="60" y="40">CLP</text>
      <rect class="track" x="98" y="32" width="88" height="9" rx="4.5" />
      <rect class="amount" x="98" y="32" width="64" height="9" rx="4.5" />
      <text class="tag" x="60" y="62">USD</text>
      <rect class="track" x="98" y="54" width="88" height="9" rx="4.5" />
      <rect class="amount" x="98" y="54" width="44" height="9" rx="4.5" />

      {/* La respuesta: alguien contesta. */}
      <path
        class="surface lift"
        d="M38 96h102a10 10 0 0110 10v18a10 10 0 01-10 10H50l-8 10 2-10h-4a10 10 0 01-10-10v-18a10 10 0 0110-10z"
      />
      <circle class="node sm" cx="44" cy="115" r="5" />
      <rect class="say" x="60" y="106" width="72" height="6" rx="3" />
      <rect class="say faint" x="60" y="118" width="44" height="6" rx="3" />
    </>
  )}

  {kind === 'custodia' && (
    <>
      <circle class="node sm" cx="26" cy="74" r="6" />
      <text class="tag mid" x="26" y="106">BANCO</text>
      <path class="link" d="M38 74h40l7-6 7 12 7-6h30" />
      <circle class="node" cx="142" cy="74" r="8" />
      <text class="tag mid" x="142" y="106">DLPAY</text>
      {/* El freno. Es el único paso donde el dinero se queda quieto a propósito:
          se confirma la recepción ANTES de mover nada. Por eso el tramo sale de
          DLPay, avanza y se detiene aquí — y no hay nada después. */}
      <path class="link" d="M152 74h24" />
      <rect class="gate" x="192" y="46" width="7" height="56" rx="3.5" />
    </>
  )}

  {kind === 'entrega' && (
    <>
      <circle class="node" cx="28" cy="78" r="8" />
      <text class="tag mid" x="28" y="110">DLPAY</text>
      {/* h40 llega a 135 y entra en el borde de la billetera (132). Con h28
          moría a 9px y parecía que el dinero no llegaba. */}
      <path class="link" d="M40 78h34l7-6 7 12 7-6h40" />
      {/* La billetera, con la esquina cortada en la diagonal del isotipo.
          El tramo TERMINA aquí: dibujar cualquier cosa después se leería como
          que DLPay mueve el dinero más allá, y ahí termina el servicio. */}
      <path class="wallet" d="M140 50h56l18 18v30a8 8 0 01-8 8h-66a8 8 0 01-8-8V58a8 8 0 018-8z" />
      <text class="tag mid on-wallet" x="173" y="84">USD</text>
    </>
  )}
</svg>

<style>
  .fig { display: block; width: 100%; max-width: 300px; height: auto; }

  /* Contenedores: una tarjeta, dos burbujas. Sobre --papel el relleno es del
     mismo tono, así que lo que las separa del fondo es la elevación, no un
     borde más duro. Valores tomados de --elev-pop, suavizados: el desenfoque
     cabe dentro del viewBox y no se recorta. */
  .surface { fill: var(--papel); stroke: var(--line); stroke-width: 1; stroke-linejoin: round; }
  .lift { filter: drop-shadow(0 4px 10px rgba(11, 19, 32, .10)); }

  /* Toggle: la activa es sólida y su marca interior contrasta contra ella;
     las de reposo son un plano tenue sin borde duro. */
  .chip-on { fill: var(--verde-deep); }
  .chip-on-mark { fill: var(--papel); fill-opacity: .92; }
  .chip-off { fill: var(--tinta); fill-opacity: .05; }
  .chip-off-mark { fill: var(--tinta); fill-opacity: .14; }

  /* Pista y monto. El monto siempre es una barra, nunca una cifra. */
  .track { fill: var(--tinta); fill-opacity: .06; }
  .amount { fill: var(--verde-deep); }

  /* Renglones de la respuesta: dos anchos y dos pesos, como texto real. */
  .say { fill: var(--tinta); fill-opacity: .16; }
  .say.faint { fill-opacity: .09; }

  .node { fill: var(--verde); }
  .node.sm { fill: var(--verde-deep); }

  /* 2.5, no 1.25: estas figuras se dibujan a 300px con un viewBox de 240, más
     del doble de grandes que las de los tres usos. Al mismo grosor nominal se
     veían proporcionalmente más finas. */
  .link {
    stroke: var(--verde-deep);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .wallet {
    fill: var(--tinta);
    fill-opacity: .05;
    stroke: var(--verde-deep);
    stroke-width: 2.5;
    stroke-linejoin: round;
  }
  .gate { fill: var(--ink-mute); }
  .rule { stroke: var(--line); stroke-width: 1; stroke-linecap: round; }

  .tag {
    font-family: var(--f-num);
    font-size: 11px;
    letter-spacing: .04em;
    fill: var(--ink-mute);
  }
  .tag.mid { text-anchor: middle; }
  .on-wallet { fill: var(--verde-deep); font-weight: 600; }
</style>
