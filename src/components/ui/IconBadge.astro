---
/**
 * Icono dentro de una píldora tenue: convierte un icono suelto en una insignia.
 *
 * El fondo es --verde-deep al 12%. Se eligió midiendo, no a ojo: el icono
 * encima queda en **4,59:1** sobre el 3:1 que WCAG pide a un gráfico con
 * significado. Subir la opacidad hace la píldora más visible y el icono peor:
 * al 24% cae a 3,86:1, todavía sobre el piso pero con mucho menos margen.
 * No cambiar sin recalcular.
 *
 * *(Corregido el 2026-09-23: esta nota decía 3,82:1, que es el valor de una
 * píldora al 24%. En algún momento la pastilla se aclaró al 12% y la cifra se
 * quedó con la de antes. El contraste real siempre fue MEJOR que el
 * documentado, así que no había nada roto — pero una cabecera que dice «no
 * cambiar sin recalcular» no puede llevar el número de otra versión.)*
 *
 * `tone` existe porque sobre tinta el verde de marca sí contrasta (8.45:1) y el
 * verde profundo no. Ver Design System §2.4.
 */
import Icon from '../Icon.astro';
import type { IconName } from '../Icon.astro';

interface Props {
  /* La unión se IMPORTA. Estuvo escrita a mano acá hasta el 2026-09-23, así que
     un icono nuevo entraba en el set y no podía usarse en una insignia. */
  name: IconName;
  /** Superficie donde vive. Decide el verde y la opacidad del fondo. */
  tone?: 'light' | 'tinta';
  /**
   * `md` (48px) para bloques apilados: la insignia encabeza su columna.
   * `sm` (36px) para listas en línea, donde el icono va al lado del texto y una
   * píldora de 48px rompería la alineación con la altura de mayúscula del
   * titular. Conserva el icono en 20px, que es el escalón del Design System §7.
   */
  size?: 'sm' | 'md';
  class?: string;
}
const { name, tone = 'light', size = 'md', class: className } = Astro.props;
const px = size === 'sm' ? 20 : 22;
---
<span class:list={['badge', tone, size, className]}>
  <Icon name={name} size={px} class="icon" />
</span>

<style>
  .badge {
    border-radius: 50%;
    display: grid;
    place-items: center;
    flex: none;
  }
  .md { width: 48px; height: 48px; }
  .sm { width: 36px; height: 36px; }
  /* El verde de `--verde-deep` al 12%. Va escrito a mano porque `color-mix()`
     queda por debajo del objetivo de CSS del proyecto (`cssTarget` en
     `astro.config.mjs`), así que este literal hay que moverlo si el token se
     mueve — como pasó el 2026-09-17, cuando se quedó en el valor anterior. */
  .light { background: rgba(10, 114, 80, .12); }
  .tinta { background: rgba(22, 199, 132, .14); }

  .icon { display: block; }
  .light .icon { color: var(--verde-deep); }
  .tinta .icon { color: var(--verde); }
</style>
