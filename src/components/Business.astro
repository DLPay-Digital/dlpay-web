---
/**
 * Bifurcación Personas / Empresas (phase-2.5 §2 secciones 4 y 5, fusionadas).
 *
 * Tardía y clara: la Home no se vuelve corporativa, pero reconoce a la empresa
 * y la lleva a su experiencia (principio UX 8).
 *
 * Enlaza a /empresas/, que es la experiencia propia de este público.
 */
import Icon from './Icon.astro';

---
<section
  class="business on-tinta-surface"
  id="empresas"
  aria-labelledby="business-title"
>
  {/* La operación de una empresa dibujada a gran escala: una tesorería paga a
      muchas contrapartes. Es la MISMA topología de la tarjeta "Pagar desde tu
      empresa", ampliada y sangrada por el borde.

      No es papel tapiz ni una "red de nodos" —ambas prohibidas por ADR-0001 §3—
      porque tiene origen único, dirección y significado: es esta sección
      dibujada. Se sangra por la derecha para que se lea como sistema y no como
      ilustración, y desaparece en móvil, donde el texto necesita el ancho. */}
  <svg class="mesh" width="420" height="340" viewBox="0 0 420 340" fill="none" aria-hidden="true">
    <path class="branch" d="M212 170h24l130-130h14" />
    <path class="branch" d="M212 170h24l65-65h79" />
    <path class="branch" d="M212 170h168" />
    <path class="branch" d="M212 170h24l65 65h79" />
    <path class="branch" d="M212 170h24l130 130h14" />
    <path class="trunk" d="M46 170h96l12-10 12 20 12-10h34" />
    <circle class="src" cx="30" cy="170" r="8" />
    <circle class="dst" cx="380" cy="40" r="5" />
    <circle class="dst" cx="380" cy="105" r="5" />
    <circle class="dst" cx="380" cy="170" r="5" />
    <circle class="dst" cx="380" cy="235" r="5" />
    <circle class="dst" cx="380" cy="300" r="5" />
  </svg>

  <div class="inner">
    <div class="copy">
      <h2 id="business-title" data-enter>¿Tu empresa paga al exterior?</h2>
      <p>
        Pagos a proveedores, tesorería en dólares y operaciones recurrentes, con un
        ejecutivo asignado, condiciones conversadas y verificación de la empresa.
        La misma mesa, otro tamaño de operación.
      </p>
      <a class="ghost" href="/empresas/">
        Ver DLPay Empresas
        <Icon name="chevron" class="chev" />
      </a>
    </div>
  </div>
</section>

<style>
  .business {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--tinta-2);
    color: var(--on-tinta);
    padding: var(--s-9) 0;
  }

  /* ── Geometría de fondo ──────────────────────────────────────────────────
     Sangrada por la derecha. Contraste bajo a propósito: acompaña, no compite.
     */
  .mesh {
    position: absolute;
    z-index: -1;
    top: 50%;
    /* Sangra por ARRIBA y ABAJO, no por la derecha: recortando el costado se
       perdían los puntos de destino, y sin ellos la figura deja de decir "una
       tesorería paga a muchos" y queda en líneas que se van del borde. */
    right: -24px;
    width: 520px;
    height: 421px;
    transform: translateY(-50%);
    /* Nunca captura el puntero: está detrás y no es interactiva. */
    pointer-events: none;
    display: none;
  }
  .trunk, .branch {
    stroke: var(--verde);
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .trunk { stroke-opacity: .30; }
  .branch { stroke-opacity: .16; }
  .src { fill: var(--verde); fill-opacity: .38; }
  .dst { fill: var(--verde); fill-opacity: .22; }

  .inner { position: relative; max-width: var(--container); margin: 0 auto; padding: 0 var(--pad-section-m); }
  .copy { max-width: 47ch; }
  h2 {
    font-size: var(--t-h2-m);
    font-weight: 700;
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
    margin-bottom: var(--s-3);
  }
  .copy p { color: var(--on-tinta-mute); margin-bottom: var(--s-5); }

  .ghost {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    border: 1px solid var(--verde);
    color: var(--verde);
    text-decoration: none;
    font-size: var(--t-body-sm);
    font-weight: 600;
    padding: var(--s-4) var(--s-5);
    border-radius: var(--r-2);
  }
  .ghost { transition: background-color var(--m-fast) var(--m-ease), color var(--m-fast) var(--m-ease); }
  .ghost:hover { background: var(--verde); color: var(--on-verde); }
  .chev { width: 15px; height: 15px; }

  @media (min-width: 900px) {
    .inner { padding-inline: var(--pad-section); }
    h2 { font-size: var(--t-h2); }
  }

  /* 1140px, no 900: por debajo el punto de origen de la figura se metía dentro
     del párrafo. Con el texto a 56ch (~476px) y la figura de 520px sangrada 24,
     la holgura recién aparece aquí — 40px a 1140, 100px a 1200. */
  @media (min-width: 1140px) {
    .mesh { display: block; }
  }
</style>
