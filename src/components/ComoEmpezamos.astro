---
/**
 * «Cómo empezamos», en `/empresas`: **la carpeta y el recorrido.**
 *
 * Pedido por Sebastián el 2026-10-02: le gustaba «Ten esto a mano» con sus
 * figuras pequeñas, «pero aun así yo veo esa sección y está todo desordenado».
 * Lo que la desordenaba, medido sobre el render: dos listas sin relación lado
 * a lado —una de cosas, a la izquierda, bajo el titular; otra de pasos, a la
 * derecha, sin titular—, con los números de los pasos en cajas de 26 px que se
 * leían como casillas de verificación, y nada que dijera cuál va primero.
 *
 * ── El orden nuevo ─────────────────────────────────────────────────────────
 *
 * Arriba, el titular y su bajada a la izquierda, y a la derecha lo que hay que
 * juntar ANTES de escribir. Abajo y a todo el ancho, los cuatro pasos, de
 * izquierda a derecha. Se lee en el orden en que pasa.
 *
 * · **«Ten esto a mano» es una carpeta**: la pestaña lleva el titular y su
 *   canto baja en la diagonal de la marca (0,673 de ancho por alto, los 34° del
 *   isotipo). Dentro, los tres iconos del dato en una placa de 48 px. Desde el
 *   2026-10-02 la dibuja `Carpeta.astro`, extraída en su tercer uso
 *   (`/como-funciona`); aquí no cambió ni un píxel.
 * · **Los pasos son un recorrido**: cada número en su nodo redondo —ya no en
 *   una caja— y, entre uno y otro, un filete con un chevron que apunta al
 *   siguiente: el «marcador de paso» del Design System §6. El filete es
 *   `--line`, sin significado; lo que dice el sentido es el chevron.
 *
 * Ninguna palabra nueva: `checklist` y `onboarding` de business.ts, y el
 * titular, la bajada y «Ten esto a mano» siguen en la página.
 *
 * Accesibilidad: dos listas reales, la de pasos ordenada, con `role="list"`;
 * placas, filetes y chevrones `aria-hidden`. El número del paso lo da la lista
 * ordenada, así que el nodo visible también va `aria-hidden`.
 */
import Icon from './Icon.astro';
import Carpeta from './Carpeta.astro';
import type { ChecklistItem } from '../content/process.ts';

interface Props {
  checklist: readonly ChecklistItem[];
  steps: readonly string[];
}
const { checklist, steps } = Astro.props;
---
<div class="ce">
  <div class="ce-cabecera">
    <slot name="cabecera" />
  </div>

  <div class="ce-carpeta">
    <Carpeta fondo="papel-2" titulo="Ten esto a mano" nivel="h3" items={checklist} />
  </div>

  <ol class="ce-pasos" role="list">
    {steps.map((step, i) => (
      <li>
        <span class="ce-nodo num" aria-hidden="true">{i + 1}</span>
        {i < steps.length - 1 && (
          <span class="ce-hacia" aria-hidden="true"><Icon name="chevron" size={16} /></span>
        )}
        <span class="ce-texto">{step}</span>
      </li>
    ))}
  </ol>
</div>

<style>
  .ce {
    --ce-nodo: 44px;
    --ce-gap: var(--s-6);
    display: grid;
    gap: var(--s-7);
  }
  .ce-cabecera :global(p) { color: var(--ink-mute); max-width: 40ch; }

  /* La carpeta la dibuja `Carpeta.astro`; aquí sólo se coloca. */
  .ce-carpeta { min-width: 0; }

  /*
    ── El recorrido ────────────────────────────────────────────────────────
    En móvil, de pie: nodo a la izquierda, texto a la derecha, y el filete
    baja de un nodo al siguiente con el chevron girado hacia abajo.
  */
  .ce-pasos {
    display: grid;
    gap: var(--ce-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ce-pasos li {
    position: relative;
    display: grid;
    grid-template-columns: var(--ce-nodo) minmax(0, 1fr);
    column-gap: var(--s-4);
    align-items: start;
  }
  .ce-nodo {
    display: grid;
    place-items: center;
    width: var(--ce-nodo);
    height: var(--ce-nodo);
    border-radius: 50%;
    border: 1.5px solid var(--ink);
    background: var(--papel);
    font-size: var(--t-body);
    font-weight: 600;
    color: var(--ink);
  }
  .ce-texto { padding-top: 10px; color: var(--ink); max-width: 40ch; }

  /* El filete, de este nodo al siguiente, y el chevron al final. */
  .ce-pasos li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(var(--ce-nodo) / 2 - .5px);
    top: calc(var(--ce-nodo) + var(--s-2));
    bottom: calc(-1 * var(--ce-gap) + var(--s-2) + 12px);
    border-left: 1px solid var(--line);
  }
  .ce-hacia {
    position: absolute;
    left: calc(var(--ce-nodo) / 2 - 8px);
    bottom: calc(-1 * var(--ce-gap) + var(--s-1));
    width: 16px;
    height: 16px;
    color: var(--ink-mute);
    transform: rotate(90deg);
  }
  .ce-hacia :global(svg) { display: block; width: 16px; height: 16px; }

  @media (min-width: 760px) {
    /* Arriba, titular y carpeta; abajo, el recorrido a todo el ancho. */
    .ce {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      column-gap: var(--s-8);
      row-gap: var(--s-8);
      align-items: start;
    }
    .ce-pasos { grid-column: 1 / -1; }
  }

  @media (min-width: 900px) {
    /* La misma rejilla de cuatro arriba y abajo: la carpeta empieza justo
       sobre el paso 3, y el titular sobre el 1. */
    .ce {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: var(--ce-gap);
    }
    .ce-cabecera { grid-column: 1 / 3; }
    .ce-carpeta { grid-column: 3 / 5; }
    .ce-pasos {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: var(--ce-gap);
    }
    .ce-pasos li {
      display: flex;
      flex-direction: column;
      gap: var(--s-4);
    }
    .ce-texto { padding-top: 0; max-width: 26ch; }
    /* En horizontal, el filete sale a la derecha del nodo y llega hasta el
       siguiente, que está una columna y un hueco más allá. */
    .ce-pasos li:not(:last-child)::after {
      left: calc(var(--ce-nodo) + var(--s-2));
      right: calc(-1 * var(--ce-gap) + var(--s-2) + 12px);
      top: calc(var(--ce-nodo) / 2 - .5px);
      bottom: auto;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .ce-hacia {
      left: auto;
      right: calc(-1 * var(--ce-gap) + var(--s-1));
      top: calc(var(--ce-nodo) / 2 - 8px);
      bottom: auto;
      transform: none;
    }
  }
</style>
