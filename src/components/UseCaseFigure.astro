---
/**
 * Abstracciones de los tres usos. NO son ilustraciones.
 *
 * Cada una está construida con el mismo vocabulario que el diagrama de flujo
 * (Design System §6): un punto verde es una contraparte, un tramo con cuña es
 * dinero moviéndose. Aquí no se inventa una gramática nueva; se reusa la que ya
 * explica el recorrido en /como-funciona.
 *
 * Lo que distingue a las tres es la TOPOLOGÍA, y esa topología es el dato:
 *
 *   cruza     · uno a uno, atravesando una frontera  → sales de Chile
 *   convierte · el mismo valor, dos unidades, sin ir a ninguna parte
 *   reparte   · uno a varios, un tronco que se bifurca → varios destinatarios
 *
 * Por eso cumplen ADR-0001 §3: cada trazo representa movimiento, flujo de valor
 * o un paso. Si las tres fueran el mismo rectángulo con una línea, no dirían
 * nada y serían decoración.
 *
 * aria-hidden: el h3 y el párrafo de al lado ya dicen esto con palabras. Un
 * lector de pantalla no debe oírlo dos veces.
 */
interface Props {
  kind: 'cruza' | 'convierte' | 'reparte';
  class?: string;
}
const { kind, class: className } = Astro.props;
---
<svg
  class:list={['fig', className]}
  width="132"
  height="46"
  viewBox="0 0 132 46"
  fill="none"
  aria-hidden="true"
>
  {kind === 'cruza' && (
    <>
      {/* La frontera. Es lo único punteado del sistema: marca un límite, no un flujo. */}
      <path class="edge" d="M66 6v26" stroke-dasharray="3 4" />
      <circle class="node" cx="5" cy="19" r="4.5" />
      {/* Misma cuña que el conector del diagrama de flujo, sin reinventarla. */}
      <path class="link" d="M14 19h40l6-5 6 10 6-5h46" />
      <circle class="node" cx="127" cy="19" r="4.5" />
      <text class="tag" x="0" y="43">CLP</text>
      <text class="tag" x="132" y="43" text-anchor="end">USD</text>
    </>
  )}

  {kind === 'convierte' && (
    <>
      {/* Dos barras de LARGO IDÉNTICO: el valor no cambia, cambia la unidad.
          No hay frontera ni segunda contraparte — el dinero no se va. */}
      <text class="tag" x="0" y="15">CLP</text>
      <path class="bar" d="M32 11h96" />
      <text class="tag" x="0" y="41">USD</text>
      <path class="bar" d="M32 37h96" />
      {/* La misma cuña del diagrama girada 90° y a escala 0,55 — proporciones
          exactas (12·6·6·6·10 → 7·3·3·3·6), no un zigzag a ojo. */}
      <path class="link" d="M66 13v7l3 3-6 3 3 3v6" />
    </>
  )}

  {kind === 'reparte' && (
    <>
      <circle class="node" cx="5" cy="23" r="4.5" />
      {/* Un tronco que se bifurca: una sola operación, varios destinatarios. */}
      <path class="link" d="M14 23h34l6-5 6 10 6-5h20" />
      <path class="link" d="M86 23h8l14-14h6" />
      <path class="link" d="M86 23h28" />
      <path class="link" d="M86 23h8l14 14h6" />
      <circle class="node sm" cx="118" cy="9" r="3.5" />
      <circle class="node sm" cx="118" cy="23" r="3.5" />
      <circle class="node sm" cx="118" cy="37" r="3.5" />
    </>
  )}
</svg>

<style>
  /* En móvil la columna mide ~280px y la figura fija de 132px ocupaba el 47%:
     se leía como un gráfico huérfano sobre un bloque de texto que la doblaba.
     Ahora escala con la columna y recupera su tamaño de rejilla en escritorio,
     donde 132px sobre una columna de ~330px sí es la proporción correcta. */
  .fig { display: block; width: 100%; max-width: 220px; height: auto; }
  @media (min-width: 760px) {
    .fig { max-width: 132px; }
  }

  /* Contrapartes. Verde de marca: es una forma llena, no texto ni trazo fino. */
  .node { fill: var(--verde); }
  .node.sm { fill: var(--verde-deep); }

  /* Trazos con significado: sobre papel necesitan 3:1, de ahí verde-deep y
     sin bajarles la opacidad (misma regla que el conector del diagrama). */
  .link, .bar {
    stroke: var(--verde-deep);
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* La barra es el monto: más peso, porque es la cifra la que manda. */
  .bar { stroke-width: 2; }

  /* La frontera no es flujo: neutra, para no competir con el verde. */
  .edge { stroke: var(--line); stroke-width: 1.25; }

  .tag {
    font-family: var(--f-num);
    font-size: 11px;
    letter-spacing: .04em;
    fill: var(--ink-mute);
  }
</style>
