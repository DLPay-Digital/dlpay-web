        <path class="arc-halo" data-idx="4"/><path class="arc-halo" data-idx="5"/><path class="arc-halo" data-idx="6"/><path class="arc-halo" data-idx="7"/>
        <path class="arc" data-idx="0"/><path class="arc" data-idx="1"/><path class="arc" data-idx="2"/><path class="arc" data-idx="3"/>
        <path class="arc" data-idx="4"/><path class="arc" data-idx="5"/><path class="arc" data-idx="6"/><path class="arc" data-idx="7"/>
      </g>
    </g>
    <circle class="globe-rim" cx="350" cy="250" r="210"/>
    <g id="chile-anchor">
      <circle class="chile-ping-slow" cx="0" cy="0" r="6" fill="none" stroke="#22e88f" stroke-width="1"/>
