60.8,64.8,-165.0,64.4,-168.1,65.7,-161.7,66.1,-166.8,68.4,-166.2,68.9,-156.6,71.4,-141.0,69.7]],[[-154.8,19.5,-155.9,19.1,-155.9,20.3,-154.8,19.5]],[[-156.3,20.9,-156.4,20.6,-156.7,20.9,-156.3,20.9]],[[-157.3,21.2,-156.8,21.1,-157.3,21.1,-157.3,21.2]],[[-158.0,21.7,-158.1,21.3,-158.3,21.6,-158.0,21.7]],[[-159.4,22.2,-159.5,21.9,-159.8,22.1,-159.4,22.2]],[[-152.1,57.6,-154.0,56.7,-154.7,57.5,-152.1,57.6]],[[-165.7,60.3,-166.2,59.8,-167.5,60.2,-165.7,60.3]],[[-171.7,63.8,-170.5,63.7,-168.7,63.3,-169.5,63.0,-171.7,63.8]],[[19.9,-24.8,21.6,-26.7,23.3,-25.3,25.7,-25.5,28.0,-22.8,30.7,-22.2,31.9,-24.4,30.7,-26.7,32.8,-26.7,32.2,-28.8,28.2,-32.8,19.6,-34.8,18.4,-34.1,18.2,-31.7,16.3,-28.6,19.9,-28.5,19.9,-24.8],[29.0,-29.0,28.1,-28.9,27.0,-29.9,28.1,-30.5,29.0,-29.0]]];
  // AUTO: worldmap-data end

  // Data de negocio: destinos. NO se autogenera, editar acá cuando cambien los países.
  const DESTS=[
    {name:"USA",lat:40.7,lon:-74,km:"8.300"},
    {name:"MÉXICO",lat:19.4,lon:-99,km:"6.600"},
    {name:"VENEZUELA",lat:10.5,lon:-66.9,km:"4.700"},
    {name:"ESPAÑA",lat:40.4,lon:-3.7,km:"10.700"},
    {name:"SUDÁFRICA",lat:-26.2,lon:28,km:"9.500"},
    {name:"INDIA",lat:28.6,lon:77.2,km:"17.000"},
    {name:"JAPÓN",lat:35.7,lon:139.7,km:"17.300"},
    {name:"AUSTRALIA",lat:-33.9,lon:151.2,km:"11.300"}
  ];
  const CHILE_ANCHOR={lat:-33.4,lon:-70.6};

  const sin=Math.sin,cos=Math.cos,atan2=Math.atan2,PI=Math.PI,hypot=Math.hypot,abs=Math.abs,ceil=Math.ceil,max=Math.max;
  const p0=LAT0*PI/180,sinp0=sin(p0),cosp0=cos(p0);

  function proj(lon,lat){
    const lam=(lon-lon0)*PI/180,phi=lat*PI/180;
    const sinp=sin(phi),cosp=cos(phi),coslam=cos(lam);
    const c=sinp0*sinp+cosp0*cosp*coslam;
    if(c<0)return null;
    return{x:CX+R*cosp*sin(lam),y:CY-R*(cosp0*sinp-sinp0*cosp*coslam)};
  }

  // Terminator clipping con cierre por arcos sobre el borde del globo (estilo d3-geo)
  function ringPath(flat){
    const n=flat.length;if(n<6)return'';const N=n/2;
    const xs=new Array(N),ys=new Array(N),cs=new Array(N);
    let anyVis=false,allVis=true;
    for(let i=0,j=0;i<n;i+=2,j++){
      const lam=(flat[i]-lon0)*PI/180,phi=flat[i+1]*PI/180;
      const sinp=sin(phi),cosp=cos(phi),coslam=cos(lam);
      cs[j]=sinp0*sinp+cosp0*cosp*coslam;
      xs[j]=CX+R*cosp*sin(lam);ys[j]=CY-R*(cosp0*sinp-sinp0*cosp*coslam);
      if(cs[j]>=0)anyVis=true;else allVis=false;
    }
    if(!anyVis)return'';
    if(allVis){let d='M'+xs[0].toFixed(1)+','+ys[0].toFixed(1);for(let i=1;i<N;i++)d+='L'+xs[i].toFixed(1)+','+ys[i].toFixed(1);return d+'Z';}
    let startIdx=0;while(cs[startIdx]<0)startIdx++;
    let d='M'+xs[startIdx].toFixed(1)+','+ys[startIdx].toFixed(1);
    let lastExit=null;
    function snap(cx,cy){const dx=cx-CX,dy=cy-CY,dL=hypot(dx,dy);if(dL>0){return[CX+dx*R/dL,CY+dy*R/dL];}return[cx,cy];}
    function arc(fromA,toA){
      let delta=toA-fromA;
      while(delta>PI)delta-=2*PI;while(delta<-PI)delta+=2*PI;
      const steps=max(3,ceil(abs(delta)*24));
      for(let s=1;s<=steps;s++){const a=fromA+delta*s/steps;d+='L'+(CX+R*cos(a)).toFixed(1)+','+(CY+R*sin(a)).toFixed(1);}
    }
    for(let k=0;k<N;k++){
      const i=(startIdx+k)%N,j=(i+1)%N;
      const pc=cs[i],nc=cs[j];
      if(pc>=0&&nc>=0){if(j!==startIdx)d+='L'+xs[j].toFixed(1)+','+ys[j].toFixed(1);}
      else if(pc>=0&&nc<0){
        const t=pc/(pc-nc);
        const [cx,cy]=snap(xs[i]+t*(xs[j]-xs[i]),ys[i]+t*(ys[j]-ys[i]));
        d+='L'+cx.toFixed(1)+','+cy.toFixed(1);
        lastExit=atan2(cy-CY,cx-CX);
      }
      else if(pc<0&&nc>=0){
        const t=pc/(pc-nc);
        const [cx,cy]=snap(xs[i]+t*(xs[j]-xs[i]),ys[i]+t*(ys[j]-ys[i]));
        const entryA=atan2(cy-CY,cx-CX);
        if(lastExit!==null)arc(lastExit,entryA);
        lastExit=null;
        if(j!==startIdx)d+='L'+xs[j].toFixed(1)+','+ys[j].toFixed(1);
      }
    }
    if(lastExit!==null){arc(lastExit,atan2(ys[startIdx]-CY,xs[startIdx]-CX));}
    return d+'Z';
  }

  function polyPath(m){let d='';for(let i=0;i<m.length;i++){const p=m[i];for(let j=0;j<p.length;j++)d+=ringPath(p[j]);}return d;}
  function arcPath(a,b){const mx=(a.x+b.x)/2,my=(a.y+b.y)/2;const dcx=mx-CX,dcy=my-CY,dcL=hypot(dcx,dcy);if(dcL<1)return null;const chord=hypot(a.x-b.x,a.y-b.y);const off=chord*0.25;const cx=mx+(dcx/dcL)*off,cy=my+(dcy/dcL)*off;return'M'+a.x.toFixed(1)+','+a.y.toFixed(1)+' Q'+cx.toFixed(1)+','+cy.toFixed(1)+' '+b.x.toFixed(1)+','+b.y.toFixed(1);}

  const landEl=document.getElementById('land-base'),landTex=document.getElementById('land-texture'),bordersEl=document.getElementById('borders');
  const chileGlow=document.getElementById('chile-glow'),chileFill=document.getElementById('chile-fill'),chileStroke=document.getElementById('chile-stroke');
  const chileAnchorEl=document.getElementById('chile-anchor'),chileLabelEl=document.getElementById('chile-label');
  const chileLabelText1=chileLabelEl.querySelectorAll('text')[0],chileLabelText2=chileLabelEl.querySelectorAll('text')[1];
  const destsGroup=document.getElementById('dests');
  const arcs=document.querySelectorAll('.arc'),arcHalos=document.querySelectorAll('.arc-halo');

  const destEls=DESTS.map((d,i)=>{
    const g=document.createElementNS('http://www.w3.org/2000/svg','g');
    g.setAttribute('class','dest');
    g.innerHTML='<circle cx="0" cy="0" r="10" fill="#22e88f" opacity="0.1"/><circle cx="0" cy="0" r="6" fill="none" stroke="#22e88f" stroke-opacity="0.4" stroke-width="1"/><circle cx="0" cy="0" r="3.2" fill="#22e88f"/><text class="dest-label" x="12" y="-4">'+d.name+'</text><text class="dest-info" x="12" y="8">USD · '+d.km+' KM</text>';
    destsGroup.appendChild(g);
    return g;
  });

  function update(){
    const landD=polyPath(LAND);landEl.setAttribute('d',landD);landTex.setAttribute('d',landD);
    bordersEl.setAttribute('d',polyPath(BORDERS));
    const chileD=polyPath(CHILE);chileGlow.setAttribute('d',chileD);chileFill.setAttribute('d',chileD);chileStroke.setAttribute('d',chileD);
    const s=proj(CHILE_ANCHOR.lon,CHILE_ANCHOR.lat);
    if(s){
      chileAnchorEl.style.opacity='1';
      chileAnchorEl.setAttribute('transform','translate('+s.x+','+s.y+')');
      chileLabelEl.style.opacity='1';
      const dx=s.x-CX,dy=s.y-CY,len=hypot(dx,dy);
      const lx=s.x+(dx/len)*22,ly=s.y+(dy/len)*22;
      const anchor=(s.x>CX)?'start':'end',xOff=(s.x>CX)?6:-6;
      chileLabelEl.setAttribute('transform','translate('+(lx+xOff)+','+ly+')');
      chileLabelText1.setAttribute('text-anchor',anchor);
      chileLabelText2.setAttribute('text-anchor',anchor);
    }else{
      chileAnchorEl.style.opacity='0';
      chileLabelEl.style.opacity='0';
    }
    DESTS.forEach((dest,i)=>{
      const d=proj(dest.lon,dest.lat);
      const arcEl=arcs[i],arcHaloEl=arcHalos[i];
      if(d){
        destEls[i].style.opacity='1';
        destEls[i].setAttribute('transform','translate('+d.x+','+d.y+')');
        const lbl=destEls[i].querySelector('.dest-label'),inf=destEls[i].querySelector('.dest-info');
        if(d.x>CX){lbl.setAttribute('x','12');lbl.setAttribute('text-anchor','start');inf.setAttribute('x','12');inf.setAttribute('text-anchor','start');}
        else{lbl.setAttribute('x','-12');lbl.setAttribute('text-anchor','end');inf.setAttribute('x','-12');inf.setAttribute('text-anchor','end');}
        if(s){const arcD=arcPath(s,d);if(arcD){arcEl.setAttribute('d',arcD);arcHaloEl.setAttribute('d',arcD);arcEl.style.opacity='1';arcHaloEl.style.opacity='1';}}
        else{arcEl.style.opacity='0';arcHaloEl.style.opacity='0';}
      }else{
        destEls[i].style.opacity='0';
        arcEl.style.opacity='0';
        arcHaloEl.style.opacity='0';
      }
    });
  }

  // motion-v1-e2: prefers-reduced-motion detiene rotación, globo estático en lon0=-40°
  const reduced=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(reduced){
    update();
  }else{
    // Se dibuja una vez para que el globo esté completo antes de entrar en
    // pantalla: si arrancara vacío, la primera vuelta se vería aparecer.
    update();

    /*
      Guardarraíl de visibilidad. Sin esto el bucle proyecta ~1.500 vértices,
      interpola los cruces del terminador y reescribe ~13 KB de atributos `d`
      SESENTA VECES POR SEGUNDO durante TODA la navegación de la Home, incluso
      con el globo a miles de píxeles del viewport. Medido antes del arreglo:
      con el globo en top=-5519 los `path` seguían cambiando.

      El patrón —IntersectionObserver— es el que ya usa el sitio en
      `Motion.astro` y en la barra fija del cotizador. Dos notas:

      · `last=0` al pausar. El delta se mide contra el último fotograma, así que
        sin reiniciarlo la primera vuelta tras volver al viewport aplicaría de
        golpe todo el tiempo que el globo estuvo fuera y daría un salto.
      · Sin `IntersectionObserver` —navegador antiguo— se rota siempre, que es
        exactamente el comportamiento anterior. Degradar es perder la
        optimización, nunca el globo.
    */
    let last=0, corriendo=false, visible=true;
    function tick(t){
      if(!visible){corriendo=false;last=0;return;}
      if(last>0){const dt=(t-last)/1000;lon0+=6*dt;if(lon0>180)lon0-=360;}
      last=t;
      update();
      requestAnimationFrame(tick);
    }
    function arranca(){
      if(corriendo||!visible)return;
      corriendo=true;
      requestAnimationFrame(tick);
    }
    const raiz=document.querySelector('.dlpay-globe-only');
    if(raiz && 'IntersectionObserver' in window){
      visible=false;
      new IntersectionObserver(function(entradas){
        visible=entradas[0].isIntersecting;
        arranca();
      }).observe(raiz);
    }
    arranca();
  }
})();
