---
/**
 * Isotipo DLPay: monograma D+P con el corte diagonal y la cola en punta hacia
 * abajo-izquierda — el vector de movimiento del que sale todo el sistema
 * geométrico (ADR-0001 §2 y §3).
 *
 * Trazado del asset real `logos/logo 1.png` el 2026-09-07. Antes había aquí un
 * dibujo aproximado que había perdido justamente el corte diagonal, es decir,
 * lo que define la marca. Los assets reales mandan (ADR-0001).
 *
 * `fill-rule="evenodd"` es necesario: el contrapunzón y el corte son huecos.
 */
interface Props { class?: string }
const { class: className } = Astro.props;
---
<svg
  class={className}
  viewBox="0 0 100.0 75.11"
  role="img"
  aria-label="DLPay"
  fill="currentColor"
  fill-rule="evenodd"
