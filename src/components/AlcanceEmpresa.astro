---
/**
 * «Hasta dónde llega nuestra parte», en `/empresas`: **el relevo.**
 *
 * Sustituye en esta página al eje de alcance (`EjeDeAlcance.astro`, que se
 * queda para `/como-funciona`). Pedido por Sebastián el 2026-10-02: aquella
 * figura —una línea de 1 px con tres puntos de 9— «es como una figura hecha sin
 * ganas y esfuerzo».
 *
 * ── Qué dice ───────────────────────────────────────────────────────────────
 *
 * Lo mismo que el eje y con los mismos datos de `content/scope.ts`, sin una
 * palabra nueva: hasta dónde llega lo nuestro, dónde lo entregamos y qué hace
 * después la empresa. Lo que cambia es que ahora se VE:
 *
 * · **Nuestra parte es un bloque en tinta**, con sus tres estaciones sobre un
 *   tramo verde —«el tramo que es nuestro», Design System §6.2—: los pesos de la
 *   empresa, nosotros cambiando y verificando, y la divisa en la
 *   billetera que indique.
 * · **El bloque termina en el corte de la marca**, a 34°, como los puentes y las
 *   cuñas del héroe. Justo antes del corte, la frase de la bisagra: «Ahí termina
 *   nuestra parte: desde ese punto decide tu empresa». Ya no es una nota de
 *   13 px al pie de una línea: es lo último que dice el bloque.
 * · **En el corte, la cuña**: el único punto de la figura donde el valor cambia
 *   de manos, igual que en el eje.
 * · **Fuera, la línea sigue en `--ink-mute`** —«existe, es real, no es
 *   nuestro»— y se abre en las tres salidas de la empresa. La tercera lleva su
 *   aviso pegado, «no lo realiza DLPay», que es un trozo de la salvedad.
 *
 * Los iconos son los del set (§7): banco, la marca, billetera; y empresa,
 * billetera, banco. La billetera sale dos veces porque es la misma: donde la
 * dejamos y desde donde la empresa decide.
 *
 * ── Por qué un componente nuevo y no rehacer el eje ────────────────────────
 *
 * El eje lo usa también `/como-funciona` en su forma corta —sin el tramo
 * nuestro, porque esa página ya contó los seis pasos justo encima— y allí
 * funciona. Lo que no funcionaba era esta forma larga. Los DATOS siguen siendo
 * los mismos y en un solo sitio (`scope.ts`), que es lo que de verdad importa:
 * que las páginas no puedan decir cosas distintas sobre dónde termina el
 * servicio.
 *
 * ── Accesibilidad ──────────────────────────────────────────────────────────
 *
 * Dos listas reales —las estaciones, ordenada; las salidas, no— con
 * `role="list"`. Iconos, tramo, cuña y líneas van `aria-hidden`: nada se dice
 * sólo con la posición o el color, todo está en el texto, en orden de lectura.
 */
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import type { IconName } from './Icon.astro';
import type { Hinge, Milestone } from '../content/scope.ts';

interface Props {
  milestones: readonly Milestone[];
  hinge: Hinge;
  /** Lo que el sitio NO promete. Hasta el 2026-10-22 eran `options`: las tres
      salidas desde la billetera, cuando el servicio terminaba ahí. */
  caveats: readonly string[];
}
const { milestones, hinge, caveats } = Astro.props;

/*
  El icono de cada estación va por posición, así que si el dato cambia de largo
  el build para en vez de dibujar un banco junto a otra cosa.

  **El tercero era `wallet` hasta el 2026-10-22**: la empresa recibía en una
  billetera y ahí terminaba lo nuestro. Con ADR-0014 el tramo llega a quien
  recibe, así que el icono es `people` — y no `bank`, que nombraría un canal
  que nadie ha decidido (D16, reabierta).
*/
const ICONOS_HITOS: readonly (IconName | 'marca')[] = ['bank', 'marca', 'people'];
if (milestones.length !== ICONOS_HITOS.length) {
  throw new Error('AlcanceEmpresa: los hitos de scope.ts cambiaron de número; revisa sus iconos.');
}
---
<div class="al">
  <div class="al-tramo">
    <div class="al-banda">
      {/* El rótulo nombra la lista: «Nuestra parte, lista, 3 elementos». */}
      <p class="al-rot" id="alcance-nuestra-parte">Nuestra parte</p>
      <ol class="al-hitos" role="list" aria-labelledby="alcance-nuestra-parte">
        {milestones.map((m, i) => (
          <li class="al-hito">
            {/* El tramo hasta la estación siguiente, y en el penúltimo la cuña:
                el dinero cambia de manos al llegar a la última. Cuelgan de cada
                hito y no de la figura entera para que la geometría salga de las
                piezas reales — ver el comentario de `.al-via`. */}
            {i < milestones.length - 1 && <span class="al-via" aria-hidden="true"></span>}
            {i === milestones.length - 2 && (
              <svg class="al-cuna" viewBox="0 0 56 20" fill="none" aria-hidden="true">
                {/* `data-draw`: se dibuja al entrar (Motion.astro). Con
                    movimiento reducido, quieta. */}
                <path d="M0 10h15.4l8.4-7 8.4 14 8.4-7h15.4" stroke="currentColor" stroke-width="3" stroke-linejoin="miter" data-draw />
              </svg>
            )}
            <span class="al-nodo" aria-hidden="true">
              {ICONOS_HITOS[i] === 'marca' ? <Logo class="al-marca" /> : <Icon name={ICONOS_HITOS[i] as IconName} size={24} />}
            </span>
            <span class="al-que">{m.what}</span>
            {/* La coma, sólo para el lector de pantalla: sin ella oía
                «Los pesos de tu empresa CLP» de corrido. */}
            {m.data && <span class="al-dato"><span class="sr-only">, </span>{m.data}</span>}
          </li>
        ))}
      </ol>
      <p class="al-bisagra">
        <span class="al-hasta">{hinge.until}</span>
        <span class="al-desde">{hinge.from}</span>
      </p>
    </div>
  </div>

  {/*
    Las salvedades. **Eran las tres salidas de la empresa**, cada una con su
    icono, y la tercera marcada «no lo realiza DLPay» porque cruzaba el límite.
    ADR-0014 cruzó ese límite, así que las salidas se quedaron sin sujeto: lo
    que queda por decir no es a dónde va el dinero después —va a destino—, sino
    lo que el sitio no promete. Van sin icono: no son estaciones.
  */}
  <ul class="al-salidas" role="list">
    {caveats.map((c) => (
      <li class="al-opcion"><span class="al-texto">{c}</span></li>
    ))}
  </ul>
  <p class="al-salvedad"><slot name="caveat" /></p>
</div>

<style>
  /*
    ── Escritorio ──────────────────────────────────────────────────────────
    La banda mide `--al-h` y el corte se lleva `--al-d` de ancho: 0,674 por el
    alto, que es la tangente de los 34° de la marca. Si el texto crece (WCAG
    1.4.12), la banda crece con él y el corte se empina un poco; no se recorta
    nada.
  */
  .al {
    --al-h: 232px;
    --al-d: 156px;
    /* Dónde cae la pista: el centro de los nodos, en proporción del alto. */
    --al-y: 80px;
    --al-r: .345;
    --al-nodo: 48px;
    --al-gap: var(--s-7);
    position: relative;
  }
  .al-tramo { position: relative; }
  .al-banda {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 1.2fr);
    grid-template-rows: auto 1fr;
    column-gap: var(--s-5);
    min-height: var(--al-h);
    padding: var(--s-5) calc(var(--al-d) + var(--s-6)) var(--s-6) var(--s-6);
    background: var(--tinta);
    color: var(--on-tinta);
    border-radius: var(--r-block) 0 0 var(--r-block);
    clip-path: polygon(0 0, 100% 0, calc(100% - var(--al-d)) 100%, 0 100%);
  }
  .al-rot {
    grid-column: 1 / -1;
    margin: 0 0 var(--s-3);
    font-family: var(--f-num);
    font-size: var(--t-label);
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--on-tinta-mute);
  }
  .al-hitos {
    grid-column: 1;
    grid-row: 2;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--s-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .al-hito {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    position: relative;
    z-index: 1;
  }
  .al-nodo {
    display: grid;
    place-items: center;
    width: var(--al-nodo);
    height: var(--al-nodo);
    margin-bottom: var(--s-3);
    border-radius: 50%;
    background: var(--tinta);
    border: 2px solid var(--verde);
    color: var(--on-tinta);
  }
  .al-nodo :global(svg) { width: 24px; height: 24px; }
  .al-nodo :global(.al-marca) { width: 26px; height: auto; color: var(--verde); }
  .al-que { font-weight: 600; font-size: var(--t-body); line-height: 1.35; max-width: 16ch; }
  .al-dato {
    font-family: var(--f-num);
    font-size: var(--t-dato-sm);
    color: var(--on-tinta-mute);
  }
  .al-bisagra {
    grid-column: 2;
    grid-row: 2;
    align-self: start;
    margin: calc(var(--al-nodo) + var(--s-3)) 0 0;
    font-size: var(--t-h3);
    line-height: var(--lh-h3);
    max-width: 18ch;
  }
  .al-hasta { display: block; font-weight: 700; color: var(--on-tinta); }
  .al-desde { display: block; color: var(--on-tinta-mute); }

  /*
    ── El tramo y la cuña, reescritos el 2026-10-22 (ADR-0014) ─────────────

    **Eran dos piezas sueltas que cruzaban la figura entera**: un tramo desde
    la primera estación hasta el corte de la marca y, cayendo en el corte, la
    cuña. Funcionaba porque ahí el dinero salía de nuestras manos y seguía en
    gris por fuera del bloque. Al quitar esa continuación gris —el recorrido es
    nuestro de punta a punta— la cuña se quedaba marcando un cambio de manos
    hacia nada, y el tramo moría contra el borde.

    Ahora **cada hito dibuja su tramo hasta el siguiente**, y la cuña va en el
    penúltimo: el dinero cambia de manos al LLEGAR a la última estación, que es
    quien recibe. Es lo mismo que hace `EjeDeAlcance`, donde la cuña cae en la
    entrada de la pieza de destino.

    Colgarlo de cada `li` y no de la figura no es un capricho de implementación:
    la geometría sale de las piezas reales —una columna, un medianil, un nodo—
    en vez de reconstruirse con porcentajes sobre un ancho que esta caja no
    conoce. El primer intento lo reconstruyó, y la cuña cayó 100 px pasada su
    estación.
  */
  .al-hito { position: relative; }
  .al-via {
    position: absolute;
    top: calc(var(--al-nodo) / 2 - 1.5px);
    left: var(--al-nodo);
    width: calc(100% + var(--s-5) - var(--al-nodo));
    height: 3px;
    background: var(--verde);
  }
  .al-cuna {
    position: absolute;
    top: calc(var(--al-nodo) / 2 - 10px);
    left: calc(100% + var(--s-5) - 56px);
    width: 56px;
    height: 20px;
    color: var(--verde);
  }

  /* Las salvedades: una lista, sin nodos y sin línea de la que colgar. Ver el
     comentario del marcado — no son estaciones del recorrido. */
  .al-salidas {
    display: grid;
    gap: var(--s-4);
    margin: var(--al-gap) 0 0;
    padding: var(--s-6) 0 0;
    list-style: none;
  }
  .al-opcion { position: relative; padding-left: var(--s-5); }
  .al-opcion::before {
    content: '';
    position: absolute;
    left: 0;
    top: 11px;
    width: 9px;
    height: 1px;
    background: var(--ink-mute);
  }
  .al-texto { font-size: var(--t-body); color: var(--ink-mute); max-width: 48ch; }
  .al-salvedad {
    margin: var(--s-6) 0 0;
    color: var(--ink-mute);
    max-width: 62ch;
  }
  .al-salvedad :global(strong) { color: var(--ink); font-weight: 600; }

  /*
    ── Bajo 900 px el relevo se pone de pie ────────────────────────────────
    Las estaciones se apilan sobre un tramo vertical, la bisagra cierra el
    bloque, y el corte pasa a la esquina de abajo a la derecha —el mismo ángulo
    en un chaflán de 64 px de alto—. La línea gris sale por abajo y baja por la
    izquierda, de la que cuelgan las tres salidas.
  */
  @media (max-width: 899px) {
    .al { --al-nodo: 44px; --al-gap: 0px; }
    .al-banda {
      display: block;
      min-height: 0;
      /* Abajo, los 64 px del chaflán y 8 más: el texto termina antes de que
         empiece el corte, y la cuña vive en ese hueco. */
      padding: var(--s-5) var(--s-5) calc(64px + var(--s-2));
      border-radius: var(--r-block) var(--r-block) 0 var(--r-block);
      clip-path: polygon(0 0, 100% 0, 100% calc(100% - 64px), calc(100% - 43px) 100%, 0 100%);
    }
    .al-hitos { grid-template-columns: 1fr; row-gap: var(--s-5); }
    .al-hito {
      display: grid;
      grid-template-columns: var(--al-nodo) minmax(0, 1fr);
      column-gap: var(--s-4);
      align-items: start;
    }
    .al-nodo { grid-row: 1 / 3; margin: 0; }
    .al-que { grid-column: 2; padding-top: 2px; max-width: none; }
    .al-dato { grid-column: 2; }
    .al-bisagra {
      /*
        24 px más de margen a la derecha: con los 24 del bloque, la frase
        termina a 48 px del canto y 8 px por encima del chaflán, y eso la deja
        a **44 px o más de la recta del corte en cualquier ancho**, por
        geometría y no por cómo caigan los renglones.

        *Corregido el 2026-10-02.* Eran 16, y el comentario decía «a 40 px de
        la esquina». A la esquina sí; a la recta del corte, que es lo que mide
        el Design System §4.7, no: entre 424 y 426 px de ancho el último
        renglón llegaba al tope y quedaba a 37,9. Lo encontró un barrido de
        1 px; el de cada 20 px pasaba entre medias.
      */
      margin: var(--s-6) var(--s-5) 0 calc(var(--al-nodo) + var(--s-4));
      font-size: var(--t-h3-m);
      max-width: none;
    }
    /* De pie: el tramo baja de una estación a la siguiente y la cuña, girada,
       cae justo antes de la última. */
    .al-via {
      top: var(--al-nodo);
      left: calc(var(--al-nodo) / 2 - 1.5px);
      width: 3px;
      height: calc(100% + var(--s-5) - var(--al-nodo));
    }
    /* Centrada en su tramo: el tramo va del pie del nodo al nodo siguiente,
       así que su mitad es `(nodo + alto del hito + medianil) / 2`. Girada, la
       caja de 56×20 se ve de 20×56 sobre el mismo centro, de ahí los 28 y los
       10 de corrección. */
    /* **Y más chica, 40×14 en vez de 56×20.** De pie el tramo mide poco más de
       40 px —lo que dan el nodo y el medianil—, y la cuña de escritorio, girada,
       ocupa 56: se montaba sobre el nodo de arriba. Se reduce en vez de
       recortarla, que es lo que el `viewBox` permite sin tocar el trazo. */
    .al-cuna {
      top: calc((var(--al-nodo) + 100% + var(--s-5)) / 2 - 7px);
      bottom: auto;
      left: calc(var(--al-nodo) / 2 - 20px);
      width: 40px;
      height: 14px;
      transform: rotate(90deg);
    }
    .al-salidas { padding: var(--s-6) 0 0; }
    .al-opcion:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 21.25px;
      bottom: calc(-1 * var(--s-5) - 22px);
      left: calc(-1 * var(--s-4) - .75px);
      border-left: 1.5px solid var(--ink-mute);
    }
  }
  /* Colores forzados: el tramo y la cuña son fondo y trazo verdes, que el
     navegador quitaría o dejaría sin contraste; pasan al color de texto de
     quien mira. Los nodos ya llevan borde. */
  @media (forced-colors: active) {
    .al-via { forced-color-adjust: none; background: CanvasText; }
    .al-cuna { forced-color-adjust: none; color: CanvasText; }
    .al-banda { border: 1px solid CanvasText; }
  }
</style>
