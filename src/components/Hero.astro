---
/**
 * Héroe. El cotizador ocupa el primer viewport (Fase 1 §12, phase-2.5 §2).
 * Móvil: titular corto arriba, cotizador inmediatamente debajo.
 *
 * Fondo en tinta con la CUÑA del sistema geométrico a muy baja opacidad
 * (≤0.12, Design System §6): representa dirección y avance, nunca es tapiz, y
 * jamás pasa por encima del cotizador.
 */
import Quoter from './Quoter.astro';
import Icon from './Icon.astro';

/**
 * El titular entra palabra por palabra (M6 enmendado el 2026-09-10). Ver la
 * nota larga en `PageHero.astro`: mismo mecanismo, desfase estándar por
 * palabra, y los bloques de abajo arrancan cuando la última empieza a entrar.
 */
/*
  REQUIERE VALIDACIÓN DE COMPLIANCE — que el dinero llega a destino en la
  moneda de ese destino (ADR-0014).

  **Decía «Cambia pesos por dólares. Muévelos donde necesites.»** hasta el
  2026-10-22, y las dos mitades habían dejado de ser ciertas: ADR-0013 sacó el
  dólar de ser el producto —son doce divisas— y ADR-0014 quitó el «muévelos
  tú», porque el recorrido es nuestro de punta a punta. Lo detectó Cowork al
  revisar staging; la decisión del titular nuevo es de Sebastián.

  Dice lo que hace el servicio en ocho palabras, y **no dice** ninguna de las
  tres cosas que ADR-0014 §3 prohíbe: ni plazo de la entrega final, ni canal,
  ni nada regulatorio. Tampoco «remesa», que sigue fuera por posicionamiento.

  Es a propósito el mismo par de verbos que rotula el cotizador dos bloques más
  abajo —«Envías» y «Llega aprox.»— y los dos carriles de «El mismo envío, por
  dos caminos». El titular, el instrumento y la figura dicen lo mismo con las
  mismas palabras.
*/
const title = 'Envías en pesos. Llega en la moneda del destino.';
const titleWords = title.split(' ');
const seqSub = titleWords.length - 1;
const seqStrip = seqSub + 1;

const trustStrip = [
  { icon: 'bank' as const, label: 'Verificamos en el banco' },
  { icon: 'clock' as const, label: 'Sin depender de días hábiles' },
  { icon: 'people' as const, label: 'Equipo en Chile' },
];
---
<section class="hero on-tinta-surface">
  <div class="wedges" aria-hidden="true"></div>

  <div class="inner">
    <div class="copy">
      <h1>
        {titleWords.map((word, i) => (
          <Fragment>{i > 0 ? ' ' : ''}<span class="w" style={`--w:${i}`}>{word}</span></Fragment>
        ))}
      </h1>
      {/*
        **Esta frase perdió sus minutos el 2026-10-22, y es la consecuencia más
        incómoda de ADR-0014.** Decía "Recibes la divisa que necesites: en
        minutos, a cualquier hora". Funcionaba porque D17 exigía que la rapidez
        se predicara de NUESTRA operación, y nuestra operación terminaba al
        entregar: el sujeto de "en minutos" estaba anclado y no podía leerse
        como "el destinatario recibe en su cuenta en minutos".

        Ahora nuestra operación INCLUYE la entrega en destino, así que ese
        anclaje desapareció: cualquier plazo en esta línea se lee como el plazo
        de la entrega final, y ése es justo el que nadie puede respaldar. La
        regla de D17 no se relajó — se volvió más estricta por cubrir más.

        Lo que queda es el diferencial sin el número: no depender de los
        horarios ni de los días hábiles de la cadena bancaria. Recuperar un
        plazo pide un dato que Compliance firme, no una redacción mejor.
      */}
      <p class="sub seq" style={`--seq:${seqSub}`}>
        Cambiamos al precio que aceptas y nos ocupamos de que llegue a destino, sin los
        horarios ni los días hábiles de una transferencia bancaria.
      </p>
      <ul class="strip seq" role="list" style={`--seq:${seqStrip}`}>
        {trustStrip.map((item) => (
          <li>
            <Icon name={item.icon} class="strip-icon" />
            {item.label}
          </li>
        ))}
      </ul>
    </div>

    <div class="instrument">
      <Quoter />
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--tinta);
    color: var(--on-tinta);
    position: relative;
    overflow: hidden;
    padding: var(--s-7) 0 var(--s-8);
  }

  /**
   * M6 · secuencia de carga. El cotizador NO entra: es el instrumento y tiene
   * que estar encendido cuando llegas. Lo que entra es el texto, sobre el eje
   * diagonal de la marca. Al revés de lo habitual, y coherente con que la cifra
   * manda. No depende de JavaScript: es una animación de carga.
   */
  .seq {
    animation: heroIn var(--m-base) var(--m-ease) both;
    animation-delay: calc(var(--seq) * var(--m-stagger));
  }
  /* Palabras del titular. `inline-block` es obligatorio: un `inline` no acepta
     `transform`. Los espacios van FUERA del span para no romper el salto de
     línea ni el `text-wrap: balance`. */
  .w {
    display: inline-block;
    animation: heroIn var(--m-base) var(--m-ease) both;
    animation-delay: calc(var(--w) * var(--m-stagger));
  }
  @keyframes heroIn {
    from { opacity: 0; transform: translate(var(--m-shift-x), var(--m-shift-y)); }
    to   { opacity: 1; transform: none; }
  }

  /* M3 · las cuñas se dibujan al cargar, en la dirección que apuntan. */
  .wedges {
    animation: wedgeIn var(--m-slow) var(--m-ease) both;
  }
  @keyframes wedgeIn {
    from { opacity: 0; }
    to   { opacity: 0.07; }
  }

  @media (prefers-reduced-motion: reduce) {
    .seq, .w, .wedges { animation: none; }
  }

  /* Cuñas del sistema geométrico. Opacidad baja, nunca sobre el cotizador. */
  .wedges {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: var(--verde);
    opacity: 0.07;
    clip-path: polygon(0 100%, 46% 0, 60% 0, 15% 100%, 20% 100%, 66% 0, 71% 0, 26% 100%);
  }

  .inner {
    position: relative;
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--pad-section-m);
    display: grid;
    gap: var(--s-6);
  }

  h1 {
    font-size: var(--t-display-m);
    font-weight: 700;
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    margin-bottom: var(--s-4);
    max-width: 18ch;
  }
  .sub {
    font-size: var(--t-body);
    line-height: 1.55;
    color: var(--on-tinta-mute);
    max-width: 46ch;
  }

  .strip {
    list-style: none;
    margin: var(--s-5) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-4);
  }
  .strip li {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--t-body-sm);
    font-weight: 500;
    color: var(--on-tinta-mute);
  }
  .strip-icon { width: 16px; height: 16px; color: var(--verde); flex: none; }

  /* Móvil: el cotizador va primero, el resto del copy después del titular */
  .copy { order: 1; }
  .instrument { order: 2; }

  @media (min-width: 900px) {
    .hero { padding: var(--s-8) 0 var(--s-9); }
    .inner {
      padding-inline: var(--pad-section);
      grid-template-columns: 1.05fr 0.95fr;
      gap: var(--s-8);
      align-items: center;
    }
    h1 { font-size: var(--t-display); }
    .sub { font-size: var(--t-h3-m); }
  }
</style>
