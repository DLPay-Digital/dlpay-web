<style>
  /* Ver la cabecera: 360 y no 420, y `margin-inline-start` y no `justify-self`. */
  .riel { max-width: 360px; margin-inline-start: auto; }
  .riel svg { display: block; width: 100%; height: auto; }
  /* Los cuatro trazos del artículo, con sus tres grosores. La cuña va a `miter`
     para que la punta salga en ángulo y no redondeada.
     Sobre tinta todo en `--verde` (8,45:1); en el artículo es `--verde-deep`
     porque allá el fondo es papel — DS §6.2, el fondo elige el verde. */
  .riel .aro,
  .riel .signo,
  .riel .unidad,
  .riel .link { fill: none; stroke: var(--verde); }
  .riel .aro { stroke-width: 1.5; }
  .riel .signo { stroke-width: 1.9; }
  .riel .unidad { stroke-width: 1.1; }
  .riel .link { stroke-width: 1.5; stroke-linejoin: miter; }
  .riel .tags {
    display: flex;
    justify-content: space-between;
    margin-top: var(--s-2);
    font-family: var(--f-num);
    font-size: var(--t-dato-sm);
    color: var(--on-tinta-mute);
  }
</style>
