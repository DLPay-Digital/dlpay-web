---
/**
 * "Por qué DLPay" — sólo señales que DLPay puede respaldar hoy
 * (phase-2.5 §5). Sin cifras de vanidad, sin sellos, sin claims regulatorios.
 */
import IconBadge from './ui/IconBadge.astro';
import ArrowLink from './ui/ArrowLink.astro';
import { trust } from '../content/home.ts';
---
<section class="trust" id="confianza" aria-labelledby="trust-title">
  <div class="inner">
    <header class="head">
      <h2 id="trust-title" data-enter>Confianza que se comprueba</h2>
      <p>Nada de sellos. Esto es lo que efectivamente pasa con tu dinero.</p>
    </header>

    {/*
      Carril deslizable en móvil, rejilla en escritorio — el mismo patrón que
      `UseCases.astro`.

      `tabindex="0"` no es un descuido: un contenedor con `overflow-x: auto` NO
      es enfocable por defecto, y dentro de los bloques no hay nada que reciba
      foco (insignia decorativa, título y párrafo). Sin esto, quien navega sólo
      con teclado no podría desplazar el carril y los bloques 2 y 3 quedarían
      fuera de su alcance: cambiaríamos apilamiento por un fallo de WCAG 2.1.1.
    */}
    <div class="viewport" tabindex="0" role="group" aria-labelledby="trust-title">
      <ul class="grid">
        {trust.map((block) => (
          <li class="block">
            <IconBadge name={block.icon} />
            <h3>{block.title}</h3>
            <p>{block.body}</p>
          </li>
        ))}
      </ul>
    </div>

    {/* FUERA del carril a propósito: es un enlace, y dentro se desplazaría
        fuera de la vista justo cuando alguien va a pulsarlo. */}
    <p class="more"><ArrowLink href="/confianza/">Cómo cuidamos tu operación</ArrowLink></p>
  </div>
</section>

<style>
  /* El fondo ya era --papel-2, pero contra --papel da 1.10:1: se distingue en
     una pantalla buena y desaparece en una mala. El filete lo hace inequívoco.
     Sólo arriba: abajo viene la banda en tinta de Empresas, que ya corta sola. */
  .trust {
    background: var(--papel-2);
    border-top: 1px solid var(--line);
    padding: var(--s-9) 0;
  }
  .inner { max-width: var(--container); margin: 0 auto; padding: 0 var(--pad-section-m); }
  .head { max-width: 46ch; margin-bottom: var(--s-7); }
  h2 {
    font-size: var(--t-h2-m);
    font-weight: 700;
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
    margin-bottom: var(--s-3);
  }
  .head p { color: var(--ink-mute); }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-6); }
  /* La insignia no trae margen propio: el espaciado lo pone quien la coloca. */
  .block :global(.badge) { margin-bottom: var(--s-4); }
  h3 { font-size: var(--t-h3-m); font-weight: 600; line-height: var(--lh-h3); margin-bottom: var(--s-2); }
  .block p { color: var(--ink-mute); max-width: 46ch; }
  .more { margin-top: var(--s-6); }

  /* El foco del carril se dibuja fuera, para no recortarlo con el overflow.
     Esta superficie es clara, así que `--focus` es `--verde-deep`: 4.44:1 sobre
     `--papel-2`, por encima del 3:1 que WCAG pide a un indicador de foco. */
  .viewport:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }

  /* ── Carril deslizable · sólo móvil ────────────────────────────────────── */
  @media (max-width: 759px) {
    .viewport {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      /* Que el deslizamiento horizontal no dispare el "atrás" del navegador. */
      overscroll-behavior-x: contain;
      /* El carril no aporta scroll vertical: sólo se desplaza en un eje. */
      overflow-y: hidden;
    }

    .grid { display: flex; gap: var(--s-4); }

    /*
      El asomo se resta en PÍXELES, no en porcentaje: así lo que se ve del
      bloque siguiente son 48px exactos en cualquier ancho, en vez de depender
      del tamaño de pantalla. Y 48px es justo el ancho de `IconBadge` en su
      tamaño `md`, así que lo que asoma es la insignia COMPLETA del bloque
      siguiente — una señal más legible que un recorte de texto.
    */
    .block {
      flex: 0 0 calc(100% - var(--s-8));
      min-width: 0;
      scroll-snap-align: start;
    }

    /*
      NO hace falta el override de `[data-enter]` que sí lleva `UseCases.astro`.
      Allí las tarjetas lo tienen y, al nacer recortadas por el `overflow`, no
      intersecan nunca y se quedaban en `opacity: 0`. Aquí `data-enter` está
      sólo en el `h2`, que vive fuera del carril: no hay nada que desatascar y
      la regla sería CSS muerta.

      ⚠️ Si algún día se le añade `data-enter` a `.block`, hay que reponerla o
      los bloques 2 y 3 saldrán en blanco —incluida la insignia que asoma— sin
      que salte ningún error.
    */
  }

  @media (min-width: 760px) {
    .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-7); }
    /* En rejilla no hay nada que desplazar; `visible` deja respirar el anillo
       de foco. El carril sigue siendo una parada de tabulación aquí, porque
       `tabindex` es HTML y no se retira por CSS: anuncia el grupo y su nombre,
       pero no hace nada. Mismo coste asumido que en `UseCases.astro`. */
    .viewport { overflow: visible; }
  }
  @media (min-width: 900px) {
    .inner { padding-inline: var(--pad-section); }
    h2 { font-size: var(--t-h2); }
    h3 { font-size: var(--t-h3); }
  }
</style>
