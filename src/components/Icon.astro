---
/**
 * Set de iconos: line icons, trazo 1.6, un solo estilo (Design System §7).
 * Sólo los que una página real necesita. Nada más.
 */
interface Props {
  name: 'bank' | 'clock' | 'people' | 'whatsapp' | 'chevron';
  class?: string;
  /**
   * Tamaño intrínseco en px. Se emite como atributos `width`/`height` en el
   * SVG, no sólo como CSS.
   *
   * POR QUÉ IMPORTA: un <svg> con viewBox y sin width/height se dibuja al ancho
   * de su contenedor. Mientras el CSS no ha aplicado —en desarrollo los estilos
   * entran por JavaScript— el icono aparece a pantalla completa. Con los
   * atributos puestos nunca hay un tamaño incorrecto, ni siquiera durante un
   * instante. El CSS sigue pudiendo ajustarlo.
   */
  size?: number;
}
const { name, class: className, size = 24 } = Astro.props;

const paths: Record<Props['name'], string> = {
  bank: '<path d="M3 21h18M4 21V10l8-6 8 6v11M9 21v-6h6v6"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  people: '<path d="M16 20v-2a4 4 0 00-4-4H7a4 4 0 00-4 4v2"/><circle cx="9.5" cy="7" r="3.5"/><path d="M17 4.5a3.5 3.5 0 010 6.8M21 20v-2a4 4 0 00-3-3.8"/>',
  whatsapp: '<path d="M3.5 20.5l1.4-4.8A8.3 8.3 0 1112 20.3a8.4 8.4 0 01-4.1-1.1z"/><path d="M9 9.2c.4 1.2 1.3 2.6 2.4 3.5.6.5 1.3.9 2 1.1"/>',
  chevron: '<path d="M9 5l7 7-7 7"/>',
};
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>
