---
/**
 * Cabecera. Navegación corta (Fase 1 §5.2) y WhatsApp siempre visible.
 * El menú móvil usa <details>: sin JavaScript (ADR-0004 §6).
 */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { contact, platform } from '../lib/config/site.ts';

const nav = [
  { label: 'Cotizar', href: '/cotizar/' },
  { label: 'Cómo funciona', href: '/como-funciona/' },
  { label: 'Empresas', href: '/empresas/' },
  { label: 'Confianza', href: '/confianza/' },
];
const wa = `https://wa.me/${contact.whatsappNumber}`;

/** Marca la página actual para lectores de pantalla y para el estilo. */
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => href === current;
---
<header class="site-header on-tinta-surface">
  <a class="skip" href="#main">Saltar al contenido</a>

  <div class="bar">
    <a class="brand" href="/">
      <Logo class="brand-mark" />
      <span>DLPay</span>
    </a>

    <nav class="desktop-nav" aria-label="Principal">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <a class="wa-link" href={wa} target="_blank" rel="noopener">
        <Icon name="whatsapp" class="wa-icon" />
        <span>WhatsApp</span>
      </a>
      <a class="login" href={platform.loginUrl}>Iniciar sesión</a>

      <details class="menu">
        <summary aria-label="Abrir menú">
          <span class="burger"><i></i><i></i><i></i></span>
        </summary>
        <nav class="drawer" aria-label="Principal, móvil">
          <ul>
            {nav.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
            <li><a href={platform.loginUrl}>Iniciar sesión</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    background: var(--tinta);
    color: var(--on-tinta);
    position: relative;
    z-index: 10;
  }
  .skip {
    position: absolute;
    left: -9999px;
    top: var(--s-2);
    background: var(--verde);
    color: #04140e;
    padding: var(--s-2) var(--s-4);
    border-radius: var(--r-2);
    font-weight: 600;
  }
  .skip:focus { left: var(--s-4); z-index: 20; }

  .bar {
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--s-4) var(--pad-section-m);
    display: flex;
    align-items: center;
    gap: var(--s-6);
    border-bottom: 1px solid rgba(237, 242, 239, 0.1);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--on-tinta);
    text-decoration: none;
    font-weight: 700;
    font-size: var(--t-h3);
    letter-spacing: -0.01em;
    flex: none;
  }
  .brand-mark { height: 18px; width: auto; color: var(--verde); display: block; }

  .desktop-nav { display: none; }
  .desktop-nav ul { display: flex; gap: var(--s-5); list-style: none; margin: 0; padding: 0; }
  .desktop-nav a {
    color: var(--on-tinta-mute);
    text-decoration: none;
    font-size: var(--t-body-sm);
    font-weight: 500;
  }
  .desktop-nav a { transition: color var(--m-fast) var(--m-ease); }
  .desktop-nav a:hover { color: var(--on-tinta); }
  .desktop-nav a[aria-current='page'] { color: var(--on-tinta); }
  .desktop-nav a[aria-current='page']::after {
    content: '';
    display: block;
    height: 1.5px;
    background: var(--verde);
    margin-top: 5px;
  }

  .actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: var(--s-4);
  }
  .wa-link {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--on-tinta);
    text-decoration: none;
    font-size: var(--t-body-sm);
    font-weight: 600;
  }
  .wa-icon { width: 17px; height: 17px; }
  .wa-link span { display: none; }
  .login { display: none; }

  /* Menú móvil sin JavaScript */
  .menu { position: relative; }
  .menu summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    min-height: 44px;
    padding-left: var(--s-2);
  }
  .menu summary::-webkit-details-marker { display: none; }
  .burger { display: flex; flex-direction: column; gap: var(--s-1); }
  .burger i { display: block; width: 20px; height: 1.5px; background: var(--on-tinta-mute); transition: background-color var(--m-fast) var(--m-ease); }
  .menu[open] .burger i { background: var(--on-tinta); }

  .drawer {
    position: absolute;
    right: 0;
    top: calc(100% + var(--s-3));
    background: var(--tinta-2);
    border: 1px solid rgba(237, 242, 239, 0.14);
    border-radius: var(--r-3);
    padding: var(--s-2);
    min-width: 200px;
    box-shadow: var(--elev-pop);
  }
  .drawer ul { list-style: none; margin: 0; padding: 0; }
  .drawer a {
    display: block;
    padding: var(--s-3);
    color: var(--on-tinta);
    text-decoration: none;
    font-size: var(--t-body-sm);
    font-weight: 500;
    border-radius: var(--r-2);
  }
  .drawer a { transition: background-color var(--m-fast) var(--m-ease); }
  .drawer a:hover { background: rgba(237, 242, 239, 0.06); }
  .drawer a[aria-current='page'] { color: var(--verde); }

  @media (min-width: 900px) {
    .bar { padding-inline: var(--pad-section); gap: var(--s-8); }
    .desktop-nav { display: block; }
    .wa-link span { display: inline; }
    .login {
      display: inline;
      color: var(--on-tinta-mute);
      text-decoration: none;
      font-size: var(--t-body-sm);
      font-weight: 500;
    }
    .login { transition: color var(--m-fast) var(--m-ease); }
  .login:hover { color: var(--on-tinta); }
    .menu { display: none; }
  }
</style>
