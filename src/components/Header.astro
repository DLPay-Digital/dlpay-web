---
/**
 * Cabecera. Navegación corta (Fase 1 §5.2) y una entrada a la plataforma.
 * El menú móvil usa <details>: sin JavaScript (ADR-0004 §6).
 *
 * La franja de notificación va aquí, dentro del `<header>`, y no en cada
 * página: las nueve la reciben sin tocar ni una. Para cambiar el copy se editan
 * las props de esta única etiqueta (ver `AnnouncementBar.astro`).
 */
import Logo from './Logo.astro';
import AnnouncementBar from './AnnouncementBar.astro';
import { platform } from '../lib/config/site.ts';

/**
 * Orden: primero a QUIÉN va dirigido y después el detalle.
 *
 * "Personas" apunta a la Home porque la Home está escrita para personas; es su
 * contrapartida de "Empresas", que sí tiene página propia. Sin ella, la Home no
 * tenía representación en el menú y la pareja Personas/Empresas no se leía.
 *
 * Efecto lateral bueno: ahora la Home marca `aria-current="page"` en su entrada,
 * cosa que antes no ocurría en ninguna ruta del menú.
 *
 * Este array alimenta la navegación de escritorio Y el cajón móvil: se ordena
 * una vez.
 */
const navMain = [
  { label: 'Personas', href: '/' },
  { label: 'Empresas', href: '/empresas/' },
];

/**
 * Entradas agrupadas bajo «Información».
 *
 * REQUIERE VALIDACIÓN DE COMPLIANCE no aplica a estas descripciones porque
 * están escritas para NO abrir claim: la de Confianza dice qué verificamos y
 * qué no afirmamos, y evita a propósito la palabra «regulaciones». CLAUDE.md §6
 * prohíbe afirmar o sugerir que DLPay está regulado, y D26 fijó que el único
 * registro público admisible es «registrada y supervisada» ante la UAF.
 *
 * **El orden no es de llegada** (2026-09-23, al entrar `/precio` y
 * `/preguntas`): va de lo que explica el servicio a lo que resuelve una duda
 * suelta — cómo funciona, qué cuesta, por qué fiarse, qué leer, qué preguntar.
 * Añadir al final habría dejado «Preguntas» entre «Confianza» y «Blog» sin
 * criterio. Con cinco entradas el desplegable sigue siendo cómodo; con más
 * habría que replantearlo, no seguir añadiendo.
 */
const navInfo = [
  {
    label: 'Cómo funciona',
    href: '/como-funciona/',
    detail: 'El recorrido del dinero, paso a paso',
  },
  {
    label: 'Precio',
    href: '/precio/',
    detail: 'Qué cuesta y qué no',
  },
  {
    label: 'Confianza',
    href: '/confianza/',
    detail: 'Qué verificamos y qué no afirmamos',
  },
  {
    label: 'Blog',
    href: '/blog/',
    detail: 'Qué mueve el precio del dólar',
  },
  {
    label: 'Preguntas',
    href: '/preguntas/',
    detail: 'Las dudas frecuentes y el glosario',
  },
];


/**
 * Marca la página actual para lectores de pantalla y para el estilo.
 *
 * Normaliza LOS DOS lados. Antes sólo se le quitaba la barra final a la ruta
 * actual y se comparaba contra un `href` que sí la lleva —`/empresas` contra
 * `/empresas/`—, así que no coincidía nunca: ninguna página interior marcaba su
 * entrada, ni con el subrayado verde ni con `aria-current` para un lector de
 * pantalla. Se rompió al adoptar `trailingSlash: 'always'` (auditoría
 * 2026-09-04, B2), cuando los enlaces del menú ganaron la barra.
 */
const normalize = (path: string): string => path.replace(/\/+$/, '') || '/';
const current = normalize(Astro.url.pathname);
const isCurrent = (href: string): boolean => normalize(href) === current;
/* Si la página actual vive dentro del desplegable, el disparador se marca:
   si no, la cabecera dejaría de señalar dónde estás en dos de las nueve rutas. */
const infoIsCurrent = navInfo.some((item) => isCurrent(item.href));
---
<header class="site-header on-tinta-surface">
  <a class="skip" href="#main">Saltar al contenido</a>

  <div class="bar">
    <a class="brand" href="/">
      <Logo class="brand-mark" />
      <span>DLPay</span>
    </a>

    <nav class="desktop-nav" aria-label="Principal">
      <ul role="list">
        {navMain.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}

        {/*
          Desplegable sin una línea de JavaScript: abre con `:hover` y con
          `:focus-within`.

          El disparador es un `<button>` DE VERDAD y eso no es cosmético: el
          panel se oculta con `visibility`, así que sus enlaces no son
          enfocables mientras está cerrado y `:focus-within` no podría
          dispararse nunca. Con un botón enfocable, el tabulador llega al
          disparador, el panel se abre y el foco puede entrar en los enlaces.
          En pantallas táctiles ocurre lo mismo: tocar el botón le da foco.

          No lleva `aria-expanded` a propósito: sin JavaScript no hay forma de
          mantenerlo sincronizado, y un valor fijo mentiría la mitad del tiempo.
        */}
        <li class:list={['nav-item', { 'is-current': infoIsCurrent }]}>
          <button class="trigger" type="button">
            Información
            <svg class="chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
              <path
                d="M1 1l4 4 4-4"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>

          <div class="dropdown">
            <ul role="list">
              {navInfo.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    <span class="d-title">{item.label}</span>
                    <span class="d-detail">{item.detail}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </li>
      </ul>
    </nav>

    <div class="actions">
      <a class="register" href={platform.registerUrl}>Crear cuenta</a>
      <a class="login" href={platform.loginUrl}>Iniciar sesión</a>

      <details class="menu">
        <summary aria-label="Abrir menú">
          <span class="burger"><i></i><i></i><i></i></span>
        </summary>
        {/* En móvil nada flota: «Información» es un rótulo y sus dos enlaces
            cuelgan indentados debajo. Un desplegable dentro de un desplegable
            obligaría a dos gestos para llegar a una página. */}
        <nav class="drawer" aria-label="Principal, móvil">
          <ul role="list">
            {navMain.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
            <li class="drawer-group">Información</li>
            {navInfo.map((item) => (
              <li>
                <a
                  class="drawer-sub"
                  href={item.href}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
            <li><a href={platform.loginUrl}>Iniciar sesión</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>

  <AnnouncementBar />
</header>

<style>
  .site-header {
    background: var(--tinta);
    color: var(--on-tinta);
    position: relative;
    z-index: 10;
  }
  .skip {
    position: absolute;
    left: -9999px;
    top: var(--s-2);
    background: var(--verde);
    color: var(--on-verde);
    padding: var(--s-2) var(--s-4);
    border-radius: var(--r-2);
    font-weight: 600;
  }
  .skip:focus { left: var(--s-4); z-index: 20; }

  .bar {
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--s-4) var(--pad-section-m);
    display: flex;
    align-items: center;
    gap: var(--s-6);
    border-bottom: 1px solid rgba(237, 242, 239, 0.1);
    /*
      **Si la fila no cabe, las acciones bajan a una segunda fila** en vez de
      salirse de la pantalla (2026-10-05). Con el espaciado de WCAG 1.4.12, a
      320 px la marca, «Crear cuenta» y el menú piden 281,4 px donde hay 280,
      y el botón del menú quedaba hasta 13,4 px fuera de la pantalla, con
      desplazamiento lateral, entre 320 y 332 (medido). Sin ese espaciado la
      fila sobra en 34 px a 320 y nunca baja: la cabecera de siempre, al
      píxel. Sólo en móvil: en escritorio la fila más justa entra en el
      margen lateral, de 64 px, y no sale de la pantalla.
    */
    flex-wrap: wrap;
    row-gap: var(--s-2);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--on-tinta);
    text-decoration: none;
    font-weight: 700;
    font-size: var(--t-h3);
    letter-spacing: -0.01em;
    /* 44px de objetivo táctil (Design System §10). El logotipo es el enlace al
       inicio y medía 31px: su alto lo daba la línea de texto. */
    min-height: 44px;
    flex: none;
  }
  .brand-mark { height: 18px; width: auto; color: var(--verde); display: block; }

  .desktop-nav { display: none; }
  .desktop-nav ul { display: flex; gap: var(--s-5); list-style: none; margin: 0; padding: 0; }
  /*
    Selector de HIJO DIRECTO, y no `.desktop-nav a`, a propósito: los enlaces
    del desplegable también cuelgan de esta navegación, y con el selector
    descendente heredaban el subrayado verde de `aria-current` —que aparecía
    suelto dentro del panel— y un `white-space: nowrap` que habría impedido que
    su descripción fluyera en más de una línea.
  */
  .desktop-nav > ul > li > a {
    color: var(--on-tinta-mute);
    text-decoration: none;
    font-size: var(--t-body-sm);
    font-weight: 500;
    /*
      Con cinco entradas, en la franja 900–1023px "Cómo funciona" partía en dos
      líneas. Y como el `ul` es flex con `align-items: stretch`, ESA entrada
      estiraba a las cinco: las `li` pasaban de 31px a 50px y la barra entera de
      77px a 83px. Un enlace de menú no se parte nunca.
    */
    white-space: nowrap;
    /*
      Caja propia de 44px, centrada. Era el único elemento de la barra que no la
      tenía —`.brand`, `.trigger` y `.register` la declaran las tres, con el
      mismo comentario— y de ahí salían dos defectos a la vez:

      · **Desalineación.** Sin caja, el enlace es `inline` y se apoya en la
        primera línea de su `li`, que está estirada a 44px. Medido: «Personas»
        centraba en 33,65 y «Empresas» en 28,75, contra el 38 de la marca, de
        «Información» y de los dos botones. Y los dos ni siquiera coincidían
        entre sí, porque el subrayado de página actual iba EN FLUJO y le sumaba
        6,5px de alto a uno solo de ellos.
      · **Objetivo táctil.** Medían 17,5 y 27,3px de alto contra los 44 que pide
        el Design System §10. No es sólo cosmético.
    */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    /* Ancla del subrayado de abajo. */
    position: relative;
  }
  .desktop-nav > ul > li > a { transition: color var(--m-fast) var(--m-ease); }
  .desktop-nav > ul > li > a:hover { color: var(--on-tinta); }
  .desktop-nav > ul > li > a[aria-current='page'] { color: var(--on-tinta); }
  /*
    Absoluto y no en flujo, igual que el marcador de `.trigger` y por el mismo
    motivo: en flujo, el subrayado agranda la caja del enlace y desplaza su
    texto respecto de los enlaces sin subrayar. `bottom: 8px` es el valor que ya
    usa el trigger, así que los dos marcadores de «dónde estoy» caen a la misma
    altura — antes quedaban a 46 y a 50,5.
  */
  .desktop-nav > ul > li > a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    height: 1.5px;
    background: var(--verde);
  }

  /* ── Desplegable «Información» ───────────────────────────────────────────
     Cero JavaScript: abre con `:hover` y con `:focus-within`.

     Se oculta con `visibility` y NO con `display: none`, para que la
     transición exista y para que el panel siga participando del cálculo de
     `:focus-within`. `pointer-events: none` evita que un panel invisible
     intercepte clics de lo que tiene debajo.

     Duración `--m-fast`: es M1 del Motion System —respuesta de un control al
     puntero o al foco—, no una entrada. Muy por debajo del techo de 280 ms. */
  .nav-item { position: relative; display: none; }

  .trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    /* Objetivo táctil de 44px (Design System §10) sin agrandar el texto. */
    min-height: 44px;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--on-tinta-mute);
    font-family: inherit;
    font-size: var(--t-body-sm);
    font-weight: 500;
    white-space: nowrap;
    transition: color var(--m-fast) var(--m-ease);
  }
  .nav-item:hover .trigger,
  .nav-item:focus-within .trigger { color: var(--on-tinta); }

  .chevron { flex: none; transition: transform var(--m-fast) var(--m-ease); }
  .nav-item:hover .chevron,
  .nav-item:focus-within .chevron { transform: rotate(180deg); }

  /* La página actual vive dentro del desplegable: se marca igual que una
     entrada de primer nivel, para no perder la señal de «dónde estoy». */
  .nav-item.is-current .trigger { color: var(--on-tinta); }
  .nav-item.is-current .trigger::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 8px;
    width: calc(100% - 16px);
    height: 1.5px;
    background: var(--verde);
  }

  /*
    `z-index: 15`, el mismo de `.drawer` y por el mismo motivo: la franja de
    notificación anima `opacity`, y mientras lo hace obtiene contexto de
    apilamiento propio. Sin declararlo, su enlace se dibujaría encima de este
    panel. Ver la nota larga del cajón móvil.
  */
  .dropdown {
    position: absolute;
    z-index: 15;
    left: 0;
    top: calc(100% - var(--s-2));
    min-width: 272px;
    padding: var(--s-2);
    background: var(--tinta-2);
    border: 1px solid var(--line-on-tinta);
    border-radius: var(--r-3);
    /* Un panel que se abre: `--elev-pop`, que es para lo que se declaró.
       Llevaba `--elev-card` —la sombra del objeto principal de la página—
       sin motivo; corregido al reescribir DS §4.5 el 2026-09-25. */
    box-shadow: var(--elev-pop);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity var(--m-fast) var(--m-ease),
      visibility var(--m-fast) var(--m-ease);
  }
  .nav-item:hover .dropdown,
  .nav-item:focus-within .dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .dropdown ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .dropdown a {
    position: relative;
    display: block;
    padding: var(--s-3) var(--s-3) var(--s-3) var(--s-4);
    border-radius: var(--r-2);
    text-decoration: none;
    transition: background-color var(--m-fast) var(--m-ease);
  }
  .dropdown a:hover,
  .dropdown a:focus-visible { background: rgba(237, 242, 239, .06); }

  /* La cuña del sistema geométrico apuntando a la entrada: señala cuál está
     activa, que es función y no adorno (ADR-0001 §3). */
  .dropdown a::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 50%;
    width: 5px;
    height: 12px;
    margin-top: -6px;
    background: var(--verde);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
    opacity: 0;
    transition: opacity var(--m-fast) var(--m-ease);
  }
  .dropdown a:hover::before,
  .dropdown a:focus-visible::before,
  .dropdown a[aria-current='page']::before { opacity: 1; }

  .d-title {
    display: block;
    font-size: var(--t-body-sm);
    font-weight: 600;
    color: var(--on-tinta);
    transition: color var(--m-fast) var(--m-ease);
  }
  .dropdown a:hover .d-title,
  .dropdown a:focus-visible .d-title,
  .dropdown a[aria-current='page'] .d-title { color: var(--verde); }
  .d-detail {
    display: block;
    margin-top: 2px;
    font-size: 12px;
    line-height: 1.35;
    color: var(--on-tinta-mute);
  }

  @media (prefers-reduced-motion: reduce) {
    .chevron, .dropdown, .dropdown a, .dropdown a::before { transition: none; }
  }

  .actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: var(--s-4);
  }
  /*
    Contorno, NO relleno verde. "Cotizar es el centro" y sólo hay una acción
    primaria por pantalla (CLAUDE.md §6): un botón verde relleno aquí arriba
    competiría con el CTA del cotizador, que es el que tiene que ganar. Esto es
    una entrada secundaria, y así se ve.

    El alfa del borde es 0.40 porque es el que da 3.50:1 sobre tinta, el mínimo
    que WCAG 1.4.11 pide al contorno de un control. Mismo valor que los
    fantasmas de `Steps.astro` y `/empresas`.
  */
  .register {
    display: inline-flex;
    align-items: center;
    /* Objetivo táctil de 44px (Design System §10) sin agrandar el texto. */
    min-height: 44px;
    padding: 0 var(--s-3);
    border: 1px solid var(--line-on-tinta);
    border-radius: var(--r-2);
    color: var(--on-tinta);
    text-decoration: none;
    font-size: var(--t-body-sm);
    font-weight: 600;
    /* En 320px la cabecera va justa: partir "Crear cuenta" en dos líneas
       rompería la fila entera. */
    white-space: nowrap;
    flex: none;
  }
  .register { transition: border-color var(--m-fast) var(--m-ease); }
  .register:hover { border-color: var(--on-tinta); }

  .login { display: none; }

  /* Menú móvil sin JavaScript */
  .menu { position: relative; }
  .menu summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    min-height: 44px;
    padding-left: var(--s-2);
  }
  .menu summary::-webkit-details-marker { display: none; }
  .burger { display: flex; flex-direction: column; gap: var(--s-1); }
  .burger i { display: block; width: 20px; height: 1.5px; background: var(--on-tinta-mute); transition: background-color var(--m-fast) var(--m-ease); }
  .menu[open] .burger i { background: var(--on-tinta); }
  /*
    Colores forzados: las tres rayas son FONDOS, y ese modo quita los fondos.
    Hasta el 2026-10-05 el botón del menú quedaba vacío bajo 900 px en las
    dieciséis rutas: se enfocaba y se anunciaba, pero no se veía (medido).
    Pasan a `CanvasText`, el color de texto que eligió quien mira, abierto o
    cerrado: con el ajuste apagado, el `--on-tinta` del estado abierto se
    quedaría tal cual, y en un tema claro no se vería.
  */
  @media (forced-colors: active) {
    .burger i, .menu[open] .burger i { forced-color-adjust: none; background: CanvasText; }
  }

  /*
    `z-index` EXPLÍCITO, y no es decorativo: sin él el enlace de la franja de
    notificación se dibujaba ENCIMA del menú desplegado.

    El motivo no se ve leyendo el CSS del cajón. La franja rota sus dos mensajes
    con una animación de `opacity`, y un elemento con una animación viva de
    `opacity` obtiene contexto de apilamiento mientras corre. Ese contexto entra
    en el MISMO grupo de pintado que este cajón posicionado —los dos con
    `z-index: auto`—, y dentro de ese grupo decide el orden del DOM: la franja
    va después de `.bar`, así que ganaba.

    Un menú superpuesto no debe depender del orden del DOM de sus hermanos.
    Escalera de apilamiento dentro de `.site-header`, que es el contexto:
      15 → este cajón, por encima del contenido de la cabecera
      20 → `.skip:focus`, que va por encima de todo por accesibilidad
  */
  .drawer {
    position: absolute;
    z-index: 15;
    right: 0;
    top: calc(100% + var(--s-3));
    background: var(--tinta-2);
    border: 1px solid rgba(237, 242, 239, 0.14);
    border-radius: var(--r-3);
    padding: var(--s-2);
    min-width: 200px;
    box-shadow: var(--elev-pop);
  }
  .drawer ul { list-style: none; margin: 0; padding: 0; }
  .drawer a {
    display: block;
    padding: var(--s-3);
    color: var(--on-tinta);
    text-decoration: none;
    font-size: var(--t-body-sm);
    font-weight: 500;
    border-radius: var(--r-2);
  }
  .drawer a { transition: background-color var(--m-fast) var(--m-ease); }
  .drawer a:hover { background: rgba(237, 242, 239, 0.06); }
  .drawer a[aria-current='page'] { color: var(--verde); }
  /* Rótulo de grupo: no es un enlace y no debe parecerlo. */
  .drawer-group {
    padding: var(--s-3) var(--s-3) var(--s-1);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--on-tinta-mute);
  }
  /* `.drawer a.drawer-sub` y no `.drawer-sub` a secas: `.drawer a` tiene más
     especificidad y su `padding` corto ganaba, así que la indentación no se
     aplicaba. */
  .drawer a.drawer-sub { padding-left: var(--s-6); }

  @media (min-width: 900px) {
    .bar { padding-inline: var(--pad-section); gap: var(--s-8); flex-wrap: nowrap; }
    /* La nav ocupa el espacio libre para que su ÚLTIMA entrada —el
       desplegable— quede pegada al bloque de autenticación, sin sacarla del
       landmark de navegación. */
    .desktop-nav { display: block; flex: 1; }
    .nav-item { display: block; margin-left: auto; }
    .register { padding-inline: var(--s-4); }
    .login {
      /*
        `inline-flex` y no `inline`, con caja de 44px: es lo mismo que declaran
        `.brand`, `.trigger`, `.register` y los enlaces del menú. Estaba bien
        CENTRADO —`.actions` es flex centrado— pero su área pulsable medía
        21,7px de alto, la mitad de lo que pide el Design System §10. Agrandar
        la caja no mueve el texto ni un píxel, porque se centra dentro de ella.
      */
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      color: var(--on-tinta-mute);
      text-decoration: none;
      font-size: var(--t-body-sm);
      font-weight: 500;
