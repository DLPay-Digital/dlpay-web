---
/**
 * Los cuatro emblemas de «Para qué lo usan» en /empresas.
 *
 * Son WIDGETS de interfaz, no dibujos: cada uno simula la pantalla de software
 * que corresponde a su caso —ruteo, saldo, comprobantes, terminal— construida
 * con HTML y CSS nativo. Cero imágenes, cero dependencias.
 *
 * ── REGLA DURA, la misma del teléfono y del portátil ────────────────────────
 *
 * Las cifras NO se teclean: salen de `quoteLimits` y de `lib/pricing`, el
 * origen único que alimenta al cotizador (D24), con la misma función
 * `convert()` que usa el instrumento. Un saldo inventado en una página
 * comercial sería una cifra sin respaldo —lo que CLAUDE.md §3 obliga a marcar y
 * D10 directamente prohíbe publicar—, así que el widget de tesorería muestra el
 * monto de muestra convertido, no un número escogido a mano.
 *
 * El precio sigue siendo de MUESTRA (ConfigPriceSource, D7) y por eso el
 * terminal lleva su etiqueta «referencial»: la web nunca muestra un precio
 * cerrado (CLAUDE.md §6).
 *
 * ── Qué dice cada uno ──────────────────────────────────────────────────────
 *
 *   proveedores · ruteo: un origen, varios destinos, todos activos
 *   tesoreria   · saldo: el dinero quieto, en la billetera del cliente
 *   recurrentes · tres comprobantes idénticos apilados: la misma operación cada mes
 *   divisas     · terminal: el par, su precio referencial y las dos patas
 *
 * `aria-hidden`: el h3 y el párrafo de al lado ya lo dicen con palabras, y una
 * interfaz simulada no debe leerse como si fuera operable.
 */
import { formatCLP, formatRate, formatUSD } from '../lib/pricing/format.ts';
import { convert } from '../lib/pricing/quote.ts';
import { ConfigPriceSource } from '../lib/pricing/config-price-source.ts';
import { quoteLimits } from '../lib/config/site.ts';
import type { EmblemKind } from '../content/business.ts';

interface Props {
  kind: EmblemKind;
}
const { kind } = Astro.props;

const price = await new ConfigPriceSource().getPrice();
const pay = quoteLimits.samplePayClp;
const get = convert('to_usd', pay, price.rate);
---
<div class:list={['emblem', kind]} aria-hidden="true">
  {kind === 'proveedores' && (
    <>
      <header class="top">
        <span class="title">Ruteo de pagos</span>
        <span class="state"><i class="dot"></i>Activo</span>
      </header>
      <div class="routes">
        {[0, 1, 2].map((i) => (
          <div class="route">
            <span class="idx num">{String(i + 1).padStart(2, '0')}</span>
            <span class="bars">
              <i class="bar"></i>
              <i class="bar sm"></i>
            </span>
            <i class="dot"></i>
          </div>
        ))}
      </div>
      <footer class="foot">
        <span>3 destinos</span>
        <span class="num">USD</span>
      </footer>
    </>
  )}

  {kind === 'tesoreria' && (
    <div class="balance-card">
      <span class="title">Saldo en tesorería</span>
      <p class="balance num">{formatUSD(get)}<em>USD</em></p>
      <span class="state"><i class="dot"></i>Dólar digital en tu billetera</span>
    </div>
  )}

  {kind === 'recurrentes' && (
    /* Tres comprobantes IDÉNTICOS: el mismo monto, la misma operación. Eso es
       lo que dice «recurrente» sin necesidad de escribirlo. */
    <div class="stack">
      {[0, 1, 2].map((i) => (
        <article class="receipt" style={`--i:${i}`}>
          <span class="r-top">
            <span class="title">Pago recurrente</span>
            <i class="dot"></i>
          </span>
          <p class="r-amount num">{formatUSD(get)}<em>USD</em></p>
          <span class="r-foot"></span>
        </article>
      ))}
    </div>
  )}

  {kind === 'divisas' && (
    <>
      <header class="top">
        <span class="title num">USD/CLP</span>
        <span class="state"><i class="dot"></i>Referencial</span>
      </header>
      <p class="rate num">{formatRate(price.rate)}</p>
      <div class="legs">
        <div class="leg">
          <span>Venta</span>
          <span class="chip num">CLP</span>
          <span class="leg-val num">{formatCLP(pay)}</span>
        </div>
        <div class="swap"><i></i></div>
        <div class="leg">
          <span>Compra</span>
          <span class="chip num">USD</span>
          <span class="leg-val num">{formatUSD(get)}</span>
        </div>
      </div>
    </>
  )}
</div>

<style>
  /**
   * Tonos del widget, locales al componente. No son tokens del Design System:
   * describen el cromo de una interfaz simulada, igual que los grises del
   * bisel del teléfono en `WhatsAppMockup`. Los dos sólidos están derivados de
   * la paleta —mezclas de `--tinta` con `--on-tinta` al 6% y 12%—, así que son
   * neutros de DLPay y no valores de otra librería.
   */
  .emblem {
    --w-surface: #19212D;   /* filas y tarjetas, sobre el panel      */
    --w-raised: #222B39;    /* la pieza que va encima del resto      */
    --w-line: rgba(255, 255, 255, .08);
    --w-line-2: rgba(255, 255, 255, .14);

    width: 100%;
    max-width: 380px;
    aspect-ratio: 4 / 3;
    background: var(--tinta-2);
    border: 1px solid var(--w-line);
    border-radius: var(--r-3);
    box-shadow: var(--elev-card);
    padding: var(--s-4);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--s-3);
  }

  /* ── Piezas compartidas ─────────────────────────────────────────────────── */
  .top { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); }
  .title {
    font-size: var(--t-dato-sm);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    color: var(--on-tinta);
  }
  .state {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: var(--on-tinta-mute);
  }
  /* Indicador de estado. El resplandor es el mismo verde a baja opacidad: es
     lo que hace que un punto se lea como «encendido» y no como una viñeta. */
  .dot {
    width: 7px;
    height: 7px;
    flex: none;
    border-radius: 50%;
    background: var(--verde);
    box-shadow: 0 0 0 3px rgba(22, 199, 132, .16);
  }
  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--s-3);
    border-top: 1px solid var(--w-line);
    font-size: 11px;
    color: var(--on-tinta-mute);
  }

  /* ── Ruteo de pagos ─────────────────────────────────────────────────────── */
  .routes { display: grid; gap: 6px; }
  .route {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: 9px var(--s-3);
    background: var(--w-surface);
    border: 1px solid var(--w-line);
    border-radius: var(--r-2);
  }
  .idx { font-size: 11px; color: var(--on-tinta-mute); flex: none; }
  /* Los destinos van abstraídos en barras: la página no inventa nombres de
     clientes ni de proveedores (D10). */
  .bars { flex: 1; display: grid; gap: 5px; }
  .bar { height: 5px; border-radius: var(--r-1); background: var(--w-raised); }
  .bar.sm { width: 55%; opacity: .7; }

  /* ── Saldo ──────────────────────────────────────────────────────────────── */
  .balance-card {
    /* `margin-block: auto` en vez de `flex: 1`: la tarjeta mide lo que mide su
       contenido y se centra en el panel. Estirada dejaba media tarjeta vacía. */
    margin-block: auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--s-2);
    padding: var(--s-4);
    background: var(--w-surface);
    border: 1px solid var(--w-line);
    border-radius: var(--r-2);
  }
  .balance {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    font-size: var(--t-h2-m);
    font-weight: 600;
    line-height: var(--lh-dato);
    letter-spacing: var(--ls-dato);
    color: var(--verde);
  }
  .balance em {
    font-style: normal;
    font-size: var(--t-dato-sm);
    font-weight: 500;
    color: var(--on-tinta-mute);
  }

  /* ── Comprobantes apilados ──────────────────────────────────────────────── */
  .stack { position: relative; flex: 1; }
  .receipt {
    position: absolute;
    left: 0;
    right: 0;
    /* Anclado al centro del panel y desplazado desde ahí: el del medio queda
       centrado y los otros dos reparten arriba y abajo. Con `top: 0` la pila
       se apelotonaba contra el borde superior y dejaba el panel vacío debajo.
       Cada comprobante baja un escalón y se estrecha un poco: la pila se lee
       en perspectiva sin recurrir a una transformación 3D. */
    top: 50%;
    transform:
      translateY(calc(-50% + (var(--i) - 1) * 26px))
      scaleX(calc(1 - (2 - var(--i)) * .05));
    z-index: var(--i);
    padding: var(--s-3);
    background: var(--w-surface);
    border: 1px solid var(--w-line);
    border-radius: var(--r-2);
    box-shadow: 0 10px 20px -10px rgba(0, 0, 0, .6);
  }
  .receipt:nth-child(3) { background: var(--w-raised); border-color: var(--w-line-2); }
  .r-top { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); }
  .r-amount {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-top: var(--s-2);
    font-size: var(--t-h3-m);
    font-weight: 600;
    line-height: var(--lh-dato);
    letter-spacing: var(--ls-dato);
    color: var(--verde);
  }
  .r-amount em {
    font-style: normal;
    font-size: 11px;
    font-weight: 500;
    color: var(--on-tinta-mute);
  }
  .r-foot {
    display: block;
    height: 1px;
    margin-top: var(--s-3);
    background: var(--w-line);
  }

  /* ── Terminal ───────────────────────────────────────────────────────────── */
  .rate {
    font-size: var(--t-h2-m);
    font-weight: 600;
    line-height: var(--lh-dato);
    letter-spacing: var(--ls-dato);
    color: var(--on-tinta);
  }
  .legs { display: grid; gap: 6px; }
  .leg {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding: 9px var(--s-3);
    background: var(--w-surface);
    border: 1px solid var(--w-line);
    border-radius: var(--r-2);
    font-size: 11px;
    color: var(--on-tinta-mute);
  }
  .chip {
    padding: 2px 6px;
    border-radius: var(--r-1);
    background: var(--w-raised);
    color: var(--on-tinta);
    font-size: 10px;
  }
  .leg-val { margin-left: auto; color: var(--on-tinta); font-size: var(--t-dato-sm); }
  /* El indicador de conversión: la cuña del sistema, girada al eje vertical. */
  .swap { display: flex; justify-content: center; }
  .swap i {
    display: block;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(22, 199, 132, .14);
    position: relative;
  }
  .swap i::before,
  .swap i::after {
    content: '';
    position: absolute;
    left: 50%;
    width: 1.5px;
    height: 6px;
    background: var(--verde);
    border-radius: 1px;
  }
  .swap i::before { top: 5px; transform: translateX(-50%) rotate(28deg); }
  .swap i::after  { bottom: 5px; transform: translateX(-50%) rotate(28deg); }

  @media (min-width: 900px) {
    .emblem { padding: var(--s-5); }
    .balance { font-size: var(--t-h2); }
    .rate { font-size: var(--t-h2); }
    .receipt {
      transform:
        translateY(calc(-50% + (var(--i) - 1) * 30px))
        scaleX(calc(1 - (2 - var(--i)) * .05));
    }
  }
</style>
