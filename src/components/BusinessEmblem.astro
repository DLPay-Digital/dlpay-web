---
/**
 * Las cuatro figuras de «Para qué lo usan» en /empresas.
 *
 * ── Por qué se reescribió entero el 2026-09-16 ──────────────────────────────
 *
 * Antes eran cuatro WIDGETS que simulaban pantallas de software —ruteo, saldo,
 * comprobantes, terminal—. Tres de ellos insinuaban producto que DLPay no
 * tiene: un panel de «Ruteo de pagos» con tres destinos activos sugiere que
 * DLPay ejecuta pagos a varios destinatarios, y un «Saldo en tesorería» sugiere
 * que DLPay mantiene un saldo de la empresa. El servicio real convierte y
 * entrega dólar digital EN LA BILLETERA DEL CLIENTE, y desde ahí decide él
 * (CLAUDE.md §1, regla dura de contenido). No era un problema estético: la
 * página más comercial del sitio estaba insinuando producto.
 *
 * Con el cambio se van tres cosas más, de un golpe:
 * · la cifra `2.174,62` aparecía SEIS veces en la página construida;
 * · los cuatro paneles usaban `--elev-card`, que el Design System §4.5 reserva
 *   sólo para la tarjeta del cotizador sobre tinta;
 * · el `aspect-ratio: 4/3` dejaba dos paneles medio vacíos.
 *
 * Por eso este componente ya NO importa `lib/pricing` ni `quoteLimits`: no hay
 * ninguna cifra que derivar porque no hay ninguna cifra.
 *
 * ── La gramática, común a las cuatro ────────────────────────────────────────
 *
 * · Un PLANO en tinta cuyo canto ES el corte del isotipo: dx 202 : dy 300, los
 *   ~34° de la marca (ADR-0001 §3, Design System §6). El mismo polígono en las
 *   cuatro, así que la frontera no es una línea prestada sino la diagonal de
 *   DLPay.
 * · El dinero es un canal HUECO dentro del plano y MACIZO fuera: el mismo trazo
 *   cambiando de material al cruzar, resuelto con dos `clipPath`. Cuando algo
 *   cruza, la cuña se parte justo en el canto.
 * · Los nodos son contrapartes, y cambian de token según la superficie que
 *   tienen debajo: `--verde` sobre tinta (8,45:1) y `--verde-deep` sobre papel
 *   (4,90:1). No es una inconsistencia — es la regla del Design System §2.4.
 * · Etiquetas en Spline Sans Mono a 13 px. NINGUNA cifra, en ninguna.
 * · `viewBox` 460×300 en las cuatro, para que las cuatro filas midan lo mismo.
 *
 * Qué dice cada una: proveedores, un canal que cruza · tesorería, un volumen
 * quieto y nada cruzando el canto —el vacío de la derecha ES la frase «sin
 * abrir una cuenta en el extranjero»— · recurrentes, tres cruces idénticos
 * cuyas cuñas caen escalonadas sobre la diagonal · divisas, dos bloques del
 * mismo tamaño a cada lado del canto con la cuña vertical entre ellos.
 *
 * Las coordenadas y los grosores dentro del `viewBox` son EL DIBUJO, no valores
 * de diseño: no salen de la escala de espaciado ni la contradicen. Mismo
 * criterio que ya rige en `UseCaseFigure.astro`.
 *
 * ── Una limitación conocida ─────────────────────────────────────────────────
 *
 * Los `clipPath` usan identificadores globales al documento (`p1-in`, `p3-out`,
 * …). Hoy es seguro porque cada caso se renderiza UNA sola vez: los cuatro
 * `emblem` de `content/business.ts` son distintos entre sí. Si algún día dos
 * filas comparten `kind`, los dos SVG declararían el mismo id y el segundo
 * recortaría con el primero: habría que sufijar los ids por instancia.
 *
 * `aria-hidden`: el `h3` y el párrafo de al lado ya lo dicen con palabras.
 */
import type { EmblemKind } from '../content/business.ts';

interface Props {
  kind: EmblemKind;
}
const { kind } = Astro.props;

/**
 * El canto de la marca. Idéntico en las cuatro figuras, a propósito: es lo que
 * las hace un sistema y no cuatro dibujos sueltos.
 */
const PLANO = 'M0 0H320L118 300H0Z';
/**
 * El complemento: un rectángulo que desborda el `viewBox` con el plano restado
 * por `clip-rule="evenodd"`. Sirve para pintar lo que queda FUERA del canto.
 * Va literal y no derivado de `PLANO` — el `M` del segundo subtrazo es parte
 * del dato, y concatenarlo a mano es justo donde se cuela un `path` inválido.
 */
const FUERA = 'M-10 -10H470V310H-10ZM0 0H320L118 300H0Z';
---
{kind === 'proveedores' && (
  <svg class="emblem" viewBox="0 0 460 300" aria-hidden="true">
    <defs>
      <clipPath id="p1-in"><path d={PLANO}/></clipPath>
      <clipPath id="p1-out"><path d={FUERA} clip-rule="evenodd"/></clipPath>
    </defs>
    <path d={PLANO} fill="var(--tinta)"/>
    <g clip-path="url(#p1-in)"><path d="M62 150H192l18-22 18 44 18-22H398" fill="none"
       stroke="var(--papel)" stroke-width="20" stroke-linejoin="round"/></g>
    <g clip-path="url(#p1-out)"><path d="M62 150H192l18-22 18 44 18-22H398" fill="none"
       stroke="var(--tinta)" stroke-width="20" stroke-linejoin="round"/></g>
    <circle cx="34" cy="150" r="11" fill="var(--verde)"/>
    <circle cx="426" cy="150" r="11" fill="var(--verde-deep)"/>
    <text x="22" y="200" fill="var(--on-tinta-mute)" font-family="var(--f-num)" font-size="13">CLP</text>
    <text x="438" y="200" fill="var(--ink-mute)" font-family="var(--f-num)" font-size="13" text-anchor="end">USD</text>
  </svg>
)}

{kind === 'tesoreria' && (
  <svg class="emblem" viewBox="0 0 460 300" aria-hidden="true">
    <path d={PLANO} fill="var(--tinta)"/>
    {/*
      La caja usa el MISMO material que el dinero de las otras figuras —una
      barra hueca— pero en VERTICAL: un volumen apilado, no un trayecto. Nada
      cruza el canto, y ése es el dibujo: «sin abrir una cuenta en el
      extranjero» dicho sin palabras. El vacío de la derecha es la frase.
    */}
    <rect x="40" y="80" width="130" height="135" fill="var(--papel)"/>
    <rect x="40" y="80" width="130" height="48" fill="var(--verde)"/>
    <text x="54" y="111" fill="var(--on-verde)" font-family="var(--f-num)" font-size="13">USD</text>
    <text x="54" y="179" fill="var(--ink-mute)" font-family="var(--f-num)" font-size="13">CLP</text>
  </svg>
)}

{kind === 'recurrentes' && (
  <svg class="emblem" viewBox="0 0 460 300" aria-hidden="true">
    <defs>
      <clipPath id="p3-in"><path d={PLANO}/></clipPath>
      <clipPath id="p3-out"><path d={FUERA} clip-rule="evenodd"/></clipPath>
    </defs>
    <path d={PLANO} fill="var(--tinta)"/>
    <g clip-path="url(#p3-in)">
      <path d="M62 90H238l14-17 14 34 14-17H398"  fill="none" stroke="var(--papel)" stroke-width="16" stroke-linejoin="round"/>
      <path d="M62 150H198l14-17 14 34 14-17H398" fill="none" stroke="var(--papel)" stroke-width="16" stroke-linejoin="round"/>
      <path d="M62 210H158l14-17 14 34 14-17H398" fill="none" stroke="var(--papel)" stroke-width="16" stroke-linejoin="round"/>
    </g>
    <g clip-path="url(#p3-out)">
      <path d="M62 90H238l14-17 14 34 14-17H398"  fill="none" stroke="var(--tinta)" stroke-width="16" stroke-linejoin="round"/>
      <path d="M62 150H198l14-17 14 34 14-17H398" fill="none" stroke="var(--tinta)" stroke-width="16" stroke-linejoin="round"/>
      <path d="M62 210H158l14-17 14 34 14-17H398" fill="none" stroke="var(--tinta)" stroke-width="16" stroke-linejoin="round"/>
    </g>
    <circle cx="34" cy="90"  r="10" fill="var(--verde)"/>
    <circle cx="34" cy="150" r="10" fill="var(--verde)"/>
    <circle cx="34" cy="210" r="10" fill="var(--verde)"/>
    <circle cx="426" cy="90"  r="10" fill="var(--verde-deep)"/>
    <circle cx="426" cy="150" r="10" fill="var(--verde-deep)"/>
    <circle cx="426" cy="210" r="10" fill="var(--verde-deep)"/>
  </svg>
)}

{kind === 'divisas' && (
  <svg class="emblem" viewBox="0 0 460 300" aria-hidden="true">
    <defs>
      <clipPath id="p4-in"><path d={PLANO}/></clipPath>
      <clipPath id="p4-out"><path d={FUERA} clip-rule="evenodd"/></clipPath>
    </defs>
    <path d={PLANO} fill="var(--tinta)"/>
    {/*
      Mismo alto y mismo ancho a cada lado del canto: el valor no cambia, cambia
      la unidad. El tamaño de los bloques es el argumento del volumen.
    */}
    <rect x="48" y="90" width="130" height="120" fill="var(--papel)"/>
    <rect x="270" y="90" width="130" height="120" fill="var(--tinta)"/>
    <g clip-path="url(#p4-in)"><path d="M219 100v22l14 14-28 14 14 14v22" fill="none"
       stroke="var(--papel)" stroke-width="16" stroke-linejoin="round"/></g>
    <g clip-path="url(#p4-out)"><path d="M219 100v22l14 14-28 14 14 14v22" fill="none"
       stroke="var(--tinta)" stroke-width="16" stroke-linejoin="round"/></g>
    <text x="48" y="238" fill="var(--on-tinta-mute)" font-family="var(--f-num)" font-size="13">CLP</text>
    <text x="400" y="238" fill="var(--ink-mute)" font-family="var(--f-num)" font-size="13" text-anchor="end">USD</text>
  </svg>
)}

<style>
  /*
    Sin panel, sin radio, sin sombra y sin fondo: la figura ES el dibujo. El
    `max-width` coincide con el ancho del `viewBox` para que nunca se escale
    por encima de su tamaño natural, y el alto lo deja gobernar la proporción
    460×300 — igual en las cuatro, así que las cuatro filas miden lo mismo.
  */
  .emblem {
    width: 100%;
    max-width: 460px;
    height: auto;
    display: block;
  }
</style>
