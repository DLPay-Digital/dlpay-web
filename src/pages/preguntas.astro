---
/**
 * /preguntas — las nueve preguntas del sitio, agrupadas, y el glosario.
 *
 * ── Por qué no usa `Faq.astro`, si publica las mismas preguntas ────────────
 *
 * Porque a esta página se llega **para** las respuestas, y a un acordeón se
 * llega ojeando. En la Home y en `/empresas` el bloque de preguntas es
 * secundario —está al final de una página que argumenta otra cosa— y ahí un
 * `<details>` es lo correcto: comprime lo que la mayoría no va a abrir. Acá la
 * respuesta es el contenido, así que va **abierta**.
 *
 * `Faq.astro` se queda como está y esas dos páginas lo siguen usando. **No se
 * unifican**: son dos presentaciones de un mismo dato, que es justamente lo que
 * el dato tipado permite.
 *
 * ── De dónde sale cada cosa ────────────────────────────────────────────────
 *
 * · Las nueve preguntas y respuestas: `home.ts` y `business.ts`. Ni una palabra
 *   escrita acá.
 * · **Qué pregunta va en qué grupo: del campo `concern` de cada pregunta**, no
 *   de una lista en esta página. Con cinco listas de textos, reescribir una
 *   pregunta en `home.ts` la sacaría de su grupo sin que nada fallara — el
 *   mismo fallo silencioso que tenía el `id` de `Faq.astro`.
 * · **De qué lado es cada pregunta: de qué archivo viene.** No hay campo que lo
 *   diga, porque un campo así podría contradecir a su propio origen.
 * · Los ocho términos: `glossary.ts`.
 *
 * Lo único escrito acá son los cinco títulos de preocupación y el cierre. Son
 * de esta página y de ninguna otra. *(El párrafo que explicaba la agrupación se
 * retiró el 2026-09-24, por decisión de Sebastián: los cinco títulos la dicen
 * sin necesidad de introducirla.)*
 *
 * ── Sin índice y sin numerar, por decisión de Sebastián del 2026-09-24 ─────
 *
 * La primera versión de esta forma traía un índice pegajoso de seis anclas y
 * numeraba los grupos 01 a 05. Las dos cosas se retiraron por estética.
 *
 * **Los `id` de las secciones se quedan**, aunque ya nada de esta página
 * enlace a ellos: `aria-labelledby` los necesita para dar nombre a cada
 * `<section>`, y un enlace externo a `/preguntas/#cuanto-cuesta` sigue
 * funcionando. `scroll-margin-top` también se queda, que es lo que hace que ese
 * enlace no deje el título pegado al borde.
 */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Motion from '../components/Motion.astro';
import { faq as faqPersonas, type Concern, type FaqItem } from '../content/home.ts';
import { faq as faqEmpresas } from '../content/business.ts';
import { glossary } from '../content/glossary.ts';
import { contact } from '../lib/config/site.ts';

/*
  El orden de los grupos y sus títulos. El `id` se DERIVA del título con el
  mismo criterio que `Faq.astro`: escrito a mano puede repetirse o no coincidir
  con su `aria-labelledby`, y ese fallo es silencioso.
*/
const grupos: readonly { concern: Concern; title: string }[] = [
  { concern: 'recibo', title: 'Qué recibo, y cuándo' },
  { concern: 'precio', title: 'Cuánto cuesta' },
  { concern: 'alcance', title: 'Hasta dónde llegamos' },
  { concern: 'requisitos', title: 'Qué te pedimos' },
  { concern: 'atencion', title: 'Quién te atiende' },
];

const slug = (t: string): string =>
  t
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

/*
  Cada pregunta se etiqueta con su lado al salir de su archivo, y a partir de
  ahí las dos fuentes son una sola lista. Así el grupo no tiene que saber de
  dónde vino nada.
*/
type Pregunta = FaqItem & { lado: 'persona' | 'empresa' };
const todas: readonly Pregunta[] = [
  ...faqPersonas.map((f): Pregunta => ({ ...f, lado: 'persona' })),
  ...faqEmpresas.map((f): Pregunta => ({ ...f, lado: 'empresa' })),
];

const secciones = grupos.map((g) => {
  const preguntas = todas.filter((p) => p.concern === g.concern);
  const lados = new Set(preguntas.map((p) => p.lado));
  return {
    ...g,
    id: slug(g.title),
    preguntas,
    /* Con un solo lado la cabecera ya dice quién pregunta y el rótulo por
       pregunta sobra A LA VISTA. Se oculta con la utilidad `.sr-only`, que lo
       deja para el lector de pantalla. */
    unLado: lados.size === 1,
    quienes: lados.size === 1 ? [...lados][0] : 'persona y empresa',
  };
});

/*
  Comprobación en tiempo de build: ninguna pregunta puede quedarse fuera de un
  grupo. Con `concern` tipado esto no debería ocurrir nunca, pero el día que se
  añada una preocupación al tipo y se olvide añadir su grupo acá, el build lo
  dice en vez de publicar una pregunta invisible.
*/
const colocadas = secciones.reduce((n, s) => n + s.preguntas.length, 0);
if (colocadas !== todas.length) {
  throw new Error(
    `/preguntas: ${todas.length - colocadas} pregunta(s) sin grupo. ` +
      `Revisa que cada valor de \`Concern\` tenga su entrada en \`grupos\`.`
  );
}

const wa = contact.whatsappUrl('Hola, tengo una duda que no encontré en la web.');
---
<Base
  title="Preguntas"
  description="Las preguntas que nos hacen antes de operar, agrupadas por preocupación, y el glosario de las palabras que usamos: dólar digital, spread, precio referencial, billetera."
  path="/preguntas/"
>
  <Motion />
  <Header />
  <main id="main">
    <PageHero
      title="Preguntas"
      lead="Lo que nos preguntan antes de operar, y las palabras que usamos para responder."
      sequence
    />

    <div class="cuerpo">
      <div class="inner">
        <div class="grupos">
            {secciones.map((s) => (
              <section class="grupo" id={s.id} aria-labelledby={`${s.id}-t`}>
                <header class="g-cab" data-enter>
                  <h2 id={`${s.id}-t`}>{s.title}</h2>
                  <span class="quienes">{s.quienes}</span>
                </header>
                <div class="qs">
                  {s.preguntas.map((p) => (
                    <div class:list={['qa', { solo: s.unLado }]}>
                      <p class:list={['quien', { 'sr-only': s.unLado }]}>{p.lado}</p>
                      <div>
                        <h3>{p.q}</h3>
                        <p class="r">{p.a}</p>
                      </div>
                    </div>
                  ))}
                </div>
              </section>
            ))}
        </div>
      </div>
    </div>

    <section class="palabras" id="las-palabras" aria-labelledby="palabras-t">
      <div class="inner">
        <h2 id="palabras-t" data-enter>Las palabras</h2>
        <p class="bajada">
          Ocho términos que usamos en todo el sitio. Cinco están definidos con las mismas palabras
          que ya usamos en otra página; tres son nuevos.
        </p>
        {/* `<dl>`, `<dt>` y `<dd>` de verdad: un lector de pantalla anuncia
            «lista de descripción, 8 elementos» y permite saltar de término en
            término, cosa que una retícula de `<div>` no da. */}
        <dl>
          {glossary.map((t) => (
            <div class="term">
              <dt>{t.term}</dt>
              <dd>
                {t.definition}
                {t.href && t.linkLabel ? (
                  <a class="dest" href={t.href}>→ {t.linkLabel}</a>
                ) : (
                  /* La ausencia se VE. `glossary.ts` lo dice en su cabecera: el
                     sitio no explica «red» en ninguna parte, y que el hueco se
                     note es parte de la información. */
                  <span class="sin-dest">El sitio todavía no lo explica en ninguna parte</span>
                )}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    {/*
      El cierre invita a PREGUNTAR y no a cotizar: en una página de dudas, la
      acción que sigue es escribir. Y el enlace lleva mensaje prellenado, así
      que **no engrosa la lista de D22** —los cinco enlaces planos que abren el
      chat en blanco—: nace resuelto.
    */}
    <section class="close" aria-labelledby="close-title">
      <div class="inner">
        <h2 id="close-title" data-enter>¿Te quedó una duda que no está acá?</h2>
        <p>Escríbenos y te responde una persona del equipo. No hace falta cuenta para preguntar.</p>
        <a class="cta" href={wa} target="_blank" rel="noopener">Escribir por WhatsApp</a>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .inner { max-width: var(--container); margin: 0 auto; padding: 0 var(--pad-section-m); }
  .cuerpo { background: var(--papel); padding: var(--s-9) 0; }

  /*
    Sin índice, la columna de texto se queda sola en un contenedor ancho. El
    `max-width` lo devuelve a una medida de lectura: sin él, los títulos de
    grupo y sus filetes cruzarían los 1.200px del contenedor y la página se
    leería como una tabla.
  */
  /*
    Sin tope propio: la columna la limita `.inner`, como en el resto del sitio.

    **Tuvo `max-width: 760px` hasta el 2026-09-25**, y el efecto medido a 1280 px
    era éste: el bloque empezaba en 141 y terminaba en 901, con **365 px de papel
    muerto a la derecha** contra 141 a la izquierda. Lo detectó Cowork; lo que su
    medición no tenía es que el titular de la página empieza también en 141,
    porque `PageHero` usa el mismo `.inner`. O sea que el borde izquierdo era el
    correcto y el que sobraba era el derecho.

    **Por qué no se centró, que era el arreglo obvio.** Centrar habría movido la
    columna a 253 y la habría despegado del titular. Sebastián eligió lo otro:
    dejar el borde izquierdo donde está y quitar el hueco. Quitando el tope, el
    bloque ocupa los 984 px del contenedor y queda en **141 a la izquierda y 140 a
    la derecha** — simétrico por construcción, sin mover un píxel el borde que ya
    estaba bien.

    **La medida de lectura no depende de esto y por eso se puede soltar.** Quien
    la fija es `.qa .r { max-width: 47ch }`, que no se toca. Lo que se ensancha es
    la ESTRUCTURA —el filete de cada cabecera y el rótulo `persona y empresa` que
    vive en su extremo—, no el texto.
  */
  .grupos { }
  /* El primer grupo abre la página: sin el párrafo de entrada, su cabecera no
     necesita el aire que separaba una cosa de la otra. */
  .grupo:first-child .g-cab { padding-top: 0; }

  /* `scroll-margin-top` para que el ancla no deje el título pegado al borde ni
     debajo de la cabecera. */
  .grupo { scroll-margin-top: var(--s-7); }
  .grupo + .grupo { margin-top: var(--s-9); }

  .g-cab {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    flex-wrap: wrap;
    padding-bottom: var(--s-4);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--s-6);
  }
  .g-cab h2 {
    font-size: var(--t-h2-m);
    font-weight: 700;
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
    margin: 0;
  }
  .quienes {
    margin-left: auto;
    font-family: var(--f-num);
    font-size: var(--t-dato-sm);
    color: var(--ink-mute);
  }

  .qs { display: grid; gap: var(--s-6); }
  /*
    Dos columnas: el rótulo de lado y la pregunta con su respuesta.

    **Cuando el rótulo se oculta, la rejilla pasa a UNA columna.** Con
    `.sr-only` el rótulo sale del flujo, y si la rejilla siguiera reservándole
    su columna el contenido se metería en lo que queda: medido en la maqueta,
    la página crecía de 4.023 a 5.451px. No se ve leyendo el CSS, se ve en el
    alto.
  */
  .qa { display: grid; grid-template-columns: 96px 1fr; gap: var(--s-4); align-items: baseline; }
  .qa.solo { grid-template-columns: 1fr; }
  .quien {
    font-family: var(--f-num);
    font-size: var(--t-dato-sm);
    color: var(--ink-mute);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .qa h3 {
    font-size: var(--t-h3-m);
    font-weight: 600;
    line-height: var(--lh-h3);
    margin-bottom: var(--s-2);
  }
  .qa .r { color: var(--ink-mute); max-width: 47ch; }

  /* ── El glosario, a pliego ─────────────────────────────────────────────── */
  .palabras { background: var(--papel-2); padding: var(--s-9) 0; scroll-margin-top: var(--s-7); }
  .palabras h2 {
    font-size: var(--t-h2-m);
    font-weight: 700;
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
    margin-bottom: var(--s-3);
  }
  .bajada { color: var(--ink-mute); max-width: 46ch; margin-bottom: var(--s-7); }
  /*
    La misma columna que los grupos de arriba. Al quitar el índice, las dos
    secciones dejaron de acabar en el mismo sitio —901 contra 1.125 px— y el
    borde derecho de la página daba un salto entre una y otra.
  */
  /* Mismo caso y misma razón que `.grupos`: el tope de 760 salía sobrando por
     la derecha. Las definiciones ya están acotadas por `dd { max-width: 47ch }`,
     así que soltar el contenedor ensancha la rejilla y no la lectura. Los dos
     bloques siguen alineados porque los dos los limita `.inner`. */
  dl { margin: 0; border-top: 1px solid var(--line); }
  .term { border-bottom: 1px solid var(--line); padding: var(--s-5) 0; }
  dt { font-size: var(--t-h3-m); font-weight: 700; margin-bottom: var(--s-2); }
  dd { margin: 0; color: var(--ink-mute); max-width: 47ch; }
  .dest {
    font-family: var(--f-num);
    font-size: var(--t-dato-sm);
    color: var(--verde-deep);
    white-space: nowrap;
    margin-left: var(--s-2);
  }
  /* La ausencia, dicha. Va en el gris del texto secundario y no en verde:
     no es un destino, es la falta de uno. */
  .sin-dest {
    display: block;
    margin-top: var(--s-2);
    padding-left: var(--s-3);
    border-left: 1px solid var(--line);
    font-family: var(--f-num);
    font-size: var(--t-dato-sm);
    color: var(--ink-mute);
  }

  /*
    La banda de cierre va sobre papel (Design System §6.3, revisado el
    2026-09-24): el pie es `--tinta`, así que una banda clara se distingue de él
    sin depender de ningún filete. El tono es el que CONTINÚA la alternancia de
    esta página — la sección de arriba es `--papel-2`, así que ésta es `--papel`.
    Centrada: la invitación y su acción leen como una sola pieza.
  */
  .close { background: var(--papel); padding: var(--s-9) 0; text-align: center; }
  /*
    La escala de sección, explícita. Esta página no tiene una regla `h2` suelta
    —los tamaños van por selector— así que dejarlo sin `font-size` no lo hacía
    heredar nada: caía al tamaño por defecto del navegador, **24px**, que no
    está en la escala. Medido a 390.
  */
  .close h2 {
    color: var(--ink);
    font-size: var(--t-h2-m);
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
    margin-bottom: var(--s-3);
  }
  .close p { color: var(--ink-mute); margin: 0 auto var(--s-5); max-width: 47ch; }
  .cta {
    display: inline-flex;
    align-items: center;
    background: var(--verde);
    color: var(--on-verde);
    font-weight: 700;
    font-size: var(--t-body);
    padding: var(--s-4) var(--s-6);
    border-radius: var(--r-2);
    text-decoration: none;
  }
  .cta { transition: background-color var(--m-fast) var(--m-ease); }
  .cta:hover { background: var(--verde-hi); }

  @media (min-width: 900px) {
    .inner { padding-inline: var(--pad-section); }
    .grupo { scroll-margin-top: var(--s-8); }
    .palabras { scroll-margin-top: var(--s-8); }
    .g-cab h2 { font-size: var(--t-h2); }
    /* Los dos que faltaban: `.palabras h2` se quedaba en la escala móvil y las
       preguntas, en la de H3 móvil, mientras todos los H3 del sitio van a 20. */
    .palabras h2 { font-size: var(--t-h2); }
    .close h2 { font-size: var(--t-h2); }
    .qa h3 { font-size: var(--t-h3); }
    dt { font-size: var(--t-h3); }
    /* El término en su columna: el ojo baja por los ocho sin atravesar las
       definiciones. */
    .term { display: grid; grid-template-columns: 200px 1fr; gap: var(--s-6); align-items: baseline; }
    dt { margin-bottom: 0; }
  }
</style>
