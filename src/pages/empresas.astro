---
/**
 * /empresas — el carril B2B (phase-2.5 §4).
 *
 * Misma mesa, otro tamaño de operación. Lenguaje de tesorería, sin volverse un
 * folleto corporativo ni prometer nada que no exista (no hay API todavía).
 */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import MacbookMockup from '../components/MacbookMockup.astro';
import BusinessEmblem from '../components/BusinessEmblem.astro';
import EjeDeAlcance from '../components/EjeDeAlcance.astro';
import { hingeBusiness, optionsBusiness, ourLegBusiness } from '../content/scope.ts';
import Motion from '../components/Motion.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import { businessUseCases, checklist, differences, faq, onboarding } from '../content/business.ts';
import { contact, platform } from '../lib/config/site.ts';

const wa = contact.whatsappUrl(
  'Hola, escribo por DLPay Empresas. Quiero conocer las condiciones para pagos al exterior y cambio de divisas.'
);

/**
 * Enlace del encabezado. Abre el chat EN BLANCO a propósito: el mensaje
 * prellenado de los enlaces planos es D22 (CLAUDE.md §13) y está en pausa.
 *
 * PENDIENTE DE DECISIÓN — texto del botón ("Habla con nosotros", provisional) y
 * mensaje prellenado de este enlace. Depende de D22 / Sebastián.
 */
const waPlain = contact.whatsappUrl();
---
<Base
  title="DLPay Empresas"
  description="Cambio de divisas y tesorería en dólar digital para empresas en Chile: ejecutivo asignado, condiciones conversadas según volumen y verificación de la sociedad."
  path="/empresas/"
>
  <Motion />
  <Header />
  <main id="main">
    {/*
      REQUIERE VALIDACIÓN DE COMPLIANCE — "el mejor precio" es un claim
      comparativo sobre el precio, y los claims de precio, spread y condiciones
      comerciales los aprueba DLPay, no ingeniería (CLAUDE.md §3). Se cruza
      además con D5, la transparencia del spread, que sigue abierta. Copy pedido
      por Sebastián el 2026-09-10; queda publicado bajo esa decisión.

      La bajada, en cambio, NO abre claim nuevo: dice lo mismo que ya afirma
      `/tarifas` —un solo precio con el spread dentro y ninguna comisión que se
      sume al final—, así que las dos páginas se sostienen entre sí.
    */}
    <PageHero
      title="La misma mesa, el mejor precio"
      lead="Un solo precio, con el spread ya incluido. Sin comisiones que aparezcan después."
      titleSize="hero"
      sequence
      layout="stacked"
    >
      <Fragment slot="cta">
        <a class="cta" href={waPlain} target="_blank" rel="noopener">
          <Icon name="whatsapp" class="wa-icon" />
          Habla con nosotros
        </a>
        {/* Misma ruta que el botón de la cabecera: la plataforma de Guita, que
            es donde vive el registro. La web nueva no lo reconstruye. */}
        <a class="ghost" href={platform.registerUrl}>Crea tu cuenta</a>
      </Fragment>
      <MacbookMockup slot="aside" />
    </PageHero>

    <section class="cases" aria-labelledby="cases-title">
      <div class="inner">
        <header class="head">
          <h2 id="cases-title" data-enter>Para qué lo usan</h2>
          <p>
            Cuatro situaciones concretas. Todas parten del mismo servicio: cambiamos tus
            pesos y te entregamos dólar digital. Si la tuya no está acá, conversémosla.
          </p>
        </header>
        {/*
          Zigzag: texto y emblema alternan de lado en escritorio. El orden del
          DOM es siempre texto → emblema, que es el orden de lectura; el lado lo
          decide `grid-column`, no el orden de los elementos, para que un lector
          de pantalla nunca oiga la página en zigzag.

          Las cuatro filas conservan `data-enter`: son cuatro hermanas, justo el
          tope de M5 (Motion System V1 §4, regla dura 4), y el escalonado por
          `nth-child` de tokens.css sigue aplicando igual que antes.
        */}
        <ul class="cases-list" role="list">
          {businessUseCases.map((item) => (
            <li class="case-row" data-enter>
              <div class="case-text">
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
              <div class="case-visual">
                <BusinessEmblem kind={item.emblem} />
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="diff" aria-labelledby="diff-title">
      <div class="inner">
        <header class="head">
          <h2 id="diff-title" data-enter>Qué cambia respecto de una persona</h2>
          <p>El producto es el mismo. Lo que cambia es el acompañamiento y la verificación.</p>
        </header>

        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">&nbsp;</th>
                <th scope="col">Persona</th>
                <th scope="col">Empresa</th>
              </tr>
            </thead>
            <tbody>
              {differences.map((row) => (
                <tr>
                  <th scope="row">{row.aspect}</th>
                  <td>{row.person}</td>
                  <td class="hi">{row.company}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="steps-band" aria-labelledby="onboarding-title">
      <div class="inner">
        <div class="split">
          <div>
            <h2 id="onboarding-title" data-enter>Cómo empezamos</h2>
            <p class="lead">
              No hay formulario que llenar a ciegas. Se parte conversando y seguimos desde ahí.
            </p>

            {/*
              La columna que faltaba. `/como-funciona` tiene su «Ten esto a mano»
              para una persona y esta página no tenía equivalente: una empresa
              que llega acá no necesita que le dibujen los cuatro pasos —la lista
              numerada ya los dice—, necesita saber qué juntar antes de escribir.
            */}
            <h3 class="sub">Ten esto a mano</h3>
            <ul class="check" role="list">
              {/* El icono sale del dato, no de la posición. Ver la nota gemela
                  en `/como-funciona`: los tres ticks idénticos no eran
                  checkboxes, sólo decían «esto es un ítem». */}
              {checklist.map((item) => (
                <li>
                  <Icon name={item.icon} size={20} class="tick" />
                  <span>{item.text}</span>
                </li>
              ))}
            </ul>
          </div>
          <ol class="onboarding" role="list">
            {onboarding.map((step, i) => (
              <li>
                <span class="n num">{i + 1}</span>
                <span>{step}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    {/*
      /empresas NO declaraba el límite en ninguna parte. Comprobado sobre el
      build: en todo el `main` no aparecían «billetera», «cuenta bancaria»,
      «moneda local» ni «no depositamos». Lo único que se acercaba era la
      salvedad de un caso de uso —«si tu proveedor sólo recibe por banco,
      conversémoslo antes»—, que es una advertencia indirecta y no una
      declaración del alcance.

      Y es la página cuyo lector es el MÁS propenso a dar por supuesta una
      transferencia bancaria: una empresa que paga a un proveedor fuera de Chile.
    */}
    <section class="scope" aria-labelledby="scope-title">
      <div class="inner">
        <h2 id="scope-title">Hasta dónde llega nuestra parte</h2>
        <EjeDeAlcance milestones={ourLegBusiness} hinge={hingeBusiness} options={optionsBusiness}>
          <Fragment slot="caveat">
            Convertir el dólar digital a moneda local en destino es un proceso distinto, con
            otros servicios, y <strong>no lo realiza DLPay</strong>. Si tu proveedor sólo
            recibe por banco, conversémoslo antes.
          </Fragment>
        </EjeDeAlcance>
      </div>
    </section>

    {/*
      La página no tenía FAQ, y las cinco de la Home son enteras de persona. Las
      cuatro preguntas viven en `content/business.ts`, no acá: son contenido.
    */}
    <Faq items={faq} title="Preguntas de una empresa" />

    <section class="contact on-tinta-surface" aria-labelledby="contact-title">
      <div class="inner">
        <h2 id="contact-title">Hablemos de tu operación</h2>
        <p>
          Cuéntanos a dónde pagas, qué montos manejas y con qué frecuencia. Te responde una
          persona del equipo, no un formulario.
        </p>
        <div class="actions">
          <a class="cta" href={wa} target="_blank" rel="noopener">
            <Icon name="whatsapp" class="wa-icon" />
            Escribir por WhatsApp
          </a>
          <a class="ghost" href="/#cotizador">Ver el cotizador</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--pad-section-m);
  }
  /* Centrado de las dos cabeceras con `.head` —«Para qué lo usan» y «Qué cambia
     respecto de una persona»—, titular y bajada. `margin-inline: auto` es lo que
     centra la CAJA: con sólo `text-align`, el `max-width` la dejaría pegada a la
     izquierda. Las otras dos cabeceras de la página no llevan esta clase y siguen
     alineadas a la izquierda. */
  .head { max-width: 46ch; margin: 0 auto var(--s-7); text-align: center; }
  h2 {
    font-size: var(--t-h2-m);
    font-weight: 700;
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
    margin-bottom: var(--s-3);
  }
  .head p { color: var(--ink-mute); }

  /*
    El montaje del portátil: cuánto de él queda sobre la superficie clara. Es la
    mitad de su alto, medido en el navegador — 332,8 px en escritorio y 262 px a
    390, que es donde alcanza esa proporción.

    Va como propiedad y no suelto en dos reglas porque los DOS sitios que lo usan
    tienen que leer el mismo número: el saliente del portátil y el aire que la
    sección siguiente tiene que recuperar. Si se separan, dejan de cuadrar.

    Y va en `main` y no en `.page-hero`: `.cases` es su HERMANA, no su
    descendiente, así que declarada en la banda no la heredaría.

    El portátil es fluido bajo 900 px —su alto sale de su ancho—, así que un solo
    valor representa entre el 53% y el 41% del objeto entre 360 y 760. En todo
    ese rango se sigue leyendo como «cruza por la mitad», y es preferible a
    inventar un tercer breakpoint que el sistema no tiene. Sobre 900 px el
    portátil llega a su ancho máximo y la mitad es exacta.
  */
  main { --montaje: 131px; }
  @media (min-width: 900px) { main { --montaje: 166px; } }

  /* El aire propio de una sección de contenido (--s-9, Design System §4.3.1)
     MÁS lo que invade el portátil. Sin el sumando, el saliente se comería el
     titular de la sección. */
  .cases {
    background: var(--papel);
    padding: calc(var(--montaje) + var(--s-9)) 0 var(--s-9);
  }

  /* Una fila por caso, no una rejilla de tarjetas: cada operación pesa lo
     mismo que su emblema. La regla de acento verde que llevaban los titulares
     se retiró — el emblema ya cumple esa función y con más sentido. */
  .cases-list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-8); }
  .case-row { display: grid; gap: var(--s-5); }
  /* En móvil el emblema va SIEMPRE arriba, aunque en el DOM vaya después:
     la figura presenta el caso y el texto lo explica. */
  .case-visual { order: -1; display: flex; justify-content: center; }
  .case-text h3 {
    font-size: var(--t-h3-m);
    font-weight: 600;
    line-height: var(--lh-h3);
    margin-bottom: var(--s-2);
  }
  .case-text p { color: var(--ink-mute); max-width: 46ch; }

  .diff { background: var(--papel-2); padding: var(--s-9) 0; }
  .table-wrap { overflow-x: auto; }
  table {
    width: 100%;
    min-width: 520px;
    border-collapse: collapse;
    text-align: left;
  }
  thead th {
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    color: var(--ink-mute);
    padding: 0 var(--s-4) var(--s-3) 0;
    border-bottom: 1px solid var(--line);
  }
  tbody th {
    font-size: var(--t-body-sm);
    font-weight: 600;
    color: var(--ink);
    padding: var(--s-4) var(--s-4) var(--s-4) 0;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }
  tbody td {
    font-size: var(--t-body-sm);
    color: var(--ink-mute);
    padding: var(--s-4) var(--s-4) var(--s-4) 0;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  tbody td.hi { color: var(--ink); }

  .steps-band { background: var(--papel); padding: var(--s-9) 0; }
  .split { display: grid; gap: var(--s-6); }
  .lead { color: var(--ink-mute); max-width: 40ch; }
  /* `align-content: start` no es cosmético: ahora que la columna izquierda es
     más alta, sin él la rejilla reparte el sobrante entre las cuatro filas y los
     pasos se separan más de 100 px unos de otros. */
  .onboarding {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }
  .onboarding li {
    display: flex;
    gap: var(--s-3);
    align-items: flex-start;
    color: var(--ink-mute);
    padding-bottom: var(--s-4);
    border-bottom: 1px solid var(--line);
  }
  .onboarding li:last-child { border-bottom: 0; padding-bottom: 0; }
  .n {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border: 1px solid var(--line);
    border-radius: var(--r-2);
    font-size: var(--t-dato-sm);
    font-weight: 600;
    color: var(--ink);
  }

  /* Hereda `--papel` para que la alternancia de fondos siga entera y la
     sección de alcance no parezca una caja pegada al final. */
  .scope { background: var(--papel-2); padding: var(--s-9) 0; }
  .scope h2 {
    font-size: var(--t-h2-m);
    font-weight: 700;
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
    margin-bottom: var(--s-7);
    max-width: 24ch;
  }

  /* «Ten esto a mano»: la columna izquierda gana su propia lista. */
  .sub {
    font-size: var(--t-h3-m);
    font-weight: 600;
    line-height: var(--lh-h3);
    margin-top: var(--s-6);
    margin-bottom: var(--s-4);
  }
  .check { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-3); }
  .check li { display: flex; gap: var(--s-3); align-items: flex-start; color: var(--ink-mute); }
  /*
    20px y no los 19 de la maqueta: **19 está fuera de la grilla 16/20/24** del
    Design System §7, que pide una razón anotada para salirse de ella, y acá no
    la hay — 20 es el escalón de al lado y la diferencia no se ve. El tick que
    sustituye medía 17px, pero era una marca sin caja interior: un icono con
    caja necesita el escalón siguiente para pesar lo mismo.

    `margin-top: 2px` alinea la caja del icono con la altura de x de la primera
    línea; con los 3px del tick viejo quedaba bajo.
  */
  .tick { width: 20px; height: 20px; color: var(--verde-deep); flex: none; margin-top: 2px; }

  .contact { background: var(--tinta-2); color: var(--on-tinta); padding: var(--s-8) 0; }
  .contact h2 { color: var(--on-tinta); }
  .contact p { color: var(--on-tinta-mute); max-width: 47ch; margin-bottom: var(--s-6); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--s-3); }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    background: var(--verde);
    color: var(--on-verde);
    font-weight: 700;
    font-size: var(--t-body);
    padding: var(--s-4) var(--s-6);
    border-radius: var(--r-2);
    text-decoration: none;
  }
  .cta { transition: background-color var(--m-fast) var(--m-ease); }
  .cta:hover { background: var(--verde-hi); }
  .ghost {
    display: inline-flex;
    align-items: center;
    /* 0.40, no 0.28. Mezclado sobre `--tinta-2` de esta banda, el 0.28 daba
       2.35:1 y WCAG 1.4.11 pide 3:1 al contorno de un control. 0.40 da 3.47:1
       aquí y 3.50:1 sobre `--tinta`, así que un solo valor sirve para las dos
       superficies oscuras y coincide con el fantasma de `Steps.astro`. */
    border: 1px solid var(--line-on-tinta);
    color: var(--on-tinta);
    font-weight: 600;
    font-size: var(--t-body-sm);
    padding: var(--s-4) var(--s-5);
    border-radius: var(--r-2);
    text-decoration: none;
  }
  .ghost { transition: border-color var(--m-fast) var(--m-ease); }
  .ghost:hover { border-color: var(--on-tinta); }
  .wa-icon { width: 16px; height: 16px; }

  @media (min-width: 760px) {
    .split { grid-template-columns: 1fr 1.2fr; gap: var(--s-8); }
  }
  @media (min-width: 900px) {
    .inner { padding-inline: var(--pad-section); }
    h2 { font-size: var(--t-h2); }
    .case-text h3 { font-size: var(--t-h3); }

    /* Zigzag. `--s-8` son exactamente los 4rem pedidos y sale de la escala.
       La posición se fija con `grid-column`/`grid-row` y no con `order`: así no
       depende de que nadie añada un tercer hijo a la fila, y el `order: -1` del
       móvil deja de tener efecto sin necesidad de anularlo. */
    .case-row {
      grid-template-columns: 1fr 1fr;
      gap: var(--s-8);
      align-items: center;
    }
    .case-text   { grid-row: 1; grid-column: 1; }
    .case-visual { grid-row: 1; grid-column: 2; }
    .case-row:nth-child(even) .case-text   { grid-column: 2; }
    .case-row:nth-child(even) .case-visual { grid-column: 1; }
  }
</style>
