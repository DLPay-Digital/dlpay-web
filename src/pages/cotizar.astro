---
/**
 * /cotizar — la herramienta, sola.
 *
 * No es una Home reducida: es un instrumento que alguien puede recibir por un
 * enlace de WhatsApp y entender de inmediato. El cotizador va centrado, con
 * aire alrededor, y no compite con nada.
 *
 * Todo lo que no sea cotizar vive en las otras páginas. Aquí sólo queda la
 * actividad de la mesa, que dice que esto está operando ahora.
 */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Quoter from '../components/Quoter.astro';
import ActivityFeed from '../components/ActivityFeed.astro';
---
<Base
  title="Cotizar"
  description="Calcula cuánto recibes al cambiar entre pesos y dólares, con el precio referencial del momento. Continúas por WhatsApp con un ejecutivo que confirma el precio final."
  path="/cotizar"
  hasQuoter
>
  <Header />
  <main id="main">
    <div class="tool">
      <div class="column">
        <!-- La página tiene título aunque el diseño no lo muestre: la herramienta
             se explica sola a la vista, pero un lector de pantalla necesita saber
             dónde está. -->
        <h1 class="sr-only">Cotizar tu operación</h1>
        <div class="instrument">
          <Quoter variant="flat" />
        </div>
        <ActivityFeed />
      </div>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* El cotizador manda: centrado en los dos ejes, con espacio propio para que
     se lea como una herramienta y no como una sección más de una página. */
  .tool {
    background: var(--papel);
    min-height: 72vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--s-7) var(--pad-section-m) var(--s-9);
  }
  .column {
    width: 100%;
    max-width: 460px;
    display: grid;
    gap: var(--s-7);
  }

  @media (min-width: 900px) {
    .tool { padding: var(--s-8) var(--pad-section) var(--s-9); }
    .column { max-width: 520px; gap: var(--s-8); }
  }
</style>
