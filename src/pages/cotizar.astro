---
/**
 * /cotizar — acceso rápido al cotizador.
 *
 * Sirve a dos usos (Fase 1 §9, §13): el cliente recurrente que sólo quiere ver
 * el precio, y los enlaces que el equipo comparte por WhatsApp. Por eso es casi
 * sólo el cotizador: nada que releer.
 *
 * Sobre fondo claro el cotizador va plano, sin sombra (cotizador-spec §2).
 */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Quoter from '../components/Quoter.astro';
import Icon from '../components/Icon.astro';
import { steps } from '../content/home.ts';

const next = steps.slice(1, 4);
---
<Base
  title="Cotizar"
  description="Calcula cuánto recibes al comprar o vender dólar digital al precio referencial de mercado, y confirma la operación con un ejecutivo por WhatsApp."
  path="/cotizar"
>
  <Header />
  <main id="main">
    <section class="quote-page">
      <div class="inner">
        <div class="intro">
          <h1>¿Cuánto recibes?</h1>
          <p>
            Escribe el monto y te mostramos el precio referencial del momento. El botón
            abre WhatsApp con tu operación ya escrita.
          </p>
        </div>

        <div class="instrument">
          <Quoter variant="flat" />
        </div>
      </div>
    </section>

    <section class="after" aria-labelledby="after-title">
      <div class="inner">
        <h2 id="after-title">Después de apretar el botón</h2>
        <ol class="mini">
          {next.map((step) => (
            <li>
              <span class="n num">{step.n}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
                {step.time && <span class="time num">{step.time}</span>}
              </div>
            </li>
          ))}
        </ol>
        <p class="more">
          <a href="/como-funciona">
            Ver el proceso completo
            <Icon name="chevron" class="chev" />
          </a>
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .quote-page { background: var(--papel); padding: var(--s-8) 0 var(--s-9); }
  .inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--pad-section-m);
  }
  .quote-page .inner {
    display: grid;
    gap: var(--s-6);
  }

  h1 {
    font-size: var(--t-display-m);
    font-weight: 700;
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    margin-bottom: var(--s-3);
  }
  .intro p { color: var(--ink-mute); max-width: 44ch; }

  .after { background: var(--papel-2); padding: var(--s-9) 0; }
  h2 {
    font-size: var(--t-h3);
    font-weight: 600;
    line-height: var(--lh-h3);
    margin-bottom: var(--s-5);
  }
  .mini { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-5); }
  .mini li { display: flex; gap: var(--s-4); align-items: flex-start; }
  .n {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--line);
    border-radius: var(--r-2);
    font-size: var(--t-body-sm);
    font-weight: 600;
  }
  .mini h3 {
    font-size: var(--t-body);
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: var(--s-1);
  }
  .mini p { color: var(--ink-mute); font-size: var(--t-body-sm); max-width: 48ch; }
  .time {
    display: inline-block;
    margin-top: var(--s-2);
    font-size: var(--t-dato-sm);
    font-weight: 500;
    color: var(--ink-mute);
  }

  .more { margin-top: var(--s-6); }
  .more a {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--verde-deep);
    font-weight: 600;
    font-size: var(--t-body-sm);
    text-decoration: none;
  }
  .more a:hover { text-decoration: underline; }
  .chev { width: 14px; height: 14px; }

  @media (min-width: 900px) {
    .inner { padding-inline: var(--pad-section); }
    .quote-page .inner {
      grid-template-columns: 1fr 1fr;
      gap: var(--s-8);
      align-items: center;
    }
    /* El titular baja de 52px a 32px en escritorio por dos razones que apuntan
       al mismo lado. Una: en esta página el cotizador va PLANO sobre papel, sin
       la tarjeta elevada del héroe de la Home, así que un titular de 52px le
       ganaba el pulso a un precio de 32px — y la regla del Design System §3.0 es
       que en ese caso se reduce el titular, no se agranda la cifra. Dos: iguala
       la voz de las otras páginas interiores, que hablan a --t-h2. */
    h1 { font-size: var(--t-h2); }
    .mini { grid-template-columns: repeat(3, 1fr); gap: var(--s-6); }
  }
</style>
