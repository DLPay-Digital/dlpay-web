---
/**
 * /blog/<slug>/ — plantilla de lectura.
 *
 * El cuerpo del artículo llega de Markdown, así que su HTML no lo escribe este
 * componente: por eso los estilos del contenido van bajo `.prose` con
 * `:global`. Es la única forma de alcanzar etiquetas que Astro no ve al
 * compilar el ámbito de estilos.
 */
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Motion from '../../components/Motion.astro';
import PortadaDato from '../../components/PortadaDato.astro';
import PortadaFigura from '../../components/PortadaFigura.astro';
import FilaArticulo from '../../components/FilaArticulo.astro';
import Icon from '../../components/Icon.astro';
import RielLateral from '../../components/RielLateral.astro';
import IndiceMovil from '../../components/IndiceMovil.astro';
import {
  publishedPosts,
  rutaPublicada,
  minutosDeLectura,
  sigueLeyendo,
} from '../../lib/blog.ts';
import { site } from '../../lib/config/site.ts';
/* Las figuras de las guías: ver la cabecera del archivo. */
import '../../styles/guias.css';

export async function getStaticPaths() {
  /* Sólo los publicados generan ruta: un borrador no tiene URL que alguien
     pueda compartir por accidente. Ver el candado en `lib/blog.ts`. */
  const posts = await publishedPosts();
  /* `post.id` es el nombre del archivo sin extensión: el slug sale del disco y
     no de un campo que alguien pueda dejar duplicado.

     Cada página recibe además la lista entera: la necesitan la ruta y «Sigue
     leyendo», y así se decide todo en el build. */
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props;
const { Content, headings } = await render(post);

/*
  ── Lo que la plantilla añade desde el 2026-10-13 (Cowork, entrega `aprende-`) ──

  Idea 2 de `ideas-zesty-ficha.md`: una plantilla de artículo más útil, **sin
  texto nuevo en los artículos**. Todo sale de lo que ya hay:

  · el índice «En esta página», de los H2 del propio Markdown;
  · los minutos de lectura, contados del cuerpo (`minutosDeLectura`);
  · la miga de pan, de la categoría;
  · «Sigue leyendo», de los demás publicados (`sigueLeyendo`);
  · el paso de la ruta, del campo `ruta` (`rutaPublicada`);
  · los datos estructurados `Article` y `BreadcrumbList`, de los campos que
    el esquema ya exige.

  Lo único que es texto nuevo es «En corto», y es OPCIONAL: sale sólo si el
  frontmatter trae `resumen`, que firma Compliance con el resto del artículo.
*/

/* El índice sólo con tres secciones o más: con dos se ve todo de un vistazo y
   un índice sería ruido. Sólo H2: los H3 lo harían largo y no se escanea. */
const indice = headings.filter((h) => h.depth === 2);
const conIndice = indice.length >= 3;
const secciones = indice.map((h) => ({ id: h.slug, texto: h.text }));
/* El riel marca la sección que lees con una línea de tiempo por H2, y el CSS
   las nombra de la primera a la duodécima (ADR-0018, pieza 19). Con una
   decimotercera, ésa no se marcaría y nada avisaría: lo dice el build. Hoy el
   artículo más largo tiene ocho. */
if (indice.length > 12) {
  throw new Error(`/blog/${post.id}/: ${indice.length} secciones, y el riel marca hasta 12. Añade sus líneas de tiempo al CSS.`);
}
const minutos = minutosDeLectura(post);
const ruta = rutaPublicada(posts);
const aquiEnRuta = ruta.find((r) => r.post.id === post.id);
const siguientes = sigueLeyendo(post, posts);

/* La miga de pan termina en el grupo del índice, no en el artículo: el titular
   está justo debajo y repetirlo sería decir lo mismo dos veces. */
const grupos = {
  Guía: { id: 'guias', nombre: 'Guías' },
  Mercado: { id: 'mercado', nombre: 'Mercado' },
  DLPay: { id: 'novedades', nombre: 'DLPay' },
} as const;
const grupo = grupos[post.data.category];
const canonical = new URL(`/blog/${post.id}/`, site.url).href;

/*
  Datos estructurados. Mismo criterio que el `Organization` de `Base.astro`:
  sólo campos verificables y que el artículo ya muestra. El autor es la
  organización, no una persona —D11, cerrada: sin nombres ni fotos del
  equipo—. La imagen es la tarjeta Open Graph del sitio, la única que hay.
*/
const datos = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.pubDate.toISOString(),
      dateModified: (post.data.actualizado ?? post.data.pubDate).toISOString(),
      inLanguage: site.locale,
      mainEntityOfPage: canonical,
      image: new URL('/og-image.png', site.url).href,
      author: { '@type': 'Organization', name: site.name, url: site.url },
      publisher: {
        '@type': 'Organization',
        name: site.name,
        logo: { '@type': 'ImageObject', url: new URL('/logo.png', site.url).href },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', site.url).href },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', site.url).href },
        { '@type': 'ListItem', position: 3, name: grupo.nombre, item: new URL(`/blog/#${grupo.id}`, site.url).href },
        { '@type': 'ListItem', position: 4, name: post.data.title, item: canonical },
      ],
    },
  ],
};

/**
 * `timeZone: 'UTC'` NO es un detalle. En el frontmatter la fecha va sin hora,
 * así que `z.coerce.date()` la interpreta como medianoche UTC; formateada en la
 * zona local de Chile (−03:00) retrocedía un día y el artículo aparecía
 * publicado la víspera. Se fija la zona para que la fecha mostrada sea
 * exactamente la escrita.
 */
const fecha = new Intl.DateTimeFormat('es-CL', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---
<Base title={post.data.title} description={post.data.description} path={`/blog/${post.id}/`}>
  {/* Va al `<head>` por la ranura de `Base.astro`. Es un bloque de datos, no
      un script: el navegador no lo ejecuta. */}
  <Fragment slot="head">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(datos).replace(/</g, '\\u003c')}
    />
  </Fragment>
  <Motion />
  <Header />
  <main id="main" class:list={['articulo', { 'con-riel': conIndice || aquiEnRuta }]}>
    {/* La barra de lectura (ADR-0018, pieza 18): crece con el texto que llevas
        leído. Es dibujo —lo que dice, lo dice la barra de desplazamiento del
        navegador— y por eso va `aria-hidden`. Sin movimiento no existe. */}
    <span class="lectura" aria-hidden="true"></span>
    {/*
      La portada va FUERA del artículo y a sangre; el titular va debajo, sobre
      papel. Con el titular dentro de la banda el artículo se leía como una
      sección de landing, y un titular largo cambiaba el alto de la portada en
      cada artículo. Separados, esto se comporta como un documento.

      Sin portada el artículo arranca por el titular y funciona igual: por eso
      el campo es opcional en el esquema.

      Dos componentes y no uno: `PortadaDato` dibuja una cifra o un intervalo
      —con su unidad, su fecha y su fuente— y `PortadaFigura` un pictograma del
      asunto, que no lleva ninguno de esos campos. El esquema es una unión
      discriminada, así que quitar esta bifurcación no compila: el día que entre
      un tercer tipo, TypeScript avisa acá.
    */}
    {post.data.portada &&
      (post.data.portada.tipo === 'figura' ? (
        <PortadaFigura figura={post.data.portada.figura} />
      ) : (
        <PortadaDato portada={post.data.portada} />
      ))}

    {/*
      ── La rejilla (2026-10-13) ──────────────────────────────────────────
      Bajo 1100 px, una columna de 760 como siempre. Desde 1100, dos: un riel
      de 176 px a la izquierda con el índice y la ruta, y la columna de
      lectura con su medida intacta (760). El riel arranca a la altura del
      cuerpo, no del titular: el titular no necesita índice al lado.

      El orden del documento es cabecera → riel → cuerpo, que es el orden en
      que se ven: así el foco de teclado no salta hacia atrás.
    */}
    <article class:list={['post', { 'con-riel': conIndice || aquiEnRuta }]} data-riel-ambito={conIndice ? '' : undefined}>
      {/*
        M6 (2026-09-23): la cabecera entra al cargar, en tres pasos. Es una
        animación CSS y no depende del observador, porque esto está sobre el
        pliegue — el mismo criterio que el encabezado de /empresas.

        **En bloques, no palabra por palabra.** `PageHero` parte el titular en
        palabras porque los suyos tienen tres o cuatro; el de un artículo puede
        tener dieciséis, y a 60 ms por palabra la entrada duraría casi un
        segundo. El titular entra entero.

        La portada NO se mueve: es lo primero que ves al llegar y tiene que
        estar ahí, igual que la tarjeta del cotizador en la Home (regla dura 2).
      */}
      <header class="head">
        {/* La miga de pan: dónde estás, en tres pasos. Entra con la meta. */}
        <nav class="miga seq" style="--seq:0" aria-label="Miga de pan">
          <ol role="list">
            <li><a href="/">Inicio</a></li>
            <li><span class="miga-sep" aria-hidden="true">/</span><a href="/blog/">Blog</a></li>
            <li><span class="miga-sep" aria-hidden="true">/</span><a href={`/blog/#${grupo.id}`}>{grupo.nombre}</a></li>
          </ol>
        </nav>
        <span class="meta seq" style="--seq:0">
          <span class="cat">{post.data.category}</span>
          <time datetime={post.data.pubDate.toISOString()}>{fecha.format(post.data.pubDate)}</time>
          {post.data.actualizado && (
            <span>
              Actualizado el <time datetime={post.data.actualizado.toISOString()}>{fecha.format(post.data.actualizado)}</time>
            </span>
          )}
          <span class="min">
            <span class="min-ico" aria-hidden="true"><Icon name="clock" size={16} /></span>
            {minutos} min de lectura
          </span>
        </span>
        <h1 class="seq" style="--seq:1">{post.data.title}</h1>
        <p class="lead seq" style="--seq:2">{post.data.description}</p>
        {aquiEnRuta && (
          <a class="en-ruta seq" style="--seq:2" href="/blog/#ruta">
            Paso {aquiEnRuta.numero} de {aquiEnRuta.total} · Tu primera operación
          </a>
        )}
      </header>

      {(conIndice || aquiEnRuta) && (
        <RielLateral secciones={conIndice ? secciones : []} etiqueta="Navegación del artículo">
          {aquiEnRuta && (
            <nav class="lat" aria-labelledby="lat-ruta">
              <p class="lat-t" id="lat-ruta">Tu primera operación</p>
              <ol class="lat-ruta" role="list">
                {ruta.map((r) => (
                  <li>
                    <a
                      href={`/blog/${r.post.id}/`}
                      aria-current={r.post.id === post.id ? 'page' : undefined}
                    >
                      <span class="lat-n num" aria-hidden="true">{r.numero}</span>
                      <span><span class="sr-only">Paso {r.numero}: </span>{r.post.data.ruta?.titulo}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )}
        </RielLateral>
      )}

      <div class="cuerpo">
        {/*
          «En corto»: sólo si el frontmatter trae `resumen`. Es texto con
          firma (ver el esquema). Va en `--papel-2`, plano: no es la pieza
          protagonista de la página y no gasta la única `--elev-card`.
        */}
        {post.data.resumen && (
          <aside class="en-corto" aria-labelledby="en-corto-t">
            <p class="en-corto-t" id="en-corto-t">En corto</p>
            <ul>
              {post.data.resumen.map((frase) => <li>{frase}</li>)}
            </ul>
          </aside>
        )}

        {/*
          El índice en móvil: un `<details>` cerrado, sin JavaScript. Desde
          1100 lo sustituye el riel, así que se oculta allí (y el riel bajo
          1100): nunca hay dos índices a la vez en el árbol accesible.
        */}
        {conIndice && (
          <IndiceMovil secciones={secciones} />
        )}

        <div class="prose" data-riel-secciones={conIndice ? '' : undefined}>
          <Content />
        </div>

        {siguientes.length > 0 && (
          <section class="sigue" aria-labelledby="sigue-t">
            <h2 id="sigue-t">Sigue leyendo</h2>
            <ul class="posts" role="list">
              {siguientes.map((p) => {
                const paso = ruta.find((r) => r.post.id === p.id);
                const esSiguiente = aquiEnRuta && paso && paso.numero === aquiEnRuta.numero + 1;
                return (
                  <li>
                    <FilaArticulo
                      post={p}
                      antetitulo={esSiguiente ? `Siguiente paso · ${paso.numero} de ${paso.total}` : undefined}
                    />
                  </li>
                );
              })}
            </ul>
          </section>
        )}

        <footer class="back">
          <a href="/blog/">Ver todos los artículos</a>
        </footer>
      </div>
    </article>
  </main>
  <Footer />
</Base>

<style>
  .post {
    max-width: 760px;
    margin: 0 auto;
    /* `--s-7` arriba y no `--s-8`: cuando hay portada, la banda ya puso su
       propio aire, y el titular tiene que quedar cerca del dato del que habla. */
    padding: var(--s-7) var(--pad-section-m) var(--s-9);
  }

  /* La categoría y la fecha en una sola línea tabular, sin cápsula. El borde y
     el radio que llevaba la categoría competían con el titular justo debajo, y
     acá el metadato tiene que pesar menos que él. */
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-1) var(--s-3);
    margin-bottom: var(--s-4);
    font-family: var(--f-text);
    font-size: var(--t-dato-sm);
    color: var(--ink-mute);
  }
  .cat { color: var(--verde-deep); font-weight: 600; }
  /* Los minutos, que entraron el 2026-10-13, llevan el reloj del juego de
     iconos delante y no un punto: a 390 px la línea se parte, y un «·» al
     principio de la segunda línea se leía como una errata. El reloj marca el
     dato en cualquier renglón. `flex-wrap` por eso mismo. */
  .min { display: inline-flex; align-items: center; gap: var(--s-1); }
  .min-ico { display: grid; }
  .min-ico :global(svg) { display: block; width: 16px; height: 16px; }

  /* La miga de pan: tres enlaces en la línea tabular del metadato, con «/»
     entre ellos. La barra va en el marcado con `aria-hidden` y NO como
     `::before`: el contenido generado por CSS sí lo lee un lector de pantalla
     (medido en el árbol accesible: «/ Blog»). */
  .miga { margin-bottom: var(--s-3); }
  .miga ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) 0;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--f-text);
    font-size: var(--t-dato-sm);
  }
  .miga-sep { margin: 0 var(--s-2); color: var(--ink-mute); }
  /* 44 px de objetivo táctil (DS §10, «los enlaces de navegación necesitan
     `min-height` explícito») sin que la línea crezca: el relleno lo compensa
     un margen negativo. Lo que se agranda es la zona que recibe el toque, no
     el dibujo. Mismo recurso en el resto de enlaces de navegación de abajo. */
  .miga a {
    display: inline-block;
    padding: 12px 6px;
    margin: -12px -6px;
    color: var(--ink-mute);
    text-underline-offset: 3px;
  }
  .miga a:hover { color: var(--ink); }

  /* El paso de la ruta, bajo la bajada. Desde 1112 lo dice el riel y se
     oculta acá. */
  .en-ruta {
    display: inline-block;
    padding-block: 12px;
    margin-top: calc(-1 * var(--s-5) - 12px);
    margin-bottom: calc(var(--s-7) - 12px);
    font-family: var(--f-text);
    font-size: var(--t-dato-sm);
    font-weight: 600;
    color: var(--verde-deep);
    text-underline-offset: 3px;
  }

  .head h1 {
    font-size: var(--t-display-m);
    font-weight: 700;
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    margin-bottom: var(--s-4);
  }
  .lead { color: var(--ink-mute); font-size: var(--t-h3-m); margin-bottom: var(--s-7); }

  /*
    M6 · la secuencia de carga de la cabecera. Sobre el eje diagonal de la marca
    —nunca un `translateY` vertical— y dentro del techo de 280 ms.

    PENDIENTE: ésta es la TERCERA copia de `heroIn` en el repositorio; las otras
    dos están en `Hero.astro` y `PageHero.astro` y son idénticas a ésta. Cuando
    alguien vuelva a tocar el Motion System, las tres deberían salir a
    `tokens.css` como utilidad M6. No se hizo hoy porque consolidarlas obliga a
    editar el héroe de la Home, y eso excede lo que se pidió.
  */
  .seq {
    animation: heroIn var(--m-base) var(--m-ease) both;
    animation-delay: calc(var(--seq) * var(--m-stagger));
  }
  @keyframes heroIn {
    from { opacity: 0; transform: translate(var(--m-shift-x), var(--m-shift-y)); }
    to   { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .seq { animation: none; }
  }

  /*
    Estilos del cuerpo en Markdown. Van con `:global` porque este componente no
    escribe ese HTML y el ámbito de estilos de Astro no puede alcanzarlo.
  */
  .prose :global(h2) {
    /* El índice salta a estos títulos: que no queden pegados al borde. */
    scroll-margin-top: var(--s-6);
    font-size: var(--t-h2-m);
    font-weight: 700;
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
    margin: var(--s-7) 0 var(--s-3);
  }
  .prose :global(h3) {
    font-size: var(--t-h3);
    font-weight: 600;
    line-height: var(--lh-h3);
    margin: var(--s-6) 0 var(--s-2);
  }
  .prose :global(p) { margin-bottom: var(--s-4); color: var(--ink); }
  .prose :global(ul),
  .prose :global(ol) { margin: 0 0 var(--s-4) var(--s-5); color: var(--ink); }
  .prose :global(li) { margin-bottom: var(--s-2); }
  .prose :global(a) { color: var(--verde-deep); }
  .prose :global(strong) { font-weight: 600; }
  .prose :global(blockquote) {
    margin: var(--s-6) 0;
    padding-left: var(--s-5);
    border-left: 2px solid var(--verde);
    color: var(--ink-mute);
  }
  .prose :global(code) {
    font-family: var(--f-num);
    font-size: var(--t-body-sm);
    background: var(--papel-2);
    padding: 1px 5px;
    border-radius: var(--r-1);
  }

  /*
    REGLA CLAVE: cualquier imagen del cuerpo se ajusta al contenedor. Sin
    `max-width: 100%`, una imagen más ancha que la columna desborda y arrastra
    el scroll horizontal de TODA la página en móvil, no sólo del artículo.
    `height: auto` conserva la proporción cuando el ancho se reduce.
  */
  /*
    La figura del riel tokenizado, del artículo de activos tokenizados. Vive en
    el Markdown como HTML crudo —ver el comentario allí— así que sus estilos van
    con `:global`, igual que los del resto del cuerpo.

    Es UNA figura de UN artículo. Si aparece una segunda, deja de ser contenido y
    se convierte en componente: tres copias de un dibujo que afirma algo es lo
    que se decidió no tener cuando el eje de alcance salió a `EjeDeAlcance.astro`.

    `--verde-deep` y no `--verde`: la figura va sobre papel y ahí `--verde` da
    2,02:1, por debajo del 3:1 de un gráfico (Design System §2.4 y §6.2). Da
    5,44:1.
  */
  .prose :global(.riel) { margin: var(--s-6) 0; }
  /* El dibujo escala con el ancho; las etiquetas NO, porque son HTML y no
     `<text>`. Dentro del SVG, a 320 px caerían a 9,6 px reales. */
  .prose :global(.riel-fig) { display: block; width: 100%; max-width: 420px; height: auto; }
  .prose :global(.riel-tags) {
    display: flex;
    justify-content: space-between;
    max-width: 420px;
    margin-top: var(--s-2);
    font-family: var(--f-text);
    font-size: var(--t-dato-sm);
    color: var(--ink-mute);
  }
  .prose :global(.riel .aro),
  .prose :global(.riel .signo),
  .prose :global(.riel .unidad),
  .prose :global(.riel .link) { fill: none; stroke: var(--verde-deep); }
  .prose :global(.riel .aro) { stroke-width: 1.5; }
  .prose :global(.riel .signo) { stroke-width: 1.9; }
  .prose :global(.riel .unidad) { stroke-width: 1.1; }
  /* La cuña canónica del DS a escala 1,2, sobre un trazo también a 1,2: así la
     relación ancho/grosor sigue siendo 14,4, la que tenía `UseCaseFigure` en la
     Home hasta el 2026-10-02. */
  .prose :global(.riel .link) { stroke-width: 1.5; stroke-linejoin: miter; }

  .prose :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: var(--r-3);
    margin: var(--s-6) 0;
  }

  .back {
    margin-top: var(--s-8);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
  }
  /* Desde el 2026-10-13 con su caja de 44 px, como pide el §10: medía 21 de
     alto desde que existe. Defecto anterior a esta entrega, arreglado de paso. */
  .back a {
    display: inline-block;
    padding-block: 12px;
    margin-block: -12px;
    color: var(--verde-deep);
    font-weight: 600;
    font-size: var(--t-body-sm);
  }

  /*
    ── «En corto» (2026-10-13) ──────────────────────────────────────────────
    Plano, en `--papel-2`, con el radio de las piezas de contenido. Las
    viñetas son las del cuerpo: es una lista más, no un objeto nuevo.
  */
  .en-corto {
    margin-bottom: var(--s-6);
    padding: var(--s-5);
    background: var(--papel-2);
