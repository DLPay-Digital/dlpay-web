---
/**
 * /blog/<slug>/ — plantilla de lectura.
 *
 * El cuerpo del artículo llega de Markdown, así que su HTML no lo escribe este
 * componente: por eso los estilos del contenido van bajo `.prose` con
 * `:global`. Es la única forma de alcanzar etiquetas que Astro no ve al
 * compilar el ámbito de estilos.
 */
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Motion from '../../components/Motion.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  /* `post.id` es el nombre del archivo sin extensión: el slug sale del disco y
     no de un campo que alguien pueda dejar duplicado. */
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

/**
 * `timeZone: 'UTC'` NO es un detalle. En el frontmatter la fecha va sin hora,
 * así que `z.coerce.date()` la interpreta como medianoche UTC; formateada en la
 * zona local de Chile (−03:00) retrocedía un día y el artículo aparecía
 * publicado la víspera. Se fija la zona para que la fecha mostrada sea
 * exactamente la escrita.
 */
const fecha = new Intl.DateTimeFormat('es-CL', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---
<Base title={post.data.title} description={post.data.description} path={`/blog/${post.id}/`}>
  <Motion />
  <Header />
  <main id="main">
    <article class="post">
      {post.data.coverImage && (
        <div class="cover-wrap">
          <Image
            class="cover"
            src={post.data.coverImage}
            alt=""
            widths={[600, 1000, 1400]}
            sizes="(min-width: 900px) 760px, 100vw"
            loading="eager"
          />
        </div>
      )}

      <header class="head">
        <span class="meta">
          <span class="cat">{post.data.category}</span>
          <time datetime={post.data.pubDate.toISOString()}>{fecha.format(post.data.pubDate)}</time>
        </span>
        <h1>{post.data.title}</h1>
        <p class="lead">{post.data.description}</p>
      </header>

      <div class="prose">
        <Content />
      </div>

      <footer class="back">
        <a href="/blog/">Ver todos los artículos</a>
      </footer>
    </article>
  </main>
  <Footer />
</Base>

<style>
  .post {
    max-width: 760px;
    margin: 0 auto;
    padding: var(--s-8) var(--pad-section-m) var(--s-9);
  }

  .cover-wrap { margin-bottom: var(--s-7); }
  .cover {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--r-3);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-bottom: var(--s-4);
    font-size: var(--t-dato-sm);
    color: var(--ink-mute);
  }
  .cat {
    padding: 2px 8px;
    border-radius: var(--r-1);
    border: 1px solid var(--line);
    color: var(--ink);
    font-weight: 600;
    letter-spacing: var(--ls-label);
  }

  .head h1 {
    font-size: var(--t-display-m);
    font-weight: 700;
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    margin-bottom: var(--s-4);
  }
  .lead { color: var(--ink-mute); font-size: var(--t-h3-m); margin-bottom: var(--s-7); }

  /*
    Estilos del cuerpo en Markdown. Van con `:global` porque este componente no
    escribe ese HTML y el ámbito de estilos de Astro no puede alcanzarlo.
  */
  .prose :global(h2) {
    font-size: var(--t-h2-m);
    font-weight: 700;
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
    margin: var(--s-7) 0 var(--s-3);
  }
  .prose :global(h3) {
    font-size: var(--t-h3);
    font-weight: 600;
    line-height: var(--lh-h3);
    margin: var(--s-6) 0 var(--s-2);
  }
  .prose :global(p) { margin-bottom: var(--s-4); color: var(--ink); }
  .prose :global(ul),
  .prose :global(ol) { margin: 0 0 var(--s-4) var(--s-5); color: var(--ink); }
  .prose :global(li) { margin-bottom: var(--s-2); }
  .prose :global(a) { color: var(--verde-deep); }
  .prose :global(strong) { font-weight: 600; }
  .prose :global(blockquote) {
    margin: var(--s-6) 0;
    padding-left: var(--s-5);
    border-left: 2px solid var(--verde);
    color: var(--ink-mute);
  }
  .prose :global(code) {
    font-family: var(--f-num);
    font-size: var(--t-body-sm);
    background: var(--papel-2);
    padding: 1px 5px;
    border-radius: var(--r-1);
  }

  /*
    REGLA CLAVE: cualquier imagen del cuerpo se ajusta al contenedor. Sin
    `max-width: 100%`, una imagen más ancha que la columna desborda y arrastra
    el scroll horizontal de TODA la página en móvil, no sólo del artículo.
    `height: auto` conserva la proporción cuando el ancho se reduce.
  */
  .prose :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: var(--r-3);
    margin: var(--s-6) 0;
  }

  .back {
    margin-top: var(--s-8);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
  }
  .back a { color: var(--verde-deep); font-weight: 600; font-size: var(--t-body-sm); }

  @media (min-width: 900px) {
    .post { padding-inline: 0; }
    .head h1 { font-size: var(--t-h2); }
  }
</style>
