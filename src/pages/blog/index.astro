---
/**
 * /blog — listado de artículos.
 *
 * Rejilla mínima de tarjetas sobre tinta, el mismo registro A×C que el resto
 * del sitio. Sin paginación: con el volumen actual sería infraestructura para
 * un problema que todavía no existe (Principio 5). Cuando haga falta, entra.
 */
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import Motion from '../../components/Motion.astro';
import { publishedPosts } from '../../lib/blog.ts';

/* Ya vienen filtrados por el candado de publicación y ordenados. Ver lib/blog.ts. */
const posts = await publishedPosts();

/**
 * `timeZone: 'UTC'` NO es un detalle. En el frontmatter la fecha va sin hora,
 * así que `z.coerce.date()` la interpreta como medianoche UTC; formateada en la
 * zona local de Chile (−03:00) retrocedía un día y el artículo aparecía
 * publicado la víspera. Se fija la zona para que la fecha mostrada sea
 * exactamente la escrita.
 */
const fecha = new Intl.DateTimeFormat('es-CL', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---
<Base
  title="Blog"
  description="Análisis del mercado cambiario y novedades de DLPay: qué mueve el precio del dólar y cómo leerlo antes de operar."
  path="/blog/"
>
  <Motion />
  <Header />
  <main id="main">
    <PageHero
      title="Blog"
      lead="Qué mueve el precio del dólar y cómo leerlo antes de operar."
    />

    <section class="list" aria-labelledby="list-title">
      <div class="inner">
        <h2 id="list-title" class="sr-only">Artículos</h2>

        {posts.length === 0 ? (
          <p class="empty">Todavía no hay artículos publicados.</p>
        ) : (
          <ul class="grid">
            {posts.map((post) => (
              <li class="card" data-enter>
                <a href={`/blog/${post.id}/`}>
                  {post.data.coverImage && (
                    <Image
                      class="cover"
                      src={post.data.coverImage}
                      alt=""
                      widths={[400, 800]}
                      sizes="(min-width: 900px) 340px, 100vw"
                      loading="lazy"
                    />
                  )}
                  <div class="body">
                    <span class="meta">
                      <span class="cat">{post.data.category}</span>
                      <time datetime={post.data.pubDate.toISOString()}>
                        {fecha.format(post.data.pubDate)}
                      </time>
                    </span>
                    <h3>{post.data.title}</h3>
                    <p>{post.data.description}</p>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .list { background: var(--papel); padding: var(--s-9) 0; }
  .inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--pad-section-m);
  }
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .empty { color: var(--ink-mute); }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-6); }

  /* Tarjeta en tinta sobre papel: el mismo contraste de banda que usa el resto
     del sitio, no una tarjeta clara con sombra de plantilla. */
  .card a {
    display: block;
    height: 100%;
    background: var(--tinta-2);
    border: 1px solid var(--line-on-tinta);
    border-radius: var(--r-3);
    overflow: hidden;
    text-decoration: none;
    transition: border-color var(--m-fast) var(--m-ease);
  }
  .card a:hover { border-color: var(--verde); }

  /* La portada reserva su espacio con la proporción declarada: sin esto, la
     imagen al cargar empuja el texto hacia abajo. */
  .cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 40 / 21;
    object-fit: cover;
    border-bottom: 1px solid var(--line-on-tinta);
  }

  .body { padding: var(--s-5); }
  .meta {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-bottom: var(--s-3);
    font-size: 11px;
    color: var(--on-tinta-mute);
  }
  .cat {
    padding: 2px 8px;
    border-radius: var(--r-1);
    border: 1px solid var(--line-on-tinta);
    color: var(--on-tinta);
    font-weight: 600;
    letter-spacing: var(--ls-label);
  }
  .card h3 {
    font-size: var(--t-h3-m);
    font-weight: 600;
    line-height: var(--lh-h3);
    color: var(--on-tinta);
    margin-bottom: var(--s-2);
  }
  .card p { color: var(--on-tinta-mute); font-size: var(--t-body-sm); }

  @media (min-width: 760px) {
    .grid { grid-template-columns: repeat(2, 1fr); gap: var(--s-7); }
  }
  @media (min-width: 900px) {
    .inner { padding-inline: var(--pad-section); }
    .grid { grid-template-columns: repeat(3, 1fr); }
    .card h3 { font-size: var(--t-h3); }
  }
</style>
