---
/**
 * Home. Estructura definida en phase-2.5-definicion-experiencia.md §2.
 *
 * Una sola acción primaria: cotizar. Todo lo demás la sostiene.
 */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import GloboRotativo from '../components/hero/GloboRotativo.astro';
import EjeDeAlcance from '../components/EjeDeAlcance.astro';
import { hinge, options, ourLeg } from '../content/scope.ts';
import UseCases from '../components/UseCases.astro';
import Steps from '../components/Steps.astro';
import Process from '../components/Process.astro';
import Trust from '../components/Trust.astro';
import Business from '../components/Business.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import Motion from '../components/Motion.astro';
---
<Base
  title="DLPay"
  description="Cambia pesos por dólares al precio real del mercado y recibe dólar digital, listo para moverse en minutos y a cualquier hora. Con una persona que cierra tu operación."
  path="/"
  hasQuoter
>
  <Motion />
  <Header />
  <main id="main">
    <Hero />

    {/*
      Banda del globo, inmediatamente bajo el héroe. NO va dentro del héroe: ahí
      el cotizador es la única acción primaria (§6) y el Motion System exige que
      el instrumento esté encendido al llegar, sin nada que le dispute la
      atención. En banda propia acompaña sin competir.

      Fondo en papel desde el 2026-09-15: en tinta, el océano navy del globo se
      confundía con la banda y el planeta no se recortaba. Sobre papel el océano
      da 15,94:1 y el objeto se lee de inmediato.

      Ámbito de las tres excepciones que habilita esta pieza —paleta propia,
      rotación continua y JavaScript en el cliente—: ADR-0007, 0008 y 0009.
    */}
    <section class="globo" aria-labelledby="globo-title">
      <div class="globo-inner">
        {/* Cascada al hacer scroll: tres hermanos con `data-enter`, el mismo
            M4+M5 de los demás titulares. Tres, no cuatro: el globo no entra —
            ya tiene su propio movimiento y superponerle un fundido sería
            animar dos veces la misma cosa. */}
        <header class="globo-head">
          {/*
            El titular nombra el límite en vez de prometer alcance. La bajada ya
            traía el encuadre correcto —«desde ahí lo mueves»—, sólo que quedaba
            300 px por encima del globo y con dos botones en medio.
          */}
          <h2 id="globo-title" data-enter>Nuestro tramo termina en tu billetera</h2>
          <p data-enter>
            Recibes dólar digital en tu billetera y desde ahí lo mueves en minutos, a
            cualquier hora y sin depender de días hábiles.
          </p>
        </header>

        {/*
          El eje va ENTRE el texto y el globo, que es donde hace falta: el globo
          dibuja ocho arcos saliendo de Chile, y ésta es la pieza que dice hasta
          dónde de ese dibujo es nuestro. CLAUDE.md §1 no prohíbe sólo afirmar:
          prohíbe «afirmar o SUGERIR», y una figura sin con qué desambiguarla es
          exactamente lo segundo.
        */}
        <div data-enter>
          <EjeDeAlcance milestones={ourLeg} hinge={hinge} options={options}>
            <Fragment slot="caveat">
              Ese último paso es un proceso distinto, con otros servicios, y
              <strong>no lo realiza DLPay</strong>.
            </Fragment>
          </EjeDeAlcance>
        </div>

        <GloboRotativo />
      </div>
    </section>

    <UseCases />
    <Steps />
    <Process />
    <Trust />
    <Business />
    <Faq />
  </main>
  <Footer />
</Base>

<style>
  .globo {
    background: var(--papel);
    padding: var(--s-9) 0;
  }
  .globo-inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--pad-section-m);
  }

  /* Titular, bajada y botones centrados. `margin-inline: auto` además del
     `text-align`: el `max-width` en ch conserva la medida de lectura, y sin él
     la caja quedaría pegada a la izquierda con el texto centrado dentro. */
  .globo-head {
    max-width: 44ch;
    margin: 0 auto var(--s-8);
    text-align: center;
  }
  .globo-head h2 {
    font-size: var(--t-h2-m);
    font-weight: 700;
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
    margin-bottom: var(--s-4);
  }
  .globo-head p { color: var(--ink-mute); }


  /* El globo se dibuja sobre un viewBox 700×500 y escala al ancho disponible.
     El tope evita que en pantallas anchas se coma la banda entera. */
  .globo-inner :global(.dlpay-globe-only) {
    max-width: 720px;
    margin: 0 auto;
  }

  @media (min-width: 900px) {
    .globo-inner { padding-inline: var(--pad-section); }
    .globo-head h2 { font-size: var(--t-h2); }
    .globo-head p { font-size: var(--t-h3-m); }
  }
</style>
