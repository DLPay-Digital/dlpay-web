---
/**
 * Home. Estructura definida en phase-2.5-definicion-experiencia.md §2.
 *
 * Una sola acción primaria: cotizar. Todo lo demás la sostiene.
 */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import UseCases from '../components/UseCases.astro';
import Steps from '../components/Steps.astro';
import Trust from '../components/Trust.astro';
import Business from '../components/Business.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="DLPay"
  description="Envía dinero al extranjero y convierte entre pesos y dólares al precio real del mercado, con una persona que cierra tu operación en minutos. Para personas y empresas en Chile."
  path="/"
>
  <Header />
  <main id="main">
    <Hero />
    <UseCases />
    <Steps />
    <Trust />
    <Business />
    <Faq />
  </main>
  <Footer />
</Base>
