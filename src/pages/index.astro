---
/**
 * Home. Estructura definida en phase-2.5-definicion-experiencia.md §2.
 *
 * Una sola acción primaria: cotizar. Todo lo demás la sostiene.
 */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import WhatsAppMockup from '../components/WhatsAppMockup.astro';
import UseCases from '../components/UseCases.astro';
import Steps from '../components/Steps.astro';
import Trust from '../components/Trust.astro';
import Business from '../components/Business.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import Motion from '../components/Motion.astro';
---
<Base
  title="DLPay"
  description="Cambia pesos por dólares al precio real del mercado y recibe dólar digital, listo para moverse en minutos y a cualquier hora. Con una persona que cierra tu operación."
  path="/"
  hasQuoter
>
  <Motion />
  <Header />
  <main id="main">
    <Hero />
    {/* Justo bajo el CTA del cotizador: la duda que resuelve —"¿me abre un chat
        en blanco?"— aparece ahí y en ningún otro punto de la página. */}
    <WhatsAppMockup />
    <UseCases />
    <Steps />
    <Trust />
    <Business />
    <Faq />
  </main>
  <Footer />
</Base>
