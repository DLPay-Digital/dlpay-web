---
/**
 * /como-funciona — el recorrido completo, web + WhatsApp + verificación, como
 * UNA sola secuencia con tiempos concretos (Fase 1 §5.5, phase-2.5 §3).
 *
 * El objetivo es que el salto a WhatsApp y a la plataforma no se sienta un
 * corte: aquí se anticipa qué va a pasar y cuánto demora.
 */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Motion from '../components/Motion.astro';
import Icon from '../components/Icon.astro';
import EjeDeAlcance from '../components/EjeDeAlcance.astro';
import { hinge, options } from '../content/scope.ts';
import Puente from '../components/Puente.astro';
import FiguraRiel from '../components/FiguraRiel.astro';
import WhatsAppMockup from '../components/WhatsAppMockup.astro';
import { detailedSteps, checklist, chatLines } from '../content/process.ts';
import { ConfigPriceSource } from '../lib/pricing/config-price-source.ts';
import { formatCLP, formatRate } from '../lib/pricing/format.ts';
import { contact, platform, quoteLimits } from '../lib/config/site.ts';

/* El botón es «Preguntar primero» y está junto a «Crear mi cuenta», en la
   sección de registro y verificación. El mensaje nombra esa duda concreta. */
const wa = contact.whatsappUrl(
  'Hola, tengo dudas sobre el registro y la verificación antes de crear mi cuenta.'
);

/*
  El teléfono de la portada.

  La página que explica la conversación no enseñaba la conversación: el mockup
  existía desde hacía semanas y sólo lo usaban la Home y `/empresas`.

  **El hilo no se teclea.** Las tres frases salen de `chatLines`, que es la
  misma fuente de la que bebe `Process.astro`; el monto y la tasa salen de
  `ConfigPriceSource` y `quoteLimits`, que es de donde salen las del cotizador.
  Ninguna cifra de esta página puede contradecir a la Home.

  Es el momento que los pasos 02 y 03 describen con palabras: el mensaje que el
  botón escribe solo, y el ejecutivo confirmando.
*/
const price = await new ConfigPriceSource().getPrice();
const chat = chatLines(formatCLP(quoteLimits.samplePayClp), formatRate(price.rate));
const hilo = [
  { sender: 'user', text: chat.pide },
  { sender: 'dlpay', text: chat.confirma },
  { sender: 'user', text: chat.acepta },
] as const;
---
<Base
  title="Cómo funciona"
  description="El recorrido completo de una operación en DLPay: cotizas en la web, confirmas con un ejecutivo por WhatsApp, transfieres, verificamos y recibes dólar digital en tu billetera."
  path="/como-funciona/"
>
  <Motion />
  <Header />
  <main id="main">
    {/*
      `stacked` y `--montaje`: el mismo mecanismo del portátil de `/empresas` y
      de la tarjeta de `/tarifas`. **Tercer uso, no tercera forma de hacer lo
      mismo.** Lo eligió Sebastián el 2026-09-25 sabiendo lo que arrastra: esta
      variante centra el titular y la bajada, que hasta hoy iban a la izquierda.
    */}
    <PageHero
      title="Cómo funciona una operación"
      lead="El recorrido es el mismo cambies pesos por dólares o al revés. La web te deja listo y una persona cierra. Acá está todo, en orden y con los tiempos reales."
      sequence
      layout="stacked"
    >
      <div class="telefono" slot="aside">
        {/* `bare`: el pie de la variante `proof` está escrito para papel —usa
            `--ink` y `--ink-mute`— y acá el teléfono se apoya en tinta. El pie
            lo pone la página, con los colores de la banda. */}
        <WhatsAppMockup variant="bare" thread={hilo} />
        <p class="pie-tel">
          <b>Acá pasa de la web a una persona.</b>
          El chat se abre con tu operación ya escrita.
        </p>
      </div>
    </PageHero>

    <section class="detail" aria-labelledby="detail-title">
      <div class="inner">
        <header class="head">
          <h2 id="detail-title" data-enter>Paso a paso</h2>
          <p>Marcamos quién hace qué, para que no quede ninguna zona gris.</p>
        </header>

        <div class="lanes">
          {/* Los rótulos de carril son redundantes para quien no ve la página:
              cada paso ya lleva su `.who`. Por eso van `aria-hidden`. */}
          <div class="lane-heads" aria-hidden="true">
            <p class="you">Lo haces tú</p>
            <p class="us">Lo hacemos nosotros</p>
          </div>

          {/*
            `role="list"` viaja con la pieza: con `list-style: none` WebKit deja
            de anunciar la lista, y acá «seis pasos, y éste es el tercero» ES el
            contenido.
          */}
          <ol class="steps" role="list">
            {detailedSteps.map((step, i) => {
              const us = step.who !== 'tú';
              /* El traspaso es el CAMBIO de manos: se marca cuando este paso no
                 lo hace quien hizo el anterior. Se calcula, no se lista a mano:
                 si mañana cambia el reparto en `process.ts`, las cuñas se mueven
                 solas. Hoy da los pasos 03, 04 y 05. */
              const anterior = detailedSteps[i - 1];
              const cambia = anterior !== undefined && (anterior.who !== 'tú') !== us;
              return (
                <li class:list={['step', us ? 'us' : 'you', { handoff: cambia }]}>
                  {cambia && (
                    <svg class="handoff-mark" viewBox="0 0 40 12" fill="none" aria-hidden="true"
                         preserveAspectRatio="none">
                      <path d="M0 6h12l6-5 6 10 6-5h10" stroke="currentColor" stroke-width="1.5" data-draw />
                    </svg>
                  )}
                  <div class="step-top">
                    <span class="n num">{String(step.n).padStart(2, '0')}</span>
                    <h3>{step.title}</h3>
                  </div>
                  <p>{step.body}</p>
                  <span class="who">{us ? 'Lo hacemos nosotros' : 'Lo haces tú'}</span>
                  <span class="time num">{step.time}</span>
                </li>
              );
            })}
          </ol>
        </div>
      </div>
    </section>

    <section class="prep" aria-labelledby="prep-title">
      <div class="inner">
        <div class="prep-grid">
          <div>
            <h2 id="prep-title" data-enter>Ten esto a mano</h2>
            <ul class="check" role="list">
              {/*
                Cada ítem lleva su icono, y sale del dato (`process.ts`), no de
                la posición: reordenar la lista no desparejaba nada porque el
                icono viaja con su frase.

                Antes eran tres ticks IDÉNTICOS. No eran checkboxes —no se marca
                nada, no hay estado—, así que sólo decían «esto es un ítem», que
                es el trazo que no dice nada del Design System §6. El sentido de
                checklist lo lleva el titular, con palabras.
              */}
              {checklist.map((item) => (
                <li>
                  <Icon name={item.icon} size={20} class="tick" />
                  {item.text}
                </li>
              ))}
            </ul>
          </div>

          <div class="kyc">
            <h2>Registro y verificación</h2>
            <p>
              Antes de tu primera operación pedimos registro y verificación de identidad,
              a personas y a empresas. Es un requisito de seguridad y cumplimiento, y es
              lo que permite mover dinero con un banco de por medio.
            </p>
            <p class="note">
              El registro se hace en la plataforma de DLPay. Si tienes dudas antes de
              empezar, escríbenos y te acompañamos.
            </p>
            <div class="kyc-actions">
              <a class="ghost" href={platform.registerUrl}>Crear mi cuenta</a>
              <a class="ghost" href={wa} target="_blank" rel="noopener">
                <Icon name="whatsapp" class="wa-icon" />
                Preguntar primero
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="scope" aria-labelledby="scope-title">
      <div class="inner">
        <h2 id="scope-title">Dónde termina nuestra operación</h2>
        {/*
          El cierre deja de ser una caja con borde y pasa a ser la MITAD DERECHA
          del mismo eje que abre la Home: línea gris, cuña en su arranque,
          bisagra y las tres opciones. No es figura nueva — es la misma
          gramática, para que el carril de los seis pasos y este cierre se lean
          como un solo recorrido.

          Sin `milestones` a propósito: la página acaba de contar los seis pasos
          justo encima, así que repetir la mitad izquierda sería decir dos veces
          lo mismo.

          La bisagra REPITE literalmente la frase del paso 06. Es deliberado:
          mismo texto, una vez dentro del recorrido y otra como conclusión. No
          son dos versiones que puedan desincronizarse.
        */}
        <EjeDeAlcance hinge={hinge} options={options}>
          <Fragment slot="caveat">
            Ese último paso es un proceso distinto, con otros servicios, y
            <strong>no lo realiza DLPay</strong>. Nosotros hacemos el cambio de divisas y te
            entregamos dólar digital en tu billetera:
            <strong>no depositamos dinero en cuentas bancarias en el extranjero</strong>.
          </Fragment>
        </EjeDeAlcance>
      </div>
    </section>

    {/*
      El puente al artículo de activos tokenizados. Cierra un circuito que
      estaba abierto por un lado: esta página usa «dólar digital» CUATRO veces
      en su `<main>` y no lo explica ninguna, su casa está escrita en
      `content/glossary.ts` —que manda ese término a este artículo— y el enlace
      de vuelta ya existía, porque el artículo termina mandando acá.

      Y con esto la página deja de ser la única de contenido del sitio sin un
      solo enlace interno: hasta hoy su `<main>` salía a tres sitios —la app de
      registro, WhatsApp y el cotizador— y a ninguna otra página.

      **El rótulo es `hinge.from`, no una copia.** Es la misma frase que la
      bisagra del eje de arriba, y viene del mismo sitio: `content/scope.ts`. Es
      la tercera vez que aparece en la página —el paso 06, la bisagra y acá— y
      las tres son deliberadas, pero ninguna se puede desincronizar de las otras.
      La figura, en cambio, SÍ es una copia del artículo: eso es cruzar de
      página, y ahí la regla es la contraria. Ver la cabecera de `FiguraRiel`.

      El titular ya tenía firma: Sebastián lo aprobó como Compliance el
      2026-09-22 junto con la figura, y lleva su marcador en el `.md` del
      artículo. Lo único nuevo es la etiqueta del botón.
    */}
    <Puente
      rotulo={hinge.from}
      titulo="El peso no está tokenizado; el dólar digital sí"
      cuerpo="Es el mismo dólar existiendo como unidades sobre una red."
      href="/blog/activos-tokenizados-que-son-y-quien-los-construye/"
      cta="Leer el artículo"
    >
      <FiguraRiel />
    </Puente>

    <section class="close" aria-labelledby="close-title">
      <div class="inner">
        <h2 id="close-title">¿Listo para ver tu precio?</h2>
        <p>Toma menos de un minuto y no necesitas cuenta para cotizar.</p>
        <a class="cta" href="/#cotizador">Cotizar ahora</a>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--pad-section-m);
  }


  /*
    Cuánto sobresale el teléfono de la banda. Lo decide la página porque depende
    del alto de la pieza; mismo contrato que en `/empresas` y `/tarifas`.
  */
  main { --montaje: 96px; }
  @media (min-width: 900px) { main { --montaje: 120px; } }

  .telefono { display: grid; justify-items: center; gap: var(--s-4); }
  /*
    El pie va con los colores del PAPEL, y esto costó una captura.

    Lo escribí primero en `--on-tinta` porque el teléfono está en la banda
    oscura. Pero el bloque **monta** sobre la sección siguiente, y el pie es lo
    último que hay dentro: cae entero sobre `--papel-2`. Medido — la banda
    termina en 769 px y el pie empieza en 839. En blanco roto sobre claro no se
    leía nada, y no había error en ninguna parte.
    Queda dicho para quien toque `--montaje`: **el pie vive del lado claro.**
  */
  .pie-tel {
    color: var(--ink-mute);
    text-align: center;
    max-width: 42ch;
    margin: 0;
  }
  .pie-tel b { color: var(--ink); font-weight: 600; }

  /* El relleno superior absorbe el saliente: sin él, el primer titular quedaría
     debajo del teléfono. */
  .detail { background: var(--papel-2); padding: calc(var(--montaje) + var(--s-8)) 0 var(--s-9); }
  .head { max-width: 46ch; margin-bottom: var(--s-7); }
  h2 {
    font-size: var(--t-h2-m);
    font-weight: 700;
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
    margin-bottom: var(--s-3);
  }
  .head p { color: var(--ink-mute); }

  /* ── La secuencia en dos carriles ─────────────────────────────────────────
     Los seis pasos dejan de ser una lista y pasan a un recorrido con un eje: a
     la izquierda lo que hace el usuario, a la derecha lo que hace DLPay. La
     alternancia real es tú·tú·nosotros·tú·nosotros·nosotros, así que el trabajo
     CAMBIA DE MANOS tres veces, y eso es lo que la página tiene que mostrar.
     Debajo de 900px no hay carriles: es una lista y el reparto viaja en el pie
     de cada paso. */
  .lanes { position: relative; }
  .handoff-mark { display: none; }
  .lane-heads { display: none; }
  .lane-heads p {
    font-family: var(--f-num);
    font-size: var(--t-dato-sm);
    font-weight: 600;
    letter-spacing: var(--ls-label);
  }
  .lane-heads .you { color: var(--ink); }
  .lane-heads .us { color: var(--verde-deep); }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-6); }
  .step { padding-top: var(--s-4); border-top: 1px solid var(--line); position: relative; }
  .step-top { display: flex; align-items: baseline; gap: var(--s-3); margin-bottom: var(--s-2); }
  .n { font-family: var(--f-num); font-size: var(--t-dato-sm); color: var(--ink-mute); }
  .step h3 { font-size: var(--t-h3-m); font-weight: 600; line-height: var(--lh-h3); }
  .step p { color: var(--ink-mute); max-width: 47ch; margin-bottom: var(--s-2); }

  /* En móvil no hay carriles, así que quién y cuándo viajan juntos en un solo
     pie mono: dos datos del mismo orden, una sola línea. */
  .who, .time { display: inline; font-family: var(--f-num); font-size: var(--t-dato-sm); }
  .who { font-weight: 600; }
  .who + .time::before {
    content: '·';
    margin: 0 .55em;
    font-weight: 400;
    color: var(--ink-mute);
  }
  .step.you .who { color: var(--ink-mute); }
  .step.us { border-top-color: var(--verde-deep); }
  .step.us .who { color: var(--verde-deep); }

  /*
    ── El suelo cambia donde cambia de manos ─────────────────────────────────

    Sale del DATO, no de una lista: `.us` lo pone `step.who !== 'tú'`, que es el
    mismo campo del que ya salían la cuña de traspaso y el color del filete. Si
    mañana cambia el reparto en `process.ts`, el suelo se mueve solo.

    **Va al revés que la maqueta, y el motivo es el ritmo de la página.** La
    entrega ponía los pasos de DLPay sobre `--papel-2`, lo que obligaba a pasar
    esta sección a `--papel`… y entonces `.detail` y `.prep` quedaban las dos
    claras y pegadas. La página alterna sus cuatro secciones a propósito —
    papel-2, papel, papel-2, papel— y eso valía más que el sentido del contraste.
    Así que la sección se queda como estaba y lo que se aclara es el paso.

    La información es la misma: el suelo cambia donde cambia de manos. Y el
    contraste sale mejor — sobre `--papel` el texto da 16:1 y el tiempo en
    `--verde-deep` 5,44:1, contra 14,5 y 4,93 sobre `--papel-2`.

    El margen negativo saca el suelo hacia fuera en lugar de meter el texto
    hacia dentro: así los seis pasos conservan el mismo borde izquierdo, que en
    móvil —una sola columna— es lo que impide que la escalera se vea torcida.
  */
  .step.us {
    background: var(--papel);
    border-radius: var(--r-3);
    margin-inline: calc(-1 * var(--s-4));
    padding: var(--s-4) var(--s-4) var(--s-5);
  }
  .time {
    display: inline-block;
    margin-top: var(--s-2);
    font-size: var(--t-dato-sm);
    font-weight: 500;
    color: var(--ink-mute);
  }

  .prep { background: var(--papel); padding: var(--s-9) 0; }
  .prep-grid { display: grid; gap: var(--s-8); }
  .check { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-3); }
  .check li {
    display: flex;
    gap: var(--s-3);
    align-items: flex-start;
    color: var(--ink-mute);
  }
  /*
    20px y no los 19 de la maqueta: **19 está fuera de la grilla 16/20/24** del
    Design System §7, que pide una razón anotada para salirse de ella, y acá no
    la hay — 20 es el escalón de al lado y la diferencia no se ve. El tick que
    sustituye medía 17px, pero era una marca sin caja interior: un icono con
    caja necesita el escalón siguiente para pesar lo mismo.

    `margin-top: 2px` alinea la caja del icono con la altura de x de la primera
    línea; con los 3px del tick viejo quedaba bajo.
  */
  .tick { width: 20px; height: 20px; color: var(--verde-deep); flex: none; margin-top: 2px; }

  .kyc p { color: var(--ink-mute); max-width: 47ch; margin-bottom: var(--s-3); }
  .kyc .note { font-size: var(--t-body-sm); }
  .kyc-actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-5); }
  .ghost {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    border: 1px solid var(--line);
    border-radius: var(--r-2);
    padding: var(--s-4) var(--s-5);
    color: var(--ink);
    text-decoration: none;
    font-size: var(--t-body-sm);
    font-weight: 600;
  }
  .ghost { transition: border-color var(--m-fast) var(--m-ease); }
  .ghost:hover { border-color: var(--ink); }
  .wa-icon { width: 15px; height: 15px; }

  /* El límite del servicio, dicho antes de que el usuario opere. Va sobre papel-2
     y con un borde de aviso: es información que protege, no letra chica. */
  .scope { background: var(--papel-2); padding: var(--s-9) 0; }

  /*
    La banda de cierre va sobre papel (Design System §6.3, revisado el
    2026-09-24): el pie es `--tinta`, así que una banda clara se distingue de él
    sin depender de ningún filete. El tono es el que CONTINÚA la alternancia de
    esta página — la sección de arriba es `--papel-2`, así que ésta es `--papel`.
    Centrada: la invitación y su acción leen como una sola pieza.
  */
  .close { background: var(--papel); padding: var(--s-9) 0; text-align: center; }
  /* Sin `font-size` propio: toma la escala de `h2` de la página. Las cuatro
     bandas de cierre del sitio hablan al mismo volumen. */
  .close h2 { color: var(--ink); margin-bottom: var(--s-3); }
  .close p { color: var(--ink-mute); margin: 0 auto var(--s-5); max-width: 47ch; }
  .cta {
    display: inline-flex;
    align-items: center;
    background: var(--verde);
    color: var(--on-verde);
    font-weight: 700;
    font-size: var(--t-body);
    padding: var(--s-4) var(--s-6);
    border-radius: var(--r-2);
    text-decoration: none;
  }
  .cta { transition: background-color var(--m-fast) var(--m-ease); }
  .cta:hover { background: var(--verde-hi); }

  @media (min-width: 760px) {
    .prep-grid { grid-template-columns: 1fr 1.3fr; gap: var(--s-8); }
  }
  @media (min-width: 900px) {
    .inner { padding-inline: var(--pad-section); }
    h2 { font-size: var(--t-h2); }
    .step h3 { font-size: var(--t-h3); }

    /* El eje: la línea que separa los dos carriles. No es adorno — es la
       frontera que el trabajo cruza tres veces. */
    .lanes::before {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: 50%;
      width: 1px;
      background: var(--line);
    }
    .lane-heads {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--s-8);
      margin-bottom: var(--s-5);
    }
    .lane-heads .us { text-align: right; }

    .steps { grid-template-columns: 1fr 1fr; gap: var(--s-5) var(--s-8); align-items: start; }
    /* Colocación EXPLÍCITA. Con seis hijos y dos columnas el flujo automático
       los reparte por orden de llegada y el carril deja de significar nada: es
       el mismo error que ya mordió en el listado del blog. */
    .step:nth-child(1) { grid-column: 1; grid-row: 1; }
    .step:nth-child(2) { grid-column: 1; grid-row: 2; }
    .step:nth-child(3) { grid-column: 2; grid-row: 3; }
    .step:nth-child(4) { grid-column: 1; grid-row: 4; }
    .step:nth-child(5) { grid-column: 2; grid-row: 5; }
    .step:nth-child(6) { grid-column: 2; grid-row: 6; }

    /* En escritorio el carril dice quién hace qué **a la vista**. Pero la
       posición en una columna NO llega al árbol de accesibilidad: con
       `display:none` el dato desaparecería para quien no ve la página. Se oculta
       visualmente y SIGUE ahí.

       Repite las declaraciones de la utilidad `.sr-only` de `tokens.css` en vez
       de usar la clase, porque acá el ocultado es CONDICIONAL al breakpoint y
       una clase del marcado no puede serlo. Si esa utilidad cambia, esta regla
       se revisa con ella. */
    .who {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .who + .time::before { content: none; }
    .time { display: block; margin-top: var(--s-2); }

    /* La cuña marca el momento en que el trabajo cambia de manos: el marcador de
       paso del Design System §6, con el mismo trazo que usaba el diagrama de
       flujo. Es lo único que se dibuja en la página. */
    .handoff-mark {
      display: block;
      position: absolute;
      top: -7px;
      width: 40px;
      height: 12px;
      color: var(--verde-deep);
    }
    .step.us .handoff-mark { left: calc(-1 * var(--s-8) / 2 - 20px); }
    .step.you .handoff-mark { right: calc(-1 * var(--s-8) / 2 - 20px); transform: scaleX(-1); }
  }
</style>
