---
/**
 * 404 — la dirección no existe.
 *
 * Reusa `PageHero`: misma banda, mismas cuñas, misma secuencia M6. Dos botones,
 * uno interno y uno a la plataforma, porque en el cutover el tráfico más
 * probable viene de URL de cuenta (/auth/login/, /app/) y no del sitio de
 * marketing (`docs/migracion-urls.md`). Desde el 2026-10-23, además, tres
 * salidas del menú en la ranura `aside`: ver más abajo.
 *
 * NO importa `Motion.astro` a propósito: el movimiento de `PageHero` es CSS de
 * carga, y un observador podría dejar el contenido oculto justo en la página
 * donde el usuario ya llegó. La página va en CERO bytes de JavaScript.
 *
 * Dos cosas la separan del resto de páginas y las dos son deliberadas:
 * · `noindex` — se sirve bajo cualquier URL que no exista, así que no tiene una
 *   dirección propia que un buscador deba guardar. La prop arrastra además la
 *   omisión del canónico; el porqué está en `Base.astro`.
 * · Queda fuera del sitemap, excluida por nombre en `sitemap.xml.ts`.
 */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { platform } from '../lib/config/site.ts';
import { navInfo } from '../lib/navegacion.ts';

/*
  ── Tres salidas más (Cowork, 2026-10-23, ADR-0018, tanda 4) ────────────────

  Para quien no venía a su cuenta: tres páginas que explican el servicio, con
  **los mismos rótulos y descripciones del menú «Información»**, leídos de
  `lib/navegacion.ts`. Ningún texto nuevo salvo el rótulo de encima.

  **No son «las más visitadas»**: el sitio no tiene analítica, así que no se
  puede saber. Son las tres que responden qué es, qué cuesta y qué dudas hay
  —cómo funciona, precio y preguntas—, en el orden del menú. El día que haya
  datos, se cambia esta lista y nada más.
*/
const SALIDAS = ['/como-funciona/', '/precio/', '/preguntas/'];
const salidas = navInfo.filter((e) => SALIDAS.includes(e.href));
---
<Base
  title="Página no encontrada"
  description="La dirección no existe o cambió. Vuelve al inicio de DLPay o entra a tu cuenta."
  path="/404/"
  noindex
  zeroJs
>
  <Header />
  <main id="main">
    <PageHero
      title="Esta página no existe."
      lead="El enlace puede estar antiguo o la dirección venir con un error de tipeo. Si venías a tu cuenta, entra directo desde acá."
      sequence
    >
      <Fragment slot="cta">
        <a class="cta" href="/">Ir al inicio</a>
        {/*
          Sale a la plataforma de Guita y va SIEMPRE por `platform.loginUrl`,
          nunca con la URL escrita a mano: `lib/config/site.ts` es el punto único
          de acoplamiento, así que el día que exista infraestructura propia la
          migración es un solo cambio y esta página lo sigue sola.

          En la MISMA pestaña, sin `target`: quien llega aquí quería su cuenta, y
          dejarle atrás una pestaña con un 404 muerto no le sirve de nada.
        */}
        <a class="ghost" href={platform.loginUrl}>Entra a tu cuenta</a>
      </Fragment>
      {/* REQUIERE VALIDACIÓN DE COMPLIANCE: el rótulo «Para conocer DLPay». */}
      <nav class="salidas" slot="aside" aria-labelledby="salidas-t">
        <p class="salidas-t" id="salidas-t">Para conocer DLPay</p>
        <ul role="list">
          {salidas.map((e) => (
            <li>
              <a href={e.href}>
                <span class="s-texto">
                  <span class="s-t">{e.label}</span>
                  <span class="s-d">{e.detail}</span>
                </span>
                <span class="s-ico" aria-hidden="true"><Icon name="chevron" size={16} /></span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </PageHero>
  </main>
  <Footer />
</Base>

<style>
  /*
    El canto del contenido contra el pie. Esta es la ÚNICA página del sitio sin
    superficie de papel: cabecera, banda y pie son los tres `--tinta`, así que
    sin filete las cuñas de la banda se cortan planas contra una línea que no
    existe y se leen como un recorte, no como una decisión. En las otras tres
    páginas con `PageHero` el canto lo declara el cambio de superficie.

    · `0.1` es el alfa de separador decorativo que ya usan `Header.astro` (borde
      inferior) y `Footer.astro` (divisor). NO es `--line-on-tinta`: ese token
      pesa 0.40 y está reservado al contorno de un CONTROL, y el Design System
      §2.2 dice explícitamente que los decorativos de 0.06–0.14 no lo usan.
      Literal y justificado en el sitio, como pide ADR-0004 §3.
    · Va en la página y no en `PageHero`, porque en el componente cambiaría
      también /como-funciona, /confianza y /empresas, donde no hace falta.
    · Va sobre `main` y no sobre `.page-hero`: con `scopedStyleStrategy: 'class'`
      una regla de la página no alcanza a un elemento del componente hijo. Y
      además dice lo correcto — marca dónde termina el contenido, no dónde
      termina un componente.
  */
  main {
    /* El fondo NO es decorativo y no se puede quitar: `main` es transparente por
       omisión y detrás está el `body`, que es `--papel`. El borde se pinta en el
       canto de ESTE elemento, fuera de la caja de fondo de la banda, así que sin
       esta línea el alfa 0.1 compone contra papel y sale un filete crema de 16:1
       — medido: rgb(245,245,241) en vez de rgb(33,42,52). Con el fondo en tinta,
       el borde compone contra tinta y da el separador discreto que se buscaba. */
    background: var(--tinta);
    border-bottom: 1px solid rgba(237, 242, 239, 0.1);
  }

  /* Copia literal del par de acciones sobre tinta de `empresas.astro`. Es la
     tercera aparición del par —`index.astro` lo tiene en variante clara— y está
     anotada como tal en la ficha de la entrega: si algún día se consolida en un
     sitio compartido, esta página debería consumirlo en vez de repetirlo. */
  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    background: var(--verde);
    color: var(--on-verde);
    font-weight: 700;
    font-size: var(--t-body);
    padding: var(--s-4) var(--s-6);
    border-radius: var(--r-2);
    text-decoration: none;
    transition: background-color var(--m-fast) var(--m-ease);
  }
  .cta:hover { background: var(--verde-hi); }
  .ghost {
    display: inline-flex;
    align-items: center;
    /* 0.40 y no 0.28: WCAG 1.4.11 pide 3:1 al contorno de un control y este
       alfa da 3.50:1 sobre `--tinta`. Mismo valor que Steps y empresas. */
    border: 1px solid var(--line-on-tinta);
    color: var(--on-tinta);
    font-weight: 600;
    font-size: var(--t-body-sm);
    padding: var(--s-4) var(--s-5);
    border-radius: var(--r-2);
    text-decoration: none;
    transition: border-color var(--m-fast) var(--m-ease);
  }
  .ghost:hover { border-color: var(--on-tinta); }

  /*
    ── Las tres salidas (2026-10-23) ────────────────────────────────────────
    La ranura `aside` de `PageHero`: bajo 900 va después de los botones; desde
    900, a la derecha. Tres filas como las del desplegable del menú —rótulo y
    descripción—, con el filete decorativo de esta página entre ellas y un
    chevron que dice «esto lleva a otra página». Cada fila mide más de 44 px.
  */
  .salidas { width: 100%; max-width: 26rem; }
  .salidas-t {
    margin-bottom: var(--s-3);
    font-family: var(--f-num);
    font-size: var(--t-dato-sm);
    color: var(--on-tinta-mute);
  }
  .salidas ul { list-style: none; margin: 0; padding: 0; }
  /* El mismo alfa 0.1 del canto de abajo y de la cabecera: decorativo. */
  .salidas li { border-top: 1px solid rgba(237, 242, 239, 0.1); }
  .salidas li:last-child { border-bottom: 1px solid rgba(237, 242, 239, 0.1); }
  .salidas a {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    min-height: 56px;
    padding: var(--s-3) 0;
    text-decoration: none;
  }
  .s-texto { display: grid; gap: 2px; flex: 1; min-width: 0; }
  .s-t { color: var(--on-tinta); font-weight: 600; transition: color var(--m-fast) var(--m-ease); }
  .s-d { color: var(--on-tinta-mute); font-size: var(--t-body-sm); }
  .s-ico { display: grid; color: var(--on-tinta-mute); }
  .s-ico :global(svg) { display: block; width: 16px; height: 16px; }
  .salidas a:hover .s-t { color: var(--verde); }
</style>
